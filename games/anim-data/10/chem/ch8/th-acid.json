 "steps": [
  {
   "id": "s0",
   "title": "Start from butane",
   "narration": "**Butane, C₄H₁₀**: four carbons in a chain. To make an acid we change the carbon at **one end**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Make the –COOH group",
   "narration": "The end carbon gets **two** oxygen bonds: a **double bond to O** (C=O) and a bond to **–OH**. This is the **carboxyl group, –COOH** (orange). The carbon with the carboxyl group is **part of the chain**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Count the carbons",
   "narration": "Count **all** the carbons, **including the –COOH carbon**: 3 + 1 = **4**, so the stem is [[stem|but]]. The –COOH carbon is always **C-1**.",
   "actions": [
    {
     "pulse": [
      "grp"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s3",
   "title": "Name: butanoic acid",
   "narration": "[[stem|but]] (4 C) + [[ane|an]] + [[acid|oic acid]]. No position number is needed, because –COOH is **always at the end** of the chain (C-1). The name is **butanoic acid**.",
   "actions": [
    {
     "pulse": [
      "t_acid"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Formulas of butanoic acid",
   "narration": "Molecular formula: **C₄H₈O₂**. Condensed (normal) formula: **CH₃CH₂CH₂COOH**. Count the atoms: C 4, H 3+2+2+1 = 8, O 2.",
   "actions": [
    {
     "pulse": [
      "f1"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Compare with an alcohol",
   "narration": "**Butan-1-ol** has just an –OH on C-1 (blue). The acid has **C=O and –OH on the same carbon**. Different group, different ending: [[ol|-ol]] for an alcohol, [[acid|-oic acid]] for an acid.",
   "actions": [
    {
     "pulse": [
      "cgrp"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Carboxylic acid",
   "tex": "\\role{acid}{\\mathrm{R{-}COOH}}",
   "text": "R is the rest of the chain. The carbon of –COOH is C-1."
  },
  {
   "title": "Name pattern",
   "tex": "\\role{stem}{\\text{stem}}\\role{ane}{\\text{an}}\\role{acid}{\\text{oic acid}}",
   "text": "Count the carbon of –COOH in the stem. No position number."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "What is the name of **CH₃CH₂CH₂CH₂COOH**?",
   "options": [
    {
     "id": "a",
     "label": "butanoic acid"
    },
    {
     "id": "b",
     "label": "hexanoic acid"
    },
    {
     "id": "c",
     "label": "pentanoic acid"
    },
    {
     "id": "d",
     "label": "pentan-1-ol"
    }
   ],
   "answer": "c",
   "hint": "Count ALL the carbons, including the COOH carbon.",
   "explain": "4 + 1 = 5 carbons: pentanoic acid (pent + an + oic acid)."
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many **oxygen atoms** are in one molecule of a carboxylic acid (one –COOH group)?",
   "answer": 2,
   "hint": "C=O and –OH.",
   "explain": "The carboxyl group has two oxygens: one in C=O and one in –OH."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Why does butanoic acid have **no position number** in its name?",
   "options": [
    {
     "id": "a",
     "label": "acids never have a double bond"
    },
    {
     "id": "b",
     "label": "the number is added later"
    },
    {
     "id": "c",
     "label": "the chain has only 4 carbons"
    },
    {
     "id": "d",
     "label": "the –COOH group is always at the end of the chain (C-1)"
    }
   ],
   "answer": "d",
   "hint": "Where can –COOH sit?",
   "explain": "The carbon of –COOH is always C-1, so a number would add no information."
  }
 ],
 "takeaways": [
  "Carboxylic acid = **–COOH** (a C=O and an –OH on the **same** carbon); the name ends in **-oic acid**.",
  "The –COOH carbon **counts** in the stem and is always **C-1**: no number needed.",
  "CH₃CH₂CH₂COOH is **butanoic acid**, C₄H₈O₂."
 ],
 "notes": [
  {
   "title": "Common mistake",
   "text": "Do not forget the carbon of the –COOH group when counting. CH₃CH₂CH₂COOH has FOUR carbons, not three."
  }
 ]
}