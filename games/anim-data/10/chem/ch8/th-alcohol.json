 "steps": [
  {
   "id": "s0",
   "title": "Start from propane",
   "narration": "**Propane, C₃H₈**: three carbons, only single bonds, no functional group. We will replace one hydrogen by the **–OH group**.",
   "actions": [
    {
     "set": {
      "p": 0
     }
    }
   ]
  },
  {
   "id": "s1",
   "title": "–OH on the end carbon",
   "narration": "Take an H off the **end** carbon and put –OH in its place. The compound is now an **alcohol**: the name loses the final “e” of propane and gains [[ol|-ol]]. Count the carbons **from the –OH end**, so the –OH is on C-1: **propan-1-ol**.",
   "actions": [
    {
     "set": {
      "p": 1
     }
    },
    {
     "pulse": [
      "bx1"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "–OH on the middle carbon",
   "narration": "Put the –OH on the **middle** carbon instead. The –OH is now on C-2 (either end gives 2): **propan-2-ol**. It is a **different compound** with different properties.",
   "actions": [
    {
     "set": {
      "p": 2
     }
    },
    {
     "pulse": [
      "bx2"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s3",
   "title": "Same formula, different compound",
   "narration": "Both have the formula **C₃H₈O**. Only the **position** of the –OH differs. That is why the number [[num|1 or 2]] must be written in the name.",
   "actions": [
    {
     "set": {
      "p": 2
     }
    }
   ]
  },
  {
   "id": "s4",
   "title": "How the name is built",
   "narration": "prop-**an**-1-ol: stem [[stem|prop]] (3 C) + [[ane|an]] (single bonds, “e” dropped) + [[num|1]] (position of –OH) + [[ol|ol]] (alcohol). Use the slider to switch between the compounds.",
   "actions": [
    {
     "set": {
      "p": 1
     }
    }
   ]
  },
  {
   "id": "s5",
   "title": "Condensed formulas",
   "narration": "Propan-1-ol: **CH₃CH₂CH₂OH**. Propan-2-ol: **CH₃CH(OH)CH₃**. Write the –OH in brackets when it is on a middle carbon.",
   "actions": [
    {
     "set": {
      "p": 2
     }
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Alcohol name",
   "tex": "\\role{stem}{\\text{stem}}\\role{ane}{\\text{an}}\\text{-}\\role{num}{p}\\text{-}\\role{ol}{\\text{ol}}",
   "text": "Drop the final “e” of the alkane and add -ol; p is the carbon that holds the –OH."
  },
  {
   "title": "General formula",
   "tex": "\\role{ol}{\\mathrm{R{-}OH}}",
   "text": "R is the carbon chain. Propan-1-ol: R = CH₃CH₂CH₂–."
  }
 ],
