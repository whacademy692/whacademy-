 "steps": [
  {
   "id": "s0",
   "title": "Start with methane",
   "narration": "**Methane, CH₄**: one carbon with four hydrogens. It is the smallest alkane (n = 1). Use the slider or the steps to add carbons.",
   "actions": [
    {
     "set": {
      "n": 1
     }
    }
   ]
  },
  {
   "id": "s1",
   "title": "Add one CH₂",
   "narration": "Put one more carbon in the chain. It brings **2 hydrogens** with it (the dashed box is the new **–CH₂–** unit). The chain is now **ethane, C₂H₆**: H = 2 × 2 + 2 = 6.",
   "actions": [
    {
     "tween": {
      "n": 2
     },
     "dur": 700,
     "at": 0
    },
    {
     "pulse": [
      "add1"
     ],
     "at": 800
    }
   ]
  },
  {
   "id": "s2",
   "title": "Again: propane",
   "narration": "Another CH₂ gives **propane, C₃H₈**. The formula grew by exactly **CH₂** (one C and two H). A family where each member differs by CH₂ is a **homologous series**.",
   "actions": [
    {
