     "pulse": [
      "title"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Step 4 · Draw the carbon chain",
   "narration": "Write six carbon atoms in a row, joined by single bonds, and number them from the left: C-1 to C-6.",
