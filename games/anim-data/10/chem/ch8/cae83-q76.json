 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "**Name this alkene and write its structural formula.** We will work it out step by step: the stem, the ending, the carbon chain, the hydrogens and the condensed formula.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Step 1 · Find the stem",
   "narration": "The question gives **6 carbon atoms**, so the stem is [[stem|hex]]. From five carbons onwards the stems are the Greek numbers: pent (5), hex (6), hept (7), oct (8).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Step 2 · Read the ending",
   "narration": "The question asks for an **alkene** (a C=C double bond), so the ending is [[ene|-ene]].",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Step 3 · Put the name together",
   "narration": "Stem + number + ending: [[stem|hex]]-[[num|3]]-[[ene|ene]] → **hex-3-ene**.",
