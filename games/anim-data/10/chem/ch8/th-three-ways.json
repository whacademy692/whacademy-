 "steps": [
  {
   "id": "s0",
   "title": "One compound, three descriptions",
   "narration": "Propane is a compound of carbon and hydrogen. There are **three ways** to write what it is made of. They all describe the same molecule.",
   "actions": [
    {
     "pulse": [
      "title"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s1",
   "title": "Molecular formula",
   "narration": "The **molecular formula** only **counts** the atoms: 3 carbon atoms and 8 hydrogen atoms, **C₃H₈**. It does not show how they are joined.",
   "actions": [
    {
     "pulse": [
      "val_m"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "Displayed formula",
   "narration": "The **displayed formula** shows **every atom and every bond**. One line = single bond. Here there are 3 C and 8 H joined by **10 lines** (2 C–C + 8 C–H). It is drawn straightened out and flattened.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Condensed (normal) formula",
   "narration": "The **condensed** (normal) formula leaves out the bond lines and groups the atoms on each carbon: **CH₃CH₂CH₃**. It is short and quick, but shows less detail.",
   "actions": [
    {
     "pulse": [
      "val_c"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Compare them",
   "narration": "Molecular: counts atoms only. Displayed: shows **all bonds** (best detail, slow to draw). Condensed: **short**, groups each carbon with its hydrogens. Always check that a condensed formula gives the same atoms as the molecular formula.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "From displayed to condensed",
   "narration": "See how the condensed formula is made: put a ring round each carbon **with the hydrogen atoms on it**. –CH₃ is a **methyl** group and –CH₂– is a **methylene** group.",
   "actions": [
    {
     "pulse": [
      "cb0",
      "cb1",
      "cb2"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Lines in a displayed formula",
   "tex": "\\text{lines} = (\\text{C–C lines}) + (\\text{C–H lines})",
   "text": "Propane: 2 C–C + 8 C–H = 10 lines."
  },
  {
   "title": "Alkane check",
   "tex": "\\role{ane}{\\mathrm{C}_{n}\\mathrm{H}_{2n+2}}",
   "text": "n = 3 gives H = 2 × 3 + 2 = 8, so C₃H₈."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many **lines** (bonds) are in the displayed formula of **butane**, C₄H₁₀?",
   "answer": 13,
   "hint": "Count C–C lines (3) and C–H lines (10).",
   "explain": "3 C–C + 10 C–H = 13 lines."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which kind of formula shows **every bond** in the molecule?",
   "options": [
    {
     "id": "a",
     "label": "condensed formula"
    },
    {
     "id": "b",
     "label": "displayed formula"
    },
    {
     "id": "c",
     "label": "empirical formula"
    },
    {
     "id": "d",
     "label": "molecular formula"
    }
   ],
   "answer": "b",
   "hint": "It is large and slow to draw.",
   "explain": "The displayed formula shows all atoms and all bonds as lines."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "What is the group –CH₂– called?",
   "options": [
    {
     "id": "a",
     "label": "hydroxyl"
    },
    {
     "id": "b",
     "label": "carboxyl"
    },
    {
     "id": "c",
     "label": "methyl"
    },
    {
     "id": "d",
     "label": "methylene"
    }
   ],
   "answer": "d",
   "hint": "CH₃ is methyl.",
   "explain": "–CH₃ is methyl; –CH₂– is methylene."
  }
 ],
 "takeaways": [
  "**Molecular** formula = counts atoms. **Displayed** = every bond. **Condensed** = grouped, bonds left out.",
  "The three formulae of one compound always contain the **same atoms**.",
  "–CH₃ is **methyl**, –CH₂– is **methylene**."
 ],
 "notes": [
  {
   "title": "Note",
   "text": "The 90° angles in a displayed formula are only a drawing convention. Real molecules are not flat."
  }
 ]
}