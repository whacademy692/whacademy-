 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "**Draw the displayed and condensed formula of but-1-ene.** We will work it out step by step: the stem, the ending, the carbon chain, the hydrogens and the condensed formula.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Step 1 · Read the stem",
   "narration": "In **[[stem|but]]-[[num|1]]-[[ene|ene]]** the stem is [[stem|but]]. It means **four carbon atoms** in the main chain. Remember: **M**ice **E**at **P**eanut **B**utter = meth, eth, prop, but (1–4 carbons).",
   "actions": [
    {
     "pulse": [
      "title"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "Step 2 · Read the ending",
   "narration": "The ending [[ene|-ene]] means an **alkene**: the chain has one carbon–carbon **double bond**, C=C.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Step 3 · Draw the carbon chain",
   "narration": "Write four carbon atoms in a row, joined by single bonds, and number them from the left: C-1 to C-4.",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Step 4 · Draw the double bond",
   "narration": "The number [[num|1]] says the double bond **starts** at C-1, so it joins **C-1 and C-2**. Draw it as **two lines** (red box).",
   "actions": [
    {
     "pulse": [
      "grp"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Step 5 · Fill in the hydrogens",
   "narration": "Every carbon must have **four** bonds. Put hydrogen on every free place: C-1 and C-3 get 2 H; C-2 gets 1 H; C-4 gets 3 H.",
   "actions": [
    {
     "pulse": [
      "tm_4",
      "tm_5",
      "tm_6",
      "tm_7",
      "tm_8",
      "tm_9",
      "tm_10",
      "tm_11"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s6",
   "title": "Check the four-bond rule",
   "narration": "Count the lines on every carbon: C-1 and C-3: 2 to carbon + 2 to hydrogen = **4**; C-2: 3 to carbon + 1 to hydrogen = **4**; C-4: 1 to carbon + 3 to hydrogen = **4**.",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s7",
   "title": "The condensed (normal) formula",
   "narration": "Group each carbon with its hydrogens and leave out the bond lines: **CH₂=CHCH₂CH₃**.",
   "actions": [
    {
     "pulse": [
      "cap_cond"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s8",
   "title": "The molecular formula",
   "narration": "Count the atoms: 4 C, 8 H → **C₄H₈**. Check with CₙH₂ₙ: 2 × 4 = 8 ✓.",
   "actions": [
    {
     "pulse": [
      "cap_mf"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "General formula of alkenes",
   "tex": "\\role{ene}{\\mathrm{C}_{n}\\mathrm{H}_{2n}}",
   "text": "Alkenes with one C=C double bond."
  },
  {
   "title": "A name is stem + ending",
   "tex": "\\role{stem}{\\text{stem}} + \\role{ene}{\\text{ending}}",
   "text": "The stem counts the carbons; the ending names the family. A number in the middle says where the bond or group sits."
  },
  {
   "title": "The four-bond rule",
   "tex": "\\mathrm{C}:\\ 4 \\qquad \\mathrm{O}:\\ 2 \\qquad \\mathrm{H}:\\ 1",
   "text": "Count the lines on every atom. A double bond is two lines, a triple bond is three."
  }
 ],
