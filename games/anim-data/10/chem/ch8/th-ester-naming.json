 "steps": [
  {
   "id": "s0",
   "title": "Two parts, two names",
   "narration": "An ester has **two parts** joined through –COO–. Here: an acid part with 2 carbons (orange) and an alkyl part with 1 carbon (blue). The blue part comes from the **alcohol**, the orange part from the **acid**. Name: **methyl ethanoate**.",
   "actions": [
    {
     "set": {
      "a": 2,
      "k": 1
     }
    }
   ]
  },
  {
   "id": "s1",
   "title": "Alkyl part first",
   "narration": "The name starts with the **alkyl group** from the alcohol ([[ol|methyl]], [[ol|ethyl]], [[ol|propyl]] …) and ends with the **acid stem + “oate”**. Here: 3-carbon acid part + 2-carbon alkyl part = **ethyl propanoate**.",
   "actions": [
    {
     "set": {
      "a": 3,
      "k": 2
     }
    }
   ]
  },
  {
   "id": "s2",
   "title": "Longer chains",
   "narration": "4-carbon acid part + 3-carbon alkyl part: **propyl butanoate**. The acid-part stem is **but** (4 carbons, counting the C=O carbon); the alkyl group is **propyl**.",
   "actions": [
    {
     "set": {
      "a": 4,
      "k": 3
     }
    }
   ]
  },
  {
   "id": "s3",
   "title": "Swap the two parts",
   "narration": "Swap the sizes: 1-carbon acid part and 3-carbon alkyl part gives **propyl methanoate**. Same pieces but a **different ester**. Which part is which matters!",
   "actions": [
    {
     "set": {
      "a": 1,
      "k": 3
     }
    }
   ]
  },
  {
   "id": "s4",
   "title": "Read the formula backwards",
   "narration": "**CH₃CH₂COOCH₃**: the part with C=O belongs to the acid: CH₃CH₂CO = 3 carbons = **propanoate**; the part after the O is **methyl**. Name: **methyl propanoate** (made from propanoic acid + methanol).",
   "actions": [
    {
     "set": {
      "a": 3,
      "k": 1
     }
    }
   ]
  },
  {
   "id": "s5",
   "title": "The rule",
   "narration": "**alkyl (from the alcohol)** + **stem + “oate” (from the acid)**. To find the parent compounds, replace “oate” by “oic acid” and “alkyl” by the alcohol: ethyl ethanoate comes from ethanoic acid + ethanol.",
   "actions": [
    {
     "set": {
      "a": 2,
      "k": 2
     }
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Naming an ester",
   "tex": "\\role{ol}{\\text{alkyl}}\\ \\ \\role{acid}{\\text{stem}\\,+\\,\\text{oate}}",
   "text": "Alkyl group of the alcohol first, then the acid stem with the ending -oate."
  },
  {
   "title": "The ester group",
   "tex": "\\role{ester}{\\mathrm{RCOOR\\prime}}",
   "text": "R comes from the acid, R′ from the alcohol."
  }
 ],
