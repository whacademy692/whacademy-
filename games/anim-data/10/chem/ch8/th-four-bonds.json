 "steps": [
  {
   "id": "s0",
   "title": "Four hands",
   "narration": "Carbon is the key atom of organic chemistry. **Every carbon atom forms four bonds** — never three, never five. Think of it as having four “hands”.",
   "actions": [
    {
     "pulse": [
      "ta_0"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s1",
   "title": "Methane: four single bonds",
   "narration": "In **methane, CH₄**, carbon holds hands with four hydrogen atoms: four single bonds, four lines. Every **H makes exactly one bond**.",
   "actions": [
    {
     "pulse": [
      "ba_0_0",
      "ba_1_0",
      "ba_2_0",
      "ba_3_0"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "Ethane: carbon joins carbon",
   "narration": "In **ethane, C₂H₆**, the carbons are joined by one C–C bond. Each carbon has **1** line to the other carbon and **3** to hydrogen: 1 + 3 = **4**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Ethene: a double bond",
   "narration": "In **ethene, C₂H₄**, the carbons share **two** pairs of electrons — a **double bond**, drawn as two lines. A double bond uses **2** of the four bonds, so each carbon has room for only **2** H: 2 + 2 = **4**.",
   "actions": [
    {
     "pulse": [
      "bx3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Ethyne: a triple bond",
   "narration": "In **ethyne, C₂H₂**, the carbons share **three** pairs of electrons — a **triple bond** (three lines). That uses **3** of the four bonds, so each carbon holds just **1** H: 3 + 1 = **4**.",
   "actions": [
    {
     "pulse": [
      "bx4"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Hydrogen and oxygen",
   "narration": "Other atoms have their own numbers: **H makes 1 bond, O makes 2, C makes 4**. In methanol the O is joined to C and to H: 1 + 1 = **2** lines. Always count the lines on every atom.",
   "actions": [
    {
     "pulse": [
      "te_0",
      "te_1",
      "te_2",
      "te_3",
      "te_4",
      "te_5"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Bonds per atom",
   "tex": "\\mathrm{C}:\\ 4 \\qquad \\mathrm{O}:\\ 2 \\qquad \\mathrm{H}:\\ 1",
   "text": "Count the lines on every atom in a displayed formula."
  },
  {
   "title": "Multiple bonds",
   "tex": "\\role{ene}{\\mathrm{C{=}C}} = 2\\ \\text{lines} \\qquad \\role{yne}{\\mathrm{C{\\equiv}C}} = 3\\ \\text{lines}",
   "text": "A double bond counts as two of the four bonds, a triple bond as three."
  }
 ],
