 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "**Name this alcohol and draw its displayed and structural formula.** We will work it out step by step: the stem, the ending, the carbon chain, the hydrogens and the condensed formula.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Step 1 · Find the stem",
   "narration": "The question gives **4 carbon atoms**, so the stem is [[stem|but]]. Remember: **M**ice **E**at **P**eanut **B**utter = meth, eth, prop, but (1–4 carbons).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Step 2 · Read the ending",
   "narration": "The question asks for an **alcohol** (an –OH group), so the ending is [[ol|-ol]].",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Step 3 · Put the name together",
   "narration": "Stem + number + ending: [[stem|but]][[ane|an]]-[[num|2]]-[[ol|ol]] → **butan-2-ol**.",
   "actions": [
    {
     "pulse": [
      "title"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Step 4 · Draw the carbon chain",
   "narration": "Write four carbon atoms in a row, joined by single bonds, and number them from the left: C-1 to C-4.",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Step 5 · Draw the –OH group",
   "narration": "The number [[num|2]] says the –OH is on **C-2**. Draw O above that carbon and put H beside the O (blue box).",
   "actions": [
    {
     "pulse": [
      "grp"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s6",
   "title": "Step 6 · Fill in the hydrogens",
   "narration": "Every carbon must have **four** bonds. Put hydrogen on every free place: C-1 and C-4 get 3 H; C-2 gets 1 H; C-3 gets 2 H. The H of the –OH is already drawn.",
   "actions": [
    {
     "pulse": [
      "tm_4",
      "tm_5",
      "tm_6",
      "tm_9",
      "tm_10",
      "tm_11",
      "tm_12",
      "tm_13",
      "tm_14"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s7",
   "title": "Check the four-bond rule",
   "narration": "Count the lines on every carbon: C-1 and C-4: 1 to carbon + 3 to hydrogen = **4**; C-2: 2 to carbon + 1 to oxygen + 1 to hydrogen = **4**; C-3: 2 to carbon + 2 to hydrogen = **4**.",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s8",
   "title": "The condensed (normal) formula",
   "narration": "Group each carbon with its hydrogens and leave out the bond lines: **CH₃CH(OH)CH₂CH₃**.",
   "actions": [
    {
     "pulse": [
      "cap_cond"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s9",
   "title": "The molecular formula",
   "narration": "Count the atoms: 4 C, 10 H, 1 O → **C₄H₁₀O**. It is the alkane C₄H₁₀ with one H replaced by –OH, so one O is added.",
   "actions": [
    {
     "pulse": [
      "cap_mf"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Alcohol group",
   "tex": "\\role{ol}{\\mathrm{R{-}OH}}",
   "text": "R stands for the carbon chain; –OH is the hydroxyl group."
  },
  {
   "title": "A name is stem + ending",
   "tex": "\\role{stem}{\\text{stem}} + \\role{ol}{\\text{ending}}",
   "text": "The stem counts the carbons; the ending names the family. A number in the middle says where the bond or group sits."
  },
  {
   "title": "The four-bond rule",
   "tex": "\\mathrm{C}:\\ 4 \\qquad \\mathrm{O}:\\ 2 \\qquad \\mathrm{H}:\\ 1",
   "text": "Count the lines on every atom. A double bond is two lines, a triple bond is three."
  }
 ],
 "challenges": [
  {
   "id": "cond",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which is the condensed formula of **propan-2-ol**?",
   "options": [
    {
     "id": "a",
     "label": "CH₃CH₂CH₃"
    },
    {
     "id": "b",
     "label": "CH₃CH(OH)CH₂CH₃"
    },
    {
     "id": "c",
     "label": "CH₃CH₂CH₂OH"
    },
    {
     "id": "d",
     "label": "CH₃CH(OH)CH₃"
    }
   ],
   "answer": "d",
   "hint": "The –OH sits on carbon 2, not on the end carbon.",
   "explain": "propan-2-ol has 3 carbons and –OH on C-2: CH₃CH(OH)CH₃."
  },
  {
   "id": "twin2",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many **hydrogen atoms** are in the displayed formula of **propan-2-ol**? (Count the one in –OH too.)",
   "answer": 8,
   "hint": "Draw it: C-2 has one H plus the –OH; the other carbons are filled up to four bonds.",
   "explain": "propan-2-ol is C₃H₈O, which has 8 H atoms."
  }
 ],
 "takeaways": [
  "**-ol** means an –OH group; the **number** says which carbon carries it.",
  "Draw the –OH as O joined to the carbon and H joined to the O.",
  "An alcohol is the alkane with one H swapped for –OH."
 ],
 "notes": [
  {
   "title": "Exam tip",
   "text": "Draw the O–H bond in the displayed formula; writing only “OH” on the carbon loses the bond mark."
  }
 ]
}