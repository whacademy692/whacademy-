 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "**Name this carboxylic acid and draw its displayed and structural formula.** We will work it out step by step: the stem, the ending, the carbon chain, the hydrogens and the condensed formula.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Step 1 · Find the stem",
   "narration": "The question gives **4 carbon atoms**, so the stem is [[stem|but]]. Remember: **M**ice **E**at **P**eanut **B**utter = meth, eth, prop, but (1–4 carbons).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Step 2 · Read the ending",
   "narration": "The question asks for a **carboxylic acid** (–COOH), so the ending is [[acid|-oic acid]].",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Step 3 · Put the name together",
   "narration": "Stem + ending: [[stem|but]][[ane|an]][[acid|oic acid]] → **butanoic acid**.",
   "actions": [
    {
     "pulse": [
      "title"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Step 4 · Draw the carbon chain",
   "narration": "Write four carbon atoms in a row, joined by single bonds. The –COOH carbon is always the **end** of the chain, so it is **C-1**; number the others from it.",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Step 5 · Draw the –COOH group",
   "narration": "Add the carboxyl group on C-1: a **double-bonded O** and an **–OH**. C-1 now has 1 + 2 + 1 = **4** bonds (orange box).",
   "actions": [
    {
     "pulse": [
      "grp"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s6",
   "title": "Step 6 · Fill in the hydrogens",
   "narration": "Every carbon must have **four** bonds. Put hydrogen on every free place: C-1 gets no H; C-2 and C-3 get 2 H; C-4 gets 3 H. The H of the –OH is already drawn.",
   "actions": [
    {
     "pulse": [
      "tm_6",
      "tm_7",
      "tm_8",
      "tm_9",
      "tm_10",
      "tm_11",
      "tm_12"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s7",
   "title": "Check the four-bond rule",
   "narration": "Count the lines on every carbon: C-1: 1 to carbon + 3 to oxygen = **4**; C-2 and C-3: 2 to carbon + 2 to hydrogen = **4**; C-4: 1 to carbon + 3 to hydrogen = **4**.",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s8",
   "title": "The condensed (normal) formula",
   "narration": "Group each carbon with its hydrogens and leave out the bond lines: **CH₃CH₂CH₂COOH**.",
   "actions": [
    {
     "pulse": [
      "cap_cond"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s9",
   "title": "The molecular formula",
   "narration": "Count the atoms: 4 C, 8 H, 2 O → **C₄H₈O₂**. The carboxyl group –COOH adds 2 O atoms.",
   "actions": [
    {
     "pulse": [
      "cap_mf"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Carboxylic acid group",
   "tex": "\\role{acid}{\\mathrm{R{-}COOH}}",
   "text": "R stands for the carbon chain; –COOH is the carboxyl group."
  },
  {
   "title": "A name is stem + ending",
   "tex": "\\role{stem}{\\text{stem}} + \\role{acid}{\\text{ending}}",
   "text": "The stem counts the carbons; the ending names the family. A number in the middle says where the bond or group sits."
  },
  {
   "title": "The four-bond rule",
   "tex": "\\mathrm{C}:\\ 4 \\qquad \\mathrm{O}:\\ 2 \\qquad \\mathrm{H}:\\ 1",
   "text": "Count the lines on every atom. A double bond is two lines, a triple bond is three."
  }
 ],
 "challenges": [
  {
   "id": "cond",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which is the condensed formula of **propanoic acid**?",
   "options": [
    {
     "id": "a",
     "label": "CH₃CH₂COOH"
    },
    {
     "id": "b",
     "label": "CH₃CH₂CH₃"
    },
    {
     "id": "c",
     "label": "CH₃CH₂CH₂COOH"
    },
    {
     "id": "d",
     "label": "CH₃CH₂CH₂OH"
    }
   ],
   "answer": "a",
   "hint": "The –COOH carbon counts as one of the carbons in the chain.",
   "explain": "propanoic acid has 3 carbons, the last one is the –COOH carbon: CH₃CH₂COOH."
  },
  {
   "id": "twin2",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many **hydrogen atoms** are in **pentanoic acid**? (Count the one in –COOH too.)",
   "answer": 10,
   "hint": "The –COOH carbon has no H of its own, but the –OH of the group has one.",
   "explain": "pentanoic acid is C₅H₁₀O₂: 10 H atoms."
  }
 ],
 "takeaways": [
  "**-oic acid** means –COOH; its carbon is always **C-1**, so no number is written.",
  "C-1 has a double-bonded O and an –OH: 1 + 2 + 1 = 4 bonds.",
  "Count the –COOH carbon as part of the chain when you count carbons."
 ],
 "notes": [
  {
   "title": "Exam tip",
   "text": "In the displayed formula show C=O and C–O–H separately; the carbon of –COOH is counted in the chain."
  }
 ]
