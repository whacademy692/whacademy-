 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "**Which name is correct for the compound CH₃CH₂CH=CHCH₃: pent-2-ene or pent-3-ene?** The compound is already drawn; we only have to number its carbons.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Count the carbons",
   "narration": "There are **5 carbons** in the chain, so the stem is [[stem|pent]]. The ending is [[ene|-ene]] because there is one C=C.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Number from the left",
   "narration": "Counting from the **left**, the double bond is between C-3 and C-4. The number in the name is where the bond **starts**: [[num|3]] → **pent-3-ene**.",
   "actions": [
    {
     "pulse": [
      "grp"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s3",
   "title": "Number from the right",
   "narration": "Counting from the **right**, the same double bond is between C-2 and C-3. It starts at C-[[num|2]] → **pent-2-ene**.",
   "actions": [
    {
     "pulse": [
      "grp"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Use the smaller number",
   "narration": "The rule: **number the chain from the end that gives the double bond the smaller number**. Here 2 is smaller than 3, so we number from the right.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer",
   "narration": "The correct name is **pent-2-ene**. “Pent-3-ene” is wrong because the same compound can be numbered to give a smaller number. (Condensed formula: CH₃CH₂CH=CHCH₃, C₅H₁₀.)",
   "actions": [
    {
     "pulse": [
      "title"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Numbering rule",
   "tex": "\\role{num}{\\text{smaller number}}\\ \\Rightarrow\\ \\text{number from the nearer end}",
   "text": "Number the chain from the end that gives the double bond (or triple bond, or –OH) the smaller number."
  },
  {
   "title": "Name pattern",
   "tex": "\\role{stem}{\\text{pent}}\\text{-}\\role{num}{2}\\text{-}\\role{ene}{\\text{ene}}",
   "text": "stem – number – ending"
  }
 ],
 "challenges": [
  {
   "id": "twin",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which name is correct for **CH₃CH=CHCH₂CH₂CH₃**?",
   "options": [
    {
     "id": "a",
     "label": "hex-1-ene"
    },
    {
     "id": "b",
     "label": "hex-4-ene"
    },
    {
     "id": "c",
     "label": "hex-2-ene"
    },
    {
     "id": "d",
     "label": "hex-3-ene"
    }
   ],
   "answer": "c",
   "hint": "Number from both ends: the double bond starts at C-2 from the left and at C-4 from the right.",
   "explain": "From the left the double bond starts at C-2; from the right it starts at C-4. Choose the smaller number: hex-2-ene."
  },
  {
   "id": "twin2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which name is correct for **CH₃CH₂CH₂CH=CH₂**?",
   "options": [
    {
     "id": "a",
     "label": "pent-3-ene"
    },
    {
     "id": "b",
     "label": "pent-4-ene"
    },
    {
     "id": "c",
     "label": "pent-1-ene"
    },
    {
     "id": "d",
     "label": "pent-2-ene"
    }
   ],
   "answer": "c",
   "hint": "The double bond is at the end of the chain. Number from that end.",
   "explain": "Numbering from the right end, the double bond starts at C-1: pent-1-ene (not pent-4-ene)."
  }
 ],
 "takeaways": [
  "Number the chain from the end that gives the **smaller number** to the double bond.",
  "The number is where the bond **starts** (the lower of its two carbons).",
  "CH₃CH₂CH=CHCH₃ is **pent-2-ene**."
 ],
 "notes": [
  {
   "title": "Exam tip",
   "text": "If a question offers two names for the same drawing, check both ways of numbering and choose the one that gives the smaller number."
  }
 ]
