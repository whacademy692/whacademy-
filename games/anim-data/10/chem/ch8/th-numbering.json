 "steps": [
  {
   "id": "s0",
   "title": "Count from the left",
   "narration": "Number the carbons **from the left**. The double bond starts at C-4, so this numbering gives **hex-4-ene**. But we may count from either end…",
   "actions": [
    {
     "set": {
      "mol": 1,
      "dir": 0
     }
    },
    {
     "pulse": [
      "bx1"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s1",
   "title": "Count from the right",
   "narration": "Number the same molecule **from the right**. Now the double bond starts at C-2: **hex-2-ene**. It is the same molecule, only counted from the other end.",
   "actions": [
    {
     "set": {
      "mol": 1,
      "dir": 1
     }
    },
    {
     "pulse": [
      "bx1"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "Choose the smaller number",
   "narration": "The rule: **number from the end that gives the smaller number** to the double bond. 2 is smaller than 4, so the correct name is **hex-2-ene**.",
   "actions": [
    {
     "set": {
      "mol": 1,
      "dir": 1
     }
    }
   ]
  },
  {
   "id": "s3",
   "title": "The same rule for a triple bond",
   "narration": "**Pent-1-yne**: from the left the triple bond starts at C-1, from the right at C-4. Choose the smaller: **1**. Check in the Values tab: set “Count from” to the right to see the wrong name.",
   "actions": [
    {
     "set": {
      "mol": 2,
      "dir": 0
     }
    },
    {
     "pulse": [
      "bx2"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "And for the –OH group",
   "narration": "**Pentan-2-ol**: the –OH is on C-2 counting from the left but on C-4 from the right. The smaller number, **2**, goes in the name.",
   "actions": [
    {
     "set": {
      "mol": 3,
      "dir": 0
     }
    },
    {
     "pulse": [
      "bx3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "The rule for every position number",
   "narration": "For a double bond, a triple bond or an –OH group: **number the main chain from the end that gives the smaller number**. The number written in the name is where the group **starts**.",
   "actions": [
    {
     "set": {
      "mol": 3,
      "dir": 0
     }
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "The numbering rule",
   "tex": "\\role{num}{\\text{smaller number}}\\ \\Rightarrow\\ \\text{number the chain from that end}",
   "text": "Try both ends, compare the two numbers, choose the smaller."
  },
  {
   "title": "The number in the name",
   "tex": "\\text{stem}\\text{-}\\role{num}{p}\\text{-}\\text{ending}",
   "text": "p is the carbon where the double bond, triple bond or –OH starts."
  }
 ],
