 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "**Complete the reaction and name the reactants and the products:** CH₃CH₂COOH + CH₃OH → ?",
   "actions": [
    {
     "set": {
      "t": 0,
      "u": 0
     }
    }
   ]
  },
  {
   "id": "s1",
   "title": "Name the reactants",
   "narration": "CH₃CH₂COOH has the –COOH group (orange): it is **propanoic acid**. CH₃OH has the –OH group (blue): it is **methanol**.",
   "actions": [
    {
     "set": {
      "t": 0,
      "u": 0
     }
    },
    {
     "pulse": [
      "bxA",
      "bxB"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "The esterification rule",
   "narration": "In esterification **the ACID gives its –OH and the ALCOHOL gives its H**. These three atoms (O, H and H) are about to leave together.",
   "actions": [
    {
     "set": {
      "t": 0,
      "u": 0
     }
    },
    {
     "pulse": [
      "bxA2",
      "bxB2"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s3",
   "title": "Water leaves",
   "narration": "The –OH from the acid and the H from the alcohol join to make **water, H₂O**. The C–O bond of the acid and the O–H bond of the alcohol are broken.",
   "actions": [
    {
     "set": {
      "u": 0
     }
    },
    {
     "tween": {
      "t": 1
     },
     "dur": 1500,
     "at": 0
    },
    {
     "pulse": [
      "wlab"
     ],
     "at": 1700
    }
   ]
  },
  {
   "id": "s4",
   "title": "The pieces join",
   "narration": "The oxygen of the alcohol is now free. It bonds to the carbonyl carbon of the acid, so the two pieces are **joined through an O atom**: the ester link **–COO–**.",
   "actions": [
    {
     "set": {
      "t": 1
     }
    },
    {
     "tween": {
      "u": 1
     },
     "dur": 1500,
