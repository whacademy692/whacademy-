{
 "id": "g10-chem-c8-th-builder",
 "title": "The name machine: stem + number + ending",
 "summary": "Choose the stem, the position number and the ending and watch the structure and the name appear.",
 "alt": "A name builder with three boxes (stem, number, ending) that draws the carbon skeleton and writes names such as but-2-ene, pentan-2-ol and butanoic acid.",
 "autoGrid": false,
 "defaultTab": "formula",
 "world": {
  "x": [
   -2.55,
   15.35
  ],
  "y": [
   -6.35,
   10.25
  ],
  "pad": 10
 },
 "roles": {
  "stem": {
   "label": "Stem (how many C)",
   "color": "#16a34a",
   "text": "The first part of the name. It tells you how many carbon atoms are in the chain."
  },
  "ane": {
   "label": "-ane · alkane",
   "color": "#64748b",
   "text": "Only single bonds between the carbons. No functional group."
  },
  "num": {
   "label": "Position number",
   "color": "#ca8a04",
   "text": "The number in the name. It tells you where the double bond, triple bond or –OH sits."
  },
  "ene": {
   "label": "-ene · C=C",
   "color": "#dc2626",
   "text": "A carbon–carbon DOUBLE bond (red box in the book)."
  },
  "yne": {
   "label": "-yne · C≡C",
   "color": "#7c3aed",
   "text": "A carbon–carbon TRIPLE bond (purple box in the book)."
  },
  "ol": {
   "label": "-ol · –OH",
   "color": "#2563eb",
   "text": "The hydroxyl group of an alcohol."
  },
  "acid": {
   "label": "-oic acid · –COOH",
   "color": "#ea580c",
   "text": "The carboxyl group of a carboxylic acid (orange box in the book)."
  },
  "atomO": {
   "label": "Oxygen",
   "color": "#ef4444",
   "text": "Every oxygen atom makes two bonds.",
   "legend": false
  },
  "good": {
   "label": "Correct",
   "color": "#16a34a",
   "text": "The part that follows the rules."
  }
 },
 "params": [
