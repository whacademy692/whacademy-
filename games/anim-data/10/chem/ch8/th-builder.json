 "formulas": [
  {
   "title": "Name pattern",
   "tex": "\\role{stem}{\\text{stem}}\\text{-}\\role{num}{p}\\text{-}\\role{ane}{\\text{ending}}",
   "text": "Stem = number of carbons, p = position of the group, ending = family."
  },
  {
   "title": "Special cases",
   "tex": "\\role{ol}{\\text{pent}\\mathbf{an}\\text{-}2\\text{-ol}}\\qquad \\role{acid}{\\text{pent}\\mathbf{an}\\text{oic acid}}",
   "text": "Alcohols and acids keep the “an”; acids need no number."
  }
 ],
