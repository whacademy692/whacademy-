 "steps": [
  {
   "id": "s0",
   "title": "One alkene, but-1-ene",
   "narration": "**But-1-ene**: four carbons, a C=C between C-1 and C-2. Molecular formula **C₄H₈**, condensed formula CH₂=CHCH₂CH₃.",
   "actions": [
    {
     "set": {
      "pair": 1,
      "both": 0
     }
    }
   ]
  },
  {
   "id": "s1",
   "title": "Move the double bond",
   "narration": "Keep the four carbons but put the double bond in the **middle**: **but-2-ene**, CH₃CH=CHCH₃. Count the atoms again: still **C₄H₈**. Only the **arrangement** is different.",
   "actions": [
    {
     "set": {
      "pair": 1,
      "both": 1
     }
    },
    {
     "pulse": [
      "bx11"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "Isomers",
   "narration": "Compounds with the **same molecular formula** but **different structural formulae** are called **isomers**. They are different compounds with their own names.",
   "actions": [
    {
     "set": {
      "pair": 1,
      "both": 1
     }
    }
   ]
  },
  {
   "id": "s3",
   "title": "Alcohol isomers",
   "narration": "The same thing happens with alcohols: **propan-1-ol** (–OH on the end carbon) and **propan-2-ol** (–OH on the middle carbon) both have the formula **C₃H₈O**.",
   "actions": [
    {
     "set": {
      "pair": 2,
      "both": 1
     }
    },
    {
     "pulse": [
      "bx20",
      "bx21"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Alkyne isomers",
   "narration": "**But-1-yne** and **but-2-yne** are isomers too: **C₄H₆**, with the triple bond in different positions.",
   "actions": [
    {
     "set": {
      "pair": 3,
      "both": 1
     }
    },
    {
     "pulse": [
      "bx30",
      "bx31"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Why the number matters",
   "narration": "Because the compounds are different, the **position number** is part of the name. Writing just “butene” or “propanol” would not tell you which compound you mean.",
   "actions": [
    {
     "set": {
      "pair": 1,
      "both": 1
     }
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Isomers",
   "tex": "\\text{same }\\role{stem}{\\text{molecular formula}},\\ \\text{different }\\role{num}{\\text{arrangement}}",
   "text": "The atoms are the same; they are joined in a different way."
  }
 ],
