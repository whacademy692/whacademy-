 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "**Draw the displayed and structural formula of butane.** We will work it out step by step: the stem, the ending, the carbon chain, the hydrogens and the condensed formula.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Step 1 · Read the stem",
   "narration": "In **[[stem|but]][[ane|ane]]** the stem is [[stem|but]]. It means **four carbon atoms** in the main chain. Remember: **M**ice **E**at **P**eanut **B**utter = meth, eth, prop, but (1–4 carbons).",
   "actions": [
    {
     "pulse": [
      "title"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s2",
   "title": "Step 2 · Read the ending",
   "narration": "The ending [[ane|-ane]] means an **alkane**: all the bonds between carbon atoms are **single** bonds.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Step 3 · Draw the carbon chain",
   "narration": "Write four carbon atoms in a row, joined by single bonds: C – C – C – C. (No number is needed in the name, but counting them helps.)",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Step 4 · Fill in the hydrogens",
   "narration": "Every carbon must have **four** bonds. Put hydrogen on every free place: C-1 and C-4 get 3 H; C-2 and C-3 get 2 H.",
   "actions": [
    {
     "pulse": [
      "tm_4",
      "tm_5",
      "tm_6",
      "tm_7",
      "tm_8",
      "tm_9",
      "tm_10",
      "tm_11",
      "tm_12",
      "tm_13"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Check the four-bond rule",
   "narration": "Count the lines on every carbon: C-1 and C-4: 1 to carbon + 3 to hydrogen = **4**; C-2 and C-3: 2 to carbon + 2 to hydrogen = **4**.",
   "actions": [
    {
     "pulse": [
      "tm_0",
      "tm_1",
      "tm_2",
      "tm_3"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s6",
   "title": "The condensed (normal) formula",
   "narration": "Group each carbon with its hydrogens and leave out the bond lines: **CH₃CH₂CH₂CH₃**. You may also write it as **CH₃(CH₂)₂CH₃**.",
   "actions": [
    {
     "pulse": [
      "cap_cond"
     ],
     "at": 500
    }
   ]
  },
  {
   "id": "s7",
   "title": "The molecular formula",
   "narration": "Count the atoms: 4 C, 10 H → **C₄H₁₀**. Check with CₙH₂ₙ₊₂: 2 × 4 + 2 = 10 ✓.",
   "actions": [
    {
     "pulse": [
      "cap_mf"
     ],
     "at": 500
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "General formula of alkanes",
   "tex": "\\role{ane}{\\mathrm{C}_{n}\\mathrm{H}_{2n+2}}",
   "text": "Alkanes: every carbon–carbon bond is single."
  },
  {
   "title": "A name is stem + ending",
   "tex": "\\role{stem}{\\text{stem}} + \\role{ane}{\\text{ending}}",
   "text": "The stem counts the carbons; the ending names the family. A number in the middle says where the bond or group sits."
  },
  {
   "title": "The four-bond rule",
   "tex": "\\mathrm{C}:\\ 4 \\qquad \\mathrm{O}:\\ 2 \\qquad \\mathrm{H}:\\ 1",
   "text": "Count the lines on every atom. A double bond is two lines, a triple bond is three."
  }
 ],
