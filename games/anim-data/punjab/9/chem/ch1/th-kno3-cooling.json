 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A solution holds 100 g of KNO₃ in 100 g of water. Using the curve, how many grams of **crystals** form on cooling to **20 °C**? (solubility at 20 °C is about 31 g)",
   "answer": "100-(13.3+0.539*20+0.01788*400)",
   "hint": "Crystals = 100 − solubility at 20 °C.",
   "explain": "About **69 g** crystallise (100 − 31).",
   "tolerance": 3,
   "unit": "g"
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A point **above** the solubility curve represents a…",
   "options": [
    {
     "id": "a",
     "label": "supersaturated solution"
    },
    {
     "id": "b",
     "label": "unsaturated solution"
    },
    {
     "id": "c",
     "label": "suspension"
    },
    {
     "id": "d",
     "label": "pure solid"
    }
   ],
   "answer": "a",
   "hint": "It holds more than the curve allows.",
   "explain": "Above the curve the solution is **supersaturated**."
  }
 ],
 "takeaways": [
  "Below the curve: unsaturated. On the curve: saturated. Above: supersaturated.",
  "Cooling a hot saturated solution makes the extra solute crystallise.",
  "Crystallisation can be used to purify solids."
 ],
 "notes": [
  {
   "title": "Beyond the book",
   "text": "The book labels the three regions of the KNO₃ curve but gives no numbers. Values here are fitted to standard tables and are **approximate**."
  }
 ]
