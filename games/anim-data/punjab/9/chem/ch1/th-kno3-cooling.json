 "steps": [
  {
   "id": "s0",
   "title": "A hot solution",
   "text": "At 90 °C, 100 g of KNO₃ dissolves completely in 100 g of water: the solution is **unsaturated**.",
   "actions": [
    {
     "set": {
      "T": 90
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Regions of the graph",
   "text": "Below the curve the solution is **unsaturated**. **On the curve** it is **saturated**. Above the curve it would be **supersaturated**, holding more than it normally can.",
   "actions": [
    {
     "set": {
      "T": 90
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cool to the curve",
   "text": "On cooling, the solubility falls. At about **56 °C** the solubility equals 100 g: the solution is just **saturated**.",
   "actions": [
    {
     "tween": {
      "T": 56
     },
     "at": 0,
     "dur": 2000
    }
   ]
  },
  {
   "id": "s3",
   "title": "Crystals appear",
   "text": "Cooling further, the water can hold less KNO₃, so the extra comes out as **crystals**. At 20 °C most of the salt has crystallised.",
   "actions": [
    {
     "tween": {
      "T": 20
     },
     "at": 0,
     "dur": 2200
    }
   ]
  },
  {
   "id": "s4",
   "title": "Purifying by crystals",
   "text": "Because solubility changes with temperature, a solid can be **purified**; pure solids appear as beautifully shaped **crystals**.",
   "actions": [
    {
     "set": {
      "T": 20
     },
     "at": 0
    }
   ]
  }
 ],
