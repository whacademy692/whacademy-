 "steps": [
  {
   "id": "s0",
   "title": "Between the main states",
   "text": "Besides solid, liquid, gas and plasma there are **intermediate states** that lie between a liquid and a gas, or between a liquid and a solid.",
   "actions": [
    {
     "set": {
      "sel": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Supercritical fluid",
   "text": "A **supercritical fluid** is a highly compressed state with properties of **both gases and liquids**.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Liquid crystal",
   "text": "A **liquid crystal** has properties between those of a liquid and a crystalline solid, so it is used in **displays**.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Graphene",
   "text": "**Graphene** is a two-dimensional crystal: one layer of carbon atoms in a hexagonal pattern.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Exotic states",
   "text": "States not commonly met, such as **dark matter**, **Bose–Einstein condensate**, nuclear matter and quantum spin liquid, are called **exotic states**.",
   "actions": [
    {
     "set": {
      "sel": 4
     },
     "at": 0
    }
   ]
  }
 ],
