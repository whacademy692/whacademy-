 "steps": [
  {
   "id": "s0",
   "title": "Three kinds of matter",
   "text": "Matter exists as **elements, compounds and mixtures**. Look at the particles in each sample.",
   "actions": [
    {
     "set": {
      "sep": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Element",
   "text": "An **element** contains **only one kind of atom**. It is the simplest form of matter and cannot be broken into simpler substances by ordinary chemical reactions.",
   "actions": [
    {
     "set": {
      "sep": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Compound",
   "text": "A **compound** is made of **two or more different elements chemically combined in a fixed ratio**. In water, hydrogen and oxygen are in the ratio **1 : 8 by mass**.",
   "actions": [
    {
     "set": {
      "sep": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Mixture",
   "text": "A **mixture** has more than one kind of element or compound mixed **in any ratio**. The parts are **not chemically bonded** and keep their own properties.",
   "actions": [
    {
     "set": {
      "sep": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Separate the mixture",
   "text": "Because the components are not bonded, a mixture can be separated by **physical methods**. A compound needs a **chemical reaction** to be broken down.",
   "actions": [
    {
     "tween": {
      "sep": 1
     },
     "at": 0,
     "dur": 1800
    }
   ]
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which of these can be **separated by physical methods**?",
   "options": [
    {
     "id": "a",
     "label": "A mixture"
    },
    {
     "id": "b",
     "label": "A compound"
    },
    {
     "id": "c",
     "label": "An element"
    },
    {
     "id": "d",
     "label": "All of them"
    }
   ],
   "answer": "a",
   "hint": "Its components are not chemically bonded.",
   "explain": "The components of a **mixture** keep their identity and can be separated physically."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which sample has atoms of **different elements combined in a fixed ratio**?",
   "options": [
    {
     "id": "a",
     "label": "Compound"
    },
    {
     "id": "b",
     "label": "Element"
    },
    {
     "id": "c",
     "label": "Mixture"
    },
    {
     "id": "d",
     "label": "Suspension"
    }
   ],
   "answer": "a",
   "hint": "Think of water, H₂O.",
   "explain": "That is the definition of a **compound**."
  }
 ],
 "takeaways": [
  "Element: one kind of atom. Compound: different atoms combined in a fixed ratio. Mixture: any ratio, not bonded.",
  "Elements and compounds are pure substances; a mixture is not.",
  "Mixtures: homogeneous (salt solution) or heterogeneous (rock)."
 ]
}