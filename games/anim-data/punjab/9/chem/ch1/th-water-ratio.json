    {
     "set": {
      "m": 36
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Fixed ratio by weight",
   "text": "In every sample of water, hydrogen and oxygen are in the ratio **1 : 8 by weight**.",
   "actions": [
    {
     "set": {
      "m": 36
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Try another amount",
   "text": "Whatever the amount of water, hydrogen is one-ninth and oxygen eight-ninths of the mass.",
