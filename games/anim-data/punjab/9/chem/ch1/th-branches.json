 "steps": [
  {
   "id": "s0",
   "title": "Why branches?",
   "text": "Chemistry is a widely spread, complex subject, so it is divided into **11 branches**. Each has its own area of study.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Core branches",
   "text": "**Physical**, **inorganic** and **organic** chemistry: how matter behaves, elements without carbon, and carbon compounds.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Life and medicine",
   "text": "**Biochemistry** studies life through chemical processes; **medicinal chemistry** designs drugs; **polymer chemistry** studies large molecules.",
   "actions": [
    {
     "set": {
      "sel": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Earth and space",
   "text": "**Environmental**, **geo-** and **astro-chemistry** study air, soil and water, the Earth’s minerals and molecules in space.",
   "actions": [
    {
     "set": {
      "sel": 9
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Measuring and nuclei",
   "text": "**Analytical** chemistry separates and measures substances; **nuclear** chemistry studies reactions inside the nucleus.",
   "actions": [
    {
     "set": {
      "sel": 7
     },
     "at": 0
    }
   ]
  }
 ],
