 "steps": [
  {
   "id": "s0",
   "title": "Allotropy",
   "text": "An element can exist in **more than one structural form** with very different properties. These forms are **allotropes**, and the phenomenon is **allotropy**. Carbon has several.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Diamond",
   "text": "**Diamond** has a **giant macromolecular** structure: carbon atoms joined in a continuous network.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Graphite",
   "text": "**Graphite** has a **layered structure** of hexagonal rings of carbon.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Buckminster fullerene",
   "text": "**Fullerene C₆₀** is a cage-like sphere of 60 carbon atoms arranged in **pentagons and hexagons**. It is covalent, so it dissolves in organic solvents; it is soft, has a low melting point and does not conduct electricity.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Graphene",
   "text": "**Graphene** is a single hexagonal layer of carbon atoms, a two-dimensional crystal.",
   "actions": [
    {
     "set": {
      "sel": 4
     },
     "at": 0
    }
   ]
  }
 ],
