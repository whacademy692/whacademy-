  },
  {
   "id": "c3",
   "type": "number",
   "title": "Now you try",
   "prompt": "Read the graph: about how many grams of KNO₃ dissolve in 100 g of water at **60 °C**?",
   "answer": "13.3+0.539*60+0.01788*3600",
   "hint": "Set the slider to 60 °C and read the KNO₃ value.",
   "explain": "About **110 g** (read from the curve).",
   "tolerance": 8,
   "unit": "g"
  }
 ],
 "takeaways": [
  "Solubility = g of solute per 100 g of solvent at a given temperature.",
  "Solids such as KNO₃ dissolve more when hot; NaCl hardly changes; gases dissolve less when hot.",
  "It is not a general rule that solubility increases with temperature."
 ],
 "notes": [
  {
   "title": "Beyond the book",
   "text": "The book’s Fig 1.6 shows the curves without numbers. The values here are smooth fits to standard solubility tables, so treat them as **approximate**."
  }
 ]
