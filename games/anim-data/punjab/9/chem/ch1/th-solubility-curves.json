 "steps": [
  {
   "id": "s0",
   "title": "Solubility at 20 °C",
   "text": "**Solubility** = grams of solute that dissolve in **100 g of solvent** at a given temperature. Slide the temperature to read each value.",
   "actions": [
    {
     "set": {
      "T": 20
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Most solids: higher T, more dissolves",
   "text": "The solubility of **KNO₃** (and NaNO₃, KCl, CuSO₄, AgNO₃) **increases** as the temperature rises. KNO₃ rises very steeply.",
   "actions": [
    {
     "tween": {
      "T": 90
     },
     "at": 0,
     "dur": 2200
    }
   ]
  },
  {
   "id": "s2",
   "title": "Sodium chloride is almost flat",
   "text": "The solubility of **NaCl** does **not increase appreciably** with temperature.",
   "actions": [
    {
     "set": {
      "T": 60
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Gases in water: opposite",
   "text": "The solubility of **gases** (NH₃, SO₂) **decreases** as the temperature rises. Usually solubility increases with temperature but this is **not a general rule**.",
   "actions": [
    {
     "tween": {
      "T": 20
     },
     "at": 0,
     "dur": 1800
    }
   ]
  }
 ],
