 "steps": [
  {
   "id": "s0",
   "title": "Three mixtures",
   "text": "A **true solution**, a **colloidal solution** and a **suspension** are all mixtures of a solute in water.",
   "actions": [
    {
     "set": {
      "t": 0,
      "fl": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Particle size and visibility",
   "text": "In a true solution the particles are completely **homogenised** and cannot be seen. Colloid particles are a little bigger but still too small to see. Suspension particles are **seen**.",
   "actions": [
    {
     "set": {
      "t": 0,
      "fl": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Let them stand",
   "text": "The true solution and the colloid **do not settle**. The suspension particles **settle down**.",
   "actions": [
    {
     "set": {
      "fl": 0
     },
     "at": 0
    },
    {
     "tween": {
      "t": 1
     },
     "at": 0,
     "dur": 2200
    }
   ]
  },
  {
   "id": "s3",
   "title": "Filter them",
   "text": "The solution and the colloid **pass through filter paper**. The suspension **cannot pass**; its particles are collected as a **residue**.",
   "actions": [
    {
     "set": {
      "t": 1,
      "fl": 1
     },
     "at": 0
    }
   ]
  }
 ],
