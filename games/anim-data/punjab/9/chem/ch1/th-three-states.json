 ],
 "takeaways": [
  "Solid: closely packed, fixed positions, vibrate, strong forces, high density.",
  "Liquid: close but random, significant forces.",
  "Gas: far apart, random fast motion, very weak forces, very low density."
 ],
 "notes": [
  {
   "title": "Beyond the book",
   "text": "The book does not discuss **fluidity** (an SLO). In standard chemistry solids are rigid, while liquids and gases flow, so they are called fluids."
  }
 ]
