 "steps": [
  {
   "id": "s0",
   "title": "Three primary states",
   "text": "Matter has mass and occupies space. The three primary states are **solid, liquid and gas**; they differ in how the particles are arranged and held together.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Arrangement and distance",
   "text": "Solid: particles **closely packed** at fixed positions. Liquid: closely attached but moving randomly. Gas: **very widely apart**, no order at all.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Motion of particles",
   "text": "Solid particles only **oscillate about their mean positions**. Liquid and gas particles move randomly; gas particles move fastest.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Intermolecular forces",
   "text": "Forces are **very strong** in a solid, **significant** in a liquid and **very weak** in a gas.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Density",
   "text": "Closely packed particles give a **high density**: crystalline solids are the most dense, gases have a very low density.",
   "actions": []
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
