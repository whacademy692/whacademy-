 "steps": [
  {
   "id": "s0",
   "title": "Electropositive metals",
   "text": "Metals tend to **lose electrons** and form **cations**: this is their **electropositive character**, linked to **reactivity**.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Alkali metals are the most reactive",
   "text": "**Na and K** lose electrons very easily and react **vigorously** with water and halogens. **Mg and Ca** are **less electropositive**, so less vigorous. **Aluminium** is also highly electropositive and reacts with mineral acids.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Electronegative non-metals",
   "text": "Non-metals have an **affinity for electrons**: they gain electrons and form **anions**. They are **electronegative**.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The order",
   "text": "**Fluorine** is the **most electronegative** element, followed by **oxygen, nitrogen and chlorine** (the order given in the book).",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  }
 ],
