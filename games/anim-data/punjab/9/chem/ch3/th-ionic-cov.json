 "steps": [
  {
   "id": "s0",
   "title": "Structure",
   "text": "Ionic compounds: oppositely charged ions in a **crystal lattice**. Covalent compounds: mostly **discrete neutral molecules**.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Melting and boiling points",
   "text": "Ionic solids have **high melting and boiling points**: NaCl melts at **801 °C** because the strong forces between ions are hard to break. Covalent compounds generally melt and boil at **lower** temperatures.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Solubility",
   "text": "Ionic compounds are generally **soluble in polar solvents like water**. Covalent compounds are usually **insoluble in water** but soluble in **non-polar solvents**.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conductivity",
   "text": "Ionic compounds conduct when **molten or in solution** because of **free ions**. Covalent compounds are usually **bad conductors**.",
   "actions": [
    {
     "set": {
      "sel": 4
     },
     "at": 0
    }
   ]
  }
 ],
