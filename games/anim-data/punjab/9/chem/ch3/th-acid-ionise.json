 "steps": [
  {
   "id": "s0",
   "title": "A covalent molecule",
   "text": "HCl and H₂SO₄ are **covalent compounds**: their atoms share electrons and there are **no ions** yet.",
   "actions": [
    {
     "set": {
      "sel": 1,
      "i": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "HCl in water",
   "text": "In water the polar H–Cl bond breaks: HCl **ionises** into **H⁺ and Cl⁻**, so its solution conducts electricity.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    },
    {
     "tween": {
      "i": 1
     },
     "at": 0,
     "dur": 2200
    }
   ]
  },
  {
   "id": "s2",
   "title": "H₂SO₄ in water",
   "text": "Sulfuric acid ionises into **two H⁺ ions** and one **sulfate ion SO₄²⁻**.",
   "actions": [
    {
     "set": {
      "sel": 2,
      "i": 0
     },
     "at": 0
    },
    {
     "tween": {
      "i": 1
     },
     "at": 0,
     "dur": 2200
    }
   ]
  },
  {
   "id": "s3",
   "title": "Ions in solution",
   "text": "The hydrogen ions are what make a solution **acidic**. A free H⁺ joins a water molecule to form **H₃O⁺** (a coordinate bond).",
   "actions": [
    {
     "set": {
      "sel": 2,
      "i": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
