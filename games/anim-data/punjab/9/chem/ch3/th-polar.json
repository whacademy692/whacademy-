 "steps": [
  {
   "id": "s0",
   "title": "Identical atoms: H₂",
   "text": "Two **identical** atoms attract the shared pair **equally**: it lies **in the middle**. The bond is **non-polar** (pure covalent).",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Chlorine, Cl₂",
   "text": "Same for Cl₂: identical atoms, shared pair in the middle: **non-polar**.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "HCl: unequal sharing",
   "text": "Chlorine is **more electronegative** than hydrogen, so the shared pair **bends toward Cl**. Cl gets a **partial negative charge (δ⁻)** and H an equal **partial positive charge (δ⁺)**: a **polar covalent bond**.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Water: polar bonds",
   "text": "The two O–H bonds in **water** are **polar covalent**: δ⁻ on oxygen and δ⁺ on each hydrogen.",
   "actions": [
    {
     "set": {
      "sel": 4
     },
     "at": 0
    }
   ]
  }
 ],
