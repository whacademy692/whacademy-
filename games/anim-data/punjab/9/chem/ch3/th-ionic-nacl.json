 "steps": [
  {
   "id": "s0",
   "title": "Two neutral atoms",
   "text": "**Sodium** has configuration **2, 8, 1** and **chlorine 2, 8, 7**. Sodium has one electron too many; chlorine is one short of an octet.",
   "actions": [
    {
     "set": {
      "x": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "An electron is transferred",
   "text": "The electron from the **outermost shell of sodium** passes to the outermost shell of chlorine.",
   "actions": [
    {
     "tween": {
      "x": 1
     },
     "at": 0,
     "dur": 2200
    }
   ]
  },
  {
   "id": "s2",
   "title": "Two ions with noble-gas shells",
   "text": "Sodium becomes **Na⁺** (2, 8, like neon) and chlorine **Cl⁻** (2, 8, 8, like argon). Both have a stable outer shell.",
   "actions": [
    {
     "set": {
      "x": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The ionic bond",
   "text": "The oppositely charged ions attract each other by an **electrostatic force**: this is an **ionic (electrovalent) bond**; NaCl is an **ionic compound**.",
   "actions": [
    {
     "set": {
      "x": 1
     },
     "at": 0
    }
   ]
  }
 ],
