 "steps": [
  {
   "id": "s0",
   "title": "Metals lose outer electrons easily",
   "text": "Metals have **low ionisation energy**, so their atoms lose outer electrons easily. The nuclei **cannot hold their outer electrons firmly**.",
   "actions": [
    {
     "set": {
      "sel": 1,
      "volt": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "A sea of electrons",
   "text": "The outer electrons move **freely** between the ions: no electron stays with one nucleus. The metal is **positive ions submerged in a sea of electrons**. This is the **metallic bond**.",
   "actions": [
    {
     "set": {
      "sel": 1,
      "volt": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Free electrons conduct",
   "text": "The freely moving electrons let metals **conduct heat and electricity**.",
   "actions": [
    {
     "set": {
      "sel": 1,
      "volt": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Stronger with more charge",
   "text": "Magnesium frees **two** electrons per atom and forms **2+** ions, so its metallic bond is **stronger** and it melts at a **higher temperature** than sodium.",
   "actions": [
    {
     "set": {
      "sel": 2,
      "volt": 0
     },
     "at": 0
    }
   ]
  }
 ],
