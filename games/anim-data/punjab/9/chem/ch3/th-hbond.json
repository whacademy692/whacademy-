 "steps": [
  {
   "id": "s0",
   "title": "Water molecules",
   "text": "Each water molecule is bent, with H atoms bonded to oxygen.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Highly polar O–H bonds",
   "text": "Oxygen is much more electronegative than hydrogen, so the **O–H bonds are highly polar**: δ⁻ on O and δ⁺ on H.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Hydrogen bonds",
   "text": "When H is bonded to a highly electronegative element (**F, O or N**), the strong dipole–dipole attraction between molecules is called **hydrogen bonding**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Effect on boiling point",
   "text": "The strength of hydrogen bonds gives **water higher melting and boiling points than H₂S and NH₃**. The stronger the intermolecular forces, the higher the boiling point.",
   "actions": []
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Hydrogen bonding occurs when H is bonded to…",
   "options": [
    {
     "id": "a",
     "label": "F, O or N"
    },
    {
     "id": "b",
     "label": "C, Si or Na"
    },
    {
     "id": "c",
     "label": "Any metal"
    },
    {
     "id": "d",
     "label": "Noble gases"
    }
   ],
   "answer": "a",
   "hint": "Highly electronegative elements.",
   "explain": "H bonded to **F, O or N** gives hydrogen bonding."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Why does water boil at a higher temperature than H₂S?",
   "options": [
    {
     "id": "a",
     "label": "Hydrogen bonds between its molecules"
    },
    {
     "id": "b",
     "label": "It has more atoms"
    },
    {
     "id": "c",
     "label": "It is ionic"
    },
    {
     "id": "d",
     "label": "It is a metal"
    }
   ],
   "answer": "a",
   "hint": "Stronger intermolecular forces.",
   "explain": "Its molecules are held by **hydrogen bonds**, so more energy is needed to separate them."
  }
 ],
 "takeaways": [
  "Hydrogen bond: strong dipole–dipole attraction when H is bonded to F, O or N.",
  "It gives water relatively high melting and boiling points.",
  "Stronger intermolecular forces mean a higher boiling point."
 ],
 "notes": [
  {
   "title": "Beyond the book",
   "text": "The book only says water boils higher than H₂S and NH₃. The boiling points shown (−60 °C, −33 °C, 100 °C) are standard values added to give the bars a scale."
  }
 ]
