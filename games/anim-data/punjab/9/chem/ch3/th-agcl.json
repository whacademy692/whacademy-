 "steps": [
  {
   "id": "s0",
   "title": "Two solutions",
   "text": "A solution of **NaCl** contains **Na⁺ and Cl⁻** ions; a solution of **AgNO₃** contains **Ag⁺ and NO₃⁻** ions. All are dissolved and move freely.",
   "actions": [
    {
     "set": {
      "m": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Mix them",
   "text": "When the solutions are mixed, **Ag⁺ meets Cl⁻**. Silver chloride is **insoluble in water**, so the ions join together.",
   "actions": [
    {
     "tween": {
      "m": 1
     },
     "at": 0,
     "dur": 2600
    }
   ]
  },
  {
   "id": "s2",
   "title": "White precipitate",
   "text": "AgCl settles as a **white precipitate**. **Na⁺ and NO₃⁻** stay dissolved as NaNO₃: they did not take part in the change.",
   "actions": [
    {
     "set": {
      "m": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "challenges": [
  {
