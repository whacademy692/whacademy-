 "steps": [
  {
   "id": "s0",
   "title": "Helium: a duplet",
   "text": "Noble gases neither combine with themselves nor with other atoms: they are **stable**. **Helium has 2 electrons** in its only (first) shell: a **duplet**.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Neon: an octet",
   "text": "**Neon** has **8 electrons** in its outermost shell: an **octet**. Also stable and unreactive.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Argon: an octet too",
   "text": "All noble gases except helium have **8 electrons** in the outermost shell. This gave the **Duplet or Octet Rule**.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Sodium: lose one",
   "text": "Atoms bond to lower their energy by **completing their duplet or octet**. It is easier for **sodium** to **lose 1 electron** than to gain 7.",
   "actions": [
    {
     "set": {
      "sel": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Chlorine: gain one",
   "text": "**Chlorine** has 7 outer electrons and needs just **1 more** to complete its octet.",
   "actions": [
    {
     "set": {
      "sel": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Hydrogen: lose or gain",
   "text": "**Hydrogen** can lose its electron to become a proton (**H⁺**) or gain one to become a hydride ion (**H⁻**), completing its duplet.",
   "actions": [
    {
     "set": {
      "sel": 6
     },
     "at": 0
    }
   ]
  }
 ],
