   "title": "Now you try",
   "prompt": "Why is sodium likely to **lose** one electron rather than gain seven?",
   "options": [
    {
     "id": "a",
     "label": "Losing one electron is energetically easier"
    },
    {
     "id": "b",
     "label": "Sodium is a noble gas"
    },
    {
     "id": "c",
     "label": "It has 8 outer electrons"
    },
    {
     "id": "d",
     "label": "Gaining electrons is impossible"
    }
   ],
   "answer": "a",
   "hint": "Compare 1 with 7.",
   "explain": "Sodium takes the **energetically easier path** and loses one electron."
  }
 ],
 "takeaways": [
  "Duplet (H, He): 2 outer electrons; octet: 8 outer electrons = stable and unreactive.",
  "Atoms form bonds to lower their energy by completing a duplet or octet.",
  "Only outermost-shell electrons take part."
 ],
 "notes": [
  {
   "title": "Beyond the book",
   "text": "The book adds that the octet rule helped explain bonding at the start but was later found to be **less important**."
  }
 ]
