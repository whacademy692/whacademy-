 "takeaways": [
  "Covalent bond: mutual sharing of electron pair(s) between atoms.",
  "Single = 1 pair (H₂, Cl₂); double = 2 pairs (O₂); triple = 3 pairs (N₂).",
  "After sharing, each atom has the configuration of the nearest noble gas."
 ]
}