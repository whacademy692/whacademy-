 "steps": [
  {
   "id": "s0",
   "title": "Ions in a crystal",
   "text": "In an ionic compound, positive and negative ions alternate. Ions are **spherical** and oppositely charged.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Attraction from all sides",
   "text": "Each ion is surrounded by oppositely charged ions: it attracts in **all directions**, so the ionic bond is **non-directional**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "A 3-D crystal lattice",
   "text": "The ions surround each other three-dimensionally to form a **crystal lattice**, as in NaCl and CaCl₂. The compound as a whole is **neutral**.",
   "actions": []
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Why is the ionic bond called **non-directional**?",
   "options": [
    {
     "id": "a",
     "label": "Ions attract oppositely charged ions on all sides"
    },
    {
     "id": "b",
     "label": "Electrons are shared in one direction"
    },
    {
     "id": "c",
     "label": "Ions never move"
    },
    {
     "id": "d",
     "label": "Only two ions attract"
    }
   ],
   "answer": "a",
   "hint": "Ions are spherical.",
   "explain": "Spherical ions attract oppositely charged ions from **all sides**."
  }
 ],
 "takeaways": [
  "Ionic compounds form a crystal lattice of oppositely charged ions.",
  "The compound as a whole is neutral; the bond is non-directional."
 ]
