 "formulas": [
  {
   "title": "Number of neutrons",
   "tex": "N = A - Z",
   "text": "Mass number minus atomic number. Protons = electrons = Z in a neutral atom."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many **neutrons** are in \\(^{210}_{83}\\text{Bi}\\)?",
   "answer": "210-83",
   "hint": "N = A − Z.",
   "explain": "\\( N = 210 - 83 = 127 \\).",
   "tolerance": 0.01
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many **electrons** are in a neutral atom of \\(^{127}_{53}\\text{I}\\)?",
   "answer": 53,
   "hint": "A neutral atom has as many electrons as protons.",
   "explain": "Electrons = protons = Z = **53**.",
   "tolerance": 0.01
  }
 ],
 "takeaways": [
  "Z = number of protons = number of electrons (neutral atom).",
  "A = protons + neutrons, so N = A − Z.",
  "Changing electrons makes ions; changing neutrons makes isotopes."
 ]
}