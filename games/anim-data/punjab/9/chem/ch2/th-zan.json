 "steps": [
  {
   "id": "s0",
   "title": "Two numbers identify an atom",
   "text": "The **atomic number Z** is the number of protons: it identifies the element. The **mass number A** = protons + neutrons (electrons are too light to count). Written as \\(^{A}_{Z}\\text{X}\\).",
   "actions": [
    {
     "set": {
      "sel": 7
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Sulphur-32",
   "text": "For \\(^{32}_{16}\\text{S}\\): protons = 16, electrons = 16 and neutrons = 32 − 16 = **16**.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Barium-137 (book example)",
   "text": "For \\(^{137}_{56}\\text{Ba}\\): protons = 56, electrons = 56, neutrons = 137 − 56 = **81**.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Platinum-195",
   "text": "Protons 78, electrons 78, neutrons 195 − 78 = **117**.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Manganese-55",
   "text": "Protons 25, electrons 25, neutrons 55 − 25 = **30**.",
   "actions": [
    {
     "set": {
      "sel": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Iodine-127",
   "text": "Protons 53, electrons 53, neutrons 127 − 53 = **74**.",
   "actions": [
    {
     "set": {
      "sel": 5
     },
     "at": 0
    }
   ]
  }
 ],
