  {
   "id": "s1",
   "title": "Electron",
   "text": "The **electron** is negative: charge −1.6022 × 10⁻¹⁹ C. Its mass is only 9.109 × 10⁻³¹ kg. A proton is about **1836 times heavier** than an electron.",
   "actions": [
    {
     "set": {
      "sel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Proton",
   "text": "The **proton** is positive: +1.6022 × 10⁻¹⁹ C, mass 1.673 × 10⁻²⁷ kg. It sits in the **nucleus**.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Neutron",
   "text": "The **neutron** has **no charge** and a mass almost the same as the proton: 1.675 × 10⁻²⁷ kg. It sits in the nucleus.",
   "actions": [
    {
     "set": {
      "sel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Same particles, different numbers",
   "text": "All atoms are made of these **three fundamental particles**. Atoms of different elements differ only in the **number** of each particle.",
   "actions": [
    {
     "set": {
      "sel": 2
     },
     "at": 0
    }
   ]
  }
 ],
