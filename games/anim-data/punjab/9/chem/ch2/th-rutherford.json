 "steps": [
  {
   "id": "s0",
   "title": "The set-up",
   "text": "**Rutherford (1911)** hit a stream of fast positive particles at a **very thin gold foil**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Most pass straight through",
   "text": "Almost all the particles went **straight through** the foil. Most of an atom must be **empty space**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "A few are deflected",
   "text": "A few particles were **bent** from their path: something small, positive and heavy repels them.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Very few bounce back",
   "text": "A **very few** particles bounced almost **straight back**, as if they hit something hard and dense.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "The nucleus",
   "text": "An atom has **two parts**: a tiny central **nucleus** (positive, with almost all the mass) and a large region around it where the electrons are. The nucleus is less than 1/100 000 of the atom in size but holds more than **99.9 %** of the mass.",
   "actions": []
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Why did **most** particles pass straight through the gold foil?",
   "options": [
    {
     "id": "a",
     "label": "The foil was very hot"
    },
    {
     "id": "b",
     "label": "Most of the atom is empty space"
    },
    {
     "id": "c",
     "label": "The nucleus is very large"
    },
    {
     "id": "d",
     "label": "The particles had no charge"
    }
   ],
   "answer": "b",
   "hint": "Think about how little of the atom the nucleus fills.",
   "explain": "The nucleus is tiny, so most of the atom is **empty space** and most particles never come close to a nucleus."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Where is almost all the mass of an atom?",
   "options": [
    {
     "id": "a",
     "label": "In the electrons"
    },
    {
     "id": "b",
     "label": "In the nucleus"
    },
    {
     "id": "c",
     "label": "In the shells"
    },
    {
     "id": "d",
     "label": "Spread equally"
    }
   ],
   "answer": "b",
   "hint": "Protons and neutrons are heavy.",
   "explain": "The heavy **protons and neutrons** are in the nucleus, which holds more than 99.9 % of the atom's mass."
  }
 ],
 "takeaways": [
  "Atom = tiny central **nucleus** + large extranuclear region with the electrons.",
  "Almost all the mass is in the nucleus (more than 99.9 %), though it is less than 1/100 000 of the atom in size.",
  "Protons and neutrons are held together by the strong nuclear force."
 ]
}