 "steps": [
  {
   "id": "s0",
   "title": "Atoms: an old idea",
   "text": "The idea that matter is made of atoms is very old. Press play to follow how it grew into the model we use today.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Ancient Greece: Democritus · named “atom”",
   "text": "**Democritus** (Greek philosopher) said all matter is made of tiny particles and named them **atoms**: particles that cannot be divided further.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "About 1800: Dalton · evidence of atoms",
   "text": "**John Dalton** (English chemist) did many experiments with compounds that gave **evidence** for the existence of atoms.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "1886: Goldstein · proton rays",
   "text": "**E. Goldstein** used a discharge tube with a holed cathode and found **canal (anode) rays**: positive gas ions, including H⁺.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "1897: Thomson · electron",
   "text": "**J. J. Thomson** showed that **cathode rays** are negatively charged particles, later called **electrons**.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "1911: Rutherford · nucleus",
   "text": "**Rutherford** fired particles at a thin gold foil and discovered the **nucleus**.",
   "actions": []
  },
  {
   "id": "s6",
   "title": "1913: Bohr · shells",
   "text": "**Niels Bohr** proposed that electrons move in fixed paths called **orbits or shells**, each with fixed energy.",
   "actions": []
  },
  {
   "id": "s7",
   "title": "1917: Rutherford · proton",
   "text": "**Rutherford** showed the hydrogen nucleus is present in other nuclei: the **proton** is a building block of all nuclei.",
   "actions": []
  },
  {
   "id": "s8",
   "title": "1933: neutron",
   "text": "The **neutron** was discovered in **1933**: no charge, mass almost the same as a proton.",
   "actions": []
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Who showed in **1897** that cathode rays are negatively charged particles?",
   "options": [
    {
     "id": "a",
     "label": "Goldstein"
    },
    {
     "id": "b",
     "label": "Thomson"
    },
    {
     "id": "c",
     "label": "Bohr"
    },
    {
     "id": "d",
     "label": "Dalton"
    }
   ],
   "answer": "b",
   "hint": "Think of the electron.",
   "explain": "**J. J. Thomson** (1897) bent cathode rays with electric plates and magnets and named their particles electrons."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which particle was discovered **last**, in 1933?",
   "options": [
    {
     "id": "a",
     "label": "Electron"
    },
    {
     "id": "b",
     "label": "Proton"
    },
    {
     "id": "c",
     "label": "Neutron"
    },
    {
     "id": "d",
     "label": "Nucleus"
    }
   ],
   "answer": "c",
   "hint": "It carries no charge.",
   "explain": "The **neutron** (1933) has no charge and a mass almost equal to the proton."
  }
 ],
 "takeaways": [
  "Democritus named the atom; Dalton gave experimental evidence for it.",
  "Discharge-tube experiments (1886 to 1897) showed atoms contain electrons and protons.",
  "Rutherford found the nucleus (1911); Bohr described shells (1913); the neutron came in 1933."
 ]
}