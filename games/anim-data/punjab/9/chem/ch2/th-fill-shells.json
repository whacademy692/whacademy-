{
 "id": "pb9-chem-c2-th-fill-shells",
 "title": "Build an atom, electron by electron",
 "summary": "Slide the atomic number from 1 to 20 and watch the shells fill (2, 8, 8, 2).",
 "alt": "An atom whose nucleus charge Z is changed from 1 to 20; electrons fill the K, L, M and N shells; outer-shell electrons are highlighted.",
 "autoGrid": false,
