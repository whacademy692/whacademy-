  "x": [
   0,
   100.0
  ],
  "y": [
   0,
   80.0
  ],
  "ratio": 1.25,
  "pad": 6
 },
 "roles": {
  "nuc": {
   "label": "Nucleus",
   "color": "#dc2626",
   "text": "The tiny central part of the atom.",
   "legend": false
  },
  "el": {
   "label": "Inner electrons",
   "color": "#2563eb",
   "text": "Electrons in the inner, filled shells.",
   "legend": true
  },
  "elx": {
   "label": "Outer-shell electrons",
   "color": "#f59e0b",
   "text": "The electrons in the outermost shell: they take part in chemical reactions.",
   "legend": true
  },
  "sh": {
   "label": "Shell",
   "color": "#94a3b8",
   "text": "An energy level (orbit).",
   "legend": false
  }
 },
 "params": [
  {
   "id": "ph",
   "label": "Spin",
   "type": "clock",
   "min": 0,
   "max": 360,
   "step": 0.01,
   "speed": 45,
   "loop": "repeat",
   "default": 0,
   "auto": true,
   "hidden": true
  },
  {
   "id": "Z",
   "label": "Atomic number Z (number of protons)",
   "type": "number",
   "min": 1,
   "max": 20,
   "step": 1,
   "default": 1
  }
 ],
 "derived": {
  "K": "min(Z,2)",
  "L": "clamp(Z-2,0,8)",
  "M": "clamp(Z-10,0,8)",
  "N": "clamp(Z-18,0,2)",
  "o": "if(Z<=2,1,if(Z<=10,2,if(Z<=18,3,4)))",
  "v": "if(Z<=2,Z,if(Z<=10,Z-2,if(Z<=18,Z-10,Z-18)))"
 },
