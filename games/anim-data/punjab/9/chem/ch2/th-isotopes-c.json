 "steps": [
  {
   "id": "s0",
   "title": "Three carbon atoms",
   "text": "Every carbon atom has **6 protons** (Z = 6) and **6 electrons**, arranged 2 in the K shell and 4 in the L shell.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Different neutrons",
   "text": "The three isotopes have **6, 7 and 8 neutrons**: ¹²₆C, ¹³₆C and ¹⁴₆C.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Different mass numbers",
   "text": "A = protons + neutrons = 12, 13 and 14. The masses of the isotopes differ.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Same chemical behaviour",
   "text": "The electron arrangement is the same, so the isotopes show almost the **same chemical properties**.",
   "actions": []
  }
 ],
