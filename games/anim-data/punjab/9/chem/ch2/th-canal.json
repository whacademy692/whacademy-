 "steps": [
  {
   "id": "s0",
   "title": "A holed cathode",
   "text": "**E. Goldstein (1886)** used a discharge tube whose **cathode had holes** in it. The idea: atoms are electrically neutral, so there should be positive particles too.",
   "actions": [
    {
     "tween": {
      "ele": 0,
      "ion": 0
     },
     "at": 0,
     "dur": 700
    }
   ]
  },
  {
   "id": "s1",
   "title": "Electrons go to the anode",
   "text": "The negative **cathode rays** travel from the cathode towards the **anode**.",
   "actions": [
    {
     "tween": {
      "ele": 1,
      "ion": 0
     },
     "at": 0,
     "dur": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Positive rays go to the cathode",
   "text": "A new kind of ray started at the **anode** and moved **towards the cathode**. Some passed **through the holes** (canals), so they are called **canal rays** or **anode rays**.",
   "actions": [
    {
     "tween": {
      "ele": 1,
      "ion": 1
     },
     "at": 0,
     "dur": 700
    }
   ]
  },
  {
   "id": "s3",
   "title": "What the rays were",
   "text": "The rays changed with the gas in the tube: they were **gas ions**, including **hydrogen ions (H⁺)**. In **1917 Rutherford** showed the hydrogen nucleus, the **proton**, is in all other nuclei.",
   "actions": [
    {
     "tween": {
      "ele": 1,
      "ion": 1
     },
     "at": 0,
     "dur": 700
    }
   ]
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Canal rays travel in which direction?",
   "options": [
    {
     "id": "a",
     "label": "Cathode to anode"
    },
    {
     "id": "b",
     "label": "Anode towards the cathode"
    },
    {
     "id": "c",
     "label": "They do not move"
    },
    {
     "id": "d",
     "label": "Only sideways"
    }
   ],
   "answer": "b",
   "hint": "They started at the anode.",
   "explain": "Canal (anode) rays move **from the anode towards the cathode** and pass through its holes."
  }
 ],
 "takeaways": [
  "Goldstein (1886): canal or anode rays pass through a holed cathode.",
  "They are positive gas ions, including H⁺.",
  "Rutherford (1917): the hydrogen nucleus (proton) is a building block of all nuclei."
 ]
