 "steps": [
  {
   "id": "s0",
   "title": "Two isotopes of chlorine",
   "text": "Chlorine has a light isotope (**75.77 %**) and **Cl-37 (24.23 %)**. Its relative atomic mass is **35.45**. We want the mass of the light isotope.",
   "actions": [
    {
     "set": {
      "m1": 35
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Try the slider",
   "text": "Move the slider: the average changes. Which value gives exactly 35.45?",
   "actions": [
    {
     "set": {
      "m1": 35
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Multiply by 100",
   "text": "35.45 = (m × 75.77 + 37 × 24.23) / 100, so **3545 = m × 75.77 + 37 × 24.23**.",
   "actions": [
    {
     "set": {
      "m1": 35
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Subtract the known part",
   "text": "37 × 24.23 = 896.51, so m × 75.77 = 3545 − 896.51 = **2648.49**.",
   "actions": [
    {
     "set": {
      "m1": 35
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Divide",
   "text": "m = 2648.49 ÷ 75.77 = **34.95**: the light isotope is Cl-35 with relative mass 34.95.",
   "actions": [
    {
     "tween": {
      "m1": 34.95
     },
     "at": 0,
     "dur": 700
    }
   ]
  }
 ],
