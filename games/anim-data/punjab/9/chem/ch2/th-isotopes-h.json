 "steps": [
  {
   "id": "s0",
   "title": "Three kinds of hydrogen atom",
   "text": "All three are **hydrogen**: each has **1 proton** (Z = 1) and **1 electron**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Different neutrons",
   "text": "**Isotopes** are atoms of the same element with a **different number of neutrons**: 0, 1 and 2. ¹₁H is the only atom with no neutron.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Different masses",
   "text": "More neutrons means more mass: ²₁H has **twice** and ³₁H **three times** the mass of ¹₁H.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Same chemistry",
   "text": "**Chemical properties** depend on the **electrons**, and all three have one electron, so they behave almost the same chemically. Physical properties such as mass may differ.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "One is radioactive",
   "text": "**Tritium** (³₁H) has an unstable nucleus and is **radioactive**. The other two hydrogen isotopes are stable.",
   "actions": []
  }
 ],
