 "steps": [
  {
   "id": "s0",
   "title": "Bohr's picture",
   "text": "Electrons revolve around the **nucleus** in fixed paths called **shells** or **orbits**. Each shell has its own fixed energy, so shells are also called **energy levels**.",
   "actions": [
    {
     "set": {
      "k": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "K shell (n = 1)",
   "text": "The shell nearest the nucleus is the **K shell**. It has the **lowest energy** and holds at most **2** electrons: 2 × 1² = 2.",
   "actions": [
    {
     "set": {
      "k": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "L shell (n = 2)",
   "text": "The second shell is **L**. Maximum = 2 × 2² = **8** electrons. It is farther away, so its energy is greater.",
   "actions": [
    {
     "set": {
      "k": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "M shell (n = 3)",
   "text": "Third shell **M**: 2 × 3² = **18** electrons.",
   "actions": [
    {
     "set": {
      "k": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "N shell (n = 4)",
   "text": "Fourth shell **N**: 2 × 4² = **32** electrons. E₄ > E₃ > E₂ > E₁.",
   "actions": [
    {
     "set": {
      "k": 4
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Shell",
   "value": "n = {{k|int}}",
   "role": "warn"
  },
  {
   "label": "Electrons it can hold (2n²)",
   "value": "{{cap|int}}",
   "role": "el"
  }
 ],
 "formulas": [
  {
   "title": "Maximum electrons in a shell",
   "tex": "\\text{max electrons} = 2n^2",
   "text": "n is the shell number (K = 1, L = 2, M = 3, N = 4)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
