 "steps": [
  {
   "id": "s0",
   "title": "The discharge tube",
   "text": "A hard glass tube holds two metal **electrodes**: the **cathode (−)** and the **anode (+)**. A vacuum pump removes most of the gas so the pressure is very low.",
   "actions": [
    {
     "tween": {
      "V": 0,
      "M": 0,
      "rays": 0
     },
     "at": 0,
     "dur": 700
    }
   ]
  },
  {
   "id": "s1",
   "title": "High voltage: cathode rays",
   "text": "With a **very high voltage** across the gas at very low pressure, the glass behind the positive electrode **glows**. The glow is caused by rays from the cathode: **cathode rays**.",
   "actions": [
    {
     "tween": {
      "V": 0,
      "M": 0,
      "rays": 1
     },
     "at": 0,
     "dur": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Electric plates: they bend",
   "text": "**J. J. Thomson (1897)** passed the rays between two charged plates. The rays **bent towards the positive plate**, so they carry **negative charge**.",
   "actions": [
    {
     "tween": {
      "V": 1,
      "M": 0,
      "rays": 1
     },
     "at": 0,
     "dur": 700
    }
   ]
  },
  {
   "id": "s3",
   "title": "Magnets: also deflected",
   "text": "Two magnets on either side of the tube also **deflected** the rays. Thomson used both results to calculate the **mass-to-charge ratio**.",
   "actions": [
    {
     "tween": {
      "V": 0,
      "M": 1,
      "rays": 1
     },
     "at": 0,
     "dur": 700
    }
   ]
  },
  {
   "id": "s4",
   "title": "Conclusion: electrons",
   "text": "Cathode rays are **negatively charged material particles**. They were named **electrons** and are found in the atoms of **all** elements.",
   "actions": [
    {
     "tween": {
      "V": 0,
      "M": 0,
      "rays": 1
     },
     "at": 0,
     "dur": 700
    }
   ]
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Cathode rays are attracted towards the **positive** plate. What does this show?",
   "options": [
    {
     "id": "a",
     "label": "They are positively charged"
    },
    {
     "id": "b",
     "label": "They are negatively charged"
    },
    {
     "id": "c",
     "label": "They have no charge"
    },
    {
     "id": "d",
     "label": "They are neutrons"
    }
   ],
   "answer": "b",
   "hint": "Opposite charges attract.",
   "explain": "Opposites attract, so rays pulled towards the positive plate must be **negative**."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "What name was later given to the particles of cathode rays?",
   "options": [
    {
     "id": "a",
     "label": "Protons"
    },
    {
     "id": "b",
     "label": "Neutrons"
    },
    {
     "id": "c",
     "label": "Electrons"
    },
    {
     "id": "d",
     "label": "Nuclei"
    }
   ],
   "answer": "c",
   "hint": "They are the negative subatomic particles.",
   "explain": "They were named **electrons**."
  }
 ],
 "takeaways": [
  "Cathode rays travel from the cathode towards the anode.",
  "They bend towards a positive plate, so they are **negative**; magnets deflect them too.",
  "They are electrons, present in all atoms."
 ]
}