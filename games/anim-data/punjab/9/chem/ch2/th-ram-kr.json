 "steps": [
  {
   "id": "s0",
   "title": "Five isotopes",
   "text": "Krypton has five isotopes with relative isotopic masses **80, 82, 83, 84, 85** and abundances **2, 12, 12, 57, 17 %**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "The formula",
   "text": "Relative atomic mass = (m₁p₁ + m₂p₂ + m₃p₃ + …) / 100, where m is the isotopic mass and p the abundance in %.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Multiply m × p",
   "text": "80×2.0 = 160, 82×12 = 984, 83×12 = 996, 84×57 = 4788, 85×17 = 1445.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Add them up",
   "text": "160 + 984 + 996 + 4788 + 1445 = **8373**.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Divide by 100",
   "text": "8373 ÷ 100 = 83.73, which the book rounds to **83.7**. The most abundant isotope (84) pulls the average close to 84.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Relative atomic mass",
   "tex": "A_r = \\dfrac{m_1p_1 + m_2p_2 + m_3p_3 + \\cdots}{100}",
   "text": "m = relative isotopic mass, p = isotopic abundance (%)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Lead has isotopes ²⁰⁴Pb (2.0 %), ²⁰⁶Pb (24.0 %), ²⁰⁷Pb (22.0 %) and ²⁰⁸Pb (52.0 %). Find its relative atomic mass.",
   "answer": "(204*2+206*24+207*22+208*52)/100",
