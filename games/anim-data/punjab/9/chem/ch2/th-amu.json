 "steps": [
  {
   "id": "s0",
   "title": "Why a unit is needed",
   "text": "Atoms are far too light to weigh in grams. Chemists need to **compare masses of atoms**, and also to know the ratio in which to mix reactants. In **1961** the **carbon-12** atom was taken as the standard.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Cut into 12 equal parts",
   "text": "The mass of one carbon-12 atom is taken as exactly **12**. Imagine it cut into **12 equal parts**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "One part = 1 amu",
   "text": "**One atomic mass unit (amu)** = one-twelfth of the mass of a carbon-12 atom = **1.67377 × 10⁻²⁷ kg**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Weigh other atoms in amu",
   "text": "Hydrogen-1 is about **1.007 amu**, almost one part. Sulphur-32 is **31.972 amu**, about 32 parts.",
   "actions": []
  }
 ],
