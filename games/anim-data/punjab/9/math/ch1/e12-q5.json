 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "\\[\\begin{aligned}&\\text{(i)}\\\\[5pt]&(25)^{\\frac{3}{2}}=(5^{2})^{\\frac{3}{2}}=5^{3}=125\\\\[5pt]&(243)^{\\frac{3}{5}}=(3^{5})^{\\frac{3}{5}}=3^{3}=27\\\\[5pt]&(16)^{\\frac{5}{4}}=(2^{4})^{\\frac{5}{4}}=2^{5}=32\\\\[5pt]&(8)^{\\frac{4}{3}}=(2^{3})^{\\frac{4}{3}}=2^{4}=16\\\\[5pt]&\\text{Expression }=\\frac{125\\times 27}{32\\times 16}=\\\\[5pt]&\\quad \\frac{3375}{512}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "\\[\\begin{aligned}&\\text{(ii)}\\\\[5pt]&^{3}\\sqrt{(27)^{2x}}=((3^{3})^{2x})^{\\frac{1}{3}}=\\\\[5pt]&\\quad 3^{2x}\\\\[5pt]&\\text{Numerator }=54\\times 3^{2x}\\\\[5pt]&\\text{Denominator }=9^{x+1}+216(3^{2x-1})\\\\[5pt]&\\quad =3^{2x+2}+216\\times \\frac{3^{2x}}{3}\\\\[5pt]&\\quad =9\\cdot 3^{2x}+72\\cdot 3^{2x}\\\\[5pt]&\\quad =81\\cdot 3^{2x}\\\\[5pt]&\\text{Expression }=\\\\[5pt]&\\quad \\frac{54\\times 3^{2x}}{81\\times 3^{2x}}=\\frac{54}{81}=\\\\[5pt]&\\quad \\frac{2}{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "\\[\\begin{aligned}&\\text{(iii)}\\\\[5pt]&(216)^{\\frac{2}{3}}=((6)^{3})^{\\frac{2}{3}}=6^{2}=36\\\\[5pt]&(25)^{\\frac{1}{2}}=5\\\\[5pt]&(0.04)^{-\\frac{3}{2}}=(\\frac{4}{100})^{-\\frac{3}{2}}=\\\\[5pt]&\\quad (\\frac{1}{25})^{-\\frac{3}{2}}=(25)^{\\frac{3}{2}}=5^{3}=125\\\\[5pt]&\\text{Expression }=\\sqrt{\\frac{36\\times 5}{125}}\\\\[5pt]&\\quad =\\sqrt{\\frac{180}{125}}\\\\[5pt]&\\quad =\\sqrt{\\frac{36}{25}}\\\\[5pt]&\\quad =\\frac{6}{5}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "\\[\\begin{aligned}&\\text{(iv)}\\\\[5pt]&\\text{Let }A=a^{\\frac{1}{3}}\\text{ and }B=b^{\\frac{2}{3}}\\\\[5pt]&\\text{Then }A^{2}=a^{\\frac{2}{3}},AB=a^{\\frac{1}{3}}\\\\[5pt]&\\quad b^{\\frac{2}{3}},B^{2}=b^{\\frac{4}{3}}\\\\[5pt]&(A+B)(A^{2}-AB+B^{2})=A^{3}+B^{3}\\\\[5pt]&\\quad =(a^{\\frac{1}{3}})^{3}+(b^{\\frac{2}{3}})^{3}\\\\[5pt]&\\quad =a+b^{2}\\end{aligned}\\]",
   "actions": [
