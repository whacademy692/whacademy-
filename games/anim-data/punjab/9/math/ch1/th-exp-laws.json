 "steps": [
  {
   "id": "s0",
   "title": "What does a power mean?",
   "narration": "\\( {{b|int}}^{{m|int}} \\) means **{{m|int}} copies of {{b|int}} multiplied together**. Each box in the picture is one factor of {{b|int}}.",
   "actions": [
    {
     "set": {
      "law": 0,
      "b": 2,
      "m": 4,
      "n": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply two powers",
   "narration": "\\( {{b|int}}^{{m|int}} \\times {{b|int}}^{{n|int}} \\): put the two rows side by side. Now there are \\( {{m|int}} + {{n|int}} = {{m+n|int}} \\) factors, so the result is \\( {{b|int}}^{{m+n|int}} \\). **Add the exponents.**",
   "actions": [
    {
     "set": {
      "law": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Divide two powers",
   "narration": "\\( {{b|int}}^{{m|int}} \\div {{b|int}}^{{n|int}} \\): {{n|int}} factors cancel. What is left is \\( {{b|int}}^{{m-n|int}} \\). **Subtract the exponents.**",
   "actions": [
    {
     "set": {
      "law": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Power of a power",
   "narration": "\\( ({{b|int}}^{{m|int}})^{{n|int}} \\) means {{n|int}} rows of {{m|int}} factors. That is \\( {{m|int}} \\times {{n|int}} = {{m*n|int}} \\) factors. **Multiply the exponents.**",
   "actions": [
    {
     "set": {
      "law": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Try your own numbers",
   "narration": "Change **b**, **m** and **n** and switch between the three laws.",
   "actions": [
    {
     "set": {
      "law": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Product law",
   "tex": "a^m \\times a^n = a^{m+n}",
   "text": "Same base: add the exponents."
  },
  {
   "title": "Quotient law",
   "tex": "\\dfrac{a^m}{a^n} = a^{m-n}",
   "text": "Same base: subtract the exponents."
  },
  {
   "title": "Power of a power",
   "tex": "(a^m)^n = a^{mn}",
   "text": "Multiply the exponents."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Product",
   "answer": 7,
   "prompt": "\\( 2^4 \\times 2^3 = 2^{?} \\). What is the missing exponent?",
   "hint": "Add the exponents.",
   "explain": "\\( 2^{4+3} = 2^7 \\)"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Quotient",
   "answer": 3,
   "prompt": "\\( 3^5 \\div 3^2 = 3^{?} \\). What is the missing exponent?",
   "hint": "Subtract the exponents.",
   "explain": "\\( 3^{5-2} = 3^3 \\)"
  },
  {
   "id": "c3",
   "type": "number",
   "title": "Power of a power",
   "answer": 6,
   "prompt": "\\( (5^2)^3 = 5^{?} \\). What is the missing exponent?",
   "hint": "Multiply the exponents.",
   "explain": "\\( 5^{2 \\times 3} = 5^6 \\)"
  }
 ],
 "intro": "A power is just a count of factors. The laws of exponents come from counting.",
 "takeaways": [
  "a^m × a^n = a^(m+n)",
  "a^m ÷ a^n = a^(m−n)",
  "(a^m)^n = a^(mn)"
 ],
 "notes": [
  {
   "title": "Keep n at most m",
   "text": "For the division law keep n at most m so the exponent stays positive in this picture."
  }
 ],
 "challengeIntro": "Now you try. Each question uses the picture above.",
 "constraints": [
  {
   "when": "law!=1 || n<=m",
   "message": "For a division keep n at most m."
  }
 ]
}