 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "\\[\\begin{aligned}&\\text{(i)}\\\\[5pt]&(\\frac{81}{16})^{-\\frac{3}{4}}=(\\frac{16}{81})^{\\frac{3}{4}}\\\\[5pt]&\\quad =((\\frac{2}{3})^{4})^{\\frac{3}{4}}\\\\[5pt]&\\quad =(\\frac{2}{3})^{3}\\\\[5pt]&\\quad =\\frac{8}{27}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "\\[\\begin{aligned}&\\text{(ii)}\\\\[5pt]&(\\frac{3}{4})^{-2}=(\\frac{4}{3})^{2}=\\frac{16}{9}\\\\[5pt]&(\\frac{4}{9})^{3}=\\frac{64}{729}\\\\[5pt]&(\\frac{3}{4})^{-2}\\div (\\frac{4}{9})^{3}\\times \\frac{16}{27}=\\frac{16}{9}\\times \\\\[5pt]&\\quad \\frac{729}{64}\\times \\frac{16}{27}\\\\[5pt]&\\quad =\\frac{16\\times 729\\times 16}{9\\times 64\\times 27}\\\\[5pt]&\\quad =12\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "\\[\\begin{aligned}&\\text{(iii)}\\\\[5pt]&(0.027)^{-\\frac{1}{3}}=(\\frac{27}{1000})^{-\\frac{1}{3}}\\\\[5pt]&\\quad =(\\frac{1000}{27})^{\\frac{1}{3}}\\\\[5pt]&\\quad =((\\frac{10}{3})^{3})^{\\frac{1}{3}}\\\\[5pt]&\\quad =\\frac{10}{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "\\[\\begin{aligned}&\\text{(iv)}\\\\[5pt]&\\frac{x^{14}y^{21}z^{35}}{y^{14}z^{7}}=x^{14}\\cdot \\\\[5pt]&\\quad y^{21-14}\\cdot z^{35-7}\\\\[5pt]&\\quad =x^{14}y^{7}z^{28}\\\\[5pt]&^{7}\\sqrt{x^{14}y^{7}z^{28}}=\\\\[5pt]&\\quad (x^{14}y^{7}z^{28})^{\\frac{1}{7}}\\\\[5pt]&\\quad =x^{2}yz^{4}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
