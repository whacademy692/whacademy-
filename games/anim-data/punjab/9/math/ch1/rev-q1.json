 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{(i)}}\\text{ }\\sqrt{7}\\text{ is: (a) integer (b)}\\\\[5pt]&\\quad \\text{rational number (c) irrational number}\\\\[5pt]&\\quad \\text{(d) natural number}\\\\[5pt]&\\textcolor{#047857}{\\textbf{Ans: (c) irrational number}}\\text{ — }7\\text{ is}\\\\[5pt]&\\quad \\text{not a perfect square, so }\\sqrt{7}=2.6457\\ldots \\\\[5pt]&\\quad \\text{is non-terminating and non-recurring.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{(ii)}}\\text{ }\\pi \\text{ and e are: (a) natural}\\\\[5pt]&\\quad \\text{numbers (b) integers (c) rational}\\\\[5pt]&\\quad \\text{numbers (d) irrational numbers}\\\\[5pt]&\\textcolor{#047857}{\\textbf{Ans: (d) irrational numbers}}\\text{ — }\\pi =\\\\[5pt]&\\quad 3.14159\\ldots \\text{ and }e=2.71828\\ldots \\text{ are}\\\\[5pt]&\\quad \\text{non-terminating and non-recurring.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{(iii)}}\\text{ If n is not a perfect}\\\\[5pt]&\\quad \\text{square, then }\\sqrt{n}\\text{ is: (a) rational}\\\\[5pt]&\\quad \\text{number (b) natural number (c) integer}\\\\[5pt]&\\quad \\text{(d) irrational number}\\\\[5pt]&\\textcolor{#047857}{\\textbf{Ans: (d) irrational number}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{(iv)}}\\text{ }\\sqrt{3}+\\sqrt{5}\\text{ is: (a) whole number}\\\\[5pt]&\\quad \\text{(b) integer (c) rational number (d)}\\\\[5pt]&\\quad \\text{irrational number}\\\\[5pt]&\\textcolor{#047857}{\\textbf{Ans: (d) irrational number}}\\text{ — the}\\\\[5pt]&\\quad \\text{sum of two non-similar surds is}\\\\[5pt]&\\quad \\text{irrational.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (v)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{(v)}}\\text{ For all }x\\in R,x=x\\text{ is}\\\\[5pt]&\\quad \\text{called: (a) reflexive property (b)}\\\\[5pt]&\\quad \\text{transitive number (c) symmetric}\\\\[5pt]&\\quad \\text{property (d) trichotomy property}\\\\[5pt]&\\textcolor{#047857}{\\textbf{Ans: (a) reflexive property}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (vi)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{(vi)}}\\text{ Let a, b, }c\\in R,\\text{ then }a>b\\\\[5pt]&\\quad \\text{and b > c $\\Rightarrow$ a > c is called \\_\\_\\_\\_\\_\\_}\\\\[5pt]&\\quad \\text{property: (a) trichotomy (b)}\\\\[5pt]&\\quad \\text{transitive (c) additive (d)}\\\\[5pt]&\\quad \\text{multiplicative}\\\\[5pt]&\\textcolor{#047857}{\\textbf{Ans: (b) transitive}}\\end{aligned}\\]",
   "actions": [
