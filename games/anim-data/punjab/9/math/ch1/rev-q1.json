     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Part (vii)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{(vii)}}\\text{ }2^{x}\\times 8^{x}=64\\text{ then }x=\\text{ (a)}\\\\[5pt]&\\quad \\frac{3}{2}\\text{ (b) }\\frac{3}{4}\\text{ (c) }\\frac{5}{6}\\text{ (d) }\\frac{2}{3}\\\\[5pt]&2^{x}\\times 8^{x}=64\\\\[5pt]&2^{x}\\times (2^{3})^{x}=2^{6}\\\\[5pt]&2^{x}\\times 2^{3x}=2^{6}\\\\[5pt]&2^{4x}=2^{6}\\\\[5pt]&4x=6\\\\[5pt]&x=\\frac{3}{2}\\\\[5pt]&\\textcolor{#047857}{\\textbf{Ans: (a) }\\mathbf{\\frac{3}{2}}}\\end{aligned}\\]",
