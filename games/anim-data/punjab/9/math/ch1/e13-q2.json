 "steps": [
  {
   "id": "s0",
   "title": "Set up",
   "text": "\\[\\begin{aligned}&\\text{Area of }\\Delta ABC=\\frac{1}{2}\\times AB\\times AC\\\\[5pt]&1+\\sqrt{15}=\\frac{1}{2}\\times AB\\times (\\sqrt{3}+\\sqrt{5})\\\\[5pt]&AB=2\\frac{1+\\sqrt{15}}{\\sqrt{3}+\\sqrt{5}}\\\\[5pt]&\\text{Rationalize the denominator:}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Working",
   "text": "\\[\\begin{aligned}&AB=2\\frac{1+\\sqrt{15}}{\\sqrt{3}+\\sqrt{5}}\\times \\\\[5pt]&\\quad \\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}\\\\[5pt]&\\quad =\\\\[5pt]&\\quad 2(1+\\sqrt{15})\\frac{\\sqrt{5}-\\sqrt{3}}{(\\sqrt{5})^{2}-(\\sqrt{3})^{2}}\\\\[5pt]&\\quad =2(1+\\sqrt{15})\\frac{\\sqrt{5}-\\sqrt{3}}{5-3}\\\\[5pt]&\\quad =(1+\\sqrt{15})(\\sqrt{5}-\\sqrt{3})\\\\[5pt]&\\quad =\\sqrt{5}-\\sqrt{3}+\\sqrt{75}-\\sqrt{45}\\\\[5pt]&\\quad =\\sqrt{5}-\\sqrt{3}+5\\sqrt{3}-3\\sqrt{5}\\\\[5pt]&\\quad =4\\sqrt{3}-2\\sqrt{5}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Result",
   "text": "\\[\\begin{aligned}&\\text{So AB }=\\text{ }\\textcolor{#047857}{\\mathbf{(4\\sqrt{3}-2\\sqrt{5})}\\textbf{ cm}}\\text{, i.e. }a=4\\\\[5pt]&\\quad \\text{and }b=-2.\\end{aligned}\\]",
   "actions": [
