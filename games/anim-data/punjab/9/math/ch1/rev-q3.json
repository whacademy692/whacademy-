 "steps": [
  {
   "id": "s0",
   "title": "Set up",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\textbf{Associative property w.r.t.}}\\\\[5pt]&\\quad \\text{addition:}\\textcolor{#047857}{\\textbf{ (a }\\mathbf{+}\\textbf{ b) }\\mathbf{+c=a+}\\textbf{ (b }\\mathbf{+}\\textbf{ c)}}\\\\[5pt]&LHS=(a+b)+c\\\\[5pt]&\\quad =(\\frac{4}{3}+\\frac{5}{2})+\\frac{7}{4}=(\\frac{8+15}{6})+\\\\[5pt]&\\quad \\frac{7}{4}\\\\[5pt]&\\quad =\\frac{23}{6}+\\frac{7}{4}=\\frac{46+21}{12}=\\frac{67}{12}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Working",
   "text": "\\[\\begin{aligned}&RHS=a+(b+c)\\\\[5pt]&\\quad =\\frac{4}{3}+(\\frac{5}{2}+\\frac{7}{4})=\\frac{4}{3}+\\\\[5pt]&\\quad (\\frac{10+7}{4})\\\\[5pt]&\\quad =\\frac{4}{3}+\\frac{17}{4}=\\frac{16+51}{12}=\\frac{67}{12}\\\\[5pt]&LHS=RHS\\\\[5pt]&\\textcolor{#047857}{\\textbf{Associative property w.r.t.}}\\\\[5pt]&\\quad \\text{multiplication:}\\textcolor{#047857}{\\textbf{ (ab)c }\\mathbf{=}\\textbf{ a(bc)}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Working",
   "text": "\\[\\begin{aligned}&LHS=\\text{ (ab)c}\\\\[5pt]&\\quad =((\\frac{4}{3})(\\frac{5}{2}))(\\frac{7}{4})=(\\frac{20}{6})(\\frac{7}{4})\\\\[5pt]&\\quad =(\\frac{10}{3})(\\frac{7}{4})=\\frac{70}{12}=\\frac{35}{6}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Result",
   "text": "\\[\\begin{aligned}&RHS=\\text{ a(bc)}\\\\[5pt]&\\quad =(\\frac{4}{3})((\\frac{5}{2})(\\frac{7}{4}))=(\\frac{4}{3})(\\frac{35}{8})\\\\[5pt]&\\quad =\\frac{140}{24}=\\frac{35}{6}\\\\[5pt]&LHS=RHS\\\\[5pt]&\\text{Hence the associative property is}\\\\[5pt]&\\quad \\text{verified w.r.t. both addition and}\\\\[5pt]&\\quad \\text{multiplication.}\\end{aligned}\\]",
   "actions": [
