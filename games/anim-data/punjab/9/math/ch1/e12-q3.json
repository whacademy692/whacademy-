 "steps": [
  {
   "id": "s0",
   "title": "Set up",
   "text": "\\[\\begin{aligned}&x=3+\\sqrt{8}=3+2\\sqrt{2}\\\\[5pt]&\\frac{1}{x}=\\frac{1}{3+2\\sqrt{2}}\\times \\\\[5pt]&\\quad \\frac{3-2\\sqrt{2}}{3-2\\sqrt{2}}\\\\[5pt]&\\quad =\\frac{3-2\\sqrt{2}}{(3)^{2}-(2\\sqrt{2})^{2}}\\\\[5pt]&\\quad =\\frac{3-2\\sqrt{2}}{9-8}\\\\[5pt]&\\quad =3-2\\sqrt{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (i)",
   "text": "\\[\\begin{aligned}&\\text{(i)}\\\\[5pt]&x+\\frac{1}{x}=(3+2\\sqrt{2})+(3-2\\sqrt{2})=6\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (ii)",
   "text": "\\[\\begin{aligned}&\\text{(ii)}\\\\[5pt]&x-\\frac{1}{x}=(3+2\\sqrt{2})-(3-2\\sqrt{2})=4\\sqrt{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iii)",
   "text": "\\[\\begin{aligned}&\\text{(iii)}\\\\[5pt]&x^{2}+\\frac{1}{x^{2}}=(x+\\frac{1}{x})^{2}-2\\\\[5pt]&\\quad =(6)^{2}-2\\\\[5pt]&\\quad =36-2\\\\[5pt]&\\quad =34\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (iv)",
   "text": "\\[\\begin{aligned}&\\text{(iv)}\\\\[5pt]&x^{2}-\\frac{1}{x^{2}}=(x+\\frac{1}{x})(x-\\frac{1}{x})\\\\[5pt]&\\quad =(6)(4\\sqrt{2})\\\\[5pt]&\\quad =24\\sqrt{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (v)",
   "text": "\\[\\begin{aligned}&\\text{(v)}\\\\[5pt]&x^{4}+\\frac{1}{x^{4}}=(x^{2}+\\frac{1}{x^{2}})^{2}-2\\\\[5pt]&\\quad =(34)^{2}-2\\\\[5pt]&\\quad =1156-2\\\\[5pt]&\\quad =1154\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Part (vi)",
   "text": "\\[\\begin{aligned}&\\text{(vi)}\\\\[5pt]&(x-\\frac{1}{x})^{2}=(4\\sqrt{2})^{2}\\\\[5pt]&\\quad =16\\times 2\\\\[5pt]&\\quad =32\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  }
