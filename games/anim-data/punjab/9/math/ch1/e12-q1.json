 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "\\[\\begin{aligned}&\\text{(i)}\\\\[5pt]&\\frac{13}{4+\\sqrt{3}}=\\frac{13}{4+\\sqrt{3}}\\times \\\\[5pt]&\\quad \\frac{4-\\sqrt{3}}{4-\\sqrt{3}}\\\\[5pt]&\\quad =13\\frac{4-\\sqrt{3}}{(4)^{2}-(\\sqrt{3})^{2}}\\\\[5pt]&\\quad =13\\frac{4-\\sqrt{3}}{16-3}\\\\[5pt]&\\quad =13\\frac{4-\\sqrt{3}}{13}\\\\[5pt]&\\quad =4-\\sqrt{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "\\[\\begin{aligned}&\\text{(ii)}\\\\[5pt]&\\frac{\\sqrt{2}+\\sqrt{5}}{\\sqrt{3}}=\\frac{\\sqrt{2}+\\sqrt{5}}{\\sqrt{3}}\\times \\frac{\\sqrt{3}}{\\sqrt{3}}\\\\[5pt]&\\quad =\\frac{\\sqrt{6}+\\sqrt{15}}{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "\\[\\begin{aligned}&\\text{(iii)}\\\\[5pt]&\\frac{\\sqrt{2}-1}{\\sqrt{5}}=\\frac{\\sqrt{2}-1}{\\sqrt{5}}\\times \\frac{\\sqrt{5}}{\\sqrt{5}}\\\\[5pt]&\\quad =\\frac{\\sqrt{10}-\\sqrt{5}}{5}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "\\[\\begin{aligned}&\\text{(iv)}\\\\[5pt]&\\frac{6-4\\sqrt{2}}{6+4\\sqrt{2}}=\\\\[5pt]&\\quad \\frac{6-4\\sqrt{2}}{6+4\\sqrt{2}}\\times \\\\[5pt]&\\quad \\frac{6-4\\sqrt{2}}{6-4\\sqrt{2}}\\\\[5pt]&\\quad =\\frac{(6-4\\sqrt{2})^{2}}{(6)^{2}-(4\\sqrt{2})^{2}}\\\\[5pt]&\\quad =\\frac{36-48\\sqrt{2}+32}{36-32}\\\\[5pt]&\\quad =\\frac{68-48\\sqrt{2}}{4}\\\\[5pt]&\\quad =17-12\\sqrt{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (v)",
   "text": "\\[\\begin{aligned}&\\text{(v)}\\\\[5pt]&\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{3}+\\sqrt{2}}=\\\\[5pt]&\\quad \\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{3}+\\sqrt{2}}\\times \\\\[5pt]&\\quad \\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{3}-\\sqrt{2}}\\\\[5pt]&\\quad =\\frac{(\\sqrt{3}-\\sqrt{2})^{2}}{(\\sqrt{3})^{2}-(\\sqrt{2})^{2}}\\\\[5pt]&\\quad =\\frac{3-2\\sqrt{6}+2}{3-2}\\\\[5pt]&\\quad =5-2\\sqrt{6}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (vi)",
   "text": "\\[\\begin{aligned}&\\text{(vi)}\\\\[5pt]&4\\frac{\\sqrt{3}}{\\sqrt{7}+\\sqrt{5}}=4\\frac{\\sqrt{3}}{\\sqrt{7}+\\sqrt{5}}\\times \\\\[5pt]&\\quad \\frac{\\sqrt{7}-\\sqrt{5}}{\\sqrt{7}-\\sqrt{5}}\\\\[5pt]&\\quad =4\\sqrt{3}\\frac{\\sqrt{7}-\\sqrt{5}}{(\\sqrt{7})^{2}-(\\sqrt{5})^{2}}\\\\[5pt]&\\quad =4\\sqrt{3}\\frac{\\sqrt{7}-\\sqrt{5}}{7-5}\\\\[5pt]&\\quad =4\\sqrt{3}\\frac{\\sqrt{7}-\\sqrt{5}}{2}\\\\[5pt]&\\quad =2\\sqrt{3}(\\sqrt{7}-\\sqrt{5})\\\\[5pt]&\\quad =2\\sqrt{21}-2\\sqrt{15}\\end{aligned}\\]",
