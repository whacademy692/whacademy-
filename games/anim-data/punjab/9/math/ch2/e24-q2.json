 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "**Q2 (i) (1/2) log 25 + 2 log 3**  \\[\\begin{aligned}&(\\frac{1}{2})\\log 25+2\\log 3\\\\[5pt]&=\\log 25^{\\frac{1}{2}}+\\log 3^{2}\\\\[5pt]&\\quad \\text{[coefficients $\\to$ powers]}\\\\[5pt]&=\\log 5+\\log 9\\quad \\text{[25\\^{}(1/2) = √25 = 5]}\\\\[5pt]&=\\log (5\\times 9)\\quad \\text{[product law]}\\\\[5pt]&=\\log 45\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "**Q2 (ii) log 9 − log (1/3)**  \\[\\begin{aligned}&\\log 9-\\log (\\frac{1}{3})\\\\[5pt]&=\\log (9\\div (\\frac{1}{3}))\\quad \\text{[quotient law]}\\\\[5pt]&=\\log (9\\times 3)\\\\[5pt]&\\quad \\text{[dividing by a fraction = multiplying by its reciprocal]}\\\\[5pt]&=\\log 27\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{Q2}\\textbf{ (iii) log₅ }\\mathbf{b^{2}\\cdot \\log_{a} 5^{3}}}\\\\[5pt]&\\quad \\text{(as printed in the book's scan)}\\\\[5pt]&\\log_{5} b^{2}\\cdot \\log_{a} 5^{3}\\\\[5pt]&\\text{Step }1\\text{ (power law on each factor):}\\\\[5pt]&\\quad \\log_{5} b^{2}=2\\log_{5} b\\\\[5pt]&\\quad \\log_{a} 5^{3}=3\\log_{a} 5\\\\[5pt]&\\text{Step }2:\\text{ Multiply:}\\\\[5pt]&\\quad (2\\log_{5} b)(3\\log_{a} 5)=6\\cdot \\log_{5} b\\cdot \\\\[5pt]&\\quad \\log_{a} 5\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\text{Step }3:\\text{ Change both to base }10\\\\[5pt]&\\quad \\text{(change of base law):}\\\\[5pt]&\\quad \\log_{5} b=\\frac{\\log b}{\\log 5}\\text{ and }\\log_{a} 5\\\\[5pt]&\\quad =\\frac{\\log 5}{\\log a}\\\\[5pt]&\\text{Step }4:\\log_{5} b\\cdot \\log_{a} 5=\\\\[5pt]&\\quad \\frac{\\log b}{\\log 5}\\times \\frac{\\log 5}{\\log a}\\\\[5pt]&\\quad \\text{[log 5 cancels]}\\\\[5pt]&\\quad =\\frac{\\log b}{\\log a}=\\log_{a} b\\\\[5pt]&\\text{Step }5:6\\cdot \\log_{a} b=\\log_{a} b^{6}\\\\[5pt]&\\log_{5} b^{2}\\cdot \\log_{a} 5^{3}=6\\log_{a} b=\\\\[5pt]&\\quad \\log_{a} (b^{6})\\\\[5pt]&\\text{📝 }\\textcolor{#047857}{\\textbf{Note:}}\\text{ The product of two}\\\\[5pt]&\\quad \\text{logarithms is normally not simplified;}\\\\[5pt]&\\quad \\text{here the bases chain nicely}\\\\[5pt]&\\quad \\text{(5 appears as a base in one and as the number in the other)}\\\\[5pt]&\\quad \\text{so the change-of-base law gives a}\\\\[5pt]&\\quad \\text{clean result. The final answer can be}\\\\[5pt]&\\quad \\text{written as 6 logₐ b or logₐ b$^{6}$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (iv)",
   "text": "**Q2 (iv) 2 log₃ x + log₃ y**  \\[\\begin{aligned}&2\\log_{3} x+\\log_{3} y\\\\[5pt]&=\\log_{3} x^{2}+\\log_{3} y\\\\[5pt]&=\\log_{3} (x^{2}y)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (v)",
   "text": "**Q2 (v) 4 log₅ x − log₅ y + log₅ z**  \\[\\begin{aligned}&4\\log_{5} x-\\log_{5} y+\\log_{5} z\\\\[5pt]&=\\log_{5} x^{4}-\\log_{5} y+\\log_{5} z\\\\[5pt]&\\quad \\text{[coefficient $\\to$ power]}\\\\[5pt]&=\\log_{5} (x^{4}\\cdot \\frac{z}{y})\\\\[5pt]&\\quad \\text{[plus $\\to$ numerator, minus $\\to$ denominator]}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Part (vi)",
   "text": "**Q2 (vi) 2 ln a + 3 ln b − 4 ln c**  \\[\\begin{aligned}&2\\ln a+3\\ln b-4\\ln c\\\\[5pt]&=\\ln a^{2}+\\ln b^{3}-\\ln c^{4}\\\\[5pt]&=\\ln (a^{2}\\frac{b^{3}}{c^{4}})\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  }
