 "steps": [
  {
   "id": "s0",
   "title": "A ruler of logarithms",
   "narration": "On this ruler the position of a number is its **logarithm**. 1 is at 0, 10 is at 1, 100 is at 2. Equal steps along the ruler mean multiplying by the same amount.",
   "actions": [
    {
     "set": {
      "law": 0,
      "a": 2,
      "b": 3,
      "p": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Lengths for a and b",
   "narration": "The blue bar is \\( \\log {{a|1}} = {{log(a)|=3}} \\) long. Place the red bar after it: its length is \\( \\log {{b|1}} = {{log(b)|=3}} \\).",
   "actions": [
    {
     "set": {
      "law": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add the lengths",
   "narration": "The two bars together reach \\( {{log(a*b)|=3}} \\). Look at the ruler: that is the position of \\( {{a*b|2}} = {{a|1}} \\times {{b|1}} \\). So \\( \\log(ab) = \\log a + \\log b \\).",
   "actions": [
    {
     "set": {
      "law": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Take a length back",
   "narration": "For a quotient, go **back** along the ruler by \\( \\log b \\). You land on \\( \\log \\frac{a}{b} \\). So \\( \\log \\frac{a}{b} = \\log a - \\log b \\).",
   "actions": [
    {
     "set": {
      "law": 1,
      "a": 6,
      "b": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Repeat a length",
   "narration": "A power repeats the same bar: \\( \\log a^p = p \\log a \\).",
   "actions": [
    {
     "set": {
      "law": 2,
      "a": 2,
      "p": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Your turn",
   "narration": "Change **a**, **b** and the law. Does the ruler always agree?",
   "actions": [
    {
     "set": {
      "law": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Product law",
   "tex": "\\log(ab) = \\log a + \\log b",
   "text": "Multiplying numbers adds their logs."
  },
  {
   "title": "Quotient law",
   "tex": "\\log\\dfrac{a}{b} = \\log a - \\log b",
   "text": "Dividing numbers subtracts their logs."
  },
  {
   "title": "Power law",
   "tex": "\\log a^{p} = p \\log a",
   "text": "A power brings the exponent down in front."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Product",
   "answer": 1,
   "prompt": "What is the value of \\( \\log 2 + \\log 5 \\)?",
   "hint": "Add the logs means multiply the numbers: log 2 + log 5 = log (2 × 5).",
   "explain": "\\( \\log 2 + \\log 5 = \\log 10 = 1 \\)."
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Power",
   "answer": 2,
   "prompt": "\\( \\log 8 = 3 \\log ? \\). Fill in the missing number.",
   "hint": "Think: 8 is what number cubed?",
   "explain": "\\( 8 = 2^3 \\), so \\( \\log 8 = 3 \\log 2 \\)."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Which law?",
   "answer": "b",
   "options": [
    {
     "id": "a",
     "label": "log(a + b) = log a + log b"
    },
    {
     "id": "b",
     "label": "log(a × b) = log a + log b"
    },
    {
     "id": "c",
     "label": "log(a × b) = log a × log b"
    }
   ],
   "prompt": "Which statement is correct?",
   "hint": "Lengths add when numbers multiply.",
   "explain": "Only the product law: **log(ab) = log a + log b**."
  }
 ],
 "intro": "Logarithms were invented to turn hard multiplication into easy addition.",
 "takeaways": [
  "log(ab) = log a + log b",
  "log(a/b) = log a − log b",
  "log a^p = p log a"
 ],
 "notes": [
  {
   "title": "Same base",
   "text": "These laws work for any base as long as every log uses the same base. Here the base is 10."
  }
 ],
 "challengeIntro": "Now you try. Each question uses the picture above.",
 "constraints": [
  {
   "when": "law!=1 || a>=b",
   "message": "For a ÷ b keep a at least as big as b."
  }
 ]
}