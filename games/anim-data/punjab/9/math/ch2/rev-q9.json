 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "**Review Q9 (i) ∛68.24**  \\[\\begin{aligned}&\\text{Estimate: }4^{3}=64,5^{3}=125\\to \\text{ the}\\\\[5pt]&\\quad \\text{answer is a little more than }4.\\\\[5pt]&\\text{Let }x=\\sqrt[3]{68.24}=(68.24)^{\\frac{1}{3}}\\\\[5pt]&\\text{Take }\\log \\text{ of both sides: }\\log x=(\\frac{1}{3})\\\\[5pt]&\\quad \\log 68.24\\\\[5pt]&\\log 68.24=1.8341\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\log x=(\\frac{1}{3})\\times \\log 68.24\\\\[5pt]&\\quad =(\\frac{1}{3})\\times 1.8341\\\\[5pt]&\\quad =0.6114\\\\[5pt]&\\log x=0.6114\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Working",
   "text": "\\[\\begin{aligned}&x=\\operatorname{antilog}(0.6114)\\\\[5pt]&\\text{Mantissa }0.6114\\to \\text{ row }.61,\\text{ column }1=\\\\[5pt]&\\quad 4083;\\text{ mean difference}\\\\[5pt]&\\quad \\text{(row }.61,\\text{ column }4)=4\\\\[5pt]&4083+4=4087\\\\[5pt]&\\text{Characteristic }=0\\to 1\\text{ digit(s) before}\\\\[5pt]&\\quad \\text{the decimal point}\\\\[5pt]&x=4.087\\\\[5pt]&\\text{$\\;\\checkmark$ }\\textcolor{#047857}{\\textbf{Check (calculator):}}\\text{ exact value}\\\\[5pt]&\\quad \\approx 4.086.\\text{ The tiny difference is normal}\\\\[5pt]&\\quad \\text{with 4-figure tables.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (ii)",
   "text": "**Review Q9 (ii) 319.8 × 3.543**  \\[\\begin{aligned}&\\text{Estimate: }300\\times 3.5\\approx 1050.\\\\[5pt]&\\text{Let }x=319.8\\times 3.543\\\\[5pt]&\\text{Take }\\log \\text{ of both sides: }\\log x=\\log \\\\[5pt]&\\quad 319.8+\\log 3.543\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\log 319.8=2.5049\\\\[5pt]&\\log 3.543=0.5494\\\\[5pt]&\\log x=\\log 319.8+\\log 3.543\\\\[5pt]&\\quad =2.5049+0.5494\\\\[5pt]&\\quad =3.0543\\\\[5pt]&\\log x=3.0543\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Working",
   "text": "\\[\\begin{aligned}&x=\\operatorname{antilog}(3.0543)\\\\[5pt]&\\text{Mantissa }0.0543\\to \\text{ row }.05,\\text{ column }4=\\\\[5pt]&\\quad 1132;\\text{ mean difference}\\\\[5pt]&\\quad \\text{(row }.05,\\text{ column }3)=1\\\\[5pt]&1132+1=1133\\\\[5pt]&\\text{Characteristic }=3\\to 4\\text{ digit(s) before}\\\\[5pt]&\\quad \\text{the decimal point}\\\\[5pt]&x=1133\\\\[5pt]&\\text{$\\;\\checkmark$ }\\textcolor{#047857}{\\textbf{Check (calculator):}}\\text{ exact value}\\\\[5pt]&\\quad \\approx 1133.\\text{ The tiny difference is normal}\\\\[5pt]&\\quad \\text{with 4-figure tables.}\\end{aligned}\\]",
   "actions": [
