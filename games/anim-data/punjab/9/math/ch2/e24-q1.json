 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "**Q1 (i) log₂ 18 − log₂ 9**  \\[\\begin{aligned}&\\log_{2} 18-\\log_{2} 9\\\\[5pt]&=\\log_{2} (\\frac{18}{9})\\quad \\text{[quotient law]}\\\\[5pt]&=\\log_{2} 2\\\\[5pt]&=1\\quad \\text{[log\\_b b = 1]}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "**Q1 (ii) log₂ 64 + log₂ 2**  \\[\\begin{aligned}&\\log_{2} 64+\\log_{2} 2\\\\[5pt]&=\\log_{2} (64\\times 2)\\quad \\text{[product law]}\\\\[5pt]&=\\log_{2} 128\\\\[5pt]&=7\\quad \\text{[because 2\\^{}7 = 128]}\\\\[5pt]&\\text{(Another way: }\\log_{2} 64=6\\text{ and }\\log_{2} 2=1,\\text{ so }6+1=7)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "**Q1 (iii) (1/3) log₃ 8 − log₃ 18**  \\[\\begin{aligned}&(\\frac{1}{3})\\log_{3} 8-\\log_{3} 18\\\\[5pt]&=\\log_{3} 8^{\\frac{1}{3}}-\\log_{3} 18\\\\[5pt]&\\quad \\text{[coefficient $\\to$ power]}\\\\[5pt]&=\\log_{3} 2-\\log_{3} 18\\quad \\text{[8\\^{}(1/3) = ∛8 = 2]}\\\\[5pt]&=\\log_{3} (\\frac{2}{18})\\quad \\text{[quotient law]}\\\\[5pt]&=\\log_{3} (\\frac{1}{9})\\\\[5pt]&=\\log_{3} 3^{-2}\\\\[5pt]&=-2\\quad \\text{[log\\_b b\\^{}n = n]}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "**Q1 (iv) 2 log 2 + log 25**  \\[\\begin{aligned}&2\\log 2+\\log 25\\\\[5pt]&=\\log 2^{2}+\\log 25\\quad \\text{[coefficient $\\to$ power]}\\\\[5pt]&=\\log 4+\\log 25\\\\[5pt]&=\\log (4\\times 25)\\quad \\text{[product law]}\\\\[5pt]&=\\log 100\\\\[5pt]&=2\\quad \\text{[base 10: 10\\^{}2 = 100]}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (v)",
   "text": "**Q1 (v) (1/3) log₄ 64 + 2 log₅ 25**  \\[\\begin{aligned}&(\\frac{1}{3})\\log_{4} 64+2\\log_{5} 25\\\\[5pt]&\\text{Find each }\\log \\text{ separately:}\\\\[5pt]&\\quad \\log_{4} 64=3\\text{ because }4^{3}=64\\\\[5pt]&\\quad \\log_{5} 25=2\\text{ because }5^{2}=25\\\\[5pt]&=(\\frac{1}{3})(3)+2(2)\\\\[5pt]&=1+4\\\\[5pt]&=5\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (vi)",
   "text": "**Q1 (vi) log₃ 12 + log₃ 0.25**  \\[\\begin{aligned}&\\log_{3} 12+\\log_{3} 0.25\\\\[5pt]&=\\log_{3} (12\\times 0.25)\\quad \\text{[product law]}\\\\[5pt]&=\\log_{3} 3\\\\[5pt]&=1\\quad \\text{[log\\_b b = 1]}\\end{aligned}\\]",
   "actions": [
