 "steps": [
  {
   "id": "s0",
   "title": "Set up",
   "text": "\\[\\begin{aligned}&\\text{Doubling means }y=2\\times 100,000=\\\\[5pt]&\\quad 200,000\\\\[5pt]&100,000(1.05)^{t}=200,000\\\\[5pt]&(1.05)^{t}=200,\\frac{000}{100},000=2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\text{Take }\\log \\text{ of both sides:}\\\\[5pt]&\\log (1.05)^{t}=\\log 2\\\\[5pt]&t\\cdot \\log 1.05=\\log 2\\quad \\text{[power law]}\\\\[5pt]&t=\\frac{\\log 2}{\\log 1.05}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\text{From the table:}\\\\[5pt]&\\log 2\\\\[5pt]&\\quad \\text{Characteristic }=\\\\[5pt]&\\quad \\text{(digits before the decimal point) }-1\\\\[5pt]&\\quad =1-1=0\\\\[5pt]&\\quad \\text{Mantissa: digits }200\\to \\text{ row }20,\\text{ column}\\\\[5pt]&\\quad 0=3010\\\\[5pt]&\\quad \\text{(no }4th\\text{ digit, so no mean difference)}\\\\[5pt]&\\quad \\to \\text{ mantissa }=0.3010\\\\[5pt]&\\quad \\log 2=0+0.3010=0.3010\\\\[5pt]&\\log 1.05\\\\[5pt]&\\quad \\text{Characteristic }=\\\\[5pt]&\\quad \\text{(digits before the decimal point) }-1\\\\[5pt]&\\quad =1-1=0\\\\[5pt]&\\quad \\text{Mantissa: digits }105\\to \\text{ row }10,\\text{ column}\\\\[5pt]&\\quad 5=0212\\\\[5pt]&\\quad \\text{(no }4th\\text{ digit, so no mean difference)}\\\\[5pt]&\\quad \\to \\text{ mantissa }=0.0212\\\\[5pt]&\\quad \\log 1.05=0+0.0212=0.0212\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Working",
   "text": "\\[\\begin{aligned}&t=\\frac{0.3010}{0.0212}\\\\[5pt]&t\\approx 14.2\\\\[5pt]&\\text{Dividing with logs: }\\log t=\\log 0.3010\\\\[5pt]&\\quad -\\log 0.0212\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\log 0.301=\\bar{1}.4786\\\\[5pt]&\\log 0.0212=\\bar{2}.3263\\\\[5pt]&\\log t=\\log 0.301-\\log 0.0212\\\\[5pt]&\\quad =\\bar{1}.4786-\\bar{2}.3263\\\\[5pt]&\\quad =1.1523\\\\[5pt]&\\log t=1.1523\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Result",
   "text": "\\[\\begin{aligned}&t=\\operatorname{antilog}(1.1523)\\\\[5pt]&\\text{Mantissa }0.1523\\to \\text{ row }.15,\\text{ column }2=\\\\[5pt]&\\quad 1419;\\text{ mean difference}\\\\[5pt]&\\quad \\text{(row }.15,\\text{ column }3)=1\\\\[5pt]&1419+1=1420\\\\[5pt]&\\text{Characteristic }=1\\to 2\\text{ digit(s) before}\\\\[5pt]&\\quad \\text{the decimal point}\\\\[5pt]&t=14.20\\\\[5pt]&\\textcolor{#047857}{\\textbf{Answer:}}\\text{ }t\\approx \\text{ }\\textcolor{#047857}{\\mathbf{14.2}\\textbf{ years}}\\text{.}\\\\[5pt]&\\quad \\text{(After }14\\text{ full years the value is }\\approx \\text{ Rs. }197,993\\text{ — still short of }200,000\\text{ — so the money doubles during the }15th\\text{ year, i.e. after about }14\\text{ years and }2\\text{ months.)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
 ],
