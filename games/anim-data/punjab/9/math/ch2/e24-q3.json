 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "**Q3 (i) log (11/5)**  \\[\\begin{aligned}&\\log (\\frac{11}{5})\\\\[5pt]&=\\log 11-\\log 5\\quad \\text{[quotient law]}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "**Q3 (ii) log₅ √(8a⁶)**  \\[\\begin{aligned}&\\log_{5} \\sqrt{8a^{6}}\\\\[5pt]&=\\log_{5} (8a^{6})^{\\frac{1}{2}}\\quad \\text{[root = power 1/2]}\\\\[5pt]&=(\\frac{1}{2})\\log_{5} (8a^{6})\\quad \\text{[power law]}\\\\[5pt]&=(\\frac{1}{2})[\\log_{5} 8+\\log_{5} a^{6}]\\\\[5pt]&\\quad \\text{[product law]}\\\\[5pt]&=(\\frac{1}{2})[\\log_{5} 8+6\\log_{5} a]\\quad \\text{[power law]}\\\\[5pt]&=(\\frac{1}{2})\\log_{5} 8+3\\log_{5} a\\\\[5pt]&=(\\frac{1}{2})\\log_{5} 2^{3}+3\\log_{5} a\\\\[5pt]&=(\\frac{3}{2})\\log_{5} 2+3\\log_{5} a\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "**Q3 (iii) ln (a²b/c)**  \\[\\begin{aligned}&\\ln (a^{2}\\frac{b}{c})\\\\[5pt]&=\\ln (a^{2}b)-\\ln c\\quad \\text{[quotient law]}\\\\[5pt]&=\\ln a^{2}+\\ln b-\\ln c\\quad \\text{[product law]}\\\\[5pt]&=2\\ln a+\\ln b-\\ln c\\quad \\text{[power law]}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{Q3}\\textbf{ (iv) log }\\mathbf{(x\\frac{y}{z})^{\\frac{1}{9}}}}\\\\[5pt]&\\quad \\text{(the exponent is printed small in the scan; read as }\\frac{1}{9}\\text{ — the method is identical for any exponent)}\\\\[5pt]&\\log (x\\frac{y}{z})^{\\frac{1}{9}}\\\\[5pt]&=(\\frac{1}{9})\\log (x\\frac{y}{z})\\quad \\text{[power law]}\\\\[5pt]&=(\\frac{1}{9})[\\log (xy)-\\log z]\\quad \\text{[quotient law]}\\\\[5pt]&=(\\frac{1}{9})[\\log x+\\log y-\\log z]\\\\[5pt]&\\quad \\text{[product law]}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (v)",
   "text": "**Q3 (v) ln ∛(16x³)**  \\[\\begin{aligned}&\\ln \\sqrt[3]{16x^{3}}\\\\[5pt]&=\\ln (16x^{3})^{\\frac{1}{3}}\\quad \\text{[cube root = power 1/3]}\\\\[5pt]&=(\\frac{1}{3})\\ln (16x^{3})\\quad \\text{[power law]}\\\\[5pt]&=(\\frac{1}{3})[\\ln 16+\\ln x^{3}]\\quad \\text{[product law]}\\\\[5pt]&=(\\frac{1}{3})\\ln 16+(\\frac{1}{3})(3\\ln x)\\quad \\text{[power law]}\\\\[5pt]&=(\\frac{1}{3})\\ln 16+\\ln x\\\\[5pt]&=(\\frac{1}{3})\\ln 2^{4}+\\ln x\\\\[5pt]&=(\\frac{4}{3})\\ln 2+\\ln x\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (vi)",
   "text": "**Q3 (vi) log₂ ((1 − a)/b)⁵**  \\[\\begin{aligned}&\\log_{2} (\\frac{1-a}{b})^{5}\\\\[5pt]&=5\\log_{2} (\\frac{1-a}{b})\\quad \\text{[power law]}\\\\[5pt]&=5[\\log_{2} (1-a)-\\log_{2} b]\\\\[5pt]&\\quad \\text{[quotient law]}\\\\[5pt]&(\\log_{2} (1-a)\\text{ cannot be split further)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
