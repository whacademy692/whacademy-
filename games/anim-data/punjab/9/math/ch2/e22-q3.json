 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "**Q3 (i) logₓ 64 = 3**  \\[\\begin{aligned}&\\log_{x} 64=3\\\\[5pt]&\\text{Exponential form: }x^{3}=64\\\\[5pt]&64=4^{3}\\to x^{3}=4^{3}\\\\[5pt]&x=4\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "**Q3 (ii) log₅ 1 = x**  \\[\\begin{aligned}&\\log_{5} 1=x\\\\[5pt]&\\text{Exponential form: }5^{x}=1\\\\[5pt]&1=5^{0}\\to 5^{x}=5^{0}\\\\[5pt]&x=0\\\\[5pt]&\\text{(Remember: }\\log \\text{ of }1\\text{ to any base is }0.)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "**Q3 (iii) logₓ 8 = 1**  \\[\\begin{aligned}&\\log_{x} 8=1\\\\[5pt]&\\text{Exponential form: }x^{1}=8\\\\[5pt]&x=8\\\\[5pt]&\\text{(Remember: }\\log_{b} b=1,\\text{ so the base must equal }8.)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "**Q3 (iv) log₁₀ x = -3**  \\[\\begin{aligned}&\\log_{10} x=-3\\\\[5pt]&\\text{Exponential form: }10^{-3}=x\\\\[5pt]&x=\\frac{1}{10^{3}}=\\frac{1}{1000}\\\\[5pt]&x=0.001\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (v)",
   "text": "**Q3 (v) log₄ x = 3/2**  \\[\\begin{aligned}&\\log_{4} x=\\frac{3}{2}\\\\[5pt]&\\text{Exponential form: }x=4^{\\frac{3}{2}}\\\\[5pt]&4^{\\frac{3}{2}}=(\\sqrt{4})^{3}\\\\[5pt]&\\quad \\text{[denominator 2 = square root, numerator 3 = cube]}\\\\[5pt]&\\quad =2^{3}\\\\[5pt]&x=8\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (vi)",
   "text": "**Q3 (vi) log₂ 1024 = x**  \\[\\begin{aligned}&\\log_{2} 1024=x\\\\[5pt]&\\text{Exponential form: }2^{x}=1024\\\\[5pt]&\\text{Break }1024\\text{ into 2s: }1024=2^{10}\\\\[5pt]&\\quad (2,4,8,16,32,64,128,256,512,1024\\to \\text{ that is the }10th\\text{ power)}\\\\[5pt]&2^{x}=2^{10}\\\\[5pt]&x=10\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
