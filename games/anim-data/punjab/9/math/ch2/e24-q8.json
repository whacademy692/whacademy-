 "steps": [
  {
   "id": "s0",
   "title": "Set up",
   "text": "\\[\\begin{aligned}&\\text{Estimate: }20\\times 0.97^{5}\\approx 20\\times 0.86\\approx 17.\\\\[5pt]&T=T_{i}\\times 0.97^{\\frac{h}{100}}\\\\[5pt]&T_{i}=20,h=500\\to \\frac{h}{100}=\\frac{500}{100}=\\\\[5pt]&\\quad 5\\\\[5pt]&T=20\\times (0.97)^{5}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\text{Take }\\log \\text{ of both sides:}\\\\[5pt]&\\log T=\\log 20+5\\log 0.97\\\\[5pt]&\\quad \\text{[product \\& power laws]}\\\\[5pt]&\\log 20=1.3010\\\\[5pt]&\\log 0.97=\\bar{1}.9868\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\log T=\\log 20+5\\times \\log 0.97\\\\[5pt]&\\quad =1.3010+5\\times \\bar{1}.9868\\\\[5pt]&\\quad =1.3010+\\bar{1}.9340\\\\[5pt]&\\quad =1.2350\\\\[5pt]&\\log T=1.2350\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Result",
   "text": "\\[\\begin{aligned}&T=\\operatorname{antilog}(1.2350)\\\\[5pt]&\\text{Mantissa }0.2350\\to \\text{ row }.23,\\text{ column }5=\\\\[5pt]&\\quad 1718\\\\[5pt]&\\quad \\text{(no }4th\\text{ digit }\\to \\text{ no mean difference)}\\\\[5pt]&\\text{Characteristic }=1\\to 2\\text{ digit(s) before}\\\\[5pt]&\\quad \\text{the decimal point}\\\\[5pt]&T=17.18\\\\[5pt]&\\textcolor{#047857}{\\textbf{Answer:}}\\text{ }T\\approx \\text{ }\\textcolor{#047857}{\\mathbf{17.18^{\\circ}C}}\\\\[5pt]&\\quad \\text{(about }17.2^{\\circ}C).\\\\[5pt]&\\text{$\\;\\checkmark$ }\\textcolor{#047857}{\\textbf{Check (calculator):}}\\text{ }20\\times 0.97^{5}=\\\\[5pt]&\\quad 17.175^{\\circ}C.\\end{aligned}\\]",
