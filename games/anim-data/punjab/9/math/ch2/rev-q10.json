 "steps": [
  {
   "id": "s0",
   "title": "Set up",
   "text": "\\[\\begin{aligned}&p(t)=22(1.025)^{t}=35\\\\[5pt]&(1.025)^{t}=\\frac{35}{22}\\\\[5pt]&\\text{Take }\\log \\text{ of both sides:}\\\\[5pt]&\\log (1.025)^{t}=\\log (\\frac{35}{22})\\\\[5pt]&t\\cdot \\log 1.025=\\log 35-\\log 22\\\\[5pt]&\\quad \\text{[power law, quotient law]}\\\\[5pt]&t=\\frac{\\log 35-\\log 22}{\\log 1.025}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\text{From the }\\log \\text{ table:}\\\\[5pt]&\\log 35\\\\[5pt]&\\quad \\text{Characteristic }=\\\\[5pt]&\\quad \\text{(digits before the decimal point) }-1\\\\[5pt]&\\quad =2-1=1\\\\[5pt]&\\quad \\text{Mantissa: digits }350\\to \\text{ row }35,\\text{ column}\\\\[5pt]&\\quad 0=5441\\\\[5pt]&\\quad \\text{(no }4th\\text{ digit, so no mean difference)}\\\\[5pt]&\\quad \\to \\text{ mantissa }=0.5441\\\\[5pt]&\\quad \\log 35=1+0.5441=1.5441\\\\[5pt]&\\log 22\\\\[5pt]&\\quad \\text{Characteristic }=\\\\[5pt]&\\quad \\text{(digits before the decimal point) }-1\\\\[5pt]&\\quad =2-1=1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\quad \\text{Mantissa: digits }220\\to \\text{ row }22,\\text{ column}\\\\[5pt]&\\quad 0=3424\\\\[5pt]&\\quad \\text{(no }4th\\text{ digit, so no mean difference)}\\\\[5pt]&\\quad \\to \\text{ mantissa }=0.3424\\\\[5pt]&\\quad \\log 22=1+0.3424=1.3424\\\\[5pt]&\\log 1.025\\\\[5pt]&\\quad \\text{Characteristic }=\\\\[5pt]&\\quad \\text{(digits before the decimal point) }-1\\\\[5pt]&\\quad =1-1=0\\\\[5pt]&\\quad \\text{Mantissa: digits }1025\\to \\text{ row }10,\\text{ column}\\\\[5pt]&\\quad 2=0086;\\text{ mean difference}\\\\[5pt]&\\quad \\text{(row }10,\\text{ column }5)=21\\\\[5pt]&\\quad 0086+21=0107\\to \\text{ mantissa }=0.0107\\\\[5pt]&\\quad \\log 1.025=0+0.0107=0.0107\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Working",
   "text": "\\[\\begin{aligned}&\\log 35-\\log 22=1.5441-1.3424=\\\\[5pt]&\\quad 0.2017\\\\[5pt]&\\log 1.025=0.0107\\\\[5pt]&t=\\frac{0.2017}{0.0107}\\\\[5pt]&t\\approx 18.85\\text{ years}\\\\[5pt]&t\\approx 19\\text{ years}\\\\[5pt]&\\quad \\text{(rounded to the nearest year)}\\\\[5pt]&\\text{Year }=2016+19=2035\\\\[5pt]&\\textcolor{#047857}{\\textbf{Answer:}}\\text{ the population will reach}\\\\[5pt]&\\quad 35\\text{ million in the year }\\textcolor{#047857}{\\mathbf{2035}}\\text{.}\\end{aligned}\\]",
   "actions": [
