 "steps": [
  {
   "id": "s0",
   "title": "Arrows from inputs to outputs",
   "narration": "A **relation** pairs inputs from set X with outputs in set Y. Each arrow is one pair. Here every input has **one** arrow: \\( x \\to x + 2 \\).",
   "actions": [
    {
     "set": {
      "rel": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "That is a function",
   "narration": "A **function** gives each input **exactly one** output. The set of inputs is the **domain** \\( \\{1,2,3,4\\} \\); the outputs used form the **range** \\( \\{3,4,5,6\\} \\).",
   "actions": [
    {
     "set": {
      "rel": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Two inputs, one output: fine",
   "narration": "Here 1 and 2 both go to 3, and 3 and 4 both go to 5. Different inputs may share an output, so this is still a function. The range is only \\( \\{3, 5\\} \\).",
   "actions": [
    {
     "set": {
      "rel": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "One input, two outputs: not allowed",
   "narration": "The input 1 has **two** arrows, to 3 and to 4. One input must not give two outputs, so this is **not** a function.",
   "actions": [
    {
     "set": {
      "rel": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "An input left out: not allowed",
   "narration": "The input 3 has **no** arrow. Every input in the domain needs an output, so this is **not** a function.",
   "actions": [
    {
     "set": {
      "rel": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "The test",
   "narration": "Check each input: **exactly one arrow**. Try the four relations again with the buttons.",
   "actions": [
    {
     "set": {
      "rel": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Function",
   "tex": "f: X \\to Y",
   "text": "Every x in X has exactly one image f(x) in Y."
  },
  {
   "title": "Domain and range",
   "tex": "\\text{domain} = X,\\quad \\text{range} = \\{f(x)\\}",
   "text": "Domain: all inputs. Range: the outputs actually reached."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Function?",
   "answer": "b",
   "options": [
