    }
   ],
   "prompt": "\\( \\{(1,5),\\ (2,5),\\ (3,5)\\} \\). Is this a function?",
   "hint": "Can different inputs share one output?",
   "explain": "Each input has exactly one output (all happen to be 5). It **is** a function."
  },
  {
   "id": "c3",
   "type": "number",
   "title": "Size of the range",
   "answer": 4,
   "prompt": "\\( f(x) = x + 2 \\) with inputs \\( \\{1, 2, 3, 4\\} \\). How many different outputs are in the range?",
   "hint": "Compute f(1), f(2), f(3), f(4).",
   "explain": "The outputs are 3, 4, 5, 6: four values."
  }
 ],
 "intro": "A function is a relation in which every input has one and only one output.",
 "takeaways": [
  "Function: each input has exactly one arrow.",
  "Two inputs may share an output.",
  "One input may not give two outputs."
 ],
 "notes": [
  {
   "title": "Domain, codomain, range",
   "text": "Y is the codomain. The range is only the part of Y that is actually reached by an arrow."
  }
 ],
 "challengeIntro": "Now you try. Each question uses the picture above."
