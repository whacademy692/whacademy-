 "steps": [
  {
   "id": "s0",
   "title": "Two sets inside a universe",
   "narration": "The rectangle is the **universal set** \\( U = \\{1, 2, \\ldots, 8\\} \\). The circles are \\( A = \\{1,2,3,4\\} \\) and \\( B = \\{3,4,5,6\\} \\). Elements 3 and 4 are in **both**.",
   "actions": [
    {
     "set": {
      "op": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Union",
   "narration": "\\( A \\cup B \\): everything that is in A **or** in B (or both). All of the shaded region: \\( \\{1,2,3,4,5,6\\} \\).",
   "actions": [
    {
     "set": {
      "op": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Intersection",
   "narration": "\\( A \\cap B \\): only what is in A **and** in B. The overlap: \\( \\{3, 4\\} \\).",
   "actions": [
    {
     "set": {
      "op": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Difference",
   "narration": "\\( A - B \\): in A but **not** in B. \\( \\{1, 2\\} \\). And \\( B - A = \\{5, 6\\} \\).",
   "actions": [
    {
     "set": {
      "op": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Complement",
   "narration": "\\( A' \\): everything in U that is **not** in A. \\( \\{5, 6, 7, 8\\} \\).",
   "actions": [
    {
     "set": {
      "op": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "De Morgan's law, part 1",
   "narration": "\\( (A \\cup B)' \\): outside both circles, \\( \\{7, 8\\} \\).",
   "actions": [
    {
     "set": {
      "op": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "De Morgan's law, part 2",
   "narration": "\\( A' \\cap B' \\): outside A **and** outside B. The same region! So \\( (A \\cup B)' = A' \\cap B' \\).",
   "actions": [
    {
     "set": {
      "op": 7
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s7",
   "title": "Your turn",
   "narration": "Pick any operation and read the elements from the highlighted region.",
   "actions": [
    {
     "set": {
      "op": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Union and intersection",
   "tex": "A \\cup B,\\quad A \\cap B",
   "text": "Union: in A or B. Intersection: in both."
  },
  {
   "title": "Difference and complement",
   "tex": "A - B,\\quad A'",
   "text": "A − B: in A but not B. A′: in U but not in A."
  },
  {
   "title": "De Morgan's laws",
   "tex": "(A \\cup B)' = A' \\cap B',\\quad (A \\cap B)' = A' \\cup B'",
   "text": "The complement of a union is the intersection of the complements, and the other way round."
  }
 ],
