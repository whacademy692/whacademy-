 "steps": [
  {
   "id": "s0",
   "title": "Part (i)",
   "text": "\\[\\begin{aligned}&\\text{(i) The set builder form of the set}\\\\[5pt]&\\quad \\{1,\\frac{1}{3},\\frac{1}{5},\\frac{1}{7},\\ldots \\}\\text{ is:}\\\\[5pt]&\\quad \\text{The denominators are the odd numbers}\\\\[5pt]&\\quad 1,3,5,7,\\ldots =2n+1\\text{ for }n=0,1,\\\\[5pt]&\\quad 2,3,\\ldots \\text{ (n }\\in \\text{ W)}\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (b)}}\\\\[5pt]&\\quad \\{x\\mid x=\\frac{1}{2n+1},n\\in W\\}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Part (ii)",
   "text": "\\[\\begin{aligned}&\\text{(ii) If }A=\\{\\},\\text{ then P(A) is:}\\\\[5pt]&\\quad \\text{The only subset of the empty set is}\\\\[5pt]&\\quad \\text{the empty set, so P(A) = \\{$\\phi$\\} = \\{\\{ \\}\\}}\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (c)}}\\text{ }\\{\\{\\}\\}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Part (iii)",
   "text": "\\[\\begin{aligned}&\\text{(iii) If }U=\\{1,2,3,4,5\\},A=\\\\[5pt]&\\quad \\{1,2,3\\}\\text{ and }B=\\{3,4,5\\},\\text{ then }U-\\\\[5pt]&\\quad \\text{(A }\\cap \\text{ B) is:}\\\\[5pt]&\\quad A\\cap B=\\{3\\}\\\\[5pt]&\\quad U-\\{3\\}=\\{1,2,4,5\\}\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (a)}}\\text{ }\\{1,2,4,5\\}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Part (iv)",
   "text": "\\[\\begin{aligned}&\\text{(iv) If A and B are overlapping sets,}\\\\[5pt]&\\quad \\text{then n(A }-\\text{ B) is equal to:}\\\\[5pt]&\\quad A-B\\text{ removes the common part from A}\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (d)}}\\text{ n(A) }-\\text{ n(A }\\cap \\text{ B)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Part (v)",
   "text": "\\[\\begin{aligned}&\\text{(v) If A $\\subseteq$ B and B $-$ A $\\ne$ $\\phi$, then}\\\\[5pt]&\\quad \\text{n(B }-\\text{ A) is equal to:}\\\\[5pt]&\\quad A\\cap B=A,\\text{ so n(B }-\\text{ A) }=\\text{ n(B) }-\\\\[5pt]&\\quad \\text{n(A }\\cap \\text{ B) }=\\text{ n(B) }-\\text{ n(A)}\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (d)}}\\text{ n(B) }-\\text{ n(A)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Part (vi)",
   "text": "\\[\\begin{aligned}&\\text{(vi) If n(A }\\cup \\text{ B) }=50,\\text{ n(A) }=30\\text{ and}\\\\[5pt]&\\quad \\text{n(B) }=35,\\text{ then n(A }\\cap \\text{ B) }=\\\\[5pt]&\\quad \\text{n(A }\\cap \\text{ B) }=\\text{ n(A) }+\\text{ n(B) }-\\text{ n(A }\\cup \\text{ B) }=30\\\\[5pt]&\\quad +35-50=15\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (b)}}\\text{ }15\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Part (vii)",
   "text": "\\[\\begin{aligned}&\\text{(vii) If }A=\\{1,2,3,4\\}\\text{ and }B=\\\\[5pt]&\\quad \\{x,y,z\\},\\text{ then the Cartesian product}\\\\[5pt]&\\quad \\text{of A and B contains exactly \\_\\_\\_}\\\\[5pt]&\\quad \\text{elements.}\\\\[5pt]&\\quad \\text{n(A }\\times \\text{ B) }=\\text{ n(A) }\\times \\text{ n(B) }=4\\times 3=12\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (b)}}\\text{ }12\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s7",
   "title": "Part (viii)",
   "text": "\\[\\begin{aligned}&\\text{(viii) If f(x) }=x^{2}-3x+2,\\text{ then}\\\\[5pt]&\\quad \\text{the value of f(a }+1)\\text{ is equal to:}\\\\[5pt]&\\quad \\text{f(a + 1) = (a + 1)$^{2}$ $-$ 3(a + 1) + 2}\\\\[5pt]&\\quad =a^{2}+2a+1-3a-3+2\\\\[5pt]&\\quad =a^{2}-a\\\\[5pt]&\\quad \\textcolor{#047857}{\\textbf{Answer: (d)}}\\text{ }a^{2}-a\\end{aligned}\\]",
   "actions": [
    {
