 "steps": [
  {
   "id": "s0",
   "title": "Counts in each part",
   "narration": "Each number is how many elements live in that part of the diagram. {{oa|int}} are only in A, {{c|int}} are in both, {{ob|int}} are only in B and {{out|int}} are in neither.",
   "actions": [
    {
     "set": {
      "oa": 3,
      "ob": 4,
      "c": 2,
      "out": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Count A",
   "narration": "\\( n(A) = {{oa|int}} + {{c|int}} = {{nA|int}} \\). The blue region includes the overlap.",
   "actions": [
    {
     "set": {
      "oa": 3,
      "ob": 4,
      "c": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Count B",
   "narration": "\\( n(B) = {{ob|int}} + {{c|int}} = {{nB|int}} \\). The red region includes the overlap too.",
   "actions": [
    {
     "set": {
      "oa": 3,
      "ob": 4,
      "c": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Add them: careful!",
   "narration": "\\( n(A) + n(B) = {{nA+nB|int}} \\). But the overlap of {{c|int}} was counted **twice**.",
   "actions": [
    {
     "set": {
      "oa": 3,
      "ob": 4,
      "c": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Subtract the overlap once",
   "narration": "\\( n(A \\cup B) = n(A) + n(B) - n(A \\cap B) = {{nA|int}} + {{nB|int}} - {{c|int}} = {{nA+nB-c|int}} \\). Now every element in the union is counted exactly once.",
   "actions": [
    {
     "set": {
      "oa": 3,
      "ob": 4,
      "c": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Your turn",
   "narration": "Change the four counts. The formula always works.",
   "actions": [
    {
     "set": {
      "oa": 3,
      "ob": 4,
      "c": 2
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Union formula",
   "tex": "n(A \\cup B) = n(A) + n(B) - n(A \\cap B)",
   "text": "Subtract the overlap because it was counted twice."
  }
 ],
 "challenges": [
