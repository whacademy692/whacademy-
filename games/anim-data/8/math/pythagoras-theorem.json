 "steps": [
  {
   "id": "tri",
   "title": "A right-angled triangle",
   "narration": "Look at this triangle. One of its corners is a perfect **square corner** — exactly **90°**. A triangle like this is called a **right-angled triangle**.",
   "actions": [
    {
     "set": {
      "sq": 0,
      "hl": 0,
      "askH": 0,
      "p": 3,
      "b": 4
     }
    }
   ]
  },
  {
   "id": "perp",
   "title": "The perpendicular — p",
   "narration": "The side that stands **straight up** from the right angle is called the [[perp|perpendicular]]. We write it as **p**. In this triangle  **p = {{p|1}}**.",
   "actions": [
    {
     "pulse": "perp",
     "at": 900
    }
   ]
  },
  {
   "id": "base",
   "title": "The base — b",
   "narration": "The side that lies **flat**, next to the right angle, is called the [[base|base]]. We write it as **b**. In this triangle  **b = {{b|1}}**.",
   "actions": [
    {
     "pulse": "base",
     "at": 900
    }
   ]
  },
  {
   "id": "hyp",
   "title": "The hypotenuse — h",
   "narration": "The slanted side that **faces the right angle** is the [[hyp|hypotenuse]], written **h**. It is always the **longest** side of a right-angled triangle. Here  **h = {{h|2}}**.",
   "actions": [
    {
     "pulse": "hyp",
     "at": 900
    }
   ]
  },
  {
   "id": "squares",
   "title": "A square on every side",
   "narration": "Now build a square on each side. A square with side s has area **s × s**. The [[perp|perpendicular]] square has area **{{p|1}} × {{p|1}} = {{p^2|2}}**, the [[base|base]] square **{{b|1}} × {{b|1}} = {{b^2|2}}**, and the [[hyp|hypotenuse]] square **{{h^2|2}}**.",
   "actions": [
    {
     "tween": {
      "sq": 1
     },
     "dur": 1000
    }
   ]
  },
  {
   "id": "count",
   "title": "Count the little squares",
   "narration": "Cut each square into **1 × 1** little squares. The two small squares hold [[perp|{{p^2|2}}]] + [[base|{{b^2|2}}]] = **{{p^2+b^2|2}}** little squares — and the big [[hyp|hypotenuse]] square holds **{{h^2|2}}**. They are exactly equal!",
   "actions": [
    {
     "pulse": [
      "sqP",
      "sqB"
     ],
     "at": 1100
    },
    {
     "pulse": "sqH",
     "at": 1800
    }
   ]
  },
  {
   "id": "theorem",
   "title": "Pythagoras Theorem",
   "narration": "This is true in **every** right-angled triangle:  \\(\\role{hyp}{h^2} = \\role{perp}{p^2} + \\role{base}{b^2}\\)  — the square on the hypotenuse equals the sum of the squares on the other two sides.",
   "actions": [
    {
     "pulse": "sqH",
     "at": 300
    },
    {
     "pulse": [
      "sqP",
      "sqB"
     ],
     "at": 1000
    }
   ]
  },
  {
   "id": "drag",
   "title": "Now you change it!",
   "narration": "Drag the two dots on the triangle — or use the sliders. Watch it stretch: now  **p = {{p|1}}**,  **b = {{b|1}}**  and  **h = {{h|2}}**.  The squares change, yet  {{p^2|2}} + {{b^2|2}} = {{h^2|2}}  stays true!",
   "actions": [
    {
     "set": {
      "hl": 1
     }
    },
    {
     "tween": {
      "p": 6,
      "b": 8
     },
     "at": 300,
     "dur": 2200
    }
   ]
  },
  {
   "id": "use",
   "title": "Use it to find a side",
   "narration": "Know two sides? You can find the third! Add the squares, then take the square root:  \\(h = \\sqrt{p^2 + b^2}\\).  With p = {{p|1}} and b = {{b|1}}:  h = √({{p^2|2}} + {{b^2|2}}) = √{{p^2+b^2|2}} = **{{h|2}}**.  Try the challenge — then play freely!",
   "challenge": "find_h"
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras Theorem",
   "tex": "\\role{hyp}{h^2} = \\role{perp}{p^2} + \\role{base}{b^2}",
   "filled": "\\role{hyp}{ {{h^2|2}} } = \\role{perp}{ {{p^2|2}} } + \\role{base}{ {{b^2|2}} }",
   "text": "The square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{h} = \\sqrt{\\role{perp}{p^2} + \\role{base}{b^2}}",
   "filled": "\\role{hyp}{ {{h|2}} } = \\sqrt{ {{p^2|2}} + {{b^2|2}} } = \\sqrt{ {{p^2+b^2|2}} }",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding the perpendicular",
   "tex": "\\role{perp}{p} = \\sqrt{\\role{hyp}{h^2} - \\role{base}{b^2}}",
   "filled": "\\role{perp}{ {{p|2}} } = \\sqrt{ {{h^2|2}} - {{b^2|2}} } = \\sqrt{ {{h^2-b^2|2}} }",
   "text": "Looking for a short side? Subtract the other short side's square from the hypotenuse's square."
  },
  {
   "title": "Finding the base",
   "tex": "\\role{base}{b} = \\sqrt{\\role{hyp}{h^2} - \\role{perp}{p^2}}",
   "filled": "\\role{base}{ {{b|2}} } = \\sqrt{ {{h^2|2}} - {{p^2|2}} } = \\sqrt{ {{h^2-p^2|2}} }"
  }
 ],
