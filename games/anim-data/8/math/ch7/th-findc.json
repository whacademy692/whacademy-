 "steps": [
  {
   "id": "tri",
   "title": "The problem",
   "narration": "In **ΔABC**, **∠C = 90°**. We know the two shorter sides: [[legA|a = BC = {{a|1}}]] and [[legB|b = AC = {{b|1}}]]. We want the **hypotenuse** [[hyp|c = AB]].",
   "actions": [
    {
     "set": {
      "sq": 0,
      "kn": 0,
      "a": 4,
      "b": 3
     }
    }
   ]
  },
  {
   "id": "spot",
   "title": "Step 1 — find the hypotenuse",
   "narration": "The right angle is at **C**, so the side opposite it, **AB**, is the [[hyp|hypotenuse]]. That is the side we are looking for, so Pythagoras' Theorem applies.",
   "actions": [
    {
     "pulse": "sideC",
     "at": 600
    }
   ]
  },
  {
   "id": "write",
   "title": "Step 2 — write the theorem",
   "narration": "In ΔABC, ∠C = 90°. Using Pythagoras' Theorem, \\[ \\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2} \\]",
   "actions": []
  },
  {
   "id": "sub",
   "title": "Step 3 — substitute the numbers",
   "narration": "Put the two known sides in:\\[ \\role{hyp}{c^2} = \\role{legA}{ {{a|1}}^2 } + \\role{legB}{ {{b|1}}^2 } \\]",
   "actions": []
  },
  {
   "id": "sqs",
   "title": "Step 4 — square the sides",
   "narration": "Squaring means **side × side** — the area of a square on that side. \\[ \\role{hyp}{c^2} = \\role{legA}{ {{a^2|2}} } + \\role{legB}{ {{b^2|2}} } \\]The [[hyp|big square]] on AB is still unknown.",
   "actions": [
    {
     "tween": {
      "sq": 1
     },
     "dur": 1000
    },
    {
     "pulse": [
      "sqA",
      "sqB"
     ],
     "at": 1400
    }
   ]
  },
  {
   "id": "add",
   "title": "Step 5 — add",
   "narration": "Add the two areas: \\[ \\role{hyp}{c^2} = {{a^2|2}} + {{b^2|2}} = \\role{hyp}{ {{a^2+b^2|2}} } \\]The big square on the hypotenuse has exactly this area.",
   "actions": [
    {
     "set": {
      "kn": 1
     }
    },
    {
     "pulse": "sqC",
     "at": 500
    }
   ]
  },
  {
   "id": "root",
   "title": "Step 6 — square root",
   "narration": "To get **c** itself, take the square root: \\[ \\role{hyp}{c} = \\sqrt{ {{a^2+b^2|2}} } = \\role{ans}{ {{c|2}} } \\]So the hypotenuse is **AB = {{c|2}}**. The hypotenuse is longer than both shorter sides — that is a good check.",
   "actions": [
    {
     "tween": {
      "sq": 0
     },
     "dur": 900
    },
    {
     "set": {
      "kn": 2
     }
    },
    {
     "pulse": "sideC",
     "at": 900
    }
   ]
  },
  {
   "id": "round",
   "title": "Not a whole number?",
   "narration": "Often the total is **not** a perfect square. Take a = {{a|1}} and b = {{b|1}}: \\[\\begin{aligned} c^2 &= {{a|1}}^2 + {{b|1}}^2 = {{a^2+b^2|2}} \\\\ c &= \\sqrt{ {{a^2+b^2|2}} } = \\role{ans}{ {{c|2}} } \\ \\text{(3 s.f.)} \\end{aligned}\\]Unless told otherwise, give the answer to **3 significant figures**.",
   "actions": [
    {
     "tween": {
      "a": 5,
      "b": 3
     },
     "dur": 1500
    }
   ]
  },
  {
   "id": "try",
   "title": "Now you try!",
   "narration": "Use the sliders to choose any two shorter sides and follow the same six steps. Then try the challenges.",
   "actions": [],
   "challenge": "twin"
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' Theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "filled": "\\role{hyp}{ {{c^2|2}} } = \\role{legA}{ {{a^2|2}} } + \\role{legB}{ {{b^2|2}} }",
   "text": "In ΔABC with ∠C = 90°:  AB² = BC² + AC². The square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse  c = AB",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "filled": "\\role{hyp}{ {{c|2}} } = \\sqrt{ {{a^2|2}} + {{b^2|2}} } = \\sqrt{ {{a^2+b^2|2}} }",
   "text": "Add the two squares, then take the square root."
  }
 ],
