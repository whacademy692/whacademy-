 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "Boat A goes **East** from **P** to **Q** (**PQ = 36 km**), then **South** to **R** (**QR = 24 km**). Boat B goes **North** from **P** to **S** (**PS = 36 km**), then **East** to **T** (**ST = 54 km**). Find the shortest distance between (i) **Q and S**, (ii) **R and T**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Spot the right angle",
   "narration": "In ΔPQS, **∠P = 90°**, so the **hypotenuse** is the side opposite it: **QS**. The other two sides meet at the right angle. East (PQ) and North (PS) are perpendicular, so ∠P = 90°.",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Pythagoras' theorem",
   "narration": "**Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{QS^2} &= \\role{legA}{PQ^2} + \\role{legB}{PS^2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute the lengths",
   "narration": "Replace each side by its length.\\[\\begin{aligned}\\role{hyp}{QS^2} &= \\role{legA}{PQ^2} + \\role{legB}{PS^2} \\\\ &= \\role{legA}{36^2} + \\role{legB}{36^2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Square and add",
   "narration": "Square each number, then add them.\\[\\begin{aligned}\\role{hyp}{QS^2} &= \\role{legA}{PQ^2} + \\role{legB}{PS^2} \\\\ &= \\role{legA}{36^2} + \\role{legB}{36^2} \\\\ &= \\role{legA}{1296} + \\role{legB}{1296} \\\\ &= \\role{hyp}{2592}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Square root",
   "narration": "2592 is not a perfect square, so use a calculator and round to 3 significant figures.\\[\\begin{aligned}\\role{hyp}{QS^2} &= \\role{legA}{PQ^2} + \\role{legB}{PS^2} \\\\ &= \\role{legA}{36^2} + \\role{legB}{36^2} \\\\ &= \\role{legA}{1296} + \\role{legB}{1296} \\\\ &= \\role{hyp}{2592} \\\\ \\role{hyp}{QS} &= \\sqrt{2592} = \\role{ans}{50.9\\ \\text{km}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s6",
   "title": "Set up for RT",
   "narration": "Drop a perpendicular from **Q** to **ST**, meeting it at **X**. Then **∠X = 90°** in **ΔRTX**, with legs along the grid.\\[\\begin{aligned}\\role{legA}{TX} &= 54 - 36 = \\role{legA}{18}\\ \\text{km} \\\\ \\role{legB}{RX} &= 24 + 36 = \\role{legB}{60}\\ \\text{km}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s7",
   "title": "Spot the right angle",
   "narration": "In ΔRTX, **∠X = 90°**, so the **hypotenuse** is the side opposite it: **RT**. The other two sides meet at the right angle.",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s8",
   "title": "Pythagoras' theorem",
   "narration": "**Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{RT^2} &= \\role{legA}{TX^2} + \\role{legB}{RX^2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s9",
   "title": "Substitute the lengths",
   "narration": "Replace each side by its length.\\[\\begin{aligned}\\role{hyp}{RT^2} &= \\role{legA}{TX^2} + \\role{legB}{RX^2} \\\\ &= \\role{legA}{18^2} + \\role{legB}{60^2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s10",
   "title": "Square and add",
   "narration": "Square each number, then add them.\\[\\begin{aligned}\\role{hyp}{RT^2} &= \\role{legA}{TX^2} + \\role{legB}{RX^2} \\\\ &= \\role{legA}{18^2} + \\role{legB}{60^2} \\\\ &= \\role{legA}{324} + \\role{legB}{3600} \\\\ &= \\role{hyp}{3924}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s11",
   "title": "Square root",
   "narration": "3924 is not a perfect square, so use a calculator and round to 3 significant figures.\\[\\begin{aligned}\\role{hyp}{RT^2} &= \\role{legA}{TX^2} + \\role{legB}{RX^2} \\\\ &= \\role{legA}{18^2} + \\role{legB}{60^2} \\\\ &= \\role{legA}{324} + \\role{legB}{3600} \\\\ &= \\role{hyp}{3924} \\\\ \\role{hyp}{RT} &= \\sqrt{3924} = \\role{ans}{62.6\\ \\text{km}}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding a shorter side",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "text": "Subtract the known shorter side's square from the hypotenuse's square, then take the square root."
  }
 ],
