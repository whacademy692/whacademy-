 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "A table coaster **ABCD** is a rhombus with diagonals of lengths **10 cm** and **24 cm**. The diagonals of a rhombus bisect each other at right angles. Find the length of each side of the coaster.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Halve each diagonal",
   "narration": "The diagonals bisect each other, so each half is **5 cm** and **12 cm**.\\[\\begin{aligned}\\role{legA}{OA} &= \\tfrac{1}{2}\\times 10 = 5\\ \\text{cm} \\\\ \\role{legB}{OB} &= \\tfrac{1}{2}\\times 24 = 12\\ \\text{cm}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Right angle and theorem",
   "narration": "In ΔOAB, **∠O = 90°**, so the **hypotenuse** is the side opposite it: **each side**. The other two sides meet at the right angle. **Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{AB^2} &= \\role{legA}{OA^2} + \\role{legB}{OB^2}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s3",
   "title": "Substitute and add",
   "narration": "Put in the lengths, square them and add.\\[\\begin{aligned}\\role{hyp}{AB^2} &= \\role{legA}{OA^2} + \\role{legB}{OB^2} \\\\ &= \\role{legA}{5^2} + \\role{legB}{12^2} \\\\ &= \\role{legA}{25} + \\role{legB}{144} \\\\ &= \\role{hyp}{169}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Square root",
   "narration": "Take the square root of both sides (a length is positive).\\[\\begin{aligned}\\role{hyp}{AB^2} &= \\role{legA}{OA^2} + \\role{legB}{OB^2} \\\\ &= \\role{legA}{5^2} + \\role{legB}{12^2} \\\\ &= \\role{legA}{25} + \\role{legB}{144} \\\\ &= \\role{hyp}{169} \\\\ \\role{hyp}{AB} &= \\sqrt{169} = \\role{ans}{13\\ \\text{cm}}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding a shorter side",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "text": "Subtract the known shorter side's square from the hypotenuse's square, then take the square root."
  }
 ],
 "challenges": [
  {
   "id": "twin",
   "type": "number",
   "title": "Now you try",
   "answer": 13,
   "unit": "cm",
   "prompt": "A right-angled triangle has shorter sides **5 cm** and **12 cm**. Find the **hypotenuse**.",
   "hint": "Add the squares: 5² + 12².",
   "explain": "5² + 12² = 25 + 144 = 169, and √169 = 13 cm."
  }
 ],
 "takeaways": [
  "Find the **right angle** first — the side opposite it is the **hypotenuse**.",
  "To find the hypotenuse: **add** the squares of the two shorter sides, then take the **square root**.",
  "The hypotenuse is always the **longest** side, so check that your answer is bigger than both of the other sides."
 ],
 "notes": [
  {
   "title": "Rhombus fact",
   "text": "A rhombus's diagonals always **bisect each other at right angles** — this is what makes the half-diagonals the legs of a right-angled triangle."
  }
 ]
