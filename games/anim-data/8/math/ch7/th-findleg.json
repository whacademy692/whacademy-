 "steps": [
  {
   "id": "tri",
   "title": "The problem",
   "narration": "In **ΔABC**, **∠C = 90°**. This time we know the **hypotenuse** [[hyp|c = AB = {{c|1}}]] and one shorter side [[legA|a = BC = {{a|1}}]]. We want the other shorter side [[legB|b = AC]].",
   "actions": [
    {
     "set": {
      "sq": 0,
      "kn": 0,
      "c": 5,
      "a": 3
     }
    }
   ]
  },
  {
   "id": "spot",
   "title": "Step 1 — find the hypotenuse",
   "narration": "The right angle is at **C**, so **AB** is the [[hyp|hypotenuse]] — it is the **longest** side, and it is the one we are given. The side we want, **AC**, is one of the shorter sides.",
   "actions": [
    {
     "pulse": "sideC",
     "at": 600
    }
   ]
  },
  {
   "id": "write",
   "title": "Step 2 — write the theorem",
   "narration": "In ΔABC, ∠C = 90°. Using Pythagoras' Theorem, \\[ \\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2} \\]",
   "actions": []
  },
  {
   "id": "sub",
   "title": "Step 3 — get the unknown alone",
   "narration": "We want **b²**, so **subtract** a² from both sides: \\[\\begin{aligned} \\role{legB}{b^2} &= \\role{hyp}{c^2} - \\role{legA}{a^2} \\\\ &= \\role{hyp}{ {{c|1}}^2 } - \\role{legA}{ {{a|1}}^2 } \\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "sqs",
   "title": "Step 4 — the squares",
   "narration": "Picture it: the [[hyp|big square]] on AB has area [[hyp|{{c^2|2}}]] and the [[legA|square on BC]] has area [[legA|{{a^2|2}}]]. The square on [[legB|AC]] is what is left over — its area is **b²**.",
   "actions": [
    {
     "tween": {
      "sq": 1
     },
     "dur": 1000
    },
    {
     "pulse": [
      "sqC",
      "sqA"
     ],
     "at": 1400
    }
   ]
  },
  {
   "id": "add",
   "title": "Step 5 — subtract",
   "narration": "\\[ \\role{legB}{b^2} = {{c^2|2}} - {{a^2|2}} = \\role{legB}{ {{c^2-a^2|2}} } \\]The square on AC has area **{{c^2-a^2|2}}**.",
   "actions": [
    {
     "set": {
      "kn": 1
     }
    },
    {
     "pulse": "sqB",
     "at": 500
    }
   ]
  },
  {
   "id": "root",
   "title": "Step 6 — square root",
   "narration": "Take the square root: \\[ \\role{legB}{b} = \\sqrt{ {{c^2-a^2|2}} } = \\role{ans}{ {{b|2}} } \\]So **AC = {{b|2}}**. A shorter side must be **smaller** than the hypotenuse ({{c|1}}) — that is a good check.",
   "actions": [
    {
     "tween": {
      "sq": 0
     },
     "dur": 900
    },
    {
     "set": {
      "kn": 2
     }
    },
    {
     "pulse": "sideB",
     "at": 900
    }
   ]
  },
  {
   "id": "round",
   "title": "Not a whole number?",
   "narration": "Take c = {{c|1}} and a = {{a|1}}: \\[\\begin{aligned} b^2 &= {{c|1}}^2 - {{a|1}}^2 = {{c^2-a^2|2}} \\\\ b &= \\sqrt{ {{c^2-a^2|2}} } = \\role{ans}{ {{b|2}} } \\ \\text{(3 s.f.)} \\end{aligned}\\]Unless told otherwise, give the answer to **3 significant figures**.",
   "actions": [
    {
     "tween": {
      "c": 9,
      "a": 5
     },
     "dur": 1500
    }
   ]
  },
  {
   "id": "try",
   "title": "Now you try!",
   "narration": "Use the sliders to choose a hypotenuse and a shorter side — then follow the same six steps. Remember to **subtract**!",
   "actions": [],
   "challenge": "twin"
  }
 ],
 "formulas": [
  {
   "title": "Finding the side  b = AC",
   "tex": "\\role{legB}{b} = \\sqrt{\\role{hyp}{c^2} - \\role{legA}{a^2}}",
   "filled": "\\role{legB}{ {{b|2}} } = \\sqrt{ {{c^2|2}} - {{a^2|2}} } = \\sqrt{ {{c^2-a^2|2}} }",
   "text": "Looking for a shorter side? Subtract the other shorter side's square from the hypotenuse's square."
  },
  {
   "title": "Finding the side  a = BC",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "filled": "\\role{legA}{ {{a|2}} } = \\sqrt{ {{c^2|2}} - {{b^2|2}} } = \\sqrt{ {{c^2-b^2|2}} }"
  },
  {
   "title": "Pythagoras' Theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "filled": "\\role{hyp}{ {{c^2|2}} } = \\role{legA}{ {{a^2|2}} } + \\role{legB}{ {{b^2|2}} }",
   "text": "In ΔABC with ∠C = 90°:  AB² = BC² + AC². The square on the hypotenuse equals the sum of the squares on the other two sides."
  }
 ],
