 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "The top of a pouch **LMNO** is a rectangle with **LM = 9 cm** and **MN = 6 cm**. **H** lies on **LM** with **HM = 2 cm** (so **LH = 7 cm**). (i) A zip is sewn along **OH**: find its length. (ii) A second zip **NK** is the perpendicular from **N** to **OH**: find its length.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Right angle and theorem",
   "narration": "In ΔOLH, **∠L = 90°**, so the **hypotenuse** is the side opposite it: **OH**. The other two sides meet at the right angle. **Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{OH^2} &= \\role{legA}{OL^2} + \\role{legB}{LH^2}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Substitute and add",
   "narration": "Put in the lengths, square them and add.\\[\\begin{aligned}\\role{hyp}{OH^2} &= \\role{legA}{OL^2} + \\role{legB}{LH^2} \\\\ &= \\role{legA}{6^2} + \\role{legB}{7^2} \\\\ &= \\role{legA}{36} + \\role{legB}{49} \\\\ &= \\role{hyp}{85}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Square root",
   "narration": "85 is not a perfect square, so use a calculator and round to 3 significant figures.\\[\\begin{aligned}\\role{hyp}{OH^2} &= \\role{legA}{OL^2} + \\role{legB}{LH^2} \\\\ &= \\role{legA}{6^2} + \\role{legB}{7^2} \\\\ &= \\role{legA}{36} + \\role{legB}{49} \\\\ &= \\role{hyp}{85} \\\\ \\role{hyp}{OH} &= \\sqrt{85} = \\sqrt{85} = \\role{ans}{9.22\\ \\text{cm}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "(ii) Area of ΔONH two ways",
   "narration": "**ΔONH** has base **ON = 9 cm** and height **6 cm** (the rectangle's height). It also has base **OH** and height **NK**.\\[\\begin{aligned}\\text{Area} &= \\tfrac{1}{2}\\times ON \\times 6 = \\tfrac{1}{2}\\times 9 \\times 6 = 27\\ \\text{cm}^2 \\\\ \\text{Area} &= \\tfrac{1}{2}\\times OH \\times NK\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Solve for NK",
   "narration": "Set the two areas equal and solve for **NK**.\\[\\begin{aligned}27 &= \\tfrac{1}{2}\\times 9.22 \\times NK \\\\ NK &= \\frac{54}{9.22} = \\role{ans}{5.86\\ \\text{cm}}\\ \\text{(3 s.f.)}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding a shorter side",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "text": "Subtract the known shorter side's square from the hypotenuse's square, then take the square root."
  }
 ],
 "challenges": [
  {
   "id": "area",
   "type": "number",
   "title": "Check the area",
   "answer": 27,
   "unit": "cm²",
   "prompt": "ON = 9 cm and the rectangle's height is 6 cm. Find the area of ΔONH using base ON.",
   "hint": "Area = ½ × base × height.",
   "explain": "Area = ½ × 9 × 6 = 27 cm²."
  }
 ],
 "takeaways": [
  "Writing one triangle's **area two different ways** is a powerful trick for finding a height (or a perpendicular) you can't reach directly.",
  "Keep a few extra decimal places in the middle of a calculation and round only the **final** answer (3 s.f.)."
 ],
