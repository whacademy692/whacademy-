 "steps": [
  {
   "id": "s0",
   "title": "Find the right angle",
   "narration": "Look at **ΔABC**. One corner has a little square in it — that marks a **right angle**. Here it is at **C**, so **∠C = 90°**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "The side opposite it",
   "narration": "Look straight across from the right angle. The side **opposite** ∠C is **AB** — the [[hyp|hypotenuse]]. It is also the **longest** side of ΔABC.",
   "actions": [
    {
     "pulse": "t1_hyp",
     "at": 900
    }
   ]
  },
  {
   "id": "s2",
   "title": "Now ΔDEF",
   "narration": "A different triangle, turned a different way. Where is the right angle? The little square is at **F**, so **∠F = 90°**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Opposite F is DE",
   "narration": "The side opposite ∠F is **DE**, so **DE** is the [[hyp|hypotenuse]] of ΔDEF — even though it slopes the other way this time.",
   "actions": [
    {
     "pulse": "t2_hyp",
     "at": 900
    }
   ]
  },
  {
   "id": "s4",
   "title": "And a tilted one",
   "narration": "The triangle can be tilted too. In **ΔPQR** the right angle is at **R**.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Opposite R is PQ",
   "narration": "The side opposite ∠R is **PQ**, so **PQ** is the [[hyp|hypotenuse]] of ΔPQR. It does not matter how the triangle is turned — the hypotenuse is always the side **opposite the right angle**.",
   "actions": [
    {
     "pulse": "t3_hyp",
     "at": 900
    }
   ]
  },
  {
   "id": "s6",
   "title": "The rule",
   "narration": "**Right angle first, then look across.** The side opposite the right angle is the **hypotenuse** — always the longest side. Only after you have found it can you use \\[ \\role{hyp}{\\text{hypotenuse}^2} = \\text{(side)}^2 + \\text{(side)}^2 \\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "The hypotenuse",
   "tex": "\\role{hyp}{\\text{hypotenuse}} = \\text{the side opposite the right angle}",
   "text": "In ΔABC with ∠C = 90°, the hypotenuse is AB. In ΔDEF with ∠F = 90° it is DE. In ΔPQR with ∠R = 90° it is PQ."
  }
 ],
