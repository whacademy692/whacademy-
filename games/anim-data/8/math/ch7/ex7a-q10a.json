 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "In the figure, **∠WYZ = 90°** and **∠PZW = 90°**. **WY = 27 cm**, **YZ = 36 cm**, **PZ = 60 cm**. **X** lies on **ZW** with **ZX = a** and **XW = 2a**. We have to find **a** and **b**, where **b = PX**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Right angle and theorem",
   "narration": "In ΔWYZ, **∠Y = 90°**, so the **hypotenuse** is the side opposite it: **WZ**. The other two sides meet at the right angle. **Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{WZ^2} &= \\role{legA}{WY^2} + \\role{legB}{YZ^2}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra1"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Substitute and add",
   "narration": "Put in the lengths, square them and add.\\[\\begin{aligned}\\role{hyp}{WZ^2} &= \\role{legA}{WY^2} + \\role{legB}{YZ^2} \\\\ &= \\role{legA}{27^2} + \\role{legB}{36^2} \\\\ &= \\role{legA}{729} + \\role{legB}{1296} \\\\ &= \\role{hyp}{2025}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Square root",
   "narration": "Take the square root of both sides (a length is positive).\\[\\begin{aligned}\\role{hyp}{WZ^2} &= \\role{legA}{WY^2} + \\role{legB}{YZ^2} \\\\ &= \\role{legA}{27^2} + \\role{legB}{36^2} \\\\ &= \\role{legA}{729} + \\role{legB}{1296} \\\\ &= \\role{hyp}{2025} \\\\ \\role{hyp}{WZ} &= \\sqrt{2025} = 45\\ \\text{cm}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Find a",
   "narration": "**WZ** is made of **ZX = a** and **XW = 2a**.\\[\\begin{aligned}WZ &= a + 2a = 3a \\\\ 3a &= 45 \\\\ a &= 15\\ \\text{cm}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Right angle and theorem",
   "narration": "In ΔPZX, **∠Z = 90°**, so the **hypotenuse** is the side opposite it: **PX**. The other two sides meet at the right angle. **Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{PX^2} &= \\role{legA}{PZ^2} + \\role{legB}{ZX^2}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s6",
   "title": "Substitute and add",
   "narration": "Put in the lengths, square them and add.\\[\\begin{aligned}\\role{hyp}{PX^2} &= \\role{legA}{PZ^2} + \\role{legB}{ZX^2} \\\\ &= \\role{legA}{60^2} + \\role{legB}{15^2} \\\\ &= \\role{legA}{3600} + \\role{legB}{225} \\\\ &= \\role{hyp}{3825}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s7",
   "title": "Square root",
   "narration": "3825 is not a perfect square, so use a calculator and round to 3 significant figures.\\[\\begin{aligned}\\role{hyp}{PX^2} &= \\role{legA}{PZ^2} + \\role{legB}{ZX^2} \\\\ &= \\role{legA}{60^2} + \\role{legB}{15^2} \\\\ &= \\role{legA}{3600} + \\role{legB}{225} \\\\ &= \\role{hyp}{3825} \\\\ \\role{hyp}{PX} &= \\sqrt{3825} = 15\\sqrt{17} = \\role{ans}{61.8\\ \\text{cm}}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding a shorter side",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "text": "Subtract the known shorter side's square from the hypotenuse's square, then take the square root."
  }
 ],
 "challenges": [
