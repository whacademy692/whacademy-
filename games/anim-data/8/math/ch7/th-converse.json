 "readouts": [
  {
   "label": "a² + b²",
   "role": "accent",
   "value": "{{a^2|2}} + {{b^2|2}} = {{a^2+b^2|2}}"
  },
  {
   "label": "c²",
   "role": "hyp",
   "value": "{{c^2|2}}"
  },
  {
   "label": "Verdict",
   "role": "ans",
   "when": "valid > 0.5",
   "value": "{{if isR > 0.5 | c² = a² + b²  so  ∠C = 90° | c² ≠ a² + b²  so  not right-angled}}"
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "Pythagoras' Theorem — one way",
   "narration": "In **ΔABC**, if **∠C = 90°**, then \\[ \\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2} \\]Right angle first, then the squares. Here {{c^2|2}} = {{a^2|2}} + {{b^2|2}}.",
   "actions": [
    {
     "set": {
      "a": 4,
      "b": 3,
      "c": 5
     }
    }
   ]
  },
  {
   "id": "s1",
   "title": "Turn it around — the Converse",
   "narration": "The theorem also works **backwards**. In ΔABC, if \\[ \\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2} \\]then **∠C = 90°**. So we can **test** a triangle from its three side lengths alone — no protractor needed. The right angle is always **opposite the longest side**.",
   "actions": [
    {
     "pulse": "sc",
     "at": 600
    }
   ]
  },
  {
   "id": "s2",
   "title": "Test 1 — Worked Example 8(a)",
   "narration": "ΔABC with **AB = 39 cm**, **BC = 15 cm**, **AC = 36 cm**. AB is the longest side. \\[\\begin{aligned} AB^2 &= 39^2 = 1521 \\\\ BC^2 + AC^2 &= 15^2 + 36^2 \\\\ &= 225 + 1296 = 1521 \\end{aligned}\\]Since AB² = BC² + AC², by the Converse ΔABC **is** right-angled, with **∠C = 90°**.",
   "actions": [
    {
     "tween": {
      "a": 15,
      "b": 36,
      "c": 39
     },
     "dur": 1800
    }
   ]
  },
  {
   "id": "s3",
   "title": "Test 2 — Worked Example 8(b)",
   "narration": "ΔPQR with **PQ = 28 m**, **QR = 20 m**, **PR = 19 m**. PQ is the longest side. \\[\\begin{aligned} PQ^2 &= 28^2 = 784 \\\\ QR^2 + PR^2 &= 20^2 + 19^2 \\\\ &= 400 + 361 = 761 \\end{aligned}\\]Since 784 ≠ 761, PQ² ≠ QR² + PR², so ΔPQR is **not** right-angled.",
   "actions": [
    {
     "tween": {
      "a": 20,
      "b": 19,
      "c": 28
     },
     "dur": 1800
    }
   ]
  },
