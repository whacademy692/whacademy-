   "unit": "units",
   "hint": "Keep c the longest side."
  }
 ],
 "derived": {
  "cosC": "clamp((a^2 + b^2 - c^2) / (2*a*b), -1, 1)",
  "sinC": "sqrt(1 - cosC^2)",
  "angC": "atan2(sinC, cosC)",
  "valid": "(a + b > c + 0.001 && a + c > b + 0.001 && b + c > a + 0.001) ? 1 : 0",
  "isR": "abs(c^2 - a^2 - b^2) < 0.001 ? 1 : 0",
  "xmin": "min(0, b*cosC)",
  "ymax": "b*sinC",
  "mx": "0.2 * max(a, max(b, c)) + 0.7",
  "C": [
   0,
   0
  ],
  "B": [
   "a",
   0
  ],
  "A": [
   "b*cosC",
   "b*sinC"
  ]
 },
