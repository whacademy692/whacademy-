{
 "id": "g8-math-pyth-th-converse",
 "title": "The Converse of Pythagoras' Theorem",
 "summary": "Test whether a triangle is right-angled using only its three side lengths: is c² = a² + b²?",
 "alt": "A triangle ABC with sides a = {{a|1}}, b = {{b|1}} and c = {{c|1}}; c² = {{c^2|2}} and a² + b² = {{a^2+b^2|2}}.",
