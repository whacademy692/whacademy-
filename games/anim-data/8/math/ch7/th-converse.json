   "ymax + 0.6*mx"
  ],
  "smooth": true,
  "ratio": 0.82,
  "pad": 14
 },
 "roles": {
  "hyp": {
   "label": "Hypotenuse",
   "color": "#059669",
   "text": "The side opposite the right angle. It is always the longest side."
  },
  "legA": {
   "label": "Shorter side 1",
   "color": "#2563eb",
   "text": "One of the two sides that meet at the right angle."
  },
  "legB": {
   "label": "Shorter side 2",
   "color": "#e11d48",
   "text": "The other side that meets at the right angle."
  },
  "ans": {
