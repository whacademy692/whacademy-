 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "A rectangular table **ABCD** has **AB = (2x + 12) cm**, **BC = x cm** and diagonal **BD = (2x + 18) cm**. In **ΔBCD**, **∠C = 90°**. Find the value of **x**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Use the right-angled triangle BCD",
   "narration": "In **ΔBCD**, **∠C = 90°**, with **BD** the hypotenuse, **CD = AB = (2x + 12)** and **BC = x**.\\[\\begin{aligned}\\role{hyp}{BD^2} &= \\role{legA}{CD^2} + \\role{legB}{BC^2} \\\\ \\role{hyp}{(2x+18)^2} &= \\role{legA}{(2x+12)^2} + \\role{legB}{x^2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Expand each bracket",
   "narration": "Multiply out the squares.\\[\\begin{aligned}4x^2 + 72x + 324 &= (4x^2 + 48x + 144) + x^2 \\\\ 4x^2 + 72x + 324 &= 5x^2 + 48x + 144\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Form a quadratic equation",
   "narration": "Bring every term to one side.\\[\\begin{aligned}0 &= 5x^2 + 48x + 144 - 4x^2 - 72x - 324 \\\\ x^2 - 24x - 180 &= 0\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Factorise and solve",
   "narration": "Factorise, then read off the roots.\\[\\begin{aligned}(x - 30)(x + 6) &= 0 \\\\ x = 30 \\;&\\text{or}\\; x = -6\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Choose the valid value",
   "narration": "A length can't be negative, so reject **x = −6**.\\[\\begin{aligned}\\therefore x = \\role{ans}{30}\\quad(\\text{since } x > 0)\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  }
 ],
 "challenges": [
  {
   "id": "twin",
   "type": "number",
   "title": "Now you try",
   "answer": "8",
   "unit": "",
   "prompt": "A rectangle has sides **(x + 7)** and **x** and diagonal **(x + 9)**. Find **x**.",
   "hint": "(x+9)² = (x+7)² + x² → x² − 4x − 32 = 0.",
   "explain": "(x + 4)(x − 8) = 0, so x = 8 (x > 0)."
  }
 ],
 "takeaways": [
  "Pythagoras' theorem works only in **right-angled** triangles — mark every right angle in the figure first.",
  "Split the figure into right-angled triangles and solve them **one at a time**; each answer feeds the next triangle.",
  "Keep a few extra decimal places in the middle of a calculation and round only the **final** answer (3 s.f.)."
 ],
 "notes": [
  {
   "title": "Keep it tidy",
   "text": "Expand carefully: **(ax + b)² = a²x² + 2abx + b²**. A sign slip here changes the whole quadratic."
  }
 ]
