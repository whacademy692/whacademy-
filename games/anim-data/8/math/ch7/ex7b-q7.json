 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "Devi folds a sheet of paper into an envelope. **∠AED = ∠ADB = ∠BCD = 90°**. **AE = ED = 8 cm**, **DC = CB = 14 cm**. She applies glue along **AD** and **DB**. Find the total length of glue needed.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Right angle and theorem",
   "narration": "In ΔAED, **∠E = 90°**, so the **hypotenuse** is the side opposite it: **AD**. The other two sides meet at the right angle. **Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{AD^2} &= \\role{legA}{AE^2} + \\role{legB}{ED^2}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Substitute and add",
   "narration": "Put in the lengths, square them and add.\\[\\begin{aligned}\\role{hyp}{AD^2} &= \\role{legA}{AE^2} + \\role{legB}{ED^2} \\\\ &= \\role{legA}{8^2} + \\role{legB}{8^2} \\\\ &= \\role{legA}{64} + \\role{legB}{64} \\\\ &= \\role{hyp}{128}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Square root",
   "narration": "128 is not a perfect square, so use a calculator and round to 3 significant figures.\\[\\begin{aligned}\\role{hyp}{AD^2} &= \\role{legA}{AE^2} + \\role{legB}{ED^2} \\\\ &= \\role{legA}{8^2} + \\role{legB}{8^2} \\\\ &= \\role{legA}{64} + \\role{legB}{64} \\\\ &= \\role{hyp}{128} \\\\ \\role{hyp}{AD} &= \\sqrt{128} = 8\\sqrt{2} = \\role{ans}{11.3\\ \\text{cm}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Right angle and theorem",
   "narration": "In ΔBCD, **∠C = 90°**, so the **hypotenuse** is the side opposite it: **DB**. The other two sides meet at the right angle. **Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{DB^2} &= \\role{legA}{DC^2} + \\role{legB}{CB^2}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra1"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s5",
   "title": "Substitute and add",
   "narration": "Put in the lengths, square them and add.\\[\\begin{aligned}\\role{hyp}{DB^2} &= \\role{legA}{DC^2} + \\role{legB}{CB^2} \\\\ &= \\role{legA}{14^2} + \\role{legB}{14^2} \\\\ &= \\role{legA}{196} + \\role{legB}{196} \\\\ &= \\role{hyp}{392}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s6",
   "title": "Square root",
   "narration": "392 is not a perfect square, so use a calculator and round to 3 significant figures.\\[\\begin{aligned}\\role{hyp}{DB^2} &= \\role{legA}{DC^2} + \\role{legB}{CB^2} \\\\ &= \\role{legA}{14^2} + \\role{legB}{14^2} \\\\ &= \\role{legA}{196} + \\role{legB}{196} \\\\ &= \\role{hyp}{392} \\\\ \\role{hyp}{DB} &= \\sqrt{392} = 14\\sqrt{2} = \\role{ans}{19.8\\ \\text{cm}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s7",
   "title": "Total glue length",
   "narration": "Add the two lengths of glue.\\[\\begin{aligned}\\text{Total} &= AD + DB \\\\ &= 8\\sqrt{2} + 14\\sqrt{2} \\\\ &= 22\\sqrt{2} = \\role{ans}{31.1\\ \\text{cm}}\\ \\text{(3 s.f.)}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding a shorter side",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "text": "Subtract the known shorter side's square from the hypotenuse's square, then take the square root."
  }
 ],
 "challenges": [
