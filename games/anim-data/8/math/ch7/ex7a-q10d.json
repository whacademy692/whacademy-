 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "The figure shows a **spiral** of four right-angled triangles. Each new triangle is built on the previous hypotenuse with a new perpendicular side of **7 cm**. The first triangle has shorter sides **g** and **7 cm**, the hypotenuses are **h₁, h₂, h₃**, and the outermost hypotenuse is **35 cm**. We have to find **g**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Triangle 1",
   "narration": "In the first triangle the right angle is at the end of **g**, so the hypotenuse is **h₁**.\\[\\begin{aligned}\\role{hyp}{h_1^2} &= \\role{legB}{7^2} + \\role{legA}{g^2}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Triangle 2",
   "narration": "The next triangle is built on **h₁**: its shorter sides are **h₁** and **7 cm**.\\[\\begin{aligned}\\role{hyp}{h_2^2} &= 7^2 + \\role{legA}{h_1^2} \\\\ &= 7^2 + 7^2 + g^2 = 2(7^2) + g^2\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra1"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s3",
   "title": "Triangle 3",
   "narration": "Again add **7²** to the previous square.\\[\\begin{aligned}\\role{hyp}{h_3^2} &= 7^2 + \\role{legA}{h_2^2} \\\\ &= 7^2 + 2(7^2) + g^2 = 3(7^2) + g^2\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra2"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s4",
   "title": "Triangle 4",
   "narration": "The outermost hypotenuse is **35 cm**.\\[\\begin{aligned}\\role{hyp}{35^2} &= 7^2 + \\role{legA}{h_3^2} \\\\ &= 7^2 + 3(7^2) + g^2 = 4(7^2) + g^2\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "ra3"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s5",
   "title": "Solve for g",
   "narration": "Now put in the numbers and solve for **g²**.\\[\\begin{aligned}1225 &= 4(49) + g^2 \\\\ 1225 &= 196 + g^2 \\\\ g^2 &= 1225 - 196 = 1029 \\\\ g &= \\sqrt{1029} = 7\\sqrt{21} = \\role{ans}{32.1\\ \\text{cm}}\\ \\text{(3 s.f.)}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding a shorter side",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "text": "Subtract the known shorter side's square from the hypotenuse's square, then take the square root."
  }
 ],
