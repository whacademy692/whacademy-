 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "narration": "The two shorter sides are **12 cm** and **35 cm**, with the right angle between them. We have to find the hypotenuse **b**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Spot the right angle",
   "narration": "In the right-angled triangle, the right angle is at **R**. The **hypotenuse** is the side opposite the right angle — the longest side.",
   "actions": [
    {
     "pulse": [
      "ra0"
     ],
     "at": 700
    }
   ]
  },
  {
   "id": "s2",
   "title": "Pythagoras' theorem",
   "narration": "**Pythagoras' theorem**: the square on the hypotenuse equals the sum of the squares on the other two sides.\\[\\begin{aligned}\\role{hyp}{\\text{hypotenuse}^2} &= \\role{legA}{\\text{leg}^2} + \\role{legB}{\\text{leg}^2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute the lengths",
   "narration": "Replace each side by its length.\\[\\begin{aligned}\\role{hyp}{\\text{hypotenuse}^2} &= \\role{legA}{\\text{leg}^2} + \\role{legB}{\\text{leg}^2} \\\\ \\role{hyp}{b^2} &= \\role{legA}{35^2} + \\role{legB}{12^2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Square and add",
   "narration": "Square each number, then add them.\\[\\begin{aligned}\\role{hyp}{\\text{hypotenuse}^2} &= \\role{legA}{\\text{leg}^2} + \\role{legB}{\\text{leg}^2} \\\\ \\role{hyp}{b^2} &= \\role{legA}{35^2} + \\role{legB}{12^2} \\\\ &= \\role{legA}{1225} + \\role{legB}{144} \\\\ &= \\role{hyp}{1369}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Square root",
   "narration": "Take the square root of both sides (a length is positive).\\[\\begin{aligned}\\role{hyp}{\\text{hypotenuse}^2} &= \\role{legA}{\\text{leg}^2} + \\role{legB}{\\text{leg}^2} \\\\ \\role{hyp}{b^2} &= \\role{legA}{35^2} + \\role{legB}{12^2} \\\\ &= \\role{legA}{1225} + \\role{legB}{144} \\\\ &= \\role{hyp}{1369} \\\\ \\role{hyp}{b} &= \\sqrt{1369} = \\role{ans}{37\\ \\text{cm}}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Pythagoras' theorem",
   "tex": "\\role{hyp}{c^2} = \\role{legA}{a^2} + \\role{legB}{b^2}",
   "text": "In a right-angled triangle, the square on the hypotenuse equals the sum of the squares on the other two sides."
  },
  {
   "title": "Finding the hypotenuse",
   "tex": "\\role{hyp}{c} = \\sqrt{\\role{legA}{a^2} + \\role{legB}{b^2}}",
   "text": "Add the two squares, then take the square root."
  },
  {
   "title": "Finding a shorter side",
   "tex": "\\role{legA}{a} = \\sqrt{\\role{hyp}{c^2} - \\role{legB}{b^2}}",
   "text": "Subtract the known shorter side's square from the hypotenuse's square, then take the square root."
  }
 ],
