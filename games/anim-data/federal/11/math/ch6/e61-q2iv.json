 "steps": [
  {
   "id": "s0",
   "title": "Goal",
   "text": "\\[\\begin{aligned}&\\text{The top (n$-$3)(n$-$2)(n$-$1) is not a}\\\\[5pt]&\\text{complete chain, so first multiply and}\\\\[5pt]&\\text{divide by (n$-$1)(n$-$2)(n$-$3).}\\\\[5pt]&\\dfrac{(n-3)(n-2)(n-1)}{n(n-4)}\\times\\dfrac{(n-1)(n-2)(n-3)}{(n-1)(n-2)(n-3)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Collect the factors",
   "text": "\\[\\begin{aligned}&{}=\\dfrac{(n-1)^2(n-2)^2(n-3)^2}{n(n-1)(n-2)(n-3)(n-4)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Build factorials",
   "text": "\\[\\begin{aligned}&\\text{Now multiply and divide by [(n$-$4)!]\\^{}2 so}\\\\[5pt]&\\text{every product becomes a factorial.}\\\\[5pt]&\\text{Top}=[(n-1)(n-2)(n-3)(n-4)!]^2=[(n-1)!]^2\\\\[5pt]&\\text{Bottom}=\\underbrace{n(n-1)(n-2)(n-3)(n-4)!}_{n!}\\times(n-4)!\\times(n-4)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Result",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{=\\dfrac{[(n-1)!]^2}{n!\\,(n-4)!\\,(n-4)}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Check with n = 6",
   "text": "\\[\\begin{aligned}&\\text{LHS}=\\dfrac{3\\times4\\times5}{6\\times2}=5\\\\[5pt]&\\text{RHS}=\\dfrac{(5!)^2}{6!\\times2!\\times2}=\\dfrac{14400}{2880}=5\\ \\checkmark\\end{aligned}\\]",
   "actions": [
