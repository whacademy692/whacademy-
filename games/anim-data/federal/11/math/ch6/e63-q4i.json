     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Second ratio",
   "text": "\\[\\begin{aligned}&\\dfrac{ {}^{n}C_{r+1}}{ {}^{n}C_{r}}=\\dfrac{n-r}{r+1}=\\dfrac{21}{14}=\\dfrac{3}{2}\\\\[5pt]&2n-2r=3r+3\\;\\Rightarrow\\;2n=5r+3\\qquad(2)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
