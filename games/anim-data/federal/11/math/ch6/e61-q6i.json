 "steps": [
  {
   "id": "s0",
   "title": "Write everything in terms of (n-2)!",
   "text": "\\[\\begin{aligned}&n!=n(n-1)(n-2)!,\\qquad(n-1)!=(n-1)(n-2)!\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Simplify the bracket",
   "text": "\\[\\begin{aligned}&\\text{Bracket}=(n-2)!\\,[\\,n^2(n-1)+(n-1)(2n-1)+(n-1)\\,]\\\\[5pt]&{}=(n-2)!\\,(n-1)\\,[\\,n^2+(2n-1)+1\\,]=(n-2)!\\,(n-1)\\,(n^2+2n)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Factorise",
   "text": "\\[\\begin{aligned}&n^2+2n=n(n+2)\\\\[5pt]&\\text{Bracket}=\\underbrace{(n-2)!\\,(n-1)\\,n}_{n!}\\,(n+2)=n!\\,(n+2)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Finish",
   "text": "\\[\\begin{aligned}&\\text{LHS}=(n+1)\\,n!\\,(n+2)=(n+2)(n+1)\\,n!\\\\[5pt]&\\textcolor{#047857}{\\mathbf{=(n+2)!=\\text{RHS}\\ \\checkmark}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Why n is at least 2",
   "text": "\\[\\begin{aligned}&\\text{The LHS has (n$-$2)!, which exists only}\\\\[5pt]&\\text{when n$-$2 is 0 or more. For n = 1 it}\\\\[5pt]&\\text{would be (-1)!, which is not defined.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
