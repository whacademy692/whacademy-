   "title": "Write with factorials",
   "text": "\\[\\begin{aligned}&{}^{2n-1}P_{n}=\\dfrac{(2n-1)!}{(n-1)!},\\qquad{}^{2n+1}P_{n-1}=\\dfrac{(2n+1)!}{(n+2)!}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Form the stacked ratio",
   "text": "\\[\\begin{aligned}&\\dfrac{(2n-1)!}{(2n+1)!}\\times\\dfrac{(n+2)!}{(n-1)!}=\\dfrac{n(n+1)(n+2)}{(2n+1)(2n)}=\\dfrac{(n+1)(n+2)}{2(2n+1)}\\\\[5pt]&\\dfrac{(n+1)(n+2)}{2(2n+1)}=\\dfrac{22}{7}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cross-multiply",
   "text": "\\[\\begin{aligned}&7(n^2+3n+2)=44(2n+1)\\;\\Rightarrow\\;7n^2-67n-30=0\\\\[5pt]&(n-10)(7n+3)=0\\\\[5pt]&\\text{n = $-$3/7 is rejected.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{n=10}}\\end{aligned}\\]",
