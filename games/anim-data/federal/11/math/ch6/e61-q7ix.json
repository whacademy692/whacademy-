 "steps": [
  {
   "id": "s0",
   "title": "Rewrite the right side",
   "text": "\\[\\begin{aligned}&(n+3)!=(n+3)(n+2)!,\\qquad(2n+1)!=(2n+1)(2n)(2n-1)!\\\\[5pt]&\\dfrac{(n+2)!}{(2n-1)!}=\\dfrac{(n+3)(n+2)!}{(2n+1)(2n)(2n-1)!}\\times\\dfrac{72}{7}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Cancel the common factor",
   "text": "\\[\\begin{aligned}&\\text{Cancel the common factor (n+2)!/(2n$-$1)!}\\\\[5pt]&\\text{from both sides.}\\\\[5pt]&1=\\dfrac{n+3}{(2n+1)(2n)}\\times\\dfrac{72}{7}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cross-multiply",
   "text": "\\[\\begin{aligned}&7(2n+1)(2n)=72(n+3)\\\\[5pt]&28n^2+14n=72n+216\\;\\Rightarrow\\;14n^2-29n-108=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Quadratic formula",
   "text": "\\[\\begin{aligned}&n=\\dfrac{29\\pm\\sqrt{841+6048}}{28}=\\dfrac{29\\pm83}{28}\\\\[5pt]&n=\\dfrac{112}{28}=4\\quad\\text{or}\\quad n=-\\dfrac{27}{14}\\\\[5pt]&\\text{n must be a positive whole number.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{n=4}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Check",
