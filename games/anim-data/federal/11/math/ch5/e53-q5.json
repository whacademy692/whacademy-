  {
   "id": "s0",
   "title": "Reading of the figure",
   "text": "\\[\\begin{aligned}&\\text{The width of rectangle ACED is AC = 2x +}\\\\[5pt]&\\text{8 (as drawn). Area = length x width.}\\end{aligned}\\]",
   "actions": [
