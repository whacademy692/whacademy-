    }
   ]
  },
  {
   "id": "s1",
   "title": "Length of the rectangle",
   "text": "\\[\\begin{aligned}&(2x+8)\\cdot\\text{length}=6x^2+38x+56\\\\[5pt]&6x^2+38x+56=(2x+8)(3x+7)\\\\[5pt]&\\text{Length}=\\textcolor{#047857}{\\mathbf{3x+7}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Side of the square",
   "text": "\\[\\begin{aligned}&\\text{B is the midpoint of AC, so AB = (2x +}\\\\[5pt]&\\text{8)/2.}\\\\[5pt]&AB=x+4\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Area of the square",
