     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Divide by x - 3",
   "text": "\\[\\begin{aligned}&3,\\ -5+9=4,\\ 0+12=12,\\ -36+36=0\\\\[5pt]&3x^3-5x^2-36=(x-3)(3x^2+4x+12)\\end{aligned}\\]",
   "actions": [
