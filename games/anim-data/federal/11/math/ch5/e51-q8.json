 "steps": [
  {
   "id": "s0",
   "title": "Look for a zero",
   "text": "\\[\\begin{aligned}&\\text{The divisors of the constant term 6 are}\\\\[5pt]&\\text{plus or minus 1, 2, 3, 6. Try x = 2:}\\\\[5pt]&p(2)=2(8)+3(4)-11(2)-6=0\\\\[5pt]&\\text{So x $-$ 2 is a factor.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Divide by x - 2",
   "text": "\\[\\begin{aligned}&\\text{Synthetic division with c = 2 on 2, 3,}\\\\[5pt]&\\text{-11, $-$6:}\\\\[5pt]&2,\\ 3+4=7,\\ -11+14=3,\\ -6+6=0\\\\[5pt]&2x^3+3x^2-11x-6=(x-2)(2x^2+7x+3)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Factorize the quadratic",
   "text": "\\[\\begin{aligned}&2x^2+7x+3=(2x+1)(x+3)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Zeros",
   "text": "\\[\\begin{aligned}&x-2=0,\\ 2x+1=0,\\ x+3=0\\\\[5pt]&\\textcolor{#047857}{\\mathbf{x=2,\\ -\\tfrac12,\\ -3}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
