   "id": "s0",
   "title": "Numerator",
   "text": "\\[\\begin{aligned}&\\sqrt{9-x}=3\\left(1-\\dfrac x9\\right)^{1/2}\\approx3-\\dfrac x6\\\\[5pt]&(1+\\tfrac{3x}{4})^{-5}\\approx1-\\dfrac{15x}{4}\\\\[5pt]&\\text{Numerator}\\approx4-\\left(\\dfrac16+\\dfrac{15}{4}\\right)x=4-\\dfrac{47}{12}x\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Denominator",
   "text": "\\[\\begin{aligned}&\\dfrac{1}{2+x}=\\dfrac12\\left(1+\\dfrac x2\\right)^{-1}\\approx\\dfrac12\\left(1-\\dfrac x2\\right)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Multiply",
   "text": "\\[\\begin{aligned}&\\text{LHS}\\approx\\dfrac12\\left(4-\\dfrac{47x}{12}\\right)\\left(1-\\dfrac x2\\right)\\\\[5pt]&\\approx\\dfrac12\\left[4-\\dfrac{47x}{12}-2x\\right]=\\dfrac12\\left[4-\\dfrac{71x}{12}\\right]\\\\[5pt]&\\textcolor{#047857}{\\mathbf{=2-\\dfrac{71x}{24}}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
