 "steps": [
  {
   "id": "s0",
   "title": "Check P(0)",
   "text": "\\[\\begin{aligned}&P(n):\\ \\displaystyle\\sum_{r=0}^{n}\\binom{n}{r}=2^n\\\\[5pt]&n=0:\\ \\binom00=1=2^0\\\\[5pt]&\\text{So $P(0)$ is true.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Assume P(k)",
   "text": "\\[\\begin{aligned}&\\displaystyle\\sum_{r=0}^{k}\\binom{k}{r}=2^k\\qquad(1)\\\\[5pt]&\\text{Pascal rule (for 1 $\\le$ $r$ $\\le$ $k$):}\\\\[5pt]&\\binom{k+1}{r}=\\binom{k}{r-1}+\\binom{k}{r}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Sum for k + 1",
   "text": "\\[\\begin{aligned}&\\displaystyle\\sum_{r=0}^{k+1}\\binom{k+1}{r}=1+\\sum_{r=1}^{k}\\left[\\binom{k}{r-1}+\\binom{k}{r}\\right]+1\\\\[5pt]&\\displaystyle\\sum_{r=1}^{k}\\binom{k}{r-1}=2^k-1\\\\[5pt]&\\displaystyle\\sum_{r=1}^{k}\\binom{k}{r}=2^k-1\\\\[5pt]&\\text{Each sum is (1) with one term 1 missing.}\\\\[5pt]&\\text{Total}=1+(2^k-1)+(2^k-1)+1=2\\cdot2^k=2^{k+1}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{$P(0)$ is true and $P(k)$ implies $P(k+1)$.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\text{ is true for all } n\\ge 0}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
