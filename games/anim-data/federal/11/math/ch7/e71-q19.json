 "steps": [
  {
   "id": "s0",
   "title": "Check P(0)",
   "text": "\\[\\begin{aligned}&P(n):\\ \\displaystyle\\sum_{r=0}^{n}\\dfrac{1}{r+1}\\binom{n}{r}=\\dfrac{2^{n+1}-1}{n+1}\\\\[5pt]&n=0:\\ \\text{LHS}=\\binom00=1,\\ \\ \\text{RHS}=\\dfrac{2-1}{1}=1\\\\[5pt]&\\text{So $P(0)$ is true.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Key identity",
   "text": "\\[\\begin{aligned}&\\dfrac{1}{r+1}\\binom{n}{r}=\\dfrac{n!}{(r+1)!\\,(n-r)!}\\\\[5pt]&{}=\\dfrac{1}{n+1}\\cdot\\dfrac{(n+1)!}{(r+1)!\\,(n-r)!}=\\dfrac{1}{n+1}\\binom{n+1}{r+1}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Use it for n = k + 1",
   "text": "\\[\\begin{aligned}&\\displaystyle\\sum_{r=0}^{k+1}\\dfrac{1}{r+1}\\binom{k+1}{r}=\\dfrac{1}{k+2}\\sum_{r=0}^{k+1}\\binom{k+2}{r+1}\\\\[5pt]&{}=\\dfrac{1}{k+2}\\left[\\binom{k+2}{1}+\\dots+\\binom{k+2}{k+2}\\right]\\\\[5pt]&{}=\\dfrac{1}{k+2}\\left[2^{k+2}-\\binom{k+2}{0}\\right]\\\\[5pt]&\\text{using Q17 for $k$+2.}\\\\[5pt]&{}=\\dfrac{2^{k+2}-1}{k+2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{This is $P(k+1)$, so the formula holds for}\\\\[5pt]&\\text{every $n$ $\\ge$ 0 (the key identity turns it}\\\\[5pt]&\\text{into the sum of Q17).}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\text{ is true for all } n\\ge 0}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
