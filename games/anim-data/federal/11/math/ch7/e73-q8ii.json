 "steps": [
  {
   "id": "s0",
   "title": "Compare with the binomial series",
   "text": "\\[\\begin{aligned}&1+nu+\\dfrac{n(n-1)}{2!}u^2+\\dfrac{n(n-1)(n-2)}{3!}u^3+\\dots\\\\[5pt]&nu=-\\dfrac1{15}\\qquad(a)\\\\[5pt]&n(n-1)u^2=\\dfrac{4}{15^2}\\qquad(b)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Find n",
   "text": "\\[\\begin{aligned}&\\dfrac{(b)}{(a)^2}:\\ \\dfrac{n-1}{n}=\\dfrac{4/225}{1/225}=4\\\\[5pt]&n-1=4n\\ \\Rightarrow\\ \\textcolor{#047857}{\\mathbf{n=-\\dfrac13}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find u",
   "text": "\\[\\begin{aligned}&u=\\dfrac{-1/15}{-1/3}=\\textcolor{#047857}{\\mathbf{\\dfrac15}}\\\\[5pt]&\\text{Check the 4th term: $n$($n$$-$1)($n$$-$2)$u^{3}$ =}\\\\[5pt]&\\text{-28/3375, the same as -(4$\\cdot$7)/$15^{3}$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Sum",
   "text": "\\[\\begin{aligned}&(1+u)^n=\\left(1+\\dfrac15\\right)^{-1/3}=\\left(\\dfrac65\\right)^{-1/3}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{=\\left(\\dfrac56\\right)^{1/3}\\approx0.9410}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
