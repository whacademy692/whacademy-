  {
   "id": "s0",
   "title": "Row of Pascal's triangle",
   "text": "\\[\\begin{aligned}&a=\\dfrac{x^2}{y^2},\\ \\ b=-\\sqrt{\\dfrac{y}{x}},\\ \\ n=5\\\\[5pt]&\\text{Row }5:\\ 1\\ 5\\ 10\\ 10\\ 5\\ 1\\end{aligned}\\]",
