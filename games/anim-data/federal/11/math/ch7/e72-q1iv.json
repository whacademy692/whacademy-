     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Add the terms",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{\\frac{x^{10}}{y^{10}} - \\frac{5 x^{\\frac{15}{2}}}{y^{\\frac{15}{2}}} + \\frac{10 x^{5}}{y^{5}}}}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{ {} - \\frac{10 x^{\\frac{5}{2}}}{y^{\\frac{5}{2}}} + 5 - \\frac{y^{\\frac{5}{2}}}{x^{\\frac{5}{2}}}}}\\end{aligned}\\]",
