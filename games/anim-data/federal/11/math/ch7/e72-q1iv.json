   ]
  },
  {
   "id": "s1",
   "title": "Terms 1 to 3",
   "text": "\\[\\begin{aligned}&T_{1}=\\left(\\dfrac{x^2}{y^2}\\right)^{5}\\\\[5pt]&{}=\\frac{x^{10}}{y^{10}}\\\\[5pt]&T_{2}=\\binom{5}{1}\\left(\\dfrac{x^2}{y^2}\\right)^{4}\\left(-\\sqrt{\\dfrac{y}{x}}\\right)\\\\[5pt]&{}=- \\frac{5 x^{\\frac{15}{2}}}{y^{\\frac{15}{2}}}\\\\[5pt]&T_{3}=\\binom{5}{2}\\left(\\dfrac{x^2}{y^2}\\right)^{3}\\left(-\\sqrt{\\dfrac{y}{x}}\\right)^{2}\\\\[5pt]&{}=\\frac{10 x^{5}}{y^{5}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Terms 4 to 6",
   "text": "\\[\\begin{aligned}&T_{4}=\\binom{5}{3}\\left(\\dfrac{x^2}{y^2}\\right)^{2}\\left(-\\sqrt{\\dfrac{y}{x}}\\right)^{3}\\\\[5pt]&{}=- \\frac{10 x^{\\frac{5}{2}}}{y^{\\frac{5}{2}}}\\\\[5pt]&T_{5}=\\binom{5}{4}\\left(\\dfrac{x^2}{y^2}\\right)\\left(-\\sqrt{\\dfrac{y}{x}}\\right)^{4}\\\\[5pt]&{}=5\\\\[5pt]&T_{6}=\\left(-\\sqrt{\\dfrac{y}{x}}\\right)^{5}\\\\[5pt]&{}=- \\frac{y^{\\frac{5}{2}}}{x^{\\frac{5}{2}}}\\end{aligned}\\]",
   "actions": [
