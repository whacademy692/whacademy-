  {
   "id": "s0",
   "title": "Take out 3",
   "text": "\\[\\begin{aligned}&\\left(3+\\dfrac2x\\right)^{-1/3}=3^{-1/3}\\left(1+\\dfrac{2}{3x}\\right)^{-1/3}\\\\[5pt]&u=\\dfrac{2}{3x}\\end{aligned}\\]",
   "actions": [
