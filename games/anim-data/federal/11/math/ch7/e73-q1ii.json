     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Expand (1 + u)^(−1/3)",
   "text": "\\[\\begin{aligned}&1-\\dfrac u3+\\dfrac{2u^2}{9}-\\dfrac{14u^3}{81}+\\dots\\\\[5pt]&\\text{Coefficients: $n$($n$$-$1)/2 = (-1/3)(-4/3)/2}\\\\[5pt]&\\text{= 2/9, and $n$($n$$-$1)($n$$-$2)/6 = $-$14/81.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Put u = 2/(3x)",
   "text": "\\[\\begin{aligned}&-\\dfrac u3=-\\dfrac{2}{9x}\\\\[5pt]&\\dfrac{2u^2}{9}=\\dfrac{8}{81x^2}\\\\[5pt]&-\\dfrac{14u^3}{81}=-\\dfrac{112}{2187x^3}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{3^{-1/3}\\left[1-\\dfrac{2}{9x}+\\dfrac{8}{81x^2}-\\dfrac{112}{2187x^3}+\\dots\\right]}}\\end{aligned}\\]",
   "actions": [
