 "steps": [
  {
   "id": "s0",
   "title": "Reading of the question",
   "text": "\\[\\begin{aligned}&\\text{A fraction is always rational, so the}\\\\[5pt]&\\text{useful statement is: 15 divides $f(n)$ =}\\\\[5pt]&\\text{$3n^{5}$ + $5n^{3}$ + 7n.}\\\\[5pt]&n=1:\\ f(1)=3+5+7=15\\ \\ \\Rightarrow\\ \\ P(1)\\ \\text{true}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Assume P(k)",
   "text": "\\[\\begin{aligned}&f(k)=3k^5+5k^3+7k=15m\\ \\text{ for an integer } m\\qquad(1)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find f(k+1) − f(k)",
   "text": "\\[\\begin{aligned}&f(k+1)-f(k)=3\\left[(k+1)^5-k^5\\right]+5\\left[(k+1)^3-k^3\\right]+7\\\\[5pt]&{}=15k^4+30k^3+45k^2+30k+15\\\\[5pt]&{}=15\\,(k^2+k+1)^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclude",
   "text": "\\[\\begin{aligned}&f(k+1)=15m+15(k^2+k+1)^2=15\\,[\\,m+(k^2+k+1)^2\\,]\\\\[5pt]&\\text{So 15 divides $f(k+1)$: $P(k+1)$ is true.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\text{ is true for all } n\\ge 1}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
