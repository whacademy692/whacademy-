 "steps": [
  {
   "id": "s0",
   "title": "Rewrite the claim",
   "text": "\\[\\begin{aligned}&\\sqrt[n]{n}<2-\\dfrac1n\\ \\iff\\ n<\\left(2-\\dfrac1n\\right)^n\\\\[5pt]&n=2:\\ \\sqrt2=1.414<1.5\\ \\ \\text{true}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Bernoulli's inequality",
   "text": "\\[\\begin{aligned}&\\text{For $h$ $>$ $-$1, $h$ not 0 and $n$ $\\ge$ 2 the}\\\\[5pt]&\\text{inequality of Q27 is strict:}\\\\[5pt]&(1+h)^n>1+nh\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Choose h = 1 − 1/n",
   "text": "\\[\\begin{aligned}&h=1-\\dfrac1n>-1,\\ \\ h\\ne0\\ \\ (n\\ge2)\\\\[5pt]&\\left(2-\\dfrac1n\\right)^n=(1+h)^n>1+n\\left(1-\\dfrac1n\\right)=n\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{Taking the $n$$-$th root of $n$ $<$ $(2 - 1/n)^{n}$}\\\\[5pt]&\\text{gives the result.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\sqrt[n]{n}<2-\\dfrac1n\\ \\text{ for all } n\\ge2}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
