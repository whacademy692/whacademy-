 "steps": [
  {
   "id": "s0",
   "title": "Binomial theorem",
   "text": "\\[\\begin{aligned}&(a+b)^n=\\binom n0a^n+\\binom n1a^{n-1}b+\\dots+\\binom nnb^n\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Put a = b = 1",
   "text": "\\[\\begin{aligned}&2^n=\\binom n0+\\binom n1+\\binom n2+\\dots+\\binom nn\\\\[5pt]&\\text{So the sum of all coefficients is $2^{n}$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Put a = 1, b = −1",
   "text": "\\[\\begin{aligned}&0=\\binom n0-\\binom n1+\\binom n2-\\dots\\\\[5pt]&\\Rightarrow\\ \\text{sum of even-place}=\\text{sum of odd-place}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Odd coefficients",
   "text": "\\[\\begin{aligned}&2\\,(\\text{odd sum})=2^n\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\text{odd sum}=2^{n-1}}}\\\\[5pt]&\\text{The even$-$place sum is also $2^{n-1}$ ($n$ $\\ge$}\\\\[5pt]&\\text{1).}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
