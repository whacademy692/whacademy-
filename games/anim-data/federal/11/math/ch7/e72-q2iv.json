 "steps": [
  {
   "id": "s0",
   "title": "Set up a, b, n",
   "text": "\\[\\begin{aligned}&\\text{Use $(sqrt2)^{2}$ = 2 and $(sqrt3)^{2}$ = 3 to}\\\\[5pt]&\\text{simplify.}\\\\[5pt]&a=a\\sqrt2,\\ \\ b=b\\sqrt3,\\ \\ n=5\\\\[5pt]&T_{r+1}=\\binom{5}{r}\\,a^{5-r}\\,b^{\\,r}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Terms 1 to 3",
   "text": "\\[\\begin{aligned}&T_{1}=\\left(a\\sqrt2\\right)^{5}\\\\[5pt]&{}=4 \\sqrt{2} a^{5}\\\\[5pt]&T_{2}=\\binom{5}{1}\\left(a\\sqrt2\\right)^{4}\\left(b\\sqrt3\\right)\\\\[5pt]&{}=20 \\sqrt{3} a^{4} b\\\\[5pt]&T_{3}=\\binom{5}{2}\\left(a\\sqrt2\\right)^{3}\\left(b\\sqrt3\\right)^{2}\\\\[5pt]&{}=60 \\sqrt{2} a^{3} b^{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Terms 4 to 6",
   "text": "\\[\\begin{aligned}&T_{4}=\\binom{5}{3}\\left(a\\sqrt2\\right)^{2}\\left(b\\sqrt3\\right)^{3}\\\\[5pt]&{}=60 \\sqrt{3} a^{2} b^{3}\\\\[5pt]&T_{5}=\\binom{5}{4}\\left(a\\sqrt2\\right)\\left(b\\sqrt3\\right)^{4}\\\\[5pt]&{}=45 \\sqrt{2} a b^{4}\\\\[5pt]&T_{6}=\\left(b\\sqrt3\\right)^{5}\\\\[5pt]&{}=9 \\sqrt{3} b^{5}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
