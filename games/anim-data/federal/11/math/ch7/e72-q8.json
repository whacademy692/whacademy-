  {
   "id": "s0",
   "title": "Position from the beginning",
   "text": "\\[\\begin{aligned}&\\text{There are $n$ + 1 terms. The $r$$-$th term}\\\\[5pt]&\\text{from the end is the ($n$ + 2 $-$ $r$)th term}\\\\[5pt]&\\text{from the start.}\\\\[5pt]&n+2-r=(n+1-r)+1\\ \\Rightarrow\\ \\text{index }k=n+1-r\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use T(k+1)",
   "text": "\\[\\begin{aligned}&T_{k+1}=\\binom nk\\,a^{n-k}b^k\\\\[5pt]&{}=\\binom{n}{n+1-r}\\,a^{r-1}\\,b^{\\,n+1-r}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Use C(n,k) = C(n,n−k)",
   "text": "\\[\\begin{aligned}&\\binom{n}{n+1-r}=\\binom{n}{r-1}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\binom{n}{r-1}\\,a^{r-1}\\,b^{\\,n-r+1}}}\\\\[5pt]&\\text{Check $n$ = 5, $r$ = 3: 10 $a^{2}$ $b^{3}$, the 3rd}\\\\[5pt]&\\text{term from the end of $(a+b)^{5}$.}\\end{aligned}\\]",
   "actions": [
