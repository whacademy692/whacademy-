  {
   "id": "s0",
   "title": "Multiply two expansions",
   "text": "\\[\\begin{aligned}&(1+x)^n(1+x)^n=(1+x)^{2n}\\\\[5pt]&\\text{Compare the coefficient of $x^{n}$ on both}\\\\[5pt]&\\text{sides.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Coefficient on the right",
   "text": "\\[\\begin{aligned}&\\text{RHS:}\\ \\binom{2n}{n}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Coefficient on the left",
   "text": "\\[\\begin{aligned}&\\left[\\binom n0+\\binom n1x+\\dots\\right]\\left[\\binom n0+\\binom n1x+\\dots\\right]\\\\[5pt]&x^n:\\ \\binom n0\\binom nn+\\binom n1\\binom n{n-1}+\\dots+\\binom nn\\binom n0\\\\[5pt]&\\text{Use $C(n,k)$ = $C(n,n-k)$ to turn every}\\\\[5pt]&\\text{product into a square.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\sum_{r=0}^{n}\\binom nr^2=\\textcolor{#047857}{\\mathbf{\\binom{2n}{n}}}\\ \\blacksquare\\end{aligned}\\]",
