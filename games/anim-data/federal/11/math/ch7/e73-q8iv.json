 "steps": [
  {
   "id": "s0",
   "title": "Take out the factor 3",
   "text": "\\[\\begin{aligned}&3\\left[1-\\dfrac1{18}-\\dfrac{1}{2!\\,18^2}-\\dfrac{3}{3!\\,18^3}-\\dots\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Compare with the binomial series",
   "text": "\\[\\begin{aligned}&nu=-\\dfrac1{18}\\qquad(a)\\\\[5pt]&n(n-1)u^2=-\\dfrac{1}{18^2}\\qquad(b)\\\\[5pt]&\\dfrac{(b)}{(a)^2}:\\ \\dfrac{n-1}{n}=-1\\ \\Rightarrow\\ \\textcolor{#047857}{\\mathbf{n=\\dfrac12}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find u",
   "text": "\\[\\begin{aligned}&u=\\dfrac{-1/18}{1/2}=\\textcolor{#047857}{\\mathbf{-\\dfrac19}}\\\\[5pt]&\\text{Check the 4th term: $n$($n$$-$1)($n$$-$2)$u^{3}$ =}\\\\[5pt]&\\text{-3/5832 = $-$3/$18^{3}$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Sum",
   "text": "\\[\\begin{aligned}&3\\left(1-\\dfrac19\\right)^{1/2}=3\\sqrt{\\dfrac89}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{=2\\sqrt2\\approx2.8284}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
