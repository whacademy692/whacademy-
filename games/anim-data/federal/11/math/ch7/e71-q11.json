 "steps": [
  {
   "id": "s0",
   "title": "Check P(0)",
   "text": "\\[\\begin{aligned}&P(n):\\ 1^3+3^3+\\dots+(2n+1)^3=(n+1)^2(2n^2+4n+1)\\\\[5pt]&n=0:\\ \\text{LHS}=1,\\ \\ \\text{RHS}=1^2\\cdot1=1\\\\[5pt]&\\text{So $P(0)$ is true.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Assume P(k)",
   "text": "\\[\\begin{aligned}&\\text{Assume P(k) is true for some } k\\ge 0:\\\\[5pt]&1^3+\\dots+(2k+1)^3=(k+1)^2(2k^2+4k+1)\\qquad(1)\\\\[5pt]&\\text{Aim: P(k+1)}:\\ \\dots+(2k+3)^3=(k+2)^2(2k^2+8k+7)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add the next term",
   "text": "\\[\\begin{aligned}&\\text{Add $(2k+3)^{3}$ to both sides of (1):}\\\\[5pt]&\\text{LHS}=(k+1)^2(2k^2+4k+1)+(2k+3)^3\\\\[5pt]&{}=(2k^4+8k^3+11k^2+6k+1)+(8k^3+36k^2+54k+27)\\\\[5pt]&{}=2k^4+16k^3+47k^2+60k+28\\\\[5pt]&\\text{Now expand the target}\\\\[5pt]&\\text{$(k+2)^{2}$($2k^{2}$+8k+7):}\\\\[5pt]&(k^2+4k+4)(2k^2+8k+7)=2k^4+16k^3+47k^2+60k+28\\\\[5pt]&\\text{Both are equal.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{$P(0)$ is true and $P(k)$ implies $P(k+1)$.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\text{ is true for all } n\\ge 0}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
