 "steps": [
  {
   "id": "s0",
   "title": "Put p = q(1 + h)",
   "text": "\\[\\begin{aligned}&h=\\dfrac{p-q}{q}\\ \\text{is very small}\\\\[5pt]&\\dfrac{q+2p}{p+2q}=\\dfrac{3+2h}{3+h}=\\left(1+\\dfrac{2h}3\\right)\\left(1+\\dfrac h3\\right)^{-1}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Expand, neglect h²",
   "text": "\\[\\begin{aligned}&\\approx\\left(1+\\dfrac{2h}{3}\\right)\\left(1-\\dfrac h3\\right)\\approx1+\\dfrac h3\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "The other side",
   "text": "\\[\\begin{aligned}&\\left(\\dfrac pq\\right)^{1/3}=(1+h)^{1/3}\\approx1+\\dfrac h3\\\\[5pt]&\\text{Both sides are 1 + $h$/3, so they are}\\\\[5pt]&\\text{approximately equal.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Hence (2.01/2)^(1/3)",
   "text": "\\[\\begin{aligned}&p=2.01,\\ \\ q=2\\\\[5pt]&\\left(\\dfrac{2.01}{2}\\right)^{1/3}\\approx\\dfrac{2+4.02}{2.01+4}=\\dfrac{6.02}{6.01}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\approx1.0017}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
