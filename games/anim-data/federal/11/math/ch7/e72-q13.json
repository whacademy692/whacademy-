  {
   "id": "s0",
   "title": "Name the coefficients",
   "text": "\\[\\begin{aligned}&\\binom n{k-1}:\\binom nk:\\binom n{k+1}=6:33:110\\\\[5pt]&\\dfrac{\\binom nk}{\\binom n{k-1}}=\\dfrac{n-k+1}{k}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Two ratio equations",
   "text": "\\[\\begin{aligned}&\\dfrac{n-k+1}{k}=\\dfrac{33}{6}=\\dfrac{11}{2}\\ \\Rightarrow\\ 2n+2=13k\\\\[5pt]&\\dfrac{n-k}{k+1}=\\dfrac{110}{33}=\\dfrac{10}{3}\\ \\Rightarrow\\ 3n=13k+10\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
