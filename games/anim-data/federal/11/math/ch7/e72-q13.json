   "title": "Solve",
   "text": "\\[\\begin{aligned}&3n=(2n+2)+10\\\\[5pt]&\\textcolor{#047857}{\\mathbf{n=12}},\\ \\ k=2\\end{aligned}\\]",
   "actions": [
