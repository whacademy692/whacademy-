 "steps": [
  {
   "id": "s0",
   "title": "Write as a product",
   "text": "\\[\\begin{aligned}&\\dfrac{3+x}{3-x}=\\dfrac{3(1+x/3)}{3(1-x/3)}=\\left(1+\\dfrac x3\\right)\\left(1-\\dfrac x3\\right)^{-1}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Expand the second factor",
   "text": "\\[\\begin{aligned}&\\left(1-\\dfrac x3\\right)^{-1}=1+\\dfrac x3+\\dfrac{x^2}{9}+\\dfrac{x^3}{27}+\\dots\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Multiply by (1 + x/3)",
   "text": "\\[\\begin{aligned}&1+\\dfrac x3+\\dfrac{x^2}{9}+\\dfrac{x^3}{27}\\\\[5pt]&\\ \\ \\ \\ \\ +\\dfrac x3+\\dfrac{x^2}{9}+\\dfrac{x^3}{27}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{=1+\\dfrac{2x}{3}+\\dfrac{2x^2}{9}+\\dfrac{2x^3}{27}+\\dots}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Range of validity",
