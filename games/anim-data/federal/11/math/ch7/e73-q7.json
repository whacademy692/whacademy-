 "steps": [
  {
   "id": "s0",
   "title": "Numerator and series",
   "text": "\\[\\begin{aligned}&(2+x)^2=4+4x+x^2\\\\[5pt]&(1+x)^{-3}=1-3x+6x^2-10x^3+\\dots\\\\[5pt]&\\text{general term: }(-1)^r\\dfrac{(r+1)(r+2)}{2}\\,x^r\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Collect x^n",
   "text": "\\[\\begin{aligned}&4\\cdot\\left[x^n\\right]:\\ \\ 4(-1)^n\\dfrac{(n+1)(n+2)}{2}\\\\[5pt]&4x\\cdot\\left[x^{n-1}\\right]:\\ \\ 4(-1)^{n-1}\\dfrac{n(n+1)}{2}\\\\[5pt]&x^2\\cdot\\left[x^{n-2}\\right]:\\ \\ (-1)^{n-2}\\dfrac{(n-1)n}{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add",
   "text": "\\[\\begin{aligned}&\\dfrac{(-1)^n}{2}\\left[4(n+1)(n+2)-4n(n+1)+n(n-1)\\right]\\\\[5pt]&{}=\\dfrac{(-1)^n}{2}\\left[8(n+1)+n^2-n\\right]=\\dfrac{(-1)^n}{2}\\left[n^2+7n+8\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{(-1)^n\\,\\dfrac{n^2+7n+8}{2}\\,x^n}}\\\\[5pt]&\\text{Check $n$ = 1: -(1+7+8)/2 = $-$8 and 4(-3) +}\\\\[5pt]&\\text{4(1) = $-$8. Valid for |x| $<$ 1.}\\end{aligned}\\]",
