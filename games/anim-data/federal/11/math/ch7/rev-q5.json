  {
   "id": "s0",
   "title": "Set up",
   "text": "\\[\\begin{aligned}&\\alpha=\\beta(1+h),\\ \\ h=\\dfrac{\\alpha-\\beta}{\\beta}\\ \\text{very small}\\\\[5pt]&\\text{Neglect $h^{2}$ and higher powers.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Left side",
   "text": "\\[\\begin{aligned}&\\left(\\dfrac{3\\beta}{5\\alpha-2\\beta}\\right)^{-1/3}=\\left(\\dfrac{5\\alpha-2\\beta}{3\\beta}\\right)^{1/3}\\\\[5pt]&5\\alpha-2\\beta=3\\beta\\left(1+\\dfrac{5h}{3}\\right)\\\\[5pt]&\\text{LHS}=\\left(1+\\dfrac{5h}3\\right)^{1/3}\\approx1+\\dfrac{5h}{9}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "First term on the right",
   "text": "\\[\\begin{aligned}&\\dfrac{\\alpha}{\\alpha+2\\beta}=\\dfrac{1+h}{3+h}=\\dfrac13(1+h)\\left(1+\\dfrac h3\\right)^{-1}\\\\[5pt]&\\approx\\dfrac13\\left(1+h-\\dfrac h3\\right)=\\dfrac13+\\dfrac{2h}{9}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Second term on the right",
   "text": "\\[\\begin{aligned}&\\dfrac{\\alpha+\\beta}{3\\beta}=\\dfrac{2+h}{3}=\\dfrac23+\\dfrac h3\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Add",
   "text": "\\[\\begin{aligned}&\\text{RHS}\\approx\\dfrac13+\\dfrac{2h}9+\\dfrac23+\\dfrac h3\\\\[5pt]&\\textcolor{#047857}{\\mathbf{=1+\\dfrac{5h}{9}\\approx\\text{LHS}}}\\ \\blacksquare\\\\[5pt]&\\text{Check: beta = 1, alpha = 1.01 gives}\\\\[5pt]&\\text{1.005525 on the left and 1.005548 on the}\\\\[5pt]&\\text{right.}\\end{aligned}\\]",
