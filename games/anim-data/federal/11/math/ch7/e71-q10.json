 "steps": [
  {
   "id": "s0",
   "title": "Check P(1)",
   "text": "\\[\\begin{aligned}&P(n):\\ 7+77+777+\\dots\\,(n\\text{ terms})=\\dfrac{7}{81}\\left(10^{n+1}-9n-10\\right)\\\\[5pt]&n=1:\\ \\text{LHS}=7,\\ \\ \\text{RHS}=\\dfrac{7}{81}(100-9-10)=7\\\\[5pt]&\\text{So $P(1)$ is true.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Assume P(k)",
   "text": "\\[\\begin{aligned}&\\text{Assume P(k) is true for some } k\\ge 1:\\\\[5pt]&\\text{sum of }k\\text{ terms}=\\dfrac{7}{81}\\left(10^{k+1}-9k-10\\right)\\qquad(1)\\\\[5pt]&\\text{Aim: P(k+1)}:\\ \\text{sum of }k+1\\text{ terms}=\\dfrac{7}{81}\\left(10^{k+2}-9k-19\\right)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add the next term",
   "text": "\\[\\begin{aligned}&\\text{The ($k$+1)th term is 7($10^{k+1}$ $-$ 1)/9.}\\\\[5pt]&\\text{Add it to (1):}\\\\[5pt]&\\text{LHS}=\\dfrac{7}{81}(10^{k+1}-9k-10)+\\dfrac{7}{9}(10^{k+1}-1)\\\\[5pt]&{}=\\dfrac{7}{81}\\,[\\,10^{k+1}-9k-10+9\\cdot10^{k+1}-9\\,]\\\\[5pt]&{}=\\dfrac{7}{81}\\,[\\,10\\cdot10^{k+1}-9k-19\\,]\\\\[5pt]&{}=\\dfrac{7}{81}\\left(10^{k+2}-9(k+1)-10\\right)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{$P(1)$ is true and $P(k)$ implies $P(k+1)$.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\text{ is true for all } n\\ge 1}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
