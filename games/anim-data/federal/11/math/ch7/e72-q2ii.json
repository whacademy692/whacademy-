 "steps": [
  {
   "id": "s0",
   "title": "Set up a, b, n",
   "text": "\\[\\begin{aligned}&\\text{$n$ = 6 is even, so $(-x + 1/y)^{6}$ = (x -}\\\\[5pt]&\\text{1/y)\\^{}6.}\\\\[5pt]&a=x,\\ \\ b=-\\dfrac{1}{y},\\ \\ n=6\\\\[5pt]&T_{r+1}=\\binom{6}{r}\\,a^{6-r}\\,b^{\\,r}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Terms 1 to 3",
   "text": "\\[\\begin{aligned}&T_{1}=\\left(x\\right)^{6}\\\\[5pt]&{}=x^{6}\\\\[5pt]&T_{2}=\\binom{6}{1}\\left(x\\right)^{5}\\left(-\\dfrac{1}{y}\\right)\\\\[5pt]&{}=- \\frac{6 x^{5}}{y}\\\\[5pt]&T_{3}=\\binom{6}{2}\\left(x\\right)^{4}\\left(-\\dfrac{1}{y}\\right)^{2}\\\\[5pt]&{}=\\frac{15 x^{4}}{y^{2}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Terms 4 to 6",
   "text": "\\[\\begin{aligned}&T_{4}=\\binom{6}{3}\\left(x\\right)^{3}\\left(-\\dfrac{1}{y}\\right)^{3}\\\\[5pt]&{}=- \\frac{20 x^{3}}{y^{3}}\\\\[5pt]&T_{5}=\\binom{6}{4}\\left(x\\right)^{2}\\left(-\\dfrac{1}{y}\\right)^{4}\\\\[5pt]&{}=\\frac{15 x^{2}}{y^{4}}\\\\[5pt]&T_{6}=\\binom{6}{5}\\left(x\\right)\\left(-\\dfrac{1}{y}\\right)^{5}\\\\[5pt]&{}=- \\frac{6 x}{y^{5}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Term 7",
   "text": "\\[\\begin{aligned}&T_{7}=\\left(-\\dfrac{1}{y}\\right)^{6}\\\\[5pt]&{}=\\frac{1}{y^{6}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Add the terms",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{x^{6} - \\frac{6 x^{5}}{y} + \\frac{15 x^{4}}{y^{2}}}}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{ {} - \\frac{20 x^{3}}{y^{3}} + \\frac{15 x^{2}}{y^{4}} - \\frac{6 x}{y^{5}}}}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{ {} + \\frac{1}{y^{6}}}}\\end{aligned}\\]",
   "actions": [
