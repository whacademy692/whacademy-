 "steps": [
  {
   "id": "s0",
   "title": "Basis: n = 1",
   "text": "\\[\\begin{aligned}&\\text{LHS}=\\dfrac1{1\\cdot2\\cdot3}=\\dfrac16\\\\[5pt]&\\text{RHS}=\\dfrac{1\\cdot4}{4\\cdot2\\cdot3}=\\dfrac16\\\\[5pt]&\\text{LHS = RHS, so $P(1)$ is true.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Hypothesis: P(m)",
   "text": "\\[\\begin{aligned}&\\sum_{k=1}^{m}\\dfrac{1}{k(k+1)(k+2)}=\\dfrac{m(m+3)}{4(m+1)(m+2)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add the next term",
   "text": "\\[\\begin{aligned}&\\dfrac{m(m+3)}{4(m+1)(m+2)}+\\dfrac1{(m+1)(m+2)(m+3)}\\\\[5pt]&{}=\\dfrac{m(m+3)^2+4}{4(m+1)(m+2)(m+3)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Factor the numerator",
   "text": "\\[\\begin{aligned}&m(m+3)^2+4=m^3+6m^2+9m+4\\\\[5pt]&{}=(m+1)^2(m+4)\\\\[5pt]&\\text{$m$ = $-$1 makes it zero, so ($m$ + 1) is a}\\\\[5pt]&\\text{factor.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Cancel one (m + 1)",
   "text": "\\[\\begin{aligned}&{}=\\dfrac{(m+1)^2(m+4)}{4(m+1)(m+2)(m+3)}\\\\[5pt]&{}=\\dfrac{(m+1)(m+4)}{4(m+2)(m+3)}\\\\[5pt]&\\text{This is exactly the formula with $n$ = $m$ +}\\\\[5pt]&\\text{1.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{$P(1)$ is true and $P(m)$ implies $P(m + 1)$.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\ \\text{holds for all positive integers }n}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
 ],
