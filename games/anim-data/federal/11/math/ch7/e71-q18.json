 "steps": [
  {
   "id": "s0",
   "title": "Check P(1)",
   "text": "\\[\\begin{aligned}&P(n):\\ \\displaystyle\\sum_{r=1}^{n}r\\binom{n}{r}=n\\cdot2^{n-1}\\\\[5pt]&n=1:\\ \\text{LHS}=1\\cdot\\binom11=1,\\ \\ \\text{RHS}=1\\cdot2^0=1\\\\[5pt]&\\text{So $P(1)$ is true.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Assume P(k)",
   "text": "\\[\\begin{aligned}&\\displaystyle\\sum_{r=1}^{k}r\\binom{k}{r}=k\\cdot2^{k-1}\\qquad(1)\\\\[5pt]&\\text{We also use Q17: the sum of $C(k,s)$ is}\\\\[5pt]&\\text{$2^{k}$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Split with Pascal rule",
   "text": "\\[\\begin{aligned}&\\displaystyle\\sum_{r=1}^{k+1}r\\binom{k+1}{r}=\\sum_{r=1}^{k+1}r\\binom{k}{r}+\\sum_{r=1}^{k+1}r\\binom{k}{r-1}\\\\[5pt]&\\text{First sum}=k\\cdot2^{k-1}\\ \\ \\text{(by (1))}\\\\[5pt]&\\text{Second: put } s=r-1:\\ \\sum_{s=0}^{k}(s+1)\\binom{k}{s}\\\\[5pt]&{}=k\\cdot2^{k-1}+2^k\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Add and finish",
   "text": "\\[\\begin{aligned}&\\text{Total}=2k\\cdot2^{k-1}+2^k\\\\[5pt]&{}=k\\cdot2^k+2^k=(k+1)\\,2^k\\\\[5pt]&{}=(k+1)\\,2^{(k+1)-1}\\\\[5pt]&\\text{This is $P(k+1)$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{$P(1)$ is true and $P(k)$ implies $P(k+1)$.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\text{ is true for all } n\\ge 1}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
