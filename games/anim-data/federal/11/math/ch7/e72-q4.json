  {
   "id": "s1",
   "title": "8th term: r = 7",
   "text": "\\[\\begin{aligned}&T_8=\\binom{10}{7}(x^2)^3\\left(\\dfrac y2\\right)^7\\\\[5pt]&{}=120\\cdot x^6\\cdot\\dfrac{y^7}{128}\\end{aligned}\\]",
   "actions": [
