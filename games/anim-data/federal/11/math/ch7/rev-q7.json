 "steps": [
  {
   "id": "s0",
   "title": "Write 6 = 5 + 1",
   "text": "\\[\\begin{aligned}&6^n=(5+1)^n=5^n+C(n,1)5^{n-1}+\\dots+C(n,n-1)5+1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Subtract 5^n",
   "text": "\\[\\begin{aligned}&6^n-5^n=C(n,1)5^{n-1}+C(n,2)5^{n-2}+\\dots+C(n,n-1)5+1\\\\[5pt]&\\text{The first term $5^{n}$ cancels.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Factor out 5",
   "text": "\\[\\begin{aligned}&{}=5\\left[C(n,1)5^{n-2}+\\dots+C(n,n-1)\\right]+1=5q+1\\\\[5pt]&\\text{$q$ is a whole number and 0 $<$ 1 $<$ 5.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{\\text{remainder}=1}}\\ \\blacksquare\\\\[5pt]&\\text{Check $n$ = 3: 216 $-$ 125 = 91 = 5(18) + 1.}\\end{aligned}\\]",
   "actions": [
