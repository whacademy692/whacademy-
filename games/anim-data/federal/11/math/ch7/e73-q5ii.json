 "steps": [
  {
   "id": "s0",
   "title": "Expand (4 + x)⁻²",
   "text": "\\[\\begin{aligned}&(4+x)^{-2}=\\dfrac1{16}\\left(1+\\dfrac x4\\right)^{-2}\\\\[5pt]&(1+u)^{-2}\\approx1-2u+3u^2\\\\[5pt]&\\approx\\dfrac1{16}\\left(1-\\dfrac x2+\\dfrac{3x^2}{16}\\right)=\\dfrac1{16}-\\dfrac x{32}+\\dfrac{3x^2}{256}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Expand (1 − 2x)⁻⁵",
   "text": "\\[\\begin{aligned}&(1+u)^{-5}\\approx1-5u+15u^2,\\ \\ u=-2x\\\\[5pt]&\\approx1+10x+60x^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Numerator and denominator",
   "text": "\\[\\begin{aligned}&\\text{Numerator}\\approx\\dfrac{17}{16}+\\dfrac{319}{32}x+\\dfrac{15363}{256}x^2\\\\[5pt]&(1+2x)^{-2}\\approx1-4x+12x^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Multiply",
   "text": "\\[\\begin{aligned}&x:\\ \\dfrac{319}{32}-4\\cdot\\dfrac{17}{16}=\\dfrac{183}{32}\\\\[5pt]&x^2:\\ \\dfrac{15363}{256}-4\\cdot\\dfrac{319}{32}+12\\cdot\\dfrac{17}{16}=\\dfrac{8419}{256}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\dfrac{17}{16}+\\dfrac{183x}{32}+\\dfrac{8419x^2}{256}}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
