 "steps": [
  {
   "id": "s0",
   "title": "Key identity",
   "text": "\\[\\begin{aligned}&\\dfrac{1}{r+1}\\binom nr=\\dfrac{n!}{(r+1)!\\,(n-r)!}=\\dfrac{1}{n+1}\\binom{n+1}{r+1}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Rewrite the sum",
   "text": "\\[\\begin{aligned}&\\text{LHS}=\\sum_{r=0}^{n}\\dfrac{1}{r+1}\\binom nr=\\dfrac{1}{n+1}\\sum_{r=0}^{n}\\binom{n+1}{r+1}\\\\[5pt]&{}=\\dfrac{1}{n+1}\\left[\\binom{n+1}{1}+\\dots+\\binom{n+1}{n+1}\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Use the sum of coefficients",
   "text": "\\[\\begin{aligned}&\\binom{n+1}{0}+\\binom{n+1}{1}+\\dots+\\binom{n+1}{n+1}=2^{n+1}\\\\[5pt]&\\Rightarrow\\ \\text{bracket}=2^{n+1}-1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Answer",
