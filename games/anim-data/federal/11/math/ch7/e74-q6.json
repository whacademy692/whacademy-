 "steps": [
  {
   "id": "s0",
   "title": "Write 12 = 10 + 2 and 8 = 10 - 2",
   "text": "\\[\\begin{aligned}&12^{15}+8^{15}=(10+2)^{15}+(10-2)^{15}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Add the expansions",
   "text": "\\[\\begin{aligned}&{}=2\\left[10^{15}+C(15,2)10^{13}(2)^2+\\dots+C(15,14)(10)(2)^{14}\\right]\\\\[5pt]&\\text{Odd powers of 2 cancel, even powers}\\\\[5pt]&\\text{double.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Factor out 10",
   "text": "\\[\\begin{aligned}&\\text{Every term in the bracket has 10 to a}\\\\[5pt]&\\text{power of at least 1.}\\\\[5pt]&{}=2\\cdot10\\cdot[\\text{integer}]\\\\[5pt]&\\textcolor{#047857}{\\mathbf{=20\\,[\\text{integer}]}}\\ \\Rightarrow\\ \\text{divisible by }10\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
