 "steps": [
  {
   "id": "s0",
   "title": "Check n = 5",
   "text": "\\[\\begin{aligned}&n=5:\\ \\binom{10}{5}=252,\\ \\ 2^{8}=256\\\\[5pt]&252<256\\ \\Rightarrow\\ P(5)\\text{ true}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Assume P(k)",
   "text": "\\[\\begin{aligned}&\\binom{2k}{k}<2^{2k-2}=4^{k-1}\\qquad(1)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Ratio of consecutive terms",
   "text": "\\[\\begin{aligned}&\\binom{2k+2}{k+1}=\\binom{2k}{k}\\cdot\\dfrac{(2k+2)(2k+1)}{(k+1)^2}\\\\[5pt]&{}=\\binom{2k}{k}\\cdot\\dfrac{2(2k+1)}{k+1}\\\\[5pt]&\\dfrac{2(2k+1)}{k+1}=\\dfrac{4k+2}{k+1}<4\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Finish",
   "text": "\\[\\begin{aligned}&\\binom{2k+2}{k+1}<4\\binom{2k}{k}<4\\cdot4^{k-1}=4^k\\\\[5pt]&{}=2^{2(k+1)-2}\\\\[5pt]&\\text{This is $P(k+1)$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{$P(5)$ is true and $P(k)$ implies $P(k+1)$.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{P(n)\\text{ is true for all } n\\ge 5}}\\ \\blacksquare\\end{aligned}\\]",
