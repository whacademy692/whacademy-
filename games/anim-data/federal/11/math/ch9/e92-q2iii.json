   "tex": "\\role{per}{c}x+\\role{key}{d}=\\dfrac\\pi2+n\\pi",
   "text": "The graph is undefined here: these are the vertical red lines."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\tan(4 x)\\) as a multiple of \\(\\pi\\)?",
   "answer": 0.25,
   "hint": "For tan and cot, \\(T=\\dfrac{\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{\\pi}{4}\\), that is 0.25 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Range",
   "prompt": "What is the **range** of \\(y=b\\tan(cx+d)\\) for any b ≠ 0?",
   "options": [
    {
     "id": "a",
     "label": "[−|b|, |b|]"
    },
    {
     "id": "b",
     "label": "All real numbers"
    },
    {
     "id": "c",
     "label": "(−∞, −|b|] ∪ [|b|, ∞)"
    }
   ],
   "answer": "b",
   "hint": "Look at how the branch climbs without limit.",
   "explain": "Each branch goes from −∞ to +∞, so every real value is reached."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Draw the graph of each function:}\\\\[5pt]&{y=2\\tan2x}\\end{aligned}\\]",
