 "formulas": [
  {
   "title": "The model",
   "tex": "y=\\role{mid}{a}+\\role{mx}{b}\\,\\cos(\\role{per}{c}\\,\\theta+\\role{key}{d})",
   "text": "The same four numbers as for sine. A cosine wave starts at its top (when b > 0)."
  },
  {
   "title": "Highest and lowest",
   "tex": "\\role{mx}{M}=a+|b|\\qquad \\role{mn}{m}=a-|b|",
   "text": "c and d do not matter for the height."
  },
  {
   "title": "Period and shift",
   "tex": "T=\\dfrac{2\\pi}{\\role{per}{c}}\\qquad \\text{shift}=-\\dfrac{\\role{key}{d}}{\\role{per}{c}}",
   "text": "Period depends only on c."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Max of a wave",
   "prompt": "A wave is \\(y=-2+5\\cos\\theta\\). What is its **maximum** value?",
   "answer": 3,
   "hint": "Use \\(M=a+|b|\\).",
   "explain": "\\(M=a+|b|=-2+5=3\\).",
   "tolerance": 0.01
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\cos(2\\theta)\\)? Give your answer as a multiple of \\(\\pi\\) (for example 0.5 means \\(\\tfrac\\pi2\\)).",
   "answer": 1.0,
   "hint": "\\(T=\\dfrac{2\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{2\\pi}{2}\\), which is 1 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Which slider?",
   "prompt": "Which slider makes the wave **twice as tall** without changing its period?",
   "options": [
    {
     "id": "a",
     "label": "Midline a"
    },
    {
     "id": "b",
     "label": "Amplitude b"
    },
    {
     "id": "c",
     "label": "Frequency c"
    },
    {
     "id": "d",
     "label": "Phase d"
    }
   ],
   "answer": "b",
   "hint": "Height of the wave = |b|.",
   "explain": "The amplitude \\(|b|\\) is the height of the wave. Midline a only lifts it; c changes the period; d slides it."
  }
 ],
