 "formulas": [
  {
   "title": "Period of a sum",
   "tex": "T=\\dfrac{\\text{LCM of numerators}}{\\text{HCF of denominators}}",
   "text": "Write each period as a fraction of π. The sum repeats once BOTH parts have completed a whole number of cycles."
  },
  {
   "title": "This exercise",
   "tex": "\\role{cv2}{2\\tan3x}\\ ,\\ \\ \\role{mx}{7\\cos5x}\\ \\Rightarrow\\ \\role{per}{T=2\\pi}",
   "text": "Check it on the graph: the purple lines mark one full period of the sum."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Period of a sum",
   "prompt": "Find the period of \\(\\sin 2x+\\cos 3x\\) as a multiple of \\(\\pi\\).",
   "answer": 2,
   "hint": "Periods: \\(\\pi\\) and \\(\\tfrac{2\\pi}{3}\\). LCM of numerators 1,2 is 2; HCF of denominators 1,3 is 1.",
   "explain": "\\(T=\\dfrac{\\text{LCM}(\\pi,2\\pi)}{\\text{HCF}(1,3)}=2\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  }
 ],
 "steps": [
  {
