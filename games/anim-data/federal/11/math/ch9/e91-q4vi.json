   "text": "\\[\\begin{aligned}&{\\tan3x}\\text{: }{\\dfrac\\pi3}\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Step 2",
   "text": "\\[\\begin{aligned}&{\\cos5x}\\text{: }{\\dfrac{2\\pi}5}\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Max & min",
   "text": "\\[\\begin{aligned}&\\text{LCM of numerators }{\\pi,2\\pi}\\text{ is }{2\\pi}\\text{; HCF of}\\\\[5pt]&\\text{denominators }{3,5}\\text{ is }{1}\\text{.}\\\\[5pt]&\\text{Period}=\\frac{2\\pi}{1}=\\boldsymbol{2\\pi}.\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Check",
   "text": "\\[\\begin{aligned}&\\text{Check: }{2\\pi=6\\cdot\\frac\\pi3}\\text{  and }{2\\pi=5\\cdot\\frac{2\\pi}5}\\\\[5pt]&\\text{.}\\end{aligned}\\]",
