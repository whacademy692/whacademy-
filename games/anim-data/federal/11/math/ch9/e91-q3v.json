 "formulas": [
  {
   "title": "The model",
   "tex": "y=\\role{mid}{a}+\\role{mx}{b}\\,\\tan(\\role{per}{c}\\,x+\\role{key}{d})",
   "text": "Tangent has no highest or lowest value."
  },
  {
   "title": "Period",
   "tex": "T=\\dfrac{\\pi}{\\role{per}{c}}",
   "text": "Tan repeats every π (not 2π)."
  },
  {
   "title": "Asymptotes",
   "tex": "\\role{per}{c}x+\\role{key}{d}=\\dfrac\\pi2+n\\pi",
   "text": "The graph is undefined here: these are the vertical red lines."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\tan(3 x)\\) as a multiple of \\(\\pi\\)?",
   "answer": 0.3333,
   "hint": "For tan and cot, \\(T=\\dfrac{\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{\\pi}{3}\\), that is 0.3333 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Range",
   "prompt": "What is the **range** of \\(y=b\\tan(cx+d)\\) for any b ≠ 0?",
   "options": [
    {
     "id": "a",
     "label": "[−|b|, |b|]"
    },
    {
     "id": "b",
     "label": "All real numbers"
    },
    {
     "id": "c",
     "label": "(−∞, −|b|] ∪ [|b|, ∞)"
    }
   ],
   "answer": "b",
   "hint": "Look at how the branch climbs without limit.",
   "explain": "Each branch goes from −∞ to +∞, so every real value is reached."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Find the domain and range: }{y=4\\tan\\pi x}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "a": 0,
      "b": 4,
      "c": 3.141593,
      "d": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Where it breaks",
   "text": "\\[\\begin{aligned}&{\\tan u}\\text{ is undefined when }{u=(2n+1)\\dfrac\\pi2}\\text{. Here}\\\\[5pt]&{u=\\pi x}\\text{:}\\\\[5pt]&\\pi x=(2n+1)\\frac\\pi2\\ \\Rightarrow\\ x=\\frac{2n+1}2=n+\\frac12.\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showAsy": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Domain",
   "text": "\\[\\begin{aligned}&\\text{Domain }{=\\mathbb R-\\left\\{\\dfrac{2n+1}2:n\\in\\mathbb Z\\right\\}}\\text{ (all}\\\\[5pt]&\\text{reals except half-odd-integers}\\\\[5pt]&{\\pm\\frac12,\\pm\\frac32,\\dots}\\text{).}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Range",
   "text": "\\[\\begin{aligned}&\\text{Range }{=\\mathbb R}\\text{.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showMax": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "takeaways": [
  "**Period = π ÷ c** for tan and cot.",
  "The range is **all real numbers**; the domain excludes the asymptotes.",
  "Tan is increasing in each branch; cot is decreasing."
 ],
 "notes": [
  {
   "title": "Try this",
   "text": "Turn on the key points: every branch passes through three of them (value −b, 0 and +b relative to the midline)."
  }
 ],
