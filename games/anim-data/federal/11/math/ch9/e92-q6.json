 "formulas": [
  {
   "title": "The model",
   "tex": "y=\\role{mid}{a}+\\role{mx}{b}\\,\\sin(\\role{per}{c}\\,\\theta+\\role{key}{d})",
   "text": "a lifts the graph, b stretches it, c squeezes it sideways, d slides it."
  },
  {
   "title": "Highest and lowest",
   "tex": "\\role{mx}{M}=a+|b|\\qquad \\role{mn}{m}=a-|b|",
   "text": "The sign of b only decides whether the wave starts upwards or downwards. The phase d never changes the height."
  },
  {
   "title": "Period and shift",
   "tex": "T=\\dfrac{2\\pi}{\\role{per}{c}}\\qquad \\text{shift}=-\\dfrac{\\role{key}{d}}{\\role{per}{c}}",
   "text": "The period depends only on c."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Max of a wave",
   "prompt": "A wave is \\(y=-2+4\\sin\\theta\\). What is its **maximum** value?",
   "answer": 2,
   "hint": "Use \\(M=a+|b|\\).",
   "explain": "\\(M=a+|b|=-2+4=2\\).",
   "tolerance": 0.01
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\sin(2\\theta)\\)? Give your answer as a multiple of \\(\\pi\\) (for example 0.5 means \\(\\tfrac\\pi2\\)).",
   "answer": 1.0,
   "hint": "\\(T=\\dfrac{2\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{2\\pi}{2}\\), which is 1 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Which slider?",
   "prompt": "Which slider makes the wave **twice as tall** without changing its period?",
   "options": [
    {
     "id": "a",
     "label": "Midline a"
    },
    {
     "id": "b",
     "label": "Amplitude b"
    },
    {
     "id": "c",
     "label": "Frequency c"
    },
    {
     "id": "d",
     "label": "Phase d"
    }
   ],
   "answer": "b",
   "hint": "Height of the wave = |b|.",
   "explain": "The amplitude \\(|b|\\) is the height of the wave. Midline a only lifts it; c changes the period; d slides it."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{AC voltage: 180 V maximum, frequency}\\\\[5pt]&\\text{56 Hz}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "a": 0,
      "b": 180,
      "c": 351.858377,
      "d": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Period",
   "text": "\\[\\begin{aligned}&\\text{Model }{V(t)=a\\sin[k(t-d)]+c}\\text{. Find: (a) period}\\\\[5pt]&\\text{(b) }{k}\\text{ (c) amplitude (d) the model.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Period (2)",
   "text": "\\[\\begin{aligned}&\\text{(a) 56 cycles per second $\\Rightarrow$ period}\\\\[5pt]&{T=\\dfrac1{56}}\\text{ s }{\\approx0.0179}\\text{ s.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Step 3",
   "text": "\\[\\begin{aligned}&\\text{(b) (degree mode, as in Example 11)}\\\\[5pt]&{k=\\dfrac{360^\\circ}{T}=360\\times56=\\mathbf{20\\,160}}\\text{.}\\\\[5pt]&\\text{(Radian form: }{k=2\\pi\\times56=112\\pi\\approx351.9}\\\\[5pt]&\\text{rad/s.)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Amplitude & midline",
   "text": "\\[\\begin{aligned}&\\text{(c) The voltage swings between }{-180}\\text{ V}\\\\[5pt]&\\text{and }{+180}\\text{ V $\\Rightarrow$ amplitude}\\\\[5pt]&{=\\dfrac{180-(-180)}2=\\mathbf{180}}\\text{ V.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Amplitude & midline (2)",
   "text": "\\[\\begin{aligned}&\\text{(d) Midline }{c=0}\\text{, no shift }{d=0}\\text{ (starts}\\\\[5pt]&\\text{at 0 going up):}\\\\[5pt]&\\boxed{V(t)=180\\sin(20\\,160\\,t)}\\qquad(\\text{degree mode})\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showMid": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Step 6",
   "text": "\\[\\begin{aligned}&\\text{equivalently }{V(t)=180\\sin(112\\pi t)}\\text{ in radian}\\\\[5pt]&\\text{mode.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  },
  {
