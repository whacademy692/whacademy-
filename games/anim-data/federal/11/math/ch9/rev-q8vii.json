 "formulas": [
  {
   "title": "The model",
   "tex": "y=\\role{mid}{a}+\\role{mx}{b}\\,\\cot(\\role{per}{c}\\,x+\\role{key}{d})",
   "text": "Cotangent has no highest or lowest value."
  },
  {
   "title": "Period",
   "tex": "T=\\dfrac{\\pi}{\\role{per}{c}}",
   "text": "Cot repeats every π (not 2π)."
  },
  {
   "title": "Asymptotes",
   "tex": "\\role{per}{c}x+\\role{key}{d}=n\\pi",
   "text": "Cot is undefined at multiples of π (the red lines)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\cot(4 x)\\) as a multiple of \\(\\pi\\)?",
   "answer": 0.25,
   "hint": "For tan and cot, \\(T=\\dfrac{\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{\\pi}{4}\\), that is 0.25 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Range",
   "prompt": "What is the **range** of \\(y=b\\tan(cx+d)\\) for any b ≠ 0?",
   "options": [
    {
     "id": "a",
     "label": "[−|b|, |b|]"
    },
    {
     "id": "b",
     "label": "All real numbers"
    },
    {
     "id": "c",
     "label": "(−∞, −|b|] ∪ [|b|, ∞)"
    }
   ],
   "answer": "b",
   "hint": "Look at how the branch climbs without limit.",
   "explain": "Each branch goes from −∞ to +∞, so every real value is reached."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Find the domain, range and period:}\\\\[5pt]&{y=\\dfrac32\\cot\\dfrac{2\\pi x}3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "a": 0,
      "b": 1.5,
      "c": 2.094395,
      "d": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Domain",
   "text": "\\[\\begin{aligned}&{\\cot u}\\text{ is undefined at }{u=n\\pi}\\text{, so Domain}\\\\[5pt]&{=x\\ne\\dfrac{3n}2}\\text{.}\\\\[5pt]&\\text{cot u is undefined when u = n$\\pi$:}\\\\[5pt]&{\\dfrac{2\\pi x}3=n\\pi\\Rightarrow x=\\dfrac{3n}2}\\text{. Cot takes}\\\\[5pt]&\\text{every real value.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showAsy": 1,
      "showPer": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Range",
   "text": "\\[\\begin{aligned}&\\text{Cot takes every real value: Range}\\\\[5pt]&{=\\mathbb R}\\text{.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showMax": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Period",
   "text": "\\[\\begin{aligned}&T=\\dfrac{\\pi}{2\\pi/3}=\\dfrac32\\\\[5pt]&\\textcolor{#047857}{\\text{ Period }{=\\dfrac32}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "takeaways": [
  "**Period = π ÷ c.**",
  "Cot is **undefined where sin = 0**, that is where cx + d = nπ.",
  "The range is all real numbers."
 ],
 "notes": [
  {
   "title": "Try this",
   "text": "Compare with tan: cot is the mirror image, falling from left to right in each branch."
  }
 ],
