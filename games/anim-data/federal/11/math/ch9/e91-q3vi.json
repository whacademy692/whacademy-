 "formulas": [
  {
   "title": "The model",
   "tex": "y=\\role{mid}{a}+\\role{mx}{b}\\,\\csc(\\role{per}{c}\\,x+\\role{key}{d})",
   "text": "Csc is 1 ÷ sin."
  },
  {
   "title": "Period",
   "tex": "T=\\dfrac{2\\pi}{\\role{per}{c}}",
   "text": "Same period as sine."
  },
  {
   "title": "Range",
   "tex": "|y-a|\\ \\ge\\ |b|",
   "text": "The branches stay outside the band between a − |b| and a + |b|."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Range",
   "prompt": "For \\(y=3\\csc x\\), which values of y are **impossible**?",
   "options": [
    {
     "id": "a",
     "label": "y between −3 and 3"
    },
    {
     "id": "b",
     "label": "y above 3"
    },
    {
     "id": "c",
     "label": "y below −3"
    }
   ],
   "answer": "a",
   "hint": "|sec| and |csc| are at least 1.",
   "explain": "Since \\(|\\sec x|\\ge 1\\) (and likewise csc), \\(|y|\\ge3\\). The graph never enters the band between −3 and 3."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Find the domain and range: }{y=\\csc4x}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "a": 0,
      "b": 1,
      "c": 4,
      "d": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Where it breaks",
   "text": "\\[\\begin{aligned}&{\\csc u}\\text{ is undefined when }{u=n\\pi}\\text{; }{u=4x}\\text{:}\\\\[5pt]&4x=n\\pi\\Rightarrow x=\\frac{n\\pi}4.\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showAsy": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Domain",
   "text": "\\[\\begin{aligned}&\\text{Domain }{=\\mathbb R-\\left\\{\\dfrac{n\\pi}4:n\\in\\mathbb Z\\right\\}}\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Range",
   "text": "\\[\\begin{aligned}&{|\\csc u|\\ge1}\\text{ $\\Rightarrow$ Range }{=(-\\infty,-1]\\cup[1,\\infty)}\\text{.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showMax": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Short trick",
   "text": "\\[\\begin{aligned}&\\text{ For }{\\tan(kx)}\\text{: }{x\\ne\\frac{(2n+1)\\pi}{2k}}\\text{ — with }{k=\\pi}\\\\[5pt]&\\text{the }{\\pi}\\text{'s cancel: }{\\frac{(2n+1)}{2}}\\text{.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Short trick (2)",
   "text": "\\[\\begin{aligned}&\\text{ For }{\\cot(kx),\\csc(kx)}\\text{: }{x\\ne\\frac{n\\pi}k}\\text{ — with }{k=\\frac\\pi2}\\\\[5pt]&\\text{gives }{\\frac{n\\pi}{\\pi/2}=2n}\\text{.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "takeaways": [
  "**Period = 2π ÷ c.**",
  "|csc| ≥ 1, so the range is **(−∞, −|b|] ∪ [|b|, ∞)** when a = 0.",
  "Csc is undefined wherever sin = 0 (the red lines)."
 ],
 "notes": [
  {
   "title": "Try this",
   "text": "Compare with sin: every peak of sin becomes the bottom of an upward branch of csc."
  }
 ],
