   "explain": "An identity holds for every angle where both sides are defined. One angle where the sides differ is enough to show the statement is not an identity."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Express }{2\\sin3x\\sin7x}\\text{ as a sum or}\\\\[5pt]&\\text{difference}\\\\[5pt]&\\text{(a) }{\\cos4x-\\cos10x}\\text{ (b) }{\\cos10x-\\cos4x}\\text{ (c)}\\\\[5pt]&{\\cos4x+\\cos10x}\\text{ (d) }{\\cos10x+\\cos4x}\\end{aligned}\\]",
   "actions": [
    {
     "set": {},
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Step 2",
   "text": "\\[\\begin{aligned}&{2\\sin A\\sin B=\\cos(A-B)-\\cos(A+B)}\\text{ with }{A=3x,\\ B=7x}\\text{:}\\\\[5pt]&{\\cos(-4x)-\\cos10x=\\cos4x-\\cos10x}\\text{ (cos is even).}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ (a) }{\\cos4x-\\cos10x}\\text{.}}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "takeaways": [
