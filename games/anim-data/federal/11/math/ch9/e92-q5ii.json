  },
  {
   "id": "s1",
   "title": "Max & min",
   "text": "\\[\\begin{aligned}&\\text{Draw }{y=\\cos x}\\text{ (wave) and the line }{y=x}\\\\[5pt]&\\text{(through the origin, slope 1). For}\\\\[5pt]&{x>1}\\text{ the line is above the cosine's}\\\\[5pt]&\\text{maximum }{1}\\text{; for }{x\\le0}\\text{ the cosine is}\\\\[5pt]&\\text{above the line (for }{-1\\le x\\le0}\\text{, }{\\cos x>0\\ge x}\\\\[5pt]&\\text{; for }{x<-1}\\text{, }{x<-1\\le\\cos x}\\text{), so they cannot}\\\\[5pt]&\\text{meet there. The curves cross exactly}\\\\[5pt]&\\text{once, between }{0}\\text{ and }{1}\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ }{x\\approx0.739}\\text{ (more precisely }{0.7391}\\text{, with}}\\\\[5pt]&\\textcolor{#047857}{{y\\approx0.7391}\\text{ too). Radian mode!}}\\\\[5pt]&\\text{Calculator check: press }{\\cos}\\\\[5pt]&\\text{repeatedly starting from 1:}\\\\[5pt]&{0.5403,\\ 0.8576,\\ 0.6543,\\dots\\to0.7391}\\text{.}\\end{aligned}\\]",
