  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ }{x=0}\\text{ and further roots}}\\\\[5pt]&\\textcolor{#047857}{{x\\approx\\pm4.493,\\ \\pm7.725,\\ \\pm10.904,\\dots}\\text{ (one in}}\\\\[5pt]&\\textcolor{#047857}{\\text{each interval }{\\left(n\\pi,\\ n\\pi+\\frac\\pi2\\right)}\\text{, }{n\\ge1}\\text{, and}}\\\\[5pt]&\\textcolor{#047857}{\\text{the negatives). In the first branch}}\\\\[5pt]&\\textcolor{#047857}{{\\left(0,\\frac\\pi2\\right)}\\text{ the tangent is always above the}}\\\\[5pt]&\\textcolor{#047857}{\\text{line, so there is no root there}}\\\\[5pt]&\\textcolor{#047857}{\\text{other than }{0}\\text{.}}\\end{aligned}\\]",
   "actions": []
  }
