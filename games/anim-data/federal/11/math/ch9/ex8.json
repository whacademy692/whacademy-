 "formulas": [
  {
   "title": "Even function",
   "tex": "\\role{cv2}{f(-x)} = \\role{cv}{f(x)}",
   "text": "The graph is a mirror image about the y-axis. f(x) − f(−x) is always 0."
  },
  {
   "title": "Odd function",
   "tex": "\\role{cv2}{f(-x)} = -\\role{cv}{f(x)}",
   "text": "The graph is unchanged by a half-turn about the origin. f(x) + f(−x) is always 0."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Odd or even?",
   "prompt": "Which of these is an **odd** function?",
   "options": [
    {
     "id": "a",
     "label": "\\(x^2\\cos x\\)"
    },
    {
     "id": "b",
     "label": "\\(x\\sin x\\)"
    },
    {
     "id": "c",
     "label": "\\(x\\cos x\\)"
    }
   ],
   "answer": "c",
   "hint": "Odd × even = odd.",
   "explain": "x is odd and cos x is even, so \\(x\\cos x\\) is odd. The other two are even (x² and cos are even; x and sin are both odd, so x sin x is even)."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "The symmetry",
   "prompt": "What symmetry has the graph of an **even** function?",
   "options": [
    {
     "id": "a",
     "label": "Mirror image in the y-axis"
    },
    {
     "id": "b",
     "label": "Half-turn about the origin"
    },
    {
     "id": "c",
     "label": "Mirror image in the x-axis"
    }
   ],
   "answer": "a",
   "hint": "Even: f(−x) = f(x).",
   "explain": "f(−x) = f(x) means the point at −x is level with the point at x: a mirror image in the y-axis."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&f(x)=x^3\\sin x\\end{aligned}\\]",
   "actions": [
    {
     "set": {},
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Test",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{f(-x)=(-x)^3\\sin(-x)=(-x^3)(-\\sin x)}\\\\[5pt]&\\textcolor{#047857}{{}=x^3\\sin x=f(x)}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{Even: the graph is a mirror image in}\\\\[5pt]&\\text{the y-axis.}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "takeaways": [
  "**Even:** f(−x) = f(x). The graph is a mirror image about the y-axis.",
  "**Odd:** f(−x) = −f(x). Turning the graph half a turn about the origin leaves it unchanged.",
  "Even × even = even, odd × odd = even, even × odd = odd."
 ],
