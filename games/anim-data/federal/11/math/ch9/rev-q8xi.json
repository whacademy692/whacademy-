   "hint": "Use \\(M=a+|b|\\).",
   "explain": "\\(M=a+|b|=3+6=9\\).",
   "tolerance": 0.01
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\cos(5\\theta)\\)? Give your answer as a multiple of \\(\\pi\\) (for example 0.5 means \\(\\tfrac\\pi2\\)).",
   "answer": 0.4,
   "hint": "\\(T=\\dfrac{2\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{2\\pi}{5}\\), which is 0.4 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
