 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&{\\dfrac{\\sin\\alpha+\\sin2\\alpha}{1+\\cos\\alpha+\\cos2\\alpha}=}\\text{ ?}\\\\[5pt]&\\text{(a) }{\\sin\\alpha}\\text{ (b) }{\\cos\\alpha}\\text{ (c) }{\\tan\\alpha}\\text{ (d)}\\\\[5pt]&{\\cot\\alpha}\\end{aligned}\\]",
   "actions": [
    {
     "set": {},
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Max & min",
   "text": "\\[\\begin{aligned}&\\text{Numerator:}\\\\[5pt]&{\\sin\\alpha+2\\sin\\alpha\\cos\\alpha=\\sin\\alpha(1+2\\cos\\alpha)}\\text{.}\\\\[5pt]&\\text{Denominator:}\\\\[5pt]&{1+\\cos\\alpha+(2\\cos^2\\alpha-1)=\\cos\\alpha+2\\cos^2\\alpha=\\cos\\alpha(1+2\\cos\\alpha)}\\\\[5pt]&\\text{.}\\\\[5pt]&\\text{Ratio }{=\\dfrac{\\sin\\alpha}{\\cos\\alpha}=\\tan\\alpha}\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ (c) }{\\tan\\alpha}\\text{.}}\\end{aligned}\\]",
   "actions": []
  }
 ],
