 "formulas": [
  {
   "title": "Squares of trig functions",
   "tex": "\\cos^2x=\\dfrac{1+\\cos2x}{2},\\qquad \\sin^2x=\\dfrac{1-\\cos2x}{2}",
   "text": "This turns a square into a plain cosine wave with midline ½ and half the height."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(\\cos^2x\\) as a multiple of \\(\\pi\\)?",
   "answer": 1,
   "hint": "\\(\\cos^2x=\\dfrac{1+\\cos2x}{2}\\).",
   "explain": "\\(\\cos2x\\) has period \\(\\pi\\), so \\(\\cos^2x\\) repeats every \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Draw the graph of each function:}\\\\[5pt]&{y=\\sin^2x}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "b": 1,
      "c": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Range",
   "text": "\\[\\begin{aligned}&\\text{Use }{\\sin^2x=\\dfrac{1-\\cos2x}2}\\text{ $\\Rightarrow$ amplitude }{\\frac12}\\text{,}\\\\[5pt]&\\text{period }{\\pi}\\text{, midline }{\\frac12}\\text{, but flipped}\\\\[5pt]&\\text{(starts at the bottom). Range }{[0,1]}\\text{.}\\\\[5pt]&\\text{Even.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Short trick",
   "text": "\\[\\begin{aligned}&\\text{ }{\\sin^2x}\\text{ and }{\\cos^2x}\\text{ are the same shape}\\\\[5pt]&\\text{shifted by }{\\frac\\pi2}\\text{, and }{\\sin^2x+\\cos^2x=1}\\text{ (their}\\\\[5pt]&\\text{graphs are mirror images about }{y=\\frac12}\\text{).}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "takeaways": [
  "A squared sine or cosine **never goes below 0** and **never above 1**.",
  "Squaring **halves the period**: cos²x repeats every π.",
  "tan²x is never negative, and still has asymptotes."
 ],
