 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{If }{\\cos\\theta-\\sin\\theta=\\sqrt2\\sin\\theta}\\text{, show}\\\\[5pt]&\\text{that }{\\cos\\theta+\\sin\\theta=\\sqrt2\\cos\\theta}\\end{aligned}\\]",
   "actions": [
    {
     "set": {},
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Step 1",
   "text": "\\[\\begin{aligned}&\\text{Proof. From the given equation:}\\\\[5pt]&{\\cos\\theta=\\sin\\theta+\\sqrt2\\sin\\theta=(\\sqrt2+1)\\sin\\theta}\\\\[5pt]&\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Step 2",
   "text": "\\[\\begin{aligned}&\\text{Hence }{\\sin\\theta=\\dfrac{\\cos\\theta}{\\sqrt2+1}}\\text{.}\\\\[5pt]&\\text{Rationalise:}\\\\[5pt]&{\\dfrac1{\\sqrt2+1}=\\dfrac{\\sqrt2-1}{(\\sqrt2+1)(\\sqrt2-1)}=\\dfrac{\\sqrt2-1}{2-1}=\\sqrt2-1}\\\\[5pt]&\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Step 3",
   "text": "\\[\\begin{aligned}&\\text{So }{\\sin\\theta=(\\sqrt2-1)\\cos\\theta}\\text{. Then}\\\\[5pt]&\\cos\\theta+\\sin\\theta\\\\[5pt]&{}=\\cos\\theta+(\\sqrt2-1)\\cos\\theta=\\sqrt2\\cos\\theta.\\qquad\\blacksquare\\\\[5pt]&\\text{(Alternative: write the given}\\\\[5pt]&\\text{equation as }{\\cos\\theta=(1+\\sqrt2)\\sin\\theta}\\text{ and}\\\\[5pt]&\\text{the required one as}\\\\[5pt]&{\\sin\\theta=(\\sqrt2-1)\\cos\\theta}\\text{; since}\\\\[5pt]&{(\\sqrt2+1)(\\sqrt2-1)=1}\\text{ they are the same}\\\\[5pt]&\\text{statement.)}\\end{aligned}\\]",
   "actions": []
  }
 ],
