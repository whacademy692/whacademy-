 "formulas": [
  {
   "title": "The reciprocal",
   "tex": "y=\\dfrac{1}{g},\\qquad g=\\role{mid}{a}+\\role{mx}{b}\\sin(\\role{per}{c}\\theta+\\role{key}{d})",
   "text": "First find the highest and lowest values of the denominator g."
  },
  {
   "title": "Same signs",
   "tex": "a-|b|\\ \\text{and}\\ a+|b|\\ \\text{same sign}\\ \\Rightarrow\\ \\role{mx}{\\dfrac1{\\text{smaller}}}\\ \\text{is the max},\\ \\role{mn}{\\dfrac1{\\text{larger}}}\\ \\text{is the min}",
   "text": "Both ends positive: max = 1/(a − |b|), min = 1/(a + |b|)."
  },
  {
   "title": "Opposite signs",
   "tex": "g\\ \\text{passes through }0\\ \\Rightarrow\\ \\text{no max or min}",
   "text": "There are asymptotes and the range has a gap."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Max of 1/g",
   "prompt": "Find the **maximum** of \\(y=\\dfrac1{5+3\\sin\\theta}\\).",
   "answer": 0.5,
   "hint": "g ranges from 2 to 8, both positive. The maximum of 1/g is 1 ÷ (smallest g).",
   "explain": "g has minimum \\(5-3=2\\) and maximum \\(8\\). Same signs, so \\(y_{max}=\\tfrac12\\) and \\(y_{min}=\\tfrac18\\).",
   "tolerance": 0.005
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Max or no max?",
   "prompt": "For which denominator does \\(\\dfrac1g\\) have **no** maximum?",
   "options": [
    {
     "id": "a",
     "label": "\\(g=4+3\\sin\\theta\\)"
    },
    {
     "id": "b",
     "label": "\\(g=2+5\\cos\\theta\\)"
    },
    {
     "id": "c",
     "label": "\\(g=6-\\cos\\theta\\)"
    }
   ],
   "answer": "b",
   "hint": "Check whether the denominator can be 0.",
   "explain": "\\(2+5\\cos\\theta\\) ranges from −3 to 7, so it crosses 0 and 1/g blows up. The other two stay positive."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Find the maximum and minimum values}\\\\[5pt]&\\text{of the reciprocal functions:}\\\\[5pt]&{y=\\dfrac1{4+3\\sin\\theta}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "a": 4,
      "b": 3,
      "c": 1,
      "d": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Max & min",
   "text": "\\[\\begin{aligned}&\\text{Denominator }{g=4+3\\sin\\theta}\\text{: }{a=4,b=3}\\text{ $\\Rightarrow$ }{M=7,\\ m=1}\\text{.}\\\\[5pt]&\\text{Both positive .}\\\\[5pt]&M'=\\frac1m=\\frac11=\\mathbf1,\\qquad m'=\\frac1M=\\mathbf{\\frac17}.\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showMax": 1,
      "showMid": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ Max }{=1}\\text{, Min }{=\\dfrac17}\\text{.}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showMax": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "takeaways": [
  "**Step 1:** find M and m of the denominator g.",
  "**Same signs → bounded:** max = 1/m, min = 1/M (positive case).",
  "**Opposite signs → no max/min:** the graph shoots off to ±∞ at asymptotes."
 ],
 "notes": [
  {
   "title": "Try this",
   "text": "Slide a up and down: when a is bigger than |b| the red asymptotes disappear and the graph becomes bounded."
  }
 ],
