 "formulas": [
  {
   "title": "The model",
   "tex": "y=\\role{mid}{a}+\\role{mx}{b}\\,\\cos(\\role{per}{c}\\,\\theta+\\role{key}{d})",
   "text": "The same four numbers as for sine. A cosine wave starts at its top (when b > 0)."
  },
  {
   "title": "Highest and lowest",
   "tex": "\\role{mx}{M}=a+|b|\\qquad \\role{mn}{m}=a-|b|",
   "text": "c and d do not matter for the height."
  },
  {
   "title": "Period and shift",
   "tex": "T=\\dfrac{2\\pi}{\\role{per}{c}}\\qquad \\text{shift}=-\\dfrac{\\role{key}{d}}{\\role{per}{c}}",
   "text": "Period depends only on c."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Max of a wave",
   "prompt": "A wave is \\(y=1-4\\cos\\theta\\). What is its **maximum** value?",
   "answer": 5,
   "hint": "Use \\(M=a+|b|\\).",
   "explain": "\\(M=a+|b|=1+4=5\\).",
   "tolerance": 0.01
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\cos(3\\theta)\\)? Give your answer as a multiple of \\(\\pi\\) (for example 0.5 means \\(\\tfrac\\pi2\\)).",
   "answer": 0.6667,
   "hint": "\\(T=\\dfrac{2\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{2\\pi}{3}\\), which is 0.6667 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Which slider?",
   "prompt": "Which slider makes the wave **twice as tall** without changing its period?",
   "options": [
    {
     "id": "a",
     "label": "Midline a"
    },
    {
     "id": "b",
     "label": "Amplitude b"
    },
    {
     "id": "c",
     "label": "Frequency c"
    },
    {
     "id": "d",
     "label": "Phase d"
    }
   ],
   "answer": "b",
   "hint": "Height of the wave = |b|.",
   "explain": "The amplitude \\(|b|\\) is the height of the wave. Midline a only lifts it; c changes the period; d slides it."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Ferris wheel, diameter 17 m}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "a": 10.5,
      "b": -8.5,
      "c": 0.125664,
      "d": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Step 1",
   "text": "\\[\\begin{aligned}&\\text{You board at the bottom from a}\\\\[5pt]&\\text{platform 2 m off the ground. It}\\\\[5pt]&\\text{takes 25 s to reach the top. Find}\\\\[5pt]&\\text{the equation of your height with}\\\\[5pt]&\\text{respect to time.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Amplitude & midline",
   "text": "\\[\\begin{aligned}&\\text{Step 1 — Max/min. Radius }{=\\dfrac{17}2=8.5}\\text{ m.}\\\\[5pt]&\\text{Lowest point }{=2}\\text{ m (platform).}\\\\[5pt]&\\text{Highest point }{=2+17=19}\\text{ m.}\\\\[5pt]&\\text{Midline }{d=\\dfrac{19+2}2=10.5}\\text{ m; amplitude }{=8.5}\\text{ m.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showMax": 1,
      "showMid": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Period",
   "text": "\\[\\begin{aligned}&\\text{Step 2 — Period. Bottom to top is}\\\\[5pt]&\\text{half a revolution = 25 s $\\Rightarrow$ period }{T=50}\\\\[5pt]&\\text{s $\\Rightarrow$ }{B=\\dfrac{2\\pi}{50}=\\dfrac\\pi{25}}\\text{.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPer": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Step 3",
   "text": "\\[\\begin{aligned}&\\text{Step 3 — Function. Start at the}\\\\[5pt]&\\text{bottom $\\Rightarrow$ }{-\\cos}\\text{:}\\\\[5pt]&\\boxed{h(t)=-8.5\\cos\\!\\left(\\frac{\\pi t}{25}\\right)+10.5}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Check",
   "text": "\\[\\begin{aligned}&\\text{Check: }{h(0)=-8.5+10.5=2}\\text{ ; }{h(25)=-8.5\\cos\\pi+10.5=19}\\\\[5pt]&\\text{; }{h(50)=2}\\text{ .}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPr": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
