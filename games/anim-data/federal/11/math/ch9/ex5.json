 "formulas": [
  {
   "title": "The model",
   "tex": "y=\\role{mid}{a}+\\role{mx}{b}\\,\\sin(\\role{per}{c}\\,\\theta+\\role{key}{d})",
   "text": "a lifts the graph, b stretches it, c squeezes it sideways, d slides it."
  },
  {
   "title": "Highest and lowest",
   "tex": "\\role{mx}{M}=a+|b|\\qquad \\role{mn}{m}=a-|b|",
   "text": "The sign of b only decides whether the wave starts upwards or downwards. The phase d never changes the height."
  },
  {
   "title": "Period and shift",
   "tex": "T=\\dfrac{2\\pi}{\\role{per}{c}}\\qquad \\text{shift}=-\\dfrac{\\role{key}{d}}{\\role{per}{c}}",
   "text": "The period depends only on c."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Max of a wave",
   "prompt": "A wave is \\(y=1+3\\sin\\theta\\). What is its **maximum** value?",
   "answer": 4,
   "hint": "Use \\(M=a+|b|\\).",
   "explain": "\\(M=a+|b|=1+3=4\\).",
   "tolerance": 0.01
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(y=\\sin(3\\theta)\\)? Give your answer as a multiple of \\(\\pi\\) (for example 0.5 means \\(\\tfrac\\pi2\\)).",
   "answer": 0.6667,
   "hint": "\\(T=\\dfrac{2\\pi}{c}\\).",
   "explain": "\\(T=\\dfrac{2\\pi}{3}\\), which is 0.6667 \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Which slider?",
   "prompt": "Which slider makes the wave **twice as tall** without changing its period?",
   "options": [
    {
