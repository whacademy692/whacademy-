 "formulas": [
  {
   "title": "Squares of trig functions",
   "tex": "\\cos^2x=\\dfrac{1+\\cos2x}{2},\\qquad \\sin^2x=\\dfrac{1-\\cos2x}{2}",
   "text": "This turns a square into a plain cosine wave with midline ½ and half the height."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Period",
   "prompt": "What is the period of \\(\\cos^2x\\) as a multiple of \\(\\pi\\)?",
   "answer": 1,
   "hint": "\\(\\cos^2x=\\dfrac{1+\\cos2x}{2}\\).",
   "explain": "\\(\\cos2x\\) has period \\(\\pi\\), so \\(\\cos^2x\\) repeats every \\(\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Draw the graph of each function:}\\\\[5pt]&{y=\\tan^2x}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "b": 1,
      "c": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Range",
   "text": "\\[\\begin{aligned}&\\text{Period }{\\pi}\\text{ (Key Fact: }{\\tan^n}\\text{ has period}\\\\[5pt]&{\\pi}\\text{). Asymptotes at }{x=\\frac\\pi2+n\\pi}\\text{. Always }{\\ge0}\\\\[5pt]&\\text{; touches }{0}\\text{ at }{x=n\\pi}\\text{. Range }{[0,\\infty)}\\text{.}\\\\[5pt]&\\text{Even.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Step 2",
   "text": "\\[\\begin{aligned}&\\text{(Because }{\\tan\\frac\\pi6=\\frac1{\\sqrt3}}\\text{, squared }{\\frac13}\\text{;}\\\\[5pt]&{\\tan\\frac\\pi3=\\sqrt3}\\text{, squared }{3}\\text{.) The left}\\\\[5pt]&\\text{half is the mirror image of the}\\\\[5pt]&\\text{right half.}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "takeaways": [
  "A squared sine or cosine **never goes below 0** and **never above 1**.",
  "Squaring **halves the period**: cos²x repeats every π.",
  "tan²x is never negative, and still has asymptotes."
 ],
