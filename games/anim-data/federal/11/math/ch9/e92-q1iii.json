 "formulas": [
  {
   "title": "Even function",
   "tex": "\\role{cv2}{f(-x)} = \\role{cv}{f(x)}",
   "text": "The graph is a mirror image about the y-axis. f(x) − f(−x) is always 0."
  },
  {
   "title": "Odd function",
   "tex": "\\role{cv2}{f(-x)} = -\\role{cv}{f(x)}",
   "text": "The graph is unchanged by a half-turn about the origin. f(x) + f(−x) is always 0."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Odd or even?",
   "prompt": "Which of these is an **odd** function?",
   "options": [
    {
     "id": "a",
     "label": "\\(x^2\\cos x\\)"
    },
    {
     "id": "b",
     "label": "\\(x\\sin x\\)"
    },
    {
     "id": "c",
     "label": "\\(x\\cos x\\)"
    }
   ],
   "answer": "c",
   "hint": "Odd × even = odd.",
   "explain": "x is odd and cos x is even, so \\(x\\cos x\\) is odd. The other two are even (x² and cos are even; x and sin are both odd, so x sin x is even)."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "The symmetry",
   "prompt": "What symmetry has the graph of an **even** function?",
   "options": [
    {
     "id": "a",
     "label": "Mirror image in the y-axis"
    },
    {
     "id": "b",
     "label": "Half-turn about the origin"
    },
    {
     "id": "c",
     "label": "Mirror image in the x-axis"
    }
   ],
   "answer": "a",
   "hint": "Even: f(−x) = f(x).",
   "explain": "f(−x) = f(x) means the point at −x is level with the point at x: a mirror image in the y-axis."
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Check whether each function is odd}\\\\[5pt]&\\text{or even: }{y=\\dfrac{x^2\\tan x}{x+\\sin x}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {},
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Step 1",
   "text": "\\[\\begin{aligned}&f(-x)=\\dfrac{(-x)^2\\tan(-x)}{-x+\\sin(-x)}\\\\[5pt]&{}=\\dfrac{x^2(-\\tan x)}{-x-\\sin x}\\\\[5pt]&{}=\\dfrac{-x^2\\tan x}{-(x+\\sin x)}\\\\[5pt]&{}=\\dfrac{x^2\\tan x}{x+\\sin x}=f(x)\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ Even. (Numerator is odd [}{x^2}\\text{ even $\\times$}}\\\\[5pt]&\\textcolor{#047857}{{\\tan x}\\text{ odd]; denominator is odd; odd $\\div$}}\\\\[5pt]&\\textcolor{#047857}{\\text{odd = even.)}}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "takeaways": [
  "**Even:** f(−x) = f(x). The graph is a mirror image about the y-axis.",
  "**Odd:** f(−x) = −f(x). Turning the graph half a turn about the origin leaves it unchanged.",
  "Even × even = even, odd × odd = even, even × odd = odd."
 ],
