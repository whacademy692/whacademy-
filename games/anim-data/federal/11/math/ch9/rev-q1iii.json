 "formulas": [
  {
   "title": "Unit circle",
   "tex": "P=(\\role{mn}{\\cos\\theta},\\ \\role{mx}{\\sin\\theta}),\\qquad \\tan\\theta=\\dfrac{\\role{mx}{\\sin\\theta}}{\\role{mn}{\\cos\\theta}}",
   "text": "The x-coordinate is cos θ, the y-coordinate is sin θ."
  },
  {
   "title": "ASTC",
   "tex": "\\text{I: All}\\quad\\text{II: Sin}\\quad\\text{III: Tan}\\quad\\text{IV: Cos}",
   "text": "The letter says which ratios are positive in that quadrant."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Signs",
   "prompt": "In which quadrant are **both** sin θ and cos θ negative?",
   "options": [
    {
     "id": "a",
     "label": "II"
    },
    {
     "id": "b",
     "label": "III"
    },
    {
     "id": "c",
     "label": "IV"
    }
   ],
   "answer": "b",
   "hint": "Left of the y-axis AND below the x-axis.",
   "explain": "cos is the x-coordinate (negative on the left) and sin is the y-coordinate (negative below). That is quadrant III (only tan is positive).",
   "set": {
    "th": 210
   }
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Full turns",
   "prompt": "What is \\(\\sin 750^\\circ\\)?",
   "answer": 0.5,
   "hint": "750° = 2 × 360° + 30°.",
   "explain": "Two full turns bring you back: \\(\\sin750^\\circ=\\sin30^\\circ=\\tfrac12\\).",
   "tolerance": 0.01,
   "set": {
    "th": 750
   }
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{For }{2\\sin\\theta+\\dfrac12\\csc\\theta}\\text{ at }{\\theta=45^\\circ}\\text{, the}\\\\[5pt]&\\text{value is}\\\\[5pt]&\\text{(a) }{\\frac1{\\sqrt2}}\\text{ (b) }{\\frac13}\\text{ (c) }{\\frac3{\\sqrt2}}\\text{ (d) }{\\frac{\\sqrt2}3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "th": 45
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Step 2",
   "text": "\\[\\begin{aligned}&{2\\sin45^\\circ=2\\cdot\\dfrac{\\sqrt2}2=\\sqrt2}\\text{.}\\\\[5pt]&{\\ \\dfrac12\\csc45^\\circ=\\dfrac12\\sqrt2=\\dfrac{\\sqrt2}2}\\text{.}\\\\[5pt]&\\text{Sum }{=\\sqrt2+\\dfrac{\\sqrt2}2=\\dfrac{3\\sqrt2}2=\\dfrac3{\\sqrt2}}\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ (c) }{\\dfrac3{\\sqrt2}}\\text{.}}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "takeaways": [
  "On the unit circle **cos θ is the x-coordinate** and **sin θ is the y-coordinate**.",
  "After a full turn (360°) the angle comes back to the same point: this is **periodicity**.",
  "**ASTC** tells the sign in each quadrant."
 ],
