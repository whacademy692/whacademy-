 "formulas": [
  {
   "title": "Period of a sum",
   "tex": "T=\\dfrac{\\text{LCM of numerators}}{\\text{HCF of denominators}}",
   "text": "Write each period as a fraction of π. The sum repeats once BOTH parts have completed a whole number of cycles."
  },
  {
   "title": "This exercise",
   "tex": "\\role{cv2}{\\cot3x}\\ ,\\ \\ \\role{mx}{\\sin\\frac{2x}{3}}\\ \\Rightarrow\\ \\role{per}{T=3\\pi}",
   "text": "Check it on the graph: the purple lines mark one full period of the sum."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Period of a sum",
   "prompt": "Find the period of \\(\\sin 2x+\\cos 3x\\) as a multiple of \\(\\pi\\).",
   "answer": 2,
   "hint": "Periods: \\(\\pi\\) and \\(\\tfrac{2\\pi}{3}\\). LCM of numerators 1,2 is 2; HCF of denominators 1,3 is 1.",
   "explain": "\\(T=\\dfrac{\\text{LCM}(\\pi,2\\pi)}{\\text{HCF}(1,3)}=2\\pi\\).",
   "tolerance": 0.02,
   "unit": "π"
  }
 ],
 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&f(x)=\\cot3x+\\sin\\dfrac{2x}3\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "b1": 1,
      "c1": 3,
      "b2": 1,
      "c2": 0.666667
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Each period",
   "text": "\\[\\begin{aligned}&\\cot3x:\\ \\dfrac\\pi3\\qquad\\sin\\dfrac{2x}3:\\ 3\\pi\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Combine",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{T}\\\\[5pt]&\\textcolor{#047857}{{}=\\dfrac{\\mathrm{LCM}(1,3)\\,\\pi}{\\mathrm{HCF}(3,1)}=3\\pi}\\end{aligned}\\]",
   "actions": []
  }
 ],
 "takeaways": [
  "Find the period of **each part** first.",
  "The sum repeats after **LCM of numerators ÷ HCF of denominators** (periods written as fractions of π).",
  "The sum repeats only when **both** parts are back at the start together."
 ],
 "notes": [
  {
   "title": "Try this",
   "text": "Change the two speeds: for most pairs the sum has a long period; if one speed is a multiple of the other, the period of the sum is the longer one."
  }
 ],
