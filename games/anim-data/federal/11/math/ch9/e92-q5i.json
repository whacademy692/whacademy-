 "steps": [
  {
   "id": "s0",
   "title": "The question",
   "text": "\\[\\begin{aligned}&\\text{Solve graphically: }{\\sin x=\\cos x}\\end{aligned}\\]",
   "actions": [
    {
     "set": {},
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "The graph",
   "text": "\\[\\begin{aligned}&\\text{Draw }{y=\\sin x}\\text{ and }{y=\\cos x}\\text{. They cross where}\\\\[5pt]&\\text{the two curves have the same height,}\\\\[5pt]&\\text{at }{x=\\frac\\pi4}\\text{ (height }{\\frac{\\sqrt2}2\\approx0.71}\\text{) and}\\\\[5pt]&{x=\\frac{5\\pi}4}\\text{ (height }{-0.71}\\text{) in }{[0,2\\pi]}\\text{, and}\\\\[5pt]&\\text{repeat every }{\\pi}\\text{.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\text{ }{x=\\dfrac\\pi4+n\\pi}\\text{ (}{n\\in\\mathbb Z}\\text{); in }{[0,2\\pi]}\\text{:}}\\\\[5pt]&\\textcolor{#047857}{{x=\\dfrac\\pi4,\\ \\dfrac{5\\pi}4}\\text{.}}\\\\[5pt]&\\text{(Algebra check: divide by }{\\cos x}\\text{:}\\\\[5pt]&{\\tan x=1\\Rightarrow x=\\frac\\pi4+n\\pi}\\text{.)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "showPr": 1
     },
     "at": 0
    }
   ]
  }
 ],
