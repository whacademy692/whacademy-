 "steps": [
  {
   "id": "s0",
   "title": "Ratios of α",
   "text": "\\[\\begin{aligned}&\\text{α is acute and sin α = 12/13, so the}\\\\[5pt]&\\text{adjacent side is 5.}\\\\[5pt]&\\cos\\alpha=\\textcolor{#047857}{\\mathbf{\\dfrac5{13}}},\\quad\\tan\\alpha=\\dfrac{12}5\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Ratios of β",
   "text": "\\[\\begin{aligned}&\\text{tan β = 4/3 gives a 3-4-5 triangle.}\\\\[5pt]&\\sin\\beta=\\textcolor{#047857}{\\mathbf{\\dfrac45}},\\quad\\cos\\beta=\\textcolor{#047857}{\\mathbf{\\dfrac35}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Tangents first",
   "text": "\\[\\begin{aligned}&\\tan\\alpha=\\dfrac{12/13}{5/13}=\\dfrac{12}5,\\quad\\tan\\beta=\\dfrac43\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Use the tan formula",
   "text": "\\[\\begin{aligned}&\\tan(\\alpha+\\beta)=\\dfrac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}=\\dfrac{\\frac{12}5+\\frac43}{1-\\frac{12}5\\cdot\\frac43}\\\\[5pt]&{}=\\dfrac{56/15}{-33/15}=\\textcolor{#047857}{\\mathbf{-\\dfrac{56}{33}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Check with sin ÷ cos",
   "text": "\\[\\begin{aligned}&\\dfrac{56/65}{-33/65}=-\\dfrac{56}{33}\\\\[5pt]&\\text{The angle α + β is about 120.5°, in}\\\\[5pt]&\\text{quadrant II, so the tangent is negative.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
 ],
