  },
  {
   "id": "s1",
   "title": "cos(α ± β)",
   "text": "\\[\\begin{aligned}&\\cos(\\alpha+\\beta)=\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=(-1)(\\dfrac{\\sqrt3}2)-(0)(\\dfrac12)=\\textcolor{#047857}{\\mathbf{-\\dfrac{\\sqrt3}2}}\\\\[5pt]&\\cos(\\alpha-\\beta)=\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=(-1)(\\dfrac{\\sqrt3}2)+(0)(\\dfrac12)=\\textcolor{#047857}{\\mathbf{-\\dfrac{\\sqrt3}2}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "sin(α ± β)",
   "text": "\\[\\begin{aligned}&\\sin(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\\\[5pt]&{}=(0)(\\dfrac{\\sqrt3}2)+(-1)(\\dfrac12)=\\textcolor{#047857}{\\mathbf{-\\dfrac12}}\\\\[5pt]&\\sin(\\alpha-\\beta)=\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\\\[5pt]&{}=(0)(\\dfrac{\\sqrt3}2)-(-1)(\\dfrac12)=\\textcolor{#047857}{\\mathbf{\\dfrac12}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "tan(α ± β)",
   "text": "\\[\\begin{aligned}&\\tan(\\alpha+\\beta)=\\dfrac{0+\\frac1{\\sqrt3}}{1-0}=\\textcolor{#047857}{\\mathbf{\\dfrac1{\\sqrt3}}}\\\\[5pt]&\\tan(\\alpha-\\beta)=\\dfrac{0-\\frac1{\\sqrt3}}{1+0}=\\textcolor{#047857}{\\mathbf{-\\dfrac1{\\sqrt3}}}\\end{aligned}\\]",
