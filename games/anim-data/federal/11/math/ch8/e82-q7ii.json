 "steps": [
  {
   "id": "s0",
   "title": "Split the powers",
   "text": "\\[\\begin{aligned}&\\sin^4\\alpha\\cos^2\\alpha=\\sin^2\\alpha\\,(\\sin\\alpha\\cos\\alpha)^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use identities",
   "text": "\\[\\begin{aligned}&{}=\\dfrac{1-\\cos2\\alpha}2\\cdot\\dfrac{\\sin^22\\alpha}4=\\dfrac{1-\\cos2\\alpha}2\\cdot\\dfrac{1-\\cos4\\alpha}8\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Multiply out",
   "text": "\\[\\begin{aligned}&{}=\\dfrac{1-\\cos4\\alpha-\\cos2\\alpha+\\cos2\\alpha\\cos4\\alpha}{16}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Product to sum",
   "text": "\\[\\begin{aligned}&\\cos2\\alpha\\cos4\\alpha=\\dfrac12(\\cos6\\alpha+\\cos2\\alpha)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Collect the terms",
   "text": "\\[\\begin{aligned}&{}=\\dfrac{1-\\frac12\\cos2\\alpha-\\cos4\\alpha+\\frac12\\cos6\\alpha}{16}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Result",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{\\dfrac{2-\\cos2\\alpha-2\\cos4\\alpha+\\cos6\\alpha}{32}}}\\\\[5pt]&\\text{Check at α = 45°: left side 1/8, right}\\\\[5pt]&\\text{side (2 − 0 + 2 + 0)/32 = 1/8.}\\end{aligned}\\]",
   "actions": [
