     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Double angle",
   "text": "\\[\\begin{aligned}&\\sin2\\theta=2\\sin\\theta\\cos\\theta=2\\Big(\\dfrac45\\Big)\\Big(-\\dfrac35\\Big)=\\textcolor{#047857}{\\mathbf{-\\dfrac{24}{25}}}\\\\[5pt]&\\cos2\\theta=\\cos^2\\theta-\\sin^2\\theta=\\dfrac9{25}-\\dfrac{16}{25}=\\textcolor{#047857}{\\mathbf{-\\dfrac7{25}}}\\end{aligned}\\]",
   "actions": [
