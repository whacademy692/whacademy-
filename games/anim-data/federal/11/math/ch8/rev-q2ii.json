 "steps": [
  {
   "id": "s0",
   "title": "Find the tangents",
   "text": "\\[\\begin{aligned}&\\tan\\theta=\\dfrac{3/5}{-4/5}=-\\dfrac34,\\quad\\tan\\varphi=\\dfrac{5/13}{12/13}=\\dfrac5{12}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use the formula",
   "text": "\\[\\begin{aligned}&\\tan(\\theta-\\varphi)=\\dfrac{\\tan\\theta-\\tan\\varphi}{1+\\tan\\theta\\tan\\varphi}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Top and bottom",
   "text": "\\[\\begin{aligned}&\\text{top}=-\\dfrac34-\\dfrac5{12}=-\\dfrac76,\\quad\\text{bottom}=1-\\dfrac{15}{48}=\\dfrac{33}{48}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Divide",
   "text": "\\[\\begin{aligned}&-\\dfrac76\\cdot\\dfrac{48}{33}=-\\dfrac{56}{33}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Check with sin and cos",
   "text": "\\[\\begin{aligned}&\\cos(\\theta-\\varphi)=-\\dfrac{48}{65}+\\dfrac{15}{65}=-\\dfrac{33}{65}\\\\[5pt]&\\dfrac{56/65}{-33/65}=-\\dfrac{56}{33}\\ \\checkmark\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Result",
