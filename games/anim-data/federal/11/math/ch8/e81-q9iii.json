 "steps": [
  {
   "id": "s0",
   "title": "Ratios of α",
   "text": "\\[\\begin{aligned}&\\text{Obtuse means quadrant II: sin is positive}\\\\[5pt]&\\text{and cos is negative.}\\\\[5pt]&\\cos\\alpha=-\\sqrt{1-\\dfrac12}=\\textcolor{#047857}{\\mathbf{-\\dfrac1{\\sqrt2}}}\\\\[5pt]&\\text{So α = 135°.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Ratios of β",
   "text": "\\[\\begin{aligned}&\\text{β is obtuse, so sin β is positive.}\\\\[5pt]&\\sin\\beta=\\sqrt{1-\\dfrac9{25}}=\\textcolor{#047857}{\\mathbf{\\dfrac45}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Sines and cosines",
   "text": "\\[\\begin{aligned}&\\sin(\\alpha+\\beta)=-\\dfrac7{5\\sqrt2},\\quad\\cos(\\alpha+\\beta)=-\\dfrac1{5\\sqrt2}\\\\[5pt]&\\sin(\\alpha-\\beta)=\\dfrac1{5\\sqrt2},\\quad\\cos(\\alpha-\\beta)=\\dfrac7{5\\sqrt2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Divide",
   "text": "\\[\\begin{aligned}&\\tan(\\alpha+\\beta)=\\dfrac{-7/(5\\sqrt2)}{-1/(5\\sqrt2)}=\\textcolor{#047857}{\\mathbf{7}}\\\\[5pt]&\\tan(\\alpha-\\beta)=\\dfrac{1/(5\\sqrt2)}{7/(5\\sqrt2)}=\\textcolor{#047857}{\\mathbf{\\dfrac17}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Check with angles",
   "text": "\\[\\begin{aligned}&\\text{α = 135° and β ≈ 126.87°, so α + β ≈}\\\\[5pt]&\\text{261.87° and α − β ≈ 8.13°.}\\\\[5pt]&\\tan261.87^\\circ\\approx7,\\quad\\tan8.13^\\circ\\approx0.143=\\dfrac17\\end{aligned}\\]",
   "actions": [
