 "steps": [
  {
   "id": "s0",
   "title": "Find sin θ, cos θ",
   "text": "\\[\\begin{aligned}&\\text{θ is in quadrant IV, where cos is}\\\\[5pt]&\\text{positive.}\\\\[5pt]&\\cos\\theta=\\sqrt{1-\\dfrac{49}{625}}=\\textcolor{#047857}{\\mathbf{\\dfrac{24}{25}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Double angles",
   "text": "\\[\\begin{aligned}&\\sin2\\theta=2\\sin\\theta\\cos\\theta=\\textcolor{#047857}{\\mathbf{-\\dfrac{336}{625}}}\\\\[5pt]&\\cos2\\theta=\\cos^2\\theta-\\sin^2\\theta=\\textcolor{#047857}{\\mathbf{\\dfrac{527}{625}}}\\\\[5pt]&\\tan2\\theta=\\dfrac{\\sin2\\theta}{\\cos2\\theta}=\\textcolor{#047857}{\\mathbf{-\\dfrac{336}{527}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Quadrant of θ/2",
   "text": "\\[\\begin{aligned}&\\text{3π/2 $<$ θ $<$ 2π gives 3π/4 $<$ θ/2 $<$ π.}\\\\[5pt]&\\text{So θ/2 is in quadrant II: sin positive,}\\\\[5pt]&\\text{cos and tan negative.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Half angles",
   "text": "\\[\\begin{aligned}&\\sin\\dfrac\\theta2=+\\sqrt{\\dfrac{1-\\frac{24}{25}}2}=\\sqrt{\\dfrac1{50}}=\\textcolor{#047857}{\\mathbf{\\dfrac{\\sqrt2}{10}}}\\\\[5pt]&\\cos\\dfrac\\theta2=-\\sqrt{\\dfrac{1+\\frac{24}{25}}2}=-\\sqrt{\\dfrac{49}{50}}=\\textcolor{#047857}{\\mathbf{-\\dfrac{7\\sqrt2}{10}}}\\\\[5pt]&\\tan\\dfrac\\theta2=\\dfrac{1-\\cos\\theta}{\\sin\\theta}=\\textcolor{#047857}{\\mathbf{-\\dfrac17}}\\quad\\text{(cross-check)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
