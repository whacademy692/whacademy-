 "steps": [
  {
   "id": "s0",
   "title": "Known values",
   "text": "\\[\\begin{aligned}&\\text{Write the sine and cosine of both angles.}\\\\[5pt]&\\cos\\alpha=0,\\ \\sin\\alpha=-1\\\\[5pt]&\\cos\\beta=\\dfrac{\\sqrt2}2,\\ \\sin\\beta=\\dfrac{\\sqrt2}2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "cos(α ± β)",
   "text": "\\[\\begin{aligned}&\\cos(\\alpha+\\beta)=\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=(0)(\\dfrac{\\sqrt2}2)-(-1)(\\dfrac{\\sqrt2}2)=\\textcolor{#047857}{\\mathbf{\\dfrac{\\sqrt2}2}}\\\\[5pt]&\\cos(\\alpha-\\beta)=\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=(0)(\\dfrac{\\sqrt2}2)+(-1)(\\dfrac{\\sqrt2}2)=\\textcolor{#047857}{\\mathbf{-\\dfrac{\\sqrt2}2}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "sin(α ± β)",
   "text": "\\[\\begin{aligned}&\\sin(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\\\[5pt]&{}=(-1)(\\dfrac{\\sqrt2}2)+(0)(\\dfrac{\\sqrt2}2)=\\textcolor{#047857}{\\mathbf{-\\dfrac{\\sqrt2}2}}\\\\[5pt]&\\sin(\\alpha-\\beta)=\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\\\[5pt]&{}=(-1)(\\dfrac{\\sqrt2}2)-(0)(\\dfrac{\\sqrt2}2)=\\textcolor{#047857}{\\mathbf{-\\dfrac{\\sqrt2}2}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "tan(α ± β)",
   "text": "\\[\\begin{aligned}&\\text{tan(3π/2) is undefined, so use tan = sin ÷}\\\\[5pt]&\\text{cos.}\\\\[5pt]&\\tan(\\alpha+\\beta)=\\dfrac{-\\sqrt2/2}{\\sqrt2/2}=\\textcolor{#047857}{\\mathbf{-1}}\\\\[5pt]&\\tan(\\alpha-\\beta)=\\dfrac{-\\sqrt2/2}{-\\sqrt2/2}=\\textcolor{#047857}{\\mathbf{1}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
