 "steps": [
  {
   "id": "s0",
   "title": "Name the half-angles",
   "text": "\\[\\begin{aligned}&A=\\dfrac\\alpha2,\\ B=\\dfrac\\beta2,\\ C=\\dfrac\\gamma2\\\\[5pt]&A+B+C=90^\\circ\\ \\Rightarrow\\ A+B=90^\\circ-C\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Take cot of both sides",
   "text": "\\[\\begin{aligned}&\\cot(A+B)=\\cot(90^\\circ-C)=\\tan C\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Expand cot(A + B)",
   "text": "\\[\\begin{aligned}&\\cot(A+B)=\\dfrac{\\cot A\\cot B-1}{\\cot A+\\cot B}\\\\[5pt]&\\text{Divide top and bottom of the cos/sin form}\\\\[5pt]&\\text{by sin A sin B.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Equate and rearrange",
   "text": "\\[\\begin{aligned}&\\dfrac{\\cot A\\cot B-1}{\\cot A+\\cot B}=\\tan C=\\dfrac1{\\cot C}\\\\[5pt]&\\cot C(\\cot A\\cot B-1)=\\cot A+\\cot B\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Collect the terms",
   "text": "\\[\\begin{aligned}&\\cot A\\cot B\\cot C-\\cot C=\\cot A+\\cot B\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\cot A+\\cot B+\\cot C=\\cot A\\cot B\\cot C}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
