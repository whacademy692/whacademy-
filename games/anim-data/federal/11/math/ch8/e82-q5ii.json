 "steps": [
  {
   "id": "s0",
   "title": "Other ratio of 2θ",
   "text": "\\[\\begin{aligned}&\\text{2θ is in quadrant III, so sin 2θ is}\\\\[5pt]&\\text{negative.}\\\\[5pt]&\\sin2\\theta=-\\sqrt{1-\\dfrac{49}{625}}=\\textcolor{#047857}{\\mathbf{-\\dfrac{24}{25}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Quadrant of θ",
   "text": "\\[\\begin{aligned}&\\text{Assume 0° $<$ 2θ $<$ 360°, so 0° $<$ θ $<$ 180°}\\\\[5pt]&\\text{and sin θ is positive.}\\\\[5pt]&\\text{2θ in quadrant III means θ is in quadrant}\\\\[5pt]&\\text{II: sin positive, cos negative.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "sin θ and cos θ",
   "text": "\\[\\begin{aligned}&\\sin\\theta=\\sqrt{\\dfrac{1-\\cos2\\theta}2}=\\sqrt{\\dfrac{1+\\frac7{25}}2}=\\textcolor{#047857}{\\mathbf{\\dfrac45}}\\\\[5pt]&\\cos\\theta=-\\sqrt{\\dfrac{1+\\cos2\\theta}2}=-\\sqrt{\\dfrac{1-\\frac7{25}}2}=\\textcolor{#047857}{\\mathbf{-\\dfrac35}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "tan θ and check",
   "text": "\\[\\begin{aligned}&\\tan\\theta=\\dfrac{\\sin\\theta}{\\cos\\theta}=\\textcolor{#047857}{\\mathbf{-\\dfrac43}}\\\\[5pt]&\\text{Check: sin 2θ = 2(4/5)(−3/5) = −24/25,}\\\\[5pt]&\\text{which is negative, as expected in quadrant}\\\\[5pt]&\\text{III.}\\end{aligned}\\]",
