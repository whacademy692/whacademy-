 "steps": [
  {
   "id": "s0",
   "title": "Known values",
   "text": "\\[\\begin{aligned}&\\text{Write the sine and cosine of both angles.}\\\\[5pt]&\\cos\\alpha=-1,\\ \\sin\\alpha=0\\\\[5pt]&\\cos\\beta=\\dfrac12,\\ \\sin\\beta=\\dfrac{\\sqrt3}2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "cos(α ± β)",
   "text": "\\[\\begin{aligned}&\\cos(\\alpha+\\beta)=\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=(-1)(\\dfrac12)-(0)(\\dfrac{\\sqrt3}2)=\\textcolor{#047857}{\\mathbf{-\\dfrac12}}\\\\[5pt]&\\cos(\\alpha-\\beta)=\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=(-1)(\\dfrac12)+(0)(\\dfrac{\\sqrt3}2)=\\textcolor{#047857}{\\mathbf{-\\dfrac12}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "sin(α ± β)",
   "text": "\\[\\begin{aligned}&\\sin(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\\\[5pt]&{}=(0)(\\dfrac12)+(-1)(\\dfrac{\\sqrt3}2)=\\textcolor{#047857}{\\mathbf{-\\dfrac{\\sqrt3}2}}\\\\[5pt]&\\sin(\\alpha-\\beta)=\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\\\[5pt]&{}=(0)(\\dfrac12)-(-1)(\\dfrac{\\sqrt3}2)=\\textcolor{#047857}{\\mathbf{\\dfrac{\\sqrt3}2}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "tan(α ± β)",
   "text": "\\[\\begin{aligned}&\\text{π = 180° and π/3 = 60°, the same pair as}\\\\[5pt]&\\text{part (i), so the answers are the same.}\\\\[5pt]&\\tan(\\alpha+\\beta)=\\dfrac{0+\\sqrt3}{1-0}=\\textcolor{#047857}{\\mathbf{\\sqrt3}}\\\\[5pt]&\\tan(\\alpha-\\beta)=\\dfrac{0-\\sqrt3}{1+0}=\\textcolor{#047857}{\\mathbf{-\\sqrt3}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
