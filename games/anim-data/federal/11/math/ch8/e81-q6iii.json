 "steps": [
  {
   "id": "s0",
   "title": "Ratios of α",
   "text": "\\[\\begin{aligned}&\\text{cos α = −7/25 and α is in quadrant II, so}\\\\[5pt]&\\text{sin α is positive.}\\\\[5pt]&\\sin\\alpha=\\sqrt{1-\\dfrac{49}{625}}=\\textcolor{#047857}{\\mathbf{\\dfrac{24}{25}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Ratios of β",
   "text": "\\[\\begin{aligned}&\\text{cot β = 15/8, so tan β = 8/15 and the legs}\\\\[5pt]&\\text{are 8 and 15.}\\\\[5pt]&\\text{hypotenuse}=\\sqrt{8^2+15^2}=17\\\\[5pt]&\\text{Quadrant III: sin and cos are both}\\\\[5pt]&\\text{negative.}\\\\[5pt]&\\sin\\beta=\\textcolor{#047857}{\\mathbf{-\\dfrac8{17}}},\\quad\\cos\\beta=\\textcolor{#047857}{\\mathbf{-\\dfrac{15}{17}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find sin(α − β)",
   "text": "\\[\\begin{aligned}&\\text{Use sin(A − B) = sin A cos B − cos A sin}\\\\[5pt]&\\text{B.}\\\\[5pt]&\\sin(\\alpha-\\beta)=-\\dfrac{360}{425}-\\dfrac{56}{425}=-\\dfrac{416}{425}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Find cos(α − β)",
   "text": "\\[\\begin{aligned}&\\text{Use cos(A − B) = cos A cos B + sin A sin}\\\\[5pt]&\\text{B.}\\\\[5pt]&\\cos(\\alpha-\\beta)=\\dfrac{105}{425}-\\dfrac{192}{425}=-\\dfrac{87}{425}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Divide",
   "text": "\\[\\begin{aligned}&\\tan(\\alpha-\\beta)=\\dfrac{\\sin(\\alpha-\\beta)}{\\cos(\\alpha-\\beta)}=\\dfrac{-416/425}{-87/425}=\\textcolor{#047857}{\\mathbf{\\dfrac{416}{87}}}\\\\[5pt]&\\text{Check: $416^2+87^2=425^2$, so sin² + cos² = 1.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
