     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Insert cos 30°",
   "text": "\\[\\begin{aligned}&{}=\\sqrt{\\dfrac{1+\\frac{\\sqrt3}2}2}=\\sqrt{\\dfrac{2+\\sqrt3}4}=\\dfrac{\\sqrt{2+\\sqrt3}}2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Simplify the root",
   "text": "\\[\\begin{aligned}&\\sqrt{2+\\sqrt3}=\\dfrac{\\sqrt6+\\sqrt2}2\\\\[5pt]&\\text{Check: squaring the right side gives}\\\\[5pt]&\\text{$\\frac{8+2\\sqrt{12}}4=2+\\sqrt3$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Final value",
