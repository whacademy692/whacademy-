 "steps": [
  {
   "id": "s0",
   "title": "Cos θ (obtuse)",
   "text": "\\[\\begin{aligned}&\\cos\\theta=-\\sqrt{1-\\tfrac9{25}}=-\\dfrac45\\\\[5pt]&\\text{θ is in quadrant II, so cosine is}\\\\[5pt]&\\text{negative.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Cos φ (acute)",
   "text": "\\[\\begin{aligned}&\\cos\\varphi=\\sqrt{1-\\tfrac{25}{169}}=\\dfrac{12}{13}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Use the formula",
   "text": "\\[\\begin{aligned}&\\sin(\\theta-\\varphi)=\\sin\\theta\\cos\\varphi-\\cos\\theta\\sin\\varphi\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Insert the values",
   "text": "\\[\\begin{aligned}&{}=\\dfrac35\\cdot\\dfrac{12}{13}-\\Big(-\\dfrac45\\Big)\\dfrac5{13}=\\dfrac{36}{65}+\\dfrac{20}{65}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Result",
