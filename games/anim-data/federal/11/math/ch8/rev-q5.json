     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Result",
   "text": "\\[\\begin{aligned}&\\tan\\theta=\\textcolor{#047857}{\\mathbf{2}}\\\\[5pt]&\\text{Check: (2 − 1)/(1 + 2) = 1/3.}\\end{aligned}\\]",
