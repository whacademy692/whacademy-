 "steps": [
  {
   "id": "s0",
   "title": "Use the formula",
   "text": "\\[\\begin{aligned}&\\tan(\\theta-45^\\circ)=\\dfrac{\\tan\\theta-\\tan45^\\circ}{1+\\tan\\theta\\tan45^\\circ}=\\dfrac{\\tan\\theta-1}{1+\\tan\\theta}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Set it equal to 1/3",
   "text": "\\[\\begin{aligned}&\\dfrac{\\tan\\theta-1}{1+\\tan\\theta}=\\dfrac13\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cross-multiply",
   "text": "\\[\\begin{aligned}&3(\\tan\\theta-1)=1+\\tan\\theta\\\\[5pt]&3\\tan\\theta-3=1+\\tan\\theta\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Solve",
   "text": "\\[\\begin{aligned}&2\\tan\\theta=4\\end{aligned}\\]",
   "actions": [
    {
     "set": {
