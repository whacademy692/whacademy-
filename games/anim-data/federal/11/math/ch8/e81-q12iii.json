 "steps": [
  {
   "id": "s0",
   "title": "Name the half-angles",
   "text": "\\[\\begin{aligned}&A=\\dfrac\\alpha2,\\ B=\\dfrac\\beta2,\\ C=\\dfrac\\gamma2\\\\[5pt]&A+B+C=90^\\circ\\ \\Rightarrow\\ A+B=90^\\circ-C\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Take tan of both sides",
   "text": "\\[\\begin{aligned}&\\tan(A+B)=\\tan(90^\\circ-C)=\\cot C=\\dfrac1{\\tan C}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Expand tan(A + B)",
   "text": "\\[\\begin{aligned}&\\dfrac{\\tan A+\\tan B}{1-\\tan A\\tan B}=\\dfrac1{\\tan C}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Cross-multiply",
   "text": "\\[\\begin{aligned}&(\\tan A+\\tan B)\\tan C=1-\\tan A\\tan B\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Collect the terms",
   "text": "\\[\\begin{aligned}&\\tan A\\tan C+\\tan B\\tan C+\\tan A\\tan B=1\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\tan A\\tan B+\\tan B\\tan C+\\tan C\\tan A-1=0}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
 ],
