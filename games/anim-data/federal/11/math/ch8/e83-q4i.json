 "steps": [
  {
   "id": "s0",
   "title": "Use cos 60° = 1/2",
   "text": "\\[\\begin{aligned}&\\cos60^\\circ=\\dfrac12\\\\[5pt]&\\text{So we first need cos 80° cos 40° cos 20°;}\\\\[5pt]&\\text{it should equal 1/8.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Pair cos 40° cos 20°",
   "text": "\\[\\begin{aligned}&\\cos40^\\circ\\cos20^\\circ=\\tfrac12\\big[\\cos60^\\circ+\\cos20^\\circ\\big]=\\tfrac12\\Big[\\dfrac12+\\cos20^\\circ\\Big]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Multiply by cos 80°",
   "text": "\\[\\begin{aligned}&\\cos80^\\circ\\cos40^\\circ\\cos20^\\circ=\\tfrac14\\cos80^\\circ+\\tfrac12\\cos80^\\circ\\cos20^\\circ\\\\[5pt]&\\cos80^\\circ\\cos20^\\circ=\\tfrac12\\cos100^\\circ+\\tfrac14\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Collect the terms",
   "text": "\\[\\begin{aligned}&{}=\\tfrac14\\cos80^\\circ+\\tfrac14\\cos100^\\circ+\\tfrac18=\\tfrac14(\\cos80^\\circ+\\cos100^\\circ)+\\tfrac18\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Cancel the cosines",
   "text": "\\[\\begin{aligned}&\\cos100^\\circ=-\\cos80^\\circ,\\ \\text{so the bracket is }0\\\\[5pt]&\\cos80^\\circ\\cos40^\\circ\\cos20^\\circ=\\textcolor{#047857}{\\mathbf{\\dfrac18}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Multiply by cos 60°",
   "text": "\\[\\begin{aligned}&\\cos80^\\circ\\cos60^\\circ\\cos40^\\circ\\cos20^\\circ=\\dfrac12\\times\\dfrac18=\\textcolor{#047857}{\\mathbf{\\dfrac1{16}}}\\ \\blacksquare\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
