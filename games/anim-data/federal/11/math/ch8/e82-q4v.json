 "steps": [
  {
   "id": "s0",
   "title": "Find sin θ, cos θ",
   "text": "\\[\\begin{aligned}&\\sin\\theta=\\dfrac1{\\csc\\theta}=\\dfrac1{\\sqrt2}\\\\[5pt]&\\text{θ is in quadrant II, so cos θ is negative.}\\\\[5pt]&\\cos\\theta=\\textcolor{#047857}{\\mathbf{-\\dfrac1{\\sqrt2}}}\\quad(\\theta=135^\\circ)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Double angles",
   "text": "\\[\\begin{aligned}&\\sin2\\theta=2\\sin\\theta\\cos\\theta=\\textcolor{#047857}{\\mathbf{-1}}\\\\[5pt]&\\cos2\\theta=\\cos^2\\theta-\\sin^2\\theta=\\textcolor{#047857}{\\mathbf{0}}\\\\[5pt]&\\tan2\\theta=\\dfrac{-1}{0}=\\textcolor{#047857}{\\mathbf{\\text{undefined}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Quadrant of θ/2",
   "text": "\\[\\begin{aligned}&\\text{π/2 $<$ θ $<$ π gives π/4 $<$ θ/2 $<$ π/2.}\\\\[5pt]&\\text{So θ/2 is in quadrant I: sin, cos and tan}\\\\[5pt]&\\text{are all positive.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Half angles",
   "text": "\\[\\begin{aligned}&\\sin\\dfrac\\theta2=\\sqrt{\\dfrac{1+\\frac{\\sqrt2}2}2}=\\textcolor{#047857}{\\mathbf{\\dfrac{\\sqrt{2+\\sqrt2}}2}}\\approx0.9239\\\\[5pt]&\\cos\\dfrac\\theta2=\\sqrt{\\dfrac{1-\\frac{\\sqrt2}2}2}=\\textcolor{#047857}{\\mathbf{\\dfrac{\\sqrt{2-\\sqrt2}}2}}\\approx0.3827\\\\[5pt]&\\tan\\dfrac\\theta2=\\dfrac{1-\\cos\\theta}{\\sin\\theta}=\\textcolor{#047857}{\\mathbf{\\sqrt2+1}}\\quad\\text{(cross-check)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
