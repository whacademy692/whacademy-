     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use sin(A − B)",
   "text": "\\[\\begin{aligned}&{}=\\sin180^\\circ\\cos60^\\circ-\\cos180^\\circ\\sin60^\\circ\\\\[5pt]&{}=0-(-1)\\dfrac{\\sqrt3}2=\\textcolor{#047857}{\\mathbf{\\dfrac{\\sqrt3}2}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Divide for tan",
   "text": "\\[\\begin{aligned}&\\text{From the previous part, $\\cos120^\\circ=-\\frac12$.}\\\\[5pt]&\\tan120^\\circ=\\dfrac{\\sin120^\\circ}{\\cos120^\\circ}=\\dfrac{\\sqrt3/2}{-1/2}=\\textcolor{#047857}{\\mathbf{-\\sqrt3}}\\end{aligned}\\]",
