 "steps": [
  {
   "id": "s0",
   "title": "Write 120° as 180° − 60°",
   "text": "\\[\\begin{aligned}&\\sin120^\\circ=\\sin(180^\\circ-60^\\circ)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
