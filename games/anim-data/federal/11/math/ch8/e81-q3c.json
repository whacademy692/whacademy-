 "steps": [
  {
   "id": "s0",
   "title": "Write 75° as 120° − 45°",
   "text": "\\[\\begin{aligned}&75^\\circ=120^\\circ-45^\\circ\\\\[5pt]&\\text{Use $\\cos120^\\circ=-\\frac12$ and $\\sin120^\\circ=\\frac{\\sqrt3}2$ from earlier.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use cos(A − B)",
   "text": "\\[\\begin{aligned}&\\cos75^\\circ=\\cos120^\\circ\\cos45^\\circ+\\sin120^\\circ\\sin45^\\circ\\\\[5pt]&{}=\\Big(-\\dfrac12\\Big)\\dfrac{\\sqrt2}2+\\dfrac{\\sqrt3}2\\cdot\\dfrac{\\sqrt2}2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Simplify",
   "text": "\\[\\begin{aligned}&{}=\\dfrac{-\\sqrt2+\\sqrt6}4\\\\[5pt]&\\cos75^\\circ=\\textcolor{#047857}{\\mathbf{\\dfrac{\\sqrt6-\\sqrt2}4}}\\\\[5pt]&\\text{This is about 0.259, small and positive,}\\\\[5pt]&\\text{which suits an angle near 90°.}\\end{aligned}\\]",
   "actions": [
