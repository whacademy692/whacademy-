 "steps": [
  {
   "id": "s0",
   "title": "Ratios of α",
   "text": "\\[\\begin{aligned}&\\text{α is in quadrant I and sin α = 3/5, so the}\\\\[5pt]&\\text{adjacent side is 4.}\\\\[5pt]&\\cos\\alpha=\\textcolor{#047857}{\\mathbf{\\dfrac45}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Ratios of β",
   "text": "\\[\\begin{aligned}&\\text{β is in quadrant IV, where cos is positive}\\\\[5pt]&\\text{and sin is negative.}\\\\[5pt]&\\sin\\beta=-\\sqrt{1-\\dfrac{144}{169}}=\\textcolor{#047857}{\\mathbf{-\\dfrac5{13}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find sin(α + β)",
   "text": "\\[\\begin{aligned}&\\sin(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\\\[5pt]&{}=\\dfrac35\\cdot\\dfrac{12}{13}+\\dfrac45\\Big(-\\dfrac5{13}\\Big)\\\\[5pt]&{}=\\dfrac{36}{65}-\\dfrac{20}{65}=\\textcolor{#047857}{\\mathbf{\\dfrac{16}{65}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Take the reciprocal",
   "text": "\\[\\begin{aligned}&\\csc(\\alpha+\\beta)=\\dfrac1{\\sin(\\alpha+\\beta)}=\\textcolor{#047857}{\\mathbf{\\dfrac{65}{16}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
