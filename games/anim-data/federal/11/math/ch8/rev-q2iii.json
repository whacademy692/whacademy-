 "steps": [
  {
   "id": "s0",
   "title": "Find the tangents",
   "text": "\\[\\begin{aligned}&\\tan\\theta=-\\dfrac34,\\quad\\tan\\varphi=\\dfrac5{12}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use the formula",
   "text": "\\[\\begin{aligned}&\\tan(\\theta+\\varphi)=\\dfrac{\\tan\\theta+\\tan\\varphi}{1-\\tan\\theta\\tan\\varphi}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Top and bottom",
   "text": "\\[\\begin{aligned}&\\text{top}=-\\dfrac34+\\dfrac5{12}=-\\dfrac13,\\quad\\text{bottom}=1+\\dfrac{15}{48}=\\dfrac{63}{48}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Divide",
   "text": "\\[\\begin{aligned}&-\\dfrac13\\cdot\\dfrac{48}{63}=-\\dfrac{16}{63}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Check with sin and cos",
   "text": "\\[\\begin{aligned}&\\sin(\\theta+\\varphi)=\\dfrac{16}{65},\\quad\\cos(\\theta+\\varphi)=-\\dfrac{63}{65}\\\\[5pt]&\\dfrac{16/65}{-63/65}=-\\dfrac{16}{63}\\ \\checkmark\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Result",
