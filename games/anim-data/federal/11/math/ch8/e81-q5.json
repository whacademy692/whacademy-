 "steps": [
  {
   "id": "s0",
   "title": "Triangle for α",
   "text": "\\[\\begin{aligned}&\\text{$\\sin\\alpha=\\frac45$: opposite side 4, hypotenuse 5.}\\\\[5pt]&\\text{adjacent}=\\sqrt{5^2-4^2}=3\\\\[5pt]&\\text{Quadrant II points left, so cos is}\\\\[5pt]&\\text{negative.}\\\\[5pt]&\\cos\\alpha=\\textcolor{#047857}{\\mathbf{-\\dfrac35}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Triangle for β",
   "text": "\\[\\begin{aligned}&\\text{$\\tan\\beta=-\\frac5{12}$: legs 5 and 12.}\\\\[5pt]&\\text{hypotenuse}=\\sqrt{5^2+12^2}=13\\\\[5pt]&\\text{In quadrant II, sin is positive and cos}\\\\[5pt]&\\text{negative.}\\\\[5pt]&\\sin\\beta=\\textcolor{#047857}{\\mathbf{\\dfrac5{13}}},\\quad\\cos\\beta=\\textcolor{#047857}{\\mathbf{-\\dfrac{12}{13}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find cos(α + β)",
   "text": "\\[\\begin{aligned}&\\cos(\\alpha+\\beta)=\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=\\Big(-\\dfrac35\\Big)\\Big(-\\dfrac{12}{13}\\Big)-\\dfrac45\\cdot\\dfrac5{13}\\\\[5pt]&{}=\\dfrac{36}{65}-\\dfrac{20}{65}=\\textcolor{#047857}{\\mathbf{\\dfrac{16}{65}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Find cos(α − β)",
   "text": "\\[\\begin{aligned}&\\cos(\\alpha-\\beta)=\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\\\[5pt]&{}=\\dfrac{36}{65}+\\dfrac{20}{65}=\\textcolor{#047857}{\\mathbf{\\dfrac{56}{65}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
