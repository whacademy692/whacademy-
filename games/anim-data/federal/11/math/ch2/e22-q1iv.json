  {
   "id": "s0",
   "title": "The rule",
   "text": "\\[\\begin{aligned}&\\text{Put each pair (i, j) into the formula,}\\\\[5pt]&\\text{row by row.}\\\\[5pt]&a_{ij}=\\frac{2(i)-3(j)}{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Row 1 (i = 1)",
   "text": "\\[\\begin{aligned}&a_{11}=\\frac{2(1)-3(1)}{3}=-\\frac{1}{3}\\\\[5pt]&a_{12}=\\frac{2(1)-3(2)}{3}=-\\frac{4}{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Row 2 (i = 2)",
   "text": "\\[\\begin{aligned}&a_{21}=\\frac{2(2)-3(1)}{3}=\\frac{1}{3}\\\\[5pt]&a_{22}=\\frac{2(2)-3(2)}{3}=-\\frac{2}{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
