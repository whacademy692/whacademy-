  },
  {
   "id": "s3",
   "title": "The matrix",
   "text": "\\[\\begin{aligned}&A=\\begin{bmatrix}-\\frac{1}{3}&-\\frac{4}{3}\\\\\\frac{1}{3}&-\\frac{2}{3}\\end{bmatrix}\\\\[5pt]&\\text{Check the order: 2 rows and 2 columns.}\\\\[5pt]&\\Rightarrow\\ A=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}-\\frac{1}{3}&-\\frac{4}{3}\\\\\\frac{1}{3}&-\\frac{2}{3}\\end{bmatrix}}}\\end{aligned}\\]",
