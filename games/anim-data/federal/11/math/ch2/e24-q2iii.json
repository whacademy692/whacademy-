 "steps": [
  {
   "id": "s0",
   "title": "Name the rows",
   "text": "\\[\\begin{aligned}&\\text{Let the rows of the right$-$hand}\\\\[5pt]&\\text{determinant be A, B, C.}\\\\[5pt]&\\text{L.H.S.}=\\det(nA+B,\\ nB+C,\\ nC+A)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Split every row",
   "text": "\\[\\begin{aligned}&\\text{A determinant is additive in each row,}\\\\[5pt]&\\text{so L.H.S. is a sum of 2 $\\times$ 2 $\\times$ 2 = 8}\\\\[5pt]&\\text{determinants.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Six of them are zero",
   "text": "\\[\\begin{aligned}&\\det(nA,nB,A),\\ \\det(nA,C,A),\\ \\det(nA,C,nC)=0\\quad(\\text{two proportional rows})\\\\[5pt]&\\det(B,nB,nC),\\ \\det(B,nB,A),\\ \\det(B,C,nC)=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The two that remain",
   "text": "\\[\\begin{aligned}&\\det(nA,nB,nC)=n^3\\det(A,B,C)\\\\[5pt]&\\det(B,C,A)=\\det(A,B,C)\\quad(\\text{two row swaps: the sign returns})\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Add",
   "text": "\\[\\begin{aligned}&\\text{L.H.S.}=n^3\\det(A,B,C)+\\det(A,B,C)=(n^3+1)\\det(A,B,C)\\\\[5pt]&\\text{L.H.S. = R.H.S.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
 ],
