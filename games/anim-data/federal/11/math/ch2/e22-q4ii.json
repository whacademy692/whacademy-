 "steps": [
  {
   "id": "s0",
   "title": "Order of X",
   "text": "\\[\\begin{aligned}&\\text{The left matrix is 3 $\\times$ 2 and the product}\\\\[5pt]&\\text{is 3 $\\times$ 3, so X must be 2 $\\times$ 3.}\\\\[5pt]&X=\\begin{bmatrix}a&b&c\\\\d&e&f\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply out",
   "text": "\\[\\begin{aligned}&\\begin{bmatrix}3&2\\\\0&1\\\\2&0\\end{bmatrix}\\begin{bmatrix}a&b&c\\\\d&e&f\\end{bmatrix}=\\begin{bmatrix}\\frac{11}{2}&11&2\\\\2&4&1\\\\1&2&0\\end{bmatrix}\\\\[5pt]&\\text{Read the rows of the product:}\\\\[5pt]&3a+2d=\\frac{11}{2},\\ \\ 3b+2e=11,\\ \\ 3c+2f=2\\\\[5pt]&d=2,\\ \\ e=4,\\ \\ f=1\\\\[5pt]&2a=1,\\ \\ 2b=2,\\ \\ 2c=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Solve",
   "text": "\\[\\begin{aligned}&\\text{Rows 2 and 3 have zeros, so solve them}\\\\[5pt]&\\text{first.}\\\\[5pt]&d=2,\\ e=4,\\ f=1,\\ a=\\frac{1}{2},\\ b=1,\\ c=0\\\\[5pt]&3a+2d=\\frac{3}{2}+4=\\frac{11}{2}\\ \\checkmark\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&X=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{1}{2}&1&0\\\\2&4&1\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
