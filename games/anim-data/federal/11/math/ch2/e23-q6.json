 "steps": [
  {
   "id": "s0",
   "title": "Determinant",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 2.}\\\\[5pt]&|A|=\\begin{vmatrix}2&1&-3\\\\0&1&0\\\\2&1&6\\end{vmatrix}=a_{21}A_{21} + a_{22}A_{22} + a_{23}A_{23}\\\\[5pt]&{}=1(18)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{18}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Cofactors, row 1",
   "text": "\\[\\begin{aligned}&A_{11}=+\\begin{vmatrix}1&0\\\\1&6\\end{vmatrix}=+[16-01]=6\\\\[5pt]&A_{12}=-\\begin{vmatrix}0&0\\\\2&6\\end{vmatrix}=-[06-02]=0\\\\[5pt]&A_{13}=+\\begin{vmatrix}0&1\\\\2&1\\end{vmatrix}=+[01-12]=-2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cofactors, row 2",
   "text": "\\[\\begin{aligned}&A_{21}=-\\begin{vmatrix}1&-3\\\\1&6\\end{vmatrix}=-[16-(-3)1]=-9\\\\[5pt]&A_{22}=+\\begin{vmatrix}2&-3\\\\2&6\\end{vmatrix}=+[26-(-3)2]=18\\\\[5pt]&A_{23}=-\\begin{vmatrix}2&1\\\\2&1\\end{vmatrix}=-[21-12]=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Cofactors, row 3",
   "text": "\\[\\begin{aligned}&A_{31}=+\\begin{vmatrix}1&-3\\\\1&0\\end{vmatrix}=+[10-(-3)1]=3\\\\[5pt]&A_{32}=-\\begin{vmatrix}2&-3\\\\0&0\\end{vmatrix}=-[20-(-3)0]=0\\\\[5pt]&A_{33}=+\\begin{vmatrix}2&1\\\\0&1\\end{vmatrix}=+[21-10]=2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Adjoint",
   "text": "\\[\\begin{aligned}&\\text{The adjoint is the transpose of the}\\\\[5pt]&\\text{cofactor matrix.}\\\\[5pt]&\\text{cof}(A)=\\begin{bmatrix}6&0&-2\\\\-9&18&0\\\\3&0&2\\end{bmatrix}\\\\[5pt]&\\operatorname{adj}A=\\text{cof}(A)^{T}=\\begin{bmatrix}6&-9&3\\\\0&18&0\\\\-2&0&2\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Inverse",
   "text": "\\[\\begin{aligned}&A^{-1}=\\frac{1}{|A|}\\operatorname{adj}A=\\frac{1}{18}\\begin{bmatrix}6&-9&3\\\\0&18&0\\\\-2&0&2\\end{bmatrix}\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{1}{3}&-\\frac{1}{2}&\\frac{1}{6}\\\\0&1&0\\\\-\\frac{1}{9}&0&\\frac{1}{9}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Check",
   "text": "\\[\\begin{aligned}&A^{-1}A=\\begin{bmatrix}\\frac{1}{3}&-\\frac{1}{2}&\\frac{1}{6}\\\\0&1&0\\\\-\\frac{1}{9}&0&\\frac{1}{9}\\end{bmatrix}\\begin{bmatrix}2&1&-3\\\\0&1&0\\\\2&1&6\\end{bmatrix}=\\begin{bmatrix}1&0&0\\\\0&1&0\\\\0&0&1\\end{bmatrix}=I_3\\\\[5pt]&AA^{-1}=\\begin{bmatrix}2&1&-3\\\\0&1&0\\\\2&1&6\\end{bmatrix}\\begin{bmatrix}\\frac{1}{3}&-\\frac{1}{2}&\\frac{1}{6}\\\\0&1&0\\\\-\\frac{1}{9}&0&\\frac{1}{9}\\end{bmatrix}=\\begin{bmatrix}1&0&0\\\\0&1&0\\\\0&0&1\\end{bmatrix}=I_3\\\\[5pt]&\\text{Multiplying in the other order also}\\\\[5pt]&\\text{gives the identity matrix.}\\end{aligned}\\]",
   "actions": [
