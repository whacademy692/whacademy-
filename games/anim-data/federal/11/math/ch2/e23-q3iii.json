 "steps": [
  {
   "id": "s0",
   "title": "Choose a row",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 3 (it has the most}\\\\[5pt]&\\text{zeros).}\\\\[5pt]&|A|=\\begin{vmatrix}3 i&1&2\\\\-4&1&i\\\\2&0&1\\end{vmatrix}\\\\[5pt]&|A|=a_{31}A_{31} + a_{32}A_{32} + a_{33}A_{33}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{31}=\\begin{vmatrix}1&2\\\\1&i\\end{vmatrix}=1i-21=-2 + i\\\\[5pt]&a_{32}=0 \\Rightarrow \\text{this term is } 0\\\\[5pt]&M_{33}=\\begin{vmatrix}3 i&1\\\\-4&1\\end{vmatrix}=3 i1-1(-4)=4 + 3 i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add up",
   "text": "\\[\\begin{aligned}&|A|=2(-2 + i) + 1(4 + 3 i)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{5 i}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Decide",
   "text": "\\[\\begin{aligned}&\\text{|A| is not 0, so the matrix is}\\\\[5pt]&\\text{non$-$singular (its inverse exists).}\\\\[5pt]&|A|=5 i\\ \\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{non-singular}}}\\end{aligned}\\]",
