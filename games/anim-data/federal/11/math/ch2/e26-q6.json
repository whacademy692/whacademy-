 "steps": [
  {
   "id": "s0",
   "title": "Determinant",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&|A|=\\begin{vmatrix}3&2&1\\\\4&-1&2\\\\7&3&-3\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=3(-3) - 2(-26) + 1(19)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{62}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Cofactors, row 1",
   "text": "\\[\\begin{aligned}&A_{11}=+\\begin{vmatrix}-1&2\\\\3&-3\\end{vmatrix}=+[(-1)(-3)-23]=-3\\\\[5pt]&A_{12}=-\\begin{vmatrix}4&2\\\\7&-3\\end{vmatrix}=-[4(-3)-27]=26\\\\[5pt]&A_{13}=+\\begin{vmatrix}4&-1\\\\7&3\\end{vmatrix}=+[43-(-1)7]=19\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cofactors, row 2",
   "text": "\\[\\begin{aligned}&A_{21}=-\\begin{vmatrix}2&1\\\\3&-3\\end{vmatrix}=-[2(-3)-13]=9\\\\[5pt]&A_{22}=+\\begin{vmatrix}3&1\\\\7&-3\\end{vmatrix}=+[3(-3)-17]=-16\\\\[5pt]&A_{23}=-\\begin{vmatrix}3&2\\\\7&3\\end{vmatrix}=-[33-27]=5\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Cofactors, row 3",
   "text": "\\[\\begin{aligned}&A_{31}=+\\begin{vmatrix}2&1\\\\-1&2\\end{vmatrix}=+[22-1(-1)]=5\\\\[5pt]&A_{32}=-\\begin{vmatrix}3&1\\\\4&2\\end{vmatrix}=-[32-14]=-2\\\\[5pt]&A_{33}=+\\begin{vmatrix}3&2\\\\4&-1\\end{vmatrix}=+[3(-1)-24]=-11\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Adjoint",
   "text": "\\[\\begin{aligned}&\\text{The adjoint is the transpose of the}\\\\[5pt]&\\text{cofactor matrix.}\\\\[5pt]&\\text{cof}(A)=\\begin{bmatrix}-3&26&19\\\\9&-16&5\\\\5&-2&-11\\end{bmatrix}\\\\[5pt]&\\operatorname{adj}A=\\text{cof}(A)^{T}=\\begin{bmatrix}-3&9&5\\\\26&-16&-2\\\\19&5&-11\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Inverse",
   "text": "\\[\\begin{aligned}&A^{-1}=\\frac{1}{|A|}\\operatorname{adj}A=\\frac{1}{62}\\begin{bmatrix}-3&9&5\\\\26&-16&-2\\\\19&5&-11\\end{bmatrix}\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}-\\frac{3}{62}&\\frac{9}{62}&\\frac{5}{62}\\\\\\frac{13}{31}&-\\frac{8}{31}&-\\frac{1}{31}\\\\\\frac{19}{62}&\\frac{5}{62}&-\\frac{11}{62}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Check",
   "text": "\\[\\begin{aligned}&AA^{-1}=\\begin{bmatrix}3&2&1\\\\4&-1&2\\\\7&3&-3\\end{bmatrix}\\begin{bmatrix}-\\frac{3}{62}&\\frac{9}{62}&\\frac{5}{62}\\\\\\frac{13}{31}&-\\frac{8}{31}&-\\frac{1}{31}\\\\\\frac{19}{62}&\\frac{5}{62}&-\\frac{11}{62}\\end{bmatrix}=\\begin{bmatrix}1&0&0\\\\0&1&0\\\\0&0&1\\end{bmatrix}=I_3\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s7",
   "title": "Write the system",
   "text": "\\[\\begin{aligned}&\\left\\{\\begin{array}{l}3x+4y+7z=14\\\\2x-y+3z=4\\\\x+2y-3z=0\\end{array}\\right.\\\\[5pt]&\\text{The coefficient matrix is the transpose}\\\\[5pt]&\\text{of A: the rows of A are the columns of}\\\\[5pt]&\\text{this system.}\\\\[5pt]&A^{T}X=B,\\quad A^{T}=\\begin{bmatrix}3&4&7\\\\2&-1&3\\\\1&2&-3\\end{bmatrix},\\ B=\\begin{bmatrix}14\\\\4\\\\0\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 7
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s8",
