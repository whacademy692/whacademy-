 "steps": [
  {
   "id": "s0",
   "title": "The system",
   "text": "\\[\\begin{aligned}&\\left\\{\\begin{array}{l}-2x_2 + 3x_3=1\\\\3x_1 + 6x_2 - 3x_3=-2\\\\6x_1 + 6x_2 + 3x_3=5\\end{array}\\right.\\\\[5pt]&\\text{Cramer's rule: x\\_j = D\\_j / D, where D =}\\\\[5pt]&\\text{|A| and D\\_j is |A| with column j}\\\\[5pt]&\\text{replaced by B.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Find D",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D=\\begin{vmatrix}0&-2&3\\\\3&6&-3\\\\6&6&3\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=- (-2)(27) + 3(-18)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{0}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find D₁",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D_1=\\begin{vmatrix}1&-2&3\\\\-2&6&-3\\\\5&6&3\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=1(36) - (-2)(9) + 3(-42)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{-72}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Find D₂",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D_2=\\begin{vmatrix}0&1&3\\\\3&-2&-3\\\\6&5&3\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=- 1(27) + 3(27)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{54}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Find D₃",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D_3=\\begin{vmatrix}0&-2&1\\\\3&6&-2\\\\6&6&5\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=- (-2)(27) + 1(-18)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{36}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Decide",
   "text": "\\[\\begin{aligned}&D=0\\ \\text{and}\\ D_1=-72\\neq 0\\\\[5pt]&\\text{Cramer's rule cannot divide by zero.}\\\\[5pt]&\\text{When D = 0 and some D\\_j is not zero, the}\\\\[5pt]&\\text{system has no solution.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\text{inconsistent: no solution}}}\\end{aligned}\\]",
