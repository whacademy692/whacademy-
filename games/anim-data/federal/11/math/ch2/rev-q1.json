 "steps": [
  {
   "id": "s0",
   "title": "(i) Order of AB",
   "text": "\\[\\begin{aligned}&\\text{A is m x n and B is n x p. The two inner}\\\\[5pt]&\\text{numbers match (n), so AB exists.}\\\\[5pt]&\\text{order of }AB=\\textcolor{#047857}{\\mathbf{m\\times p}}\\\\[5pt]&\\text{Answer: (b) m x p.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "(ii) Order of AᵗA",
   "text": "\\[\\begin{aligned}&\\text{A is 1 x n, so Aᵗ is n x 1.}\\\\[5pt]&A^{T}A=(n\\times1)(1\\times n)=\\textcolor{#047857}{\\mathbf{n\\times n}}\\\\[5pt]&\\text{Answer: (d) n x n. (A Aᵗ would be 1 $\\times$ 1:}\\\\[5pt]&\\text{mind the order.)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "(iii) Cofactor rule",
   "text": "\\[\\begin{aligned}&A_{ij}=(-1)^{i+j}M_{ij}\\ \\Rightarrow\\ \\frac{A_{ij}}{M_{ij}}=\\textcolor{#047857}{\\mathbf{(-1)^{i+j}}}\\\\[5pt]&\\text{Answer: (c). The options with a\\_ij name}\\\\[5pt]&\\text{an element, not a cofactor.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "(iv) Always defined",
   "text": "\\[\\begin{aligned}&\\text{A is m x n, so Aᵗ is n x m.}\\\\[5pt]&A\\,A^{T}=(m\\times n)(n\\times m)\\ \\text{always exists}\\\\[5pt]&\\text{Addition and subtraction need equal}\\\\[5pt]&\\text{orders, which only a square matrix}\\\\[5pt]&\\text{gives. Answer: (b) multiplication.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "(v) |adj A|",
   "text": "\\[\\begin{aligned}&|\\operatorname{adj}A|=|A|^{\\,n-1}=3^{2}=\\textcolor{#047857}{\\mathbf{9}}\\\\[5pt]&\\text{Here n = 3 and |A| = 3. Answer: (c) 9.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "(vi) Missing entry",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 2 and use the given}\\\\[5pt]&\\text{value |A| = 9.}\\\\[5pt]&9=a_{21}A_{21}+a_{22}A_{22}+a_{23}A_{23}=1(2)+a_{22}(3)+2(-1)\\\\[5pt]&9=3a_{22}\\ \\Rightarrow\\ a_{22}=\\textcolor{#047857}{\\mathbf{3}}\\\\[5pt]&\\text{Answer: (b) 3.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "(vii) Singular",
   "text": "\\[\\begin{aligned}&\\text{A homogeneous system AX = 0 has a}\\\\[5pt]&\\text{non$-$trivial solution only when A is}\\\\[5pt]&\\text{singular.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{|A|=0}}\\\\[5pt]&\\text{Answer: (c).}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s7",
   "title": "(viii) No solution",
   "text": "\\[\\begin{aligned}&\\text{The system has no solution exactly when}\\\\[5pt]&\\text{the ranks differ.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\text{rank }A\\neq\\text{rank }[A|B]}}\\\\[5pt]&\\text{Answer: (b).}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 7
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s8",
   "title": "(ix) Unique solution",
   "text": "\\[\\begin{aligned}&\\text{With three unknowns, a unique solution}\\\\[5pt]&\\text{needs both ranks to equal 3.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{\\text{rank }A=\\text{rank }[A|B]=3}}\\\\[5pt]&\\text{Answer: (c).}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 8
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s9",
   "title": "(x) Which method",
   "text": "\\[\\begin{aligned}&\\text{With infinitely many solutions |A| = 0.}\\\\[5pt]&\\text{Matrix inversion needs A⁻¹ and Cramer's}\\\\[5pt]&\\text{rule divides by |A|, so both fail when}\\\\[5pt]&\\text{|A| = 0.}\\\\[5pt]&\\text{Only the echelon$-$based methods still}\\\\[5pt]&\\text{work. Answer: (c) Gauss$-$Jordan method.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 9
     },
     "at": 0
    }
   ]
  }
 ],
 "notes": [
