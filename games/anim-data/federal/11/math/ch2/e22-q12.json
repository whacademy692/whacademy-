    }
   ]
  },
  {
   "id": "s2",
   "title": "Find X",
   "text": "\\[\\begin{aligned}&X=\\frac{1}{7}\\begin{bmatrix}7&21&-7\\\\7&0&21\\end{bmatrix}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}1&3&-1\\\\1&0&3\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Find Y",
   "text": "\\[\\begin{aligned}&Y=2X-M_1=\\begin{bmatrix}2&6&-2\\\\2&0&6\\end{bmatrix}-\\begin{bmatrix}1&6&-3\\\\2&1&7\\end{bmatrix}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}1&0&1\\\\0&-1&-1\\end{bmatrix}}}\\end{aligned}\\]",
