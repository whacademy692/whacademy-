 "steps": [
  {
   "id": "s0",
   "title": "Expand along R1",
   "text": "\\[\\begin{aligned}&\\text{No row or column trick works here, so}\\\\[5pt]&\\text{expand along R1.}\\\\[5pt]&|A|=a\\left[bc-(c-a)(a+b)\\right]-(b-c)\\left[(a+c)c-(c-a)(a-b)\\right]+(b+c)\\left[(a+c)(a+b)-b(a-b)\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "The three brackets",
   "text": "\\[\\begin{aligned}&bc-(c-a)(a+b)=a^2+ab-ac\\\\[5pt]&(a+c)c-(c-a)(a-b)=a^2+c^2+bc-ab\\\\[5pt]&(a+c)(a+b)-b(a-b)=a^2+b^2+ac+bc\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Multiply out",
   "text": "\\[\\begin{aligned}&a(\\ldots)=a^3+a^2b-a^2c\\\\[5pt]&-(b-c)(\\ldots)=-a^2b-b^2c+ab^2+a^2c+c^3-abc\\\\[5pt]&(b+c)(\\ldots)=a^2b+b^3+abc+2b^2c+a^2c+ac^2+bc^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Add",
   "text": "\\[\\begin{aligned}&|A|=a^3+b^3+c^3+a^2b+a^2c+ab^2+b^2c+ac^2+bc^2\\quad(abc\\text{ terms cancel})\\\\[5pt]&(a+b+c)(a^2+b^2+c^2)=\\text{the same nine terms}\\\\[5pt]&\\text{L.H.S. = R.H.S.}\\end{aligned}\\]",
   "actions": [
