 "steps": [
  {
   "id": "s0",
   "title": "(i) Neither",
   "text": "\\[\\begin{aligned}&A=\\begin{bmatrix}2&0\\\\\\sqrt{5}&6\\\\1&9\\end{bmatrix}\\ \\Rightarrow\\ A^{T}=\\begin{bmatrix}2&\\sqrt{5}&1\\\\0&6&9\\end{bmatrix}\\\\[5pt]&\\text{The matrix is not square, so it can be}\\\\[5pt]&\\text{neither symmetric nor skew$-$symmetric.}\\\\[5pt]&\\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{neither}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "(ii) Neither",
   "text": "\\[\\begin{aligned}&B=\\begin{bmatrix}1&6&2&0\\end{bmatrix}\\ \\Rightarrow\\ B^{T}=\\begin{bmatrix}1\\\\6\\\\2\\\\0\\end{bmatrix}\\\\[5pt]&\\text{The matrix is not square, so it can be}\\\\[5pt]&\\text{neither symmetric nor skew$-$symmetric.}\\\\[5pt]&\\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{neither}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "(iii) Symmetric",
   "text": "\\[\\begin{aligned}&C=\\begin{bmatrix}2&6\\\\6&2\\end{bmatrix}\\ \\Rightarrow\\ C^{T}=\\begin{bmatrix}2&6\\\\6&2\\end{bmatrix}\\\\[5pt]&\\text{Compare $C^{T}$ with $C$: they are}\\\\[5pt]&\\text{equal.}\\\\[5pt]&C^{T}=C\\ \\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{symmetric}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "(iv) Skew-symmetric",
   "text": "\\[\\begin{aligned}&D=\\begin{bmatrix}0&1&9\\\\-1&0&5\\\\-9&-5&0\\end{bmatrix}\\ \\Rightarrow\\ D^{T}=\\begin{bmatrix}0&-1&-9\\\\1&0&-5\\\\9&5&0\\end{bmatrix}\\\\[5pt]&\\text{Compare $D^{T}$ with $-D$: the diagonal}\\\\[5pt]&\\text{is 0 and $a_{ij}=-a_{ji}$.}\\\\[5pt]&-D=\\begin{bmatrix}0&-1&-9\\\\1&0&-5\\\\9&5&0\\end{bmatrix}=D^{T}\\ \\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{skew-symmetric}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "(v) Symmetric",
   "text": "\\[\\begin{aligned}&E=\\begin{bmatrix}3&-6&9\\\\-6&2&0\\\\9&0&0\\end{bmatrix}\\ \\Rightarrow\\ E^{T}=\\begin{bmatrix}3&-6&9\\\\-6&2&0\\\\9&0&0\\end{bmatrix}\\\\[5pt]&\\text{Compare $E^{T}$ with $E$: they are}\\\\[5pt]&\\text{equal.}\\\\[5pt]&E^{T}=E\\ \\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{symmetric}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "(vi) Neither",
   "text": "\\[\\begin{aligned}&F=\\begin{bmatrix}9&0&1\\\\0&6&3\\\\0&0&1\\end{bmatrix}\\ \\Rightarrow\\ F^{T}=\\begin{bmatrix}9&0&0\\\\0&6&0\\\\1&3&1\\end{bmatrix}\\\\[5pt]&\\text{$F^{T}$ is not equal to $F$ or to $-F$}\\\\[5pt]&\\text{(for example $a_{13}=1$ but $a_{31}=0$).}\\\\[5pt]&\\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{neither}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
