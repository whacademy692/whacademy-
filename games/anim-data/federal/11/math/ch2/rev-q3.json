 "steps": [
  {
   "id": "s0",
   "title": "Name s",
   "text": "\\[\\begin{aligned}&\\text{Write s = a + 1 so every diagonal entry}\\\\[5pt]&\\text{is s.}\\\\[5pt]&\\Delta=\\begin{vmatrix}s&l&l\\\\l&s&l\\\\l&l&s\\end{vmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "C1 → C1 + C2 + C3",
   "text": "\\[\\begin{aligned}&\\text{Every row now has the same sum s + 2l in}\\\\[5pt]&\\text{the first column.}\\\\[5pt]&\\Delta=\\begin{vmatrix}s+2l&l&l\\\\s+2l&s&l\\\\s+2l&l&s\\end{vmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Take out s + 2l",
   "text": "\\[\\begin{aligned}&\\Delta=(s+2l)\\begin{vmatrix}1&l&l\\\\1&s&l\\\\1&l&s\\end{vmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "R2 → R2 − R1, R3 → R3 − R1",
   "text": "\\[\\begin{aligned}&\\Delta=(s+2l)\\begin{vmatrix}1&l&l\\\\0&s-l&0\\\\0&0&s-l\\end{vmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Triangular",
   "text": "\\[\\begin{aligned}&\\text{The determinant of a triangular matrix}\\\\[5pt]&\\text{is the product of its diagonal.}\\\\[5pt]&\\Delta=(s+2l)\\cdot1\\cdot(s-l)(s-l)=(s+2l)(s-l)^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Put s = a + 1 back",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{\\Delta=(a+1+2l)(a+1-l)^2}}\\\\[5pt]&\\text{L.H.S. = R.H.S.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
 ],
