  {
   "id": "s1",
   "title": "Rescale",
   "text": "\\[\\begin{aligned}&\\text{Multiply R1, R2, R3 by a, b, c and}\\\\[5pt]&\\text{divide C1, C2, C3 by a, b, c: the value}\\\\[5pt]&\\text{is unchanged (abc cancels).}\\\\[5pt]&|A|=\\begin{vmatrix}-bc&a(b+c)&a(b+c)\\\\b(a+c)&-ac&b(a+c)\\\\c(a+b)&c(a+b)&-ab\\end{vmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Use s",
   "text": "\\[\\begin{aligned}&a(b+c)=s-bc,\\quad b(a+c)=s-ac,\\quad c(a+b)=s-ab\\\\[5pt]&|A|=\\begin{vmatrix}-bc&s-bc&s-bc\\\\s-ac&-ac&s-ac\\\\s-ab&s-ab&-ab\\end{vmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Column operations",
   "text": "\\[\\begin{aligned}&C_2\\to C_2-C_1,\\ C_3\\to C_3-C_1\\\\[5pt]&|A|=\\begin{vmatrix}-bc&s&s\\\\s-ac&-s&0\\\\s-ab&0&-s\\end{vmatrix}=s^2\\begin{vmatrix}-bc&1&1\\\\s-ac&-1&0\\\\s-ab&0&-1\\end{vmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "R1 → R1 + R2 + R3",
   "text": "\\[\\begin{aligned}&-bc+(s-ac)+(s-ab)=2s-s=s\\\\[5pt]&|A|=s^2\\begin{vmatrix}s&0&0\\\\*&-1&0\\\\*&0&-1\\end{vmatrix}=s^2\\cdot s\\cdot[(-1)(-1)-0]\\\\[5pt]&{}=s^3=\\textcolor{#047857}{\\mathbf{(ab+bc+ca)^3}}\\end{aligned}\\]",
