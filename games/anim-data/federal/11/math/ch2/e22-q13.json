 "steps": [
  {
   "id": "s0",
   "title": "Label the equations",
   "text": "\\[\\begin{aligned}&3X+Y=M_1\\quad(1),\\qquad X+2Y=M_2\\quad(2)\\\\[5pt]&M_1=\\begin{bmatrix}2&5&3 i\\\\2 + 7 i&5&7\\\\2&2&3 i\\end{bmatrix},\\ M_2=\\begin{bmatrix}1&6&3 i\\\\7 + 2 i&5 i&7\\\\3&3&6\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Eliminate Y",
   "text": "\\[\\begin{aligned}&\\text{Multiply (1) by 2 and subtract (2).}\\\\[5pt]&6X+2Y=2M_1,\\ X+2Y=M_2\\ \\Rightarrow\\ 5X=2M_1-M_2\\\\[5pt]&2M_1-M_2=\\begin{bmatrix}3&4&3 i\\\\-3 + 12 i&10 - 5 i&7\\\\1&1&-6 + 6 i\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find X",
   "text": "\\[\\begin{aligned}&X=\\frac{1}{5}(2M_1-M_2)=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{3}{5}&\\frac{4}{5}&\\frac{3 i}{5}\\\\- \\frac{3}{5} + \\frac{12 i}{5}&2 - i&\\frac{7}{5}\\\\\\frac{1}{5}&\\frac{1}{5}&- \\frac{6}{5} + \\frac{6 i}{5}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Eliminate X",
   "text": "\\[\\begin{aligned}&\\text{Multiply (2) by 3 and subtract (1).}\\\\[5pt]&3X+6Y=3M_2,\\ 3X+Y=M_1\\ \\Rightarrow\\ 5Y=3M_2-M_1\\\\[5pt]&3M_2-M_1=\\begin{bmatrix}1&13&6 i\\\\19 - i&-5 + 15 i&14\\\\7&7&18 - 3 i\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Find Y",
   "text": "\\[\\begin{aligned}&Y=\\frac{1}{5}(3M_2-M_1)=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{1}{5}&\\frac{13}{5}&\\frac{6 i}{5}\\\\\\frac{19}{5} - \\frac{i}{5}&-1 + 3 i&\\frac{14}{5}\\\\\\frac{7}{5}&\\frac{7}{5}&\\frac{18}{5} - \\frac{3 i}{5}\\end{bmatrix}}}\\\\[5pt]&\\text{Complex entries are added and scaled}\\\\[5pt]&\\text{like numbers; just remember i squared is}\\\\[5pt]&\\text{-1.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
