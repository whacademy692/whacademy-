 "steps": [
  {
   "id": "s0",
   "title": "Choose a row",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1 (we start with the}\\\\[5pt]&\\text{first row).}\\\\[5pt]&|A|=\\begin{vmatrix}3&1&2\\\\2&3&1\\\\-4&1&-3\\end{vmatrix}\\\\[5pt]&|A|=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{11}=\\begin{vmatrix}3&1\\\\1&-3\\end{vmatrix}=3(-3)-11=-10\\\\[5pt]&M_{12}=\\begin{vmatrix}2&1\\\\-4&-3\\end{vmatrix}=2(-3)-1(-4)=-2\\\\[5pt]&M_{13}=\\begin{vmatrix}2&3\\\\-4&1\\end{vmatrix}=21-3(-4)=14\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add up",
   "text": "\\[\\begin{aligned}&|A|=3(-10) - 1(-2) + 2(14)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{0}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Decide",
