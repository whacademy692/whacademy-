 "steps": [
  {
   "id": "s0",
   "title": "Name the matrices",
   "text": "\\[\\begin{aligned}&P=\\begin{bmatrix}2&1\\\\3&2\\end{bmatrix},\\quad Q=\\begin{bmatrix}1&3\\\\2&4\\end{bmatrix},\\quad PAQ=I\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Undo P and Q",
   "text": "\\[\\begin{aligned}&\\text{Multiply on the left by $P^{-1}$ and on}\\\\[5pt]&\\text{the right by $Q^{-1}$ (never swap the}\\\\[5pt]&\\text{sides).}\\\\[5pt]&P^{-1}(PAQ)Q^{-1}=P^{-1}IQ^{-1}\\ \\Rightarrow\\ A=P^{-1}Q^{-1}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find the inverses",
   "text": "\\[\\begin{aligned}&|P|=22-13=1,\\quad P^{-1}=\\begin{bmatrix}2&-1\\\\-3&2\\end{bmatrix}\\\\[5pt]&|Q|=14-32=-2,\\quad Q^{-1}=\\frac{1}{-2}\\begin{bmatrix}4&-3\\\\-2&1\\end{bmatrix}=\\begin{bmatrix}-2&\\frac{3}{2}\\\\1&-\\frac{1}{2}\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Multiply",
   "text": "\\[\\begin{aligned}&A=P^{-1}Q^{-1}=\\begin{bmatrix}2&-1\\\\-3&2\\end{bmatrix}\\begin{bmatrix}-2&\\frac{3}{2}\\\\1&-\\frac{1}{2}\\end{bmatrix}\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}-5&\\frac{7}{2}\\\\8&-\\frac{11}{2}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Check",
   "text": "\\[\\begin{aligned}&\\text{Compute PAQ and you get the identity}\\\\[5pt]&\\text{matrix.}\\\\[5pt]&PAQ=\\begin{bmatrix}1&0\\\\0&1\\end{bmatrix}=I\\end{aligned}\\]",
   "actions": [
