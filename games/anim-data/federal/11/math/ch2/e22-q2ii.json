 "steps": [
  {
   "id": "s0",
   "title": "The rule",
   "text": "\\[\\begin{aligned}&\\text{Put each pair (i, j) into the formula,}\\\\[5pt]&\\text{row by row.}\\\\[5pt]&a_{ij}=\\frac{(i)^2-(j)^2}{2(i)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Row 1 (i = 1)",
   "text": "\\[\\begin{aligned}&a_{11}=\\frac{(1)^2-(1)^2}{2(1)}=0\\\\[5pt]&a_{12}=\\frac{(1)^2-(2)^2}{2(1)}=-\\frac{3}{2}\\\\[5pt]&a_{13}=\\frac{(1)^2-(3)^2}{2(1)}=-4\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Row 2 (i = 2)",
   "text": "\\[\\begin{aligned}&a_{21}=\\frac{(2)^2-(1)^2}{2(2)}=\\frac{3}{4}\\\\[5pt]&a_{22}=\\frac{(2)^2-(2)^2}{2(2)}=0\\\\[5pt]&a_{23}=\\frac{(2)^2-(3)^2}{2(2)}=-\\frac{5}{4}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Row 3 (i = 3)",
   "text": "\\[\\begin{aligned}&a_{31}=\\frac{(3)^2-(1)^2}{2(3)}=\\frac{4}{3}\\\\[5pt]&a_{32}=\\frac{(3)^2-(2)^2}{2(3)}=\\frac{5}{6}\\\\[5pt]&a_{33}=\\frac{(3)^2-(3)^2}{2(3)}=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "The matrix",
   "text": "\\[\\begin{aligned}&B=\\begin{bmatrix}0&-\\frac{3}{2}&-4\\\\\\frac{3}{4}&0&-\\frac{5}{4}\\\\\\frac{4}{3}&\\frac{5}{6}&0\\end{bmatrix}\\\\[5pt]&\\text{Check the order: 3 rows and 3 columns.}\\\\[5pt]&\\Rightarrow\\ B=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}0&-\\frac{3}{2}&-4\\\\\\frac{3}{4}&0&-\\frac{5}{4}\\\\\\frac{4}{3}&\\frac{5}{6}&0\\end{bmatrix}}}\\end{aligned}\\]",
