 "steps": [
  {
   "id": "s0",
   "title": "Matrix form",
   "text": "\\[\\begin{aligned}&\\left\\{\\begin{array}{l}5x + 3y + z=6\\\\2x + y + 3z=19\\\\x + 2y + 4z=25\\end{array}\\right.\\\\[5pt]&AX=B\\ \\Rightarrow\\ X=A^{-1}B,\\quad A=\\begin{bmatrix}5&3&1\\\\2&1&3\\\\1&2&4\\end{bmatrix},\\ B=\\begin{bmatrix}6\\\\19\\\\25\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Determinant",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&|A|=\\begin{vmatrix}5&3&1\\\\2&1&3\\\\1&2&4\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=5(-2) - 3(5) + 1(3)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{-22}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cofactors, row 1",
   "text": "\\[\\begin{aligned}&A_{11}=+\\begin{vmatrix}1&3\\\\2&4\\end{vmatrix}=+[14-32]=-2\\\\[5pt]&A_{12}=-\\begin{vmatrix}2&3\\\\1&4\\end{vmatrix}=-[24-31]=-5\\\\[5pt]&A_{13}=+\\begin{vmatrix}2&1\\\\1&2\\end{vmatrix}=+[22-11]=3\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Cofactors, row 2",
   "text": "\\[\\begin{aligned}&A_{21}=-\\begin{vmatrix}3&1\\\\2&4\\end{vmatrix}=-[34-12]=-10\\\\[5pt]&A_{22}=+\\begin{vmatrix}5&1\\\\1&4\\end{vmatrix}=+[54-11]=19\\\\[5pt]&A_{23}=-\\begin{vmatrix}5&3\\\\1&2\\end{vmatrix}=-[52-31]=-7\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Cofactors, row 3",
   "text": "\\[\\begin{aligned}&A_{31}=+\\begin{vmatrix}3&1\\\\1&3\\end{vmatrix}=+[33-11]=8\\\\[5pt]&A_{32}=-\\begin{vmatrix}5&1\\\\2&3\\end{vmatrix}=-[53-12]=-13\\\\[5pt]&A_{33}=+\\begin{vmatrix}5&3\\\\2&1\\end{vmatrix}=+[51-32]=-1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Adjoint",
   "text": "\\[\\begin{aligned}&\\text{The adjoint is the transpose of the}\\\\[5pt]&\\text{cofactor matrix.}\\\\[5pt]&\\text{cof}(A)=\\begin{bmatrix}-2&-5&3\\\\-10&19&-7\\\\8&-13&-1\\end{bmatrix}\\\\[5pt]&\\operatorname{adj}A=\\text{cof}(A)^{T}=\\begin{bmatrix}-2&-10&8\\\\-5&19&-13\\\\3&-7&-1\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Inverse",
   "text": "\\[\\begin{aligned}&A^{-1}=\\frac{1}{|A|}\\operatorname{adj}A=\\frac{1}{-22}\\begin{bmatrix}-2&-10&8\\\\-5&19&-13\\\\3&-7&-1\\end{bmatrix}\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{1}{11}&\\frac{5}{11}&-\\frac{4}{11}\\\\\\frac{5}{22}&-\\frac{19}{22}&\\frac{13}{22}\\\\-\\frac{3}{22}&\\frac{7}{22}&\\frac{1}{22}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s7",
   "title": "Find X",
   "text": "\\[\\begin{aligned}&X=A^{-1}B=\\frac{1}{-22}\\begin{bmatrix}-2&-10&8\\\\-5&19&-13\\\\3&-7&-1\\end{bmatrix}\\begin{bmatrix}6\\\\19\\\\25\\end{bmatrix}\\\\[5pt]&{}=\\frac{1}{-22}\\begin{bmatrix}-2\\\\6\\\\-140\\end{bmatrix}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{1}{11}\\\\-\\frac{3}{11}\\\\\\frac{70}{11}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
