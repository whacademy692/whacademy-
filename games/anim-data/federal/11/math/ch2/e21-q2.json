   "text": "\\[\\begin{aligned}&B=\\begin{bmatrix}\\frac{1}{3}&1\\\\2&6\\end{bmatrix},\\quad \\text{order }2\\times 2\\\\[5pt]&\\text{Reason: rows = columns = 2.}\\\\[5pt]&\\Rightarrow\\ \\textcolor{#047857}{\\mathbf{\\text{Square}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
