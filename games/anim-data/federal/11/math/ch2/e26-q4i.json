 "steps": [
  {
   "id": "s0",
   "title": "The system",
   "text": "\\[\\begin{aligned}&\\left\\{\\begin{array}{l}x_1 + x_2 + 2x_3=8\\\\-x_1 - 2x_2 + 3x_3=1\\\\3x_1 - 7x_2 + 4x_3=10\\end{array}\\right.\\\\[5pt]&\\text{Cramer's rule: x\\_j = D\\_j / D, where D =}\\\\[5pt]&\\text{|A| and D\\_j is |A| with column j}\\\\[5pt]&\\text{replaced by B.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Find D",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D=\\begin{vmatrix}1&1&2\\\\-1&-2&3\\\\3&-7&4\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=1(13) - 1(-13) + 2(13)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{52}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find D₁",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D_1=\\begin{vmatrix}8&1&2\\\\1&-2&3\\\\10&-7&4\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=8(13) - 1(-26) + 2(13)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{156}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Find D₂",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D_2=\\begin{vmatrix}1&8&2\\\\-1&1&3\\\\3&10&4\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=1(-26) - 8(-13) + 2(-13)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{52}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Find D₃",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&D_3=\\begin{vmatrix}1&1&8\\\\-1&-2&1\\\\3&-7&10\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=1(-13) - 1(-13) + 8(13)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{104}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Divide",
   "text": "\\[\\begin{aligned}&x_1=\\frac{D_1}{D}=\\frac{156}{52}=3\\\\[5pt]&x_2=\\frac{D_2}{D}=\\frac{52}{52}=1\\\\[5pt]&x_3=\\frac{D_3}{D}=\\frac{104}{52}=2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{(x_1,x_2,x_3)=\\left(3,\\ 1,\\ 2\\right)}}\\\\[5pt]&\\begin{bmatrix}1&1&2\\\\-1&-2&3\\\\3&-7&4\\end{bmatrix}\\begin{bmatrix}3\\\\1\\\\2\\end{bmatrix}=\\begin{bmatrix}8\\\\1\\\\10\\end{bmatrix}=\\begin{bmatrix}8\\\\1\\\\10\\end{bmatrix}\\\\[5pt]&\\text{The product returns B, so the solution}\\\\[5pt]&\\text{checks.}\\end{aligned}\\]",
   "actions": [
