 "steps": [
  {
   "id": "s0",
   "title": "Singular means |A| = 0",
   "text": "\\[\\begin{aligned}&\\text{Expand |A| along row 1 and set it equal}\\\\[5pt]&\\text{to 0.}\\\\[5pt]&|A|=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&M_{11}=\\begin{vmatrix}1&3\\\\1&2\\end{vmatrix}=12-31=-1\\\\[5pt]&M_{12}=\\begin{vmatrix}2&3\\\\3&2\\end{vmatrix}=22-33=-5\\\\[5pt]&M_{13}=\\begin{vmatrix}2&1\\\\3&1\\end{vmatrix}=21-13=-1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Expand",
   "text": "\\[\\begin{aligned}&|A|=(\\lambda)(-1) - i(-5) + 1(-1)\\\\[5pt]&{}=- \\lambda - 1 + 5 i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Set |A| = 0",
   "text": "\\[\\begin{aligned}&- \\lambda - 1 + 5 i=0\\\\[5pt]&\\Rightarrow\\ \\lambda=\\textcolor{#047857}{\\mathbf{-1 + 5 i}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
