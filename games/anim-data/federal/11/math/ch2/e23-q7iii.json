 "steps": [
  {
   "id": "s0",
   "title": "Why this works",
   "text": "\\[\\begin{aligned}&\\text{Since A\\^{}-1 = adj A / |A|, the law}\\\\[5pt]&\\text{(AB)\\^{}-1 = B\\^{}-1 A\\^{}-1 follows from two}\\\\[5pt]&\\text{facts: |AB| = |A||B| and adj(AB) =}\\\\[5pt]&\\text{adj(B) adj(A).}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Determinants",
   "text": "\\[\\begin{aligned}&|A|=34 + 13 i,\\qquad |B|=-2\\\\[5pt]&|A||B|=-68 - 26 i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find AB",
   "text": "\\[\\begin{aligned}&AB=\\begin{bmatrix}2&-1&6\\\\1&2&1\\\\- i&1&6\\end{bmatrix}\\begin{bmatrix}3&1&2\\\\1&0&1\\\\0&1&1\\end{bmatrix}=\\begin{bmatrix}5&8&9\\\\5&2&5\\\\1 - 3 i&6 - i&7 - 2 i\\end{bmatrix}\\\\[5pt]&|AB|=-68 - 26 i=|A||B|\\ \\checkmark\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Adjoint of A and B",
   "text": "\\[\\begin{aligned}&\\operatorname{adj}A=\\begin{bmatrix}11&12&-13\\\\-6 - i&12 + 6 i&4\\\\1 + 2 i&-2 + i&5\\end{bmatrix}\\\\[5pt]&\\operatorname{adj}B=\\begin{bmatrix}-1&1&1\\\\-1&3&-1\\\\1&-3&-1\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "adj(AB)",
   "text": "\\[\\begin{aligned}&\\operatorname{adj}(AB)=\\begin{bmatrix}-16 + i&-2 + 7 i&22\\\\-30 - 5 i&26 + 17 i&20\\\\28 + i&-22 - 19 i&-30\\end{bmatrix}\\\\[5pt]&\\operatorname{adj}B\\,\\operatorname{adj}A=\\begin{bmatrix}-16 + i&-2 + 7 i&22\\\\-30 - 5 i&26 + 17 i&20\\\\28 + i&-22 - 19 i&-30\\end{bmatrix}=\\operatorname{adj}(AB)\\ \\checkmark\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Conclude",
   "text": "\\[\\begin{aligned}&(AB)^{-1}=\\frac{\\operatorname{adj}(AB)}{|AB|}=\\frac{\\operatorname{adj}B\\,\\operatorname{adj}A}{|B|\\,|A|}=B^{-1}A^{-1}\\\\[5pt]&\\text{The law is verified.}\\end{aligned}\\]",
   "actions": [
