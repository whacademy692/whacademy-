 "steps": [
  {
   "id": "s0",
   "title": "Determinant",
   "text": "\\[\\begin{aligned}&\\text{Expand along column 2.}\\\\[5pt]&|A|=\\begin{vmatrix}i&0&1\\\\2 i&-1&- i\\\\1&0&4 i\\end{vmatrix}=a_{12}A_{12} + a_{22}A_{22} + a_{32}A_{32}\\\\[5pt]&{}=(-1)(-5)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{5}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Cofactors, row 1",
   "text": "\\[\\begin{aligned}&A_{11}=+\\begin{vmatrix}-1&- i\\\\0&4 i\\end{vmatrix}=+[(-1)4 i-(- i)0]=- 4 i\\\\[5pt]&A_{12}=-\\begin{vmatrix}2 i&- i\\\\1&4 i\\end{vmatrix}=-[2 i4 i-(- i)1]=8 - i\\\\[5pt]&A_{13}=+\\begin{vmatrix}2 i&-1\\\\1&0\\end{vmatrix}=+[2 i0-(-1)1]=1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cofactors, row 2",
   "text": "\\[\\begin{aligned}&A_{21}=-\\begin{vmatrix}0&1\\\\0&4 i\\end{vmatrix}=-[04 i-10]=0\\\\[5pt]&A_{22}=+\\begin{vmatrix}i&1\\\\1&4 i\\end{vmatrix}=+[i4 i-11]=-5\\\\[5pt]&A_{23}=-\\begin{vmatrix}i&0\\\\1&0\\end{vmatrix}=-[i0-01]=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Cofactors, row 3",
   "text": "\\[\\begin{aligned}&A_{31}=+\\begin{vmatrix}0&1\\\\-1&- i\\end{vmatrix}=+[0(- i)-1(-1)]=1\\\\[5pt]&A_{32}=-\\begin{vmatrix}i&1\\\\2 i&- i\\end{vmatrix}=-[i(- i)-12 i]=-1 + 2 i\\\\[5pt]&A_{33}=+\\begin{vmatrix}i&0\\\\2 i&-1\\end{vmatrix}=+[i(-1)-02 i]=- i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Adjoint",
   "text": "\\[\\begin{aligned}&\\text{The adjoint is the transpose of the}\\\\[5pt]&\\text{cofactor matrix.}\\\\[5pt]&\\text{cof}(A)=\\begin{bmatrix}- 4 i&8 - i&1\\\\0&-5&0\\\\1&-1 + 2 i&- i\\end{bmatrix}\\\\[5pt]&\\operatorname{adj}A=\\text{cof}(A)^{T}=\\begin{bmatrix}- 4 i&0&1\\\\8 - i&-5&-1 + 2 i\\\\1&0&- i\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Inverse",
   "text": "\\[\\begin{aligned}&A^{-1}=\\frac{1}{|A|}\\operatorname{adj}A=\\frac{1}{5}\\begin{bmatrix}- 4 i&0&1\\\\8 - i&-5&-1 + 2 i\\\\1&0&- i\\end{bmatrix}\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}- \\frac{4 i}{5}&0&\\frac{1}{5}\\\\\\frac{8}{5} - \\frac{i}{5}&-1&- \\frac{1}{5} + \\frac{2 i}{5}\\\\\\frac{1}{5}&0&- \\frac{i}{5}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Check",
   "text": "\\[\\begin{aligned}&AA^{-1}=\\begin{bmatrix}i&0&1\\\\2 i&-1&- i\\\\1&0&4 i\\end{bmatrix}\\begin{bmatrix}- \\frac{4 i}{5}&0&\\frac{1}{5}\\\\\\frac{8}{5} - \\frac{i}{5}&-1&- \\frac{1}{5} + \\frac{2 i}{5}\\\\\\frac{1}{5}&0&- \\frac{i}{5}\\end{bmatrix}=\\begin{bmatrix}1&0&0\\\\0&1&0\\\\0&0&1\\end{bmatrix}=I_3\\end{aligned}\\]",
   "actions": [
