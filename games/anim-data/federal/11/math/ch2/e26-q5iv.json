 "steps": [
  {
   "id": "s0",
   "title": "Substitute",
   "text": "\\[\\begin{aligned}&\\text{The unknowns sit in denominators. Put u}\\\\[5pt]&\\text{= 1/x, v = 1/y, w = 1/z to make the}\\\\[5pt]&\\text{system linear.}\\\\[5pt]&\\left\\{\\begin{array}{l}2u+3v+10w=4\\\\4u-6v+5w=1\\\\6u+9v-20w=2\\end{array}\\right.\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Matrix form",
   "text": "\\[\\begin{aligned}&\\left\\{\\begin{array}{l}2u + 3v + 10w=4\\\\4u - 6v + 5w=1\\\\6u + 9v - 20w=2\\end{array}\\right.\\\\[5pt]&AX=B\\ \\Rightarrow\\ X=A^{-1}B,\\quad A=\\begin{bmatrix}2&3&10\\\\4&-6&5\\\\6&9&-20\\end{bmatrix},\\ B=\\begin{bmatrix}4\\\\1\\\\2\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Determinant",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1.}\\\\[5pt]&|A|=\\begin{vmatrix}2&3&10\\\\4&-6&5\\\\6&9&-20\\end{vmatrix}=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\\\[5pt]&{}=2(75) - 3(-110) + 10(72)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{1200}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Cofactors, row 1",
   "text": "\\[\\begin{aligned}&A_{11}=+\\begin{vmatrix}-6&5\\\\9&-20\\end{vmatrix}=+[(-6)(-20)-59]=75\\\\[5pt]&A_{12}=-\\begin{vmatrix}4&5\\\\6&-20\\end{vmatrix}=-[4(-20)-56]=110\\\\[5pt]&A_{13}=+\\begin{vmatrix}4&-6\\\\6&9\\end{vmatrix}=+[49-(-6)6]=72\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Cofactors, row 2",
   "text": "\\[\\begin{aligned}&A_{21}=-\\begin{vmatrix}3&10\\\\9&-20\\end{vmatrix}=-[3(-20)-109]=150\\\\[5pt]&A_{22}=+\\begin{vmatrix}2&10\\\\6&-20\\end{vmatrix}=+[2(-20)-106]=-100\\\\[5pt]&A_{23}=-\\begin{vmatrix}2&3\\\\6&9\\end{vmatrix}=-[29-36]=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Cofactors, row 3",
   "text": "\\[\\begin{aligned}&A_{31}=+\\begin{vmatrix}3&10\\\\-6&5\\end{vmatrix}=+[35-10(-6)]=75\\\\[5pt]&A_{32}=-\\begin{vmatrix}2&10\\\\4&5\\end{vmatrix}=-[25-104]=30\\\\[5pt]&A_{33}=+\\begin{vmatrix}2&3\\\\4&-6\\end{vmatrix}=+[2(-6)-34]=-24\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Adjoint",
   "text": "\\[\\begin{aligned}&\\text{The adjoint is the transpose of the}\\\\[5pt]&\\text{cofactor matrix.}\\\\[5pt]&\\text{cof}(A)=\\begin{bmatrix}75&110&72\\\\150&-100&0\\\\75&30&-24\\end{bmatrix}\\\\[5pt]&\\operatorname{adj}A=\\text{cof}(A)^{T}=\\begin{bmatrix}75&150&75\\\\110&-100&30\\\\72&0&-24\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s7",
   "title": "Inverse",
   "text": "\\[\\begin{aligned}&A^{-1}=\\frac{1}{|A|}\\operatorname{adj}A=\\frac{1}{1200}\\begin{bmatrix}75&150&75\\\\110&-100&30\\\\72&0&-24\\end{bmatrix}\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{1}{16}&\\frac{1}{8}&\\frac{1}{16}\\\\\\frac{11}{120}&-\\frac{1}{12}&\\frac{1}{40}\\\\\\frac{3}{50}&0&-\\frac{1}{50}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 7
     },
     "at": 0
    }
   ]
  },
  {
