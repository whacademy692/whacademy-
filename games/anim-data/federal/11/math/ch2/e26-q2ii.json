  {
   "id": "s3",
   "title": "Add up",
   "text": "\\[\\begin{aligned}&|A|=1(\\lambda^{2} + 2) - (-4)(2 \\lambda - 1) + 3(- \\lambda - 4)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\lambda^{2} + 5 \\lambda - 14}}\\end{aligned}\\]",
   "actions": [
