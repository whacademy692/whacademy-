 "steps": [
  {
   "id": "s0",
   "title": "The system",
   "text": "\\[\\begin{aligned}&\\text{A homogeneous system has a non$-$trivial}\\\\[5pt]&\\text{solution exactly when |A| = 0. First}\\\\[5pt]&\\text{find λ.}\\\\[5pt]&A=\\begin{bmatrix}1&-4&3\\\\2&\\lambda&1\\\\1&-2&\\lambda\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Choose a row",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1 (we start with the}\\\\[5pt]&\\text{first row).}\\\\[5pt]&|A|=\\begin{vmatrix}1&-4&3\\\\2&\\lambda&1\\\\1&-2&\\lambda\\end{vmatrix}\\\\[5pt]&|A|=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{11}=\\begin{vmatrix}\\lambda&1\\\\-2&\\lambda\\end{vmatrix}=(\\lambda)(\\lambda)-1(-2)=\\lambda^{2} + 2\\\\[5pt]&M_{12}=\\begin{vmatrix}2&1\\\\1&\\lambda\\end{vmatrix}=2(\\lambda)-11=2 \\lambda - 1\\\\[5pt]&M_{13}=\\begin{vmatrix}2&\\lambda\\\\1&-2\\end{vmatrix}=2(-2)-(\\lambda)1=- \\lambda - 4\\end{aligned}\\]",
   "actions": [
    {
     "set": {
