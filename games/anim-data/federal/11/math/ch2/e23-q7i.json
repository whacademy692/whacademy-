 "steps": [
  {
   "id": "s0",
   "title": "Find AB",
   "text": "\\[\\begin{aligned}&AB=\\begin{bmatrix}2&1\\\\8&6\\end{bmatrix}\\begin{bmatrix}3&2\\\\0&2\\end{bmatrix}=\\begin{bmatrix}6&6\\\\24&28\\end{bmatrix}\\\\[5pt]&|AB|=6(28)-6(24)=24\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Left side",
   "text": "\\[\\begin{aligned}&\\operatorname{adj}(AB)=\\begin{bmatrix}28&-6\\\\-24&6\\end{bmatrix}\\\\[5pt]&(AB)^{-1}=\\frac{1}{24}\\begin{bmatrix}28&-6\\\\-24&6\\end{bmatrix}=\\begin{bmatrix}\\frac{7}{6}&-\\frac{1}{4}\\\\-1&\\frac{1}{4}\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find A⁻¹",
   "text": "\\[\\begin{aligned}&|A|=4,\\ \\ \\operatorname{adj}A=\\begin{bmatrix}6&-1\\\\-8&2\\end{bmatrix}\\\\[5pt]&A^{-1}=\\frac{1}{4}\\begin{bmatrix}6&-1\\\\-8&2\\end{bmatrix}=\\begin{bmatrix}\\frac{3}{2}&-\\frac{1}{4}\\\\-2&\\frac{1}{2}\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Find B⁻¹",
   "text": "\\[\\begin{aligned}&|B|=6,\\ \\ \\operatorname{adj}B=\\begin{bmatrix}2&-2\\\\0&3\\end{bmatrix}\\\\[5pt]&B^{-1}=\\frac{1}{6}\\begin{bmatrix}2&-2\\\\0&3\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{3}&-\\frac{1}{3}\\\\0&\\frac{1}{2}\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Right side",
   "text": "\\[\\begin{aligned}&B^{-1}A^{-1}=\\begin{bmatrix}\\frac{1}{3}&-\\frac{1}{3}\\\\0&\\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}\\frac{3}{2}&-\\frac{1}{4}\\\\-2&\\frac{1}{2}\\end{bmatrix}=\\textcolor{#047857}{\\mathbf{\\begin{bmatrix}\\frac{7}{6}&-\\frac{1}{4}\\\\-1&\\frac{1}{4}\\end{bmatrix}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Compare",
   "text": "\\[\\begin{aligned}&\\text{Both sides are the same matrix, so the}\\\\[5pt]&\\text{law is verified.}\\\\[5pt]&(AB)^{-1}=B^{-1}A^{-1}=\\begin{bmatrix}\\frac{7}{6}&-\\frac{1}{4}\\\\-1&\\frac{1}{4}\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
