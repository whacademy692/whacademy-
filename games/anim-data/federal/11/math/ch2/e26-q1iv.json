 "steps": [
  {
   "id": "s0",
   "title": "The system",
   "text": "\\[\\begin{aligned}&\\left\\{\\begin{array}{l}5x_1 + 6x_2 - 7x_3=0\\\\2x_1 - x_2 + x_3=0\\\\x_1 + 2x_2 + 2x_3=0\\end{array}\\right.\\\\[5pt]&\\text{Non$-$trivial solutions exist only when}\\\\[5pt]&\\text{|A| = 0.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Choose a row",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1 (we start with the}\\\\[5pt]&\\text{first row).}\\\\[5pt]&|A|=\\begin{vmatrix}5&6&-7\\\\2&-1&1\\\\1&2&2\\end{vmatrix}\\\\[5pt]&|A|=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{11}=\\begin{vmatrix}-1&1\\\\2&2\\end{vmatrix}=(-1)2-12=-4\\\\[5pt]&M_{12}=\\begin{vmatrix}2&1\\\\1&2\\end{vmatrix}=22-11=3\\\\[5pt]&M_{13}=\\begin{vmatrix}2&-1\\\\1&2\\end{vmatrix}=22-(-1)1=5\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Add up",
   "text": "\\[\\begin{aligned}&|A|=5(-4) - 6(3) + (-7)(5)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{-73}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Decide",
   "text": "\\[\\begin{aligned}&|A|=-73\\neq 0\\ \\Rightarrow\\ \\text{rank}=3\\\\[5pt]&\\text{Only the trivial solution exists.}\\\\[5pt]&\\textcolor{#047857}{\\mathbf{x_1=0,\\ x_2=0,\\ x_3=0}}\\\\[5pt]&\\text{There is no non$-$trivial solution.}\\end{aligned}\\]",
   "actions": [
