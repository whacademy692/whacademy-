 "steps": [
  {
   "id": "s0",
   "title": "The shift",
   "text": "\\[\\begin{aligned}&\\text{Moving every point h units right and k}\\\\[5pt]&\\text{units up uses (x′, y′) = (x + h, y + k);}\\\\[5pt]&\\text{left and down are negative.}\\\\[5pt]&h=1,\\quad k=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Shift matrix",
   "text": "\\[\\begin{aligned}&\\begin{bmatrix}x'\\\\y'\\end{bmatrix}=\\begin{bmatrix}x\\\\y\\end{bmatrix}+\\begin{bmatrix}1\\\\0\\end{bmatrix}\\\\[5pt]&x'=x+1,\\quad y'=y\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Old coordinates",
   "text": "\\[\\begin{aligned}&\\text{The equation must be written in the new}\\\\[5pt]&\\text{coordinates, so solve for the old ones.}\\\\[5pt]&\\text{The sign flips.}\\\\[5pt]&x=x'-1,\\quad y=y'\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Substitute",
   "text": "\\[\\begin{aligned}&2(x'-1)^{2}-5y'^{2}-10=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Expand",
   "text": "\\[\\begin{aligned}&2x'^{2}-4x'+2-5y'^{2}-10=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Transformed equation",
   "text": "\\[\\begin{aligned}&\\textcolor{#047857}{\\mathbf{2x'^{2}-5y'^{2}-4x'-8=0}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Check",
   "text": "\\[\\begin{aligned}&\\text{A point of the old curve must land on}\\\\[5pt]&\\text{the new curve.}\\\\[5pt]&(\\sqrt{5},\\ 0)\\ \\to\\ (1 + \\sqrt{5},\\ 0)\\ \\text{satisfies the new equation}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  }
 ],
