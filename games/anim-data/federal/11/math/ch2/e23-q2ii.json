 "steps": [
  {
   "id": "s0",
   "title": "Choose a row",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 2 (it has the most}\\\\[5pt]&\\text{zeros).}\\\\[5pt]&|A|=\\begin{vmatrix}2&3&-1\\\\-1&0&2\\\\3&1&4\\end{vmatrix}\\\\[5pt]&|A|=a_{21}A_{21} + a_{22}A_{22} + a_{23}A_{23}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{21}=\\begin{vmatrix}3&-1\\\\1&4\\end{vmatrix}=34-(-1)1=13\\\\[5pt]&a_{22}=0 \\Rightarrow \\text{this term is } 0\\\\[5pt]&M_{23}=\\begin{vmatrix}2&3\\\\3&1\\end{vmatrix}=21-33=-7\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add up",
   "text": "\\[\\begin{aligned}&|A|=- (-1)(13) - 2(-7)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{27}}\\end{aligned}\\]",
