 "steps": [
  {
   "id": "s0",
   "title": "The system",
   "text": "\\[\\begin{aligned}&\\text{A homogeneous system has a non$-$trivial}\\\\[5pt]&\\text{solution exactly when |A| = 0. First}\\\\[5pt]&\\text{find λ.}\\\\[5pt]&A=\\begin{bmatrix}2&- \\lambda&1\\\\2&3&-1\\\\3&-2&4\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Choose a row",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1 (we start with the}\\\\[5pt]&\\text{first row).}\\\\[5pt]&|A|=\\begin{vmatrix}2&- \\lambda&1\\\\2&3&-1\\\\3&-2&4\\end{vmatrix}\\\\[5pt]&|A|=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{11}=\\begin{vmatrix}3&-1\\\\-2&4\\end{vmatrix}=34-(-1)(-2)=10\\\\[5pt]&M_{12}=\\begin{vmatrix}2&-1\\\\3&4\\end{vmatrix}=24-(-1)3=11\\\\[5pt]&M_{13}=\\begin{vmatrix}2&3\\\\3&-2\\end{vmatrix}=2(-2)-33=-13\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Add up",
   "text": "\\[\\begin{aligned}&|A|=2(10) - (- \\lambda)(11) + 1(-13)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{11 \\lambda + 7}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Find λ",
   "text": "\\[\\begin{aligned}&|A|=11 \\lambda + 7=0\\\\[5pt]&\\lambda=\\textcolor{#047857}{\\mathbf{-\\frac{7}{11}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Matrix [A | 0]",
   "text": "\\[\\begin{aligned}&\\left[\\begin{array}{ccc|c}2&\\frac{7}{11}&1&0\\\\2&3&-1&0\\\\3&-2&4&0\\end{array}\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Row operations",
   "text": "\\[\\begin{aligned}&R_1\\to \\frac{1}{2}R_1:\\quad \\left[\\begin{array}{ccc|c}1&\\frac{7}{22}&\\frac{1}{2}&0\\\\2&3&-1&0\\\\3&-2&4&0\\end{array}\\right]\\\\[5pt]&R_2\\to R_2-2R_1:\\quad \\left[\\begin{array}{ccc|c}1&\\frac{7}{22}&\\frac{1}{2}&0\\\\0&\\frac{26}{11}&-2&0\\\\3&-2&4&0\\end{array}\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
