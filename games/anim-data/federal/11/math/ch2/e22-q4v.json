  {
   "id": "s1",
   "title": "Both sides",
   "text": "\\[\\begin{aligned}&A^2+\\alpha I=\\begin{bmatrix}\\alpha + 37&36\\\\63&\\alpha + 64\\end{bmatrix},\\qquad \\beta A=\\begin{bmatrix}3\\beta&4\\beta\\\\7\\beta&6\\beta\\end{bmatrix}\\end{aligned}\\]",
   "actions": [
