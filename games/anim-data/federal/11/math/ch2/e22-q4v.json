   "id": "s2",
   "title": "Equate entries",
   "text": "\\[\\begin{aligned}&36=4\\beta\\ \\Rightarrow\\ \\beta=\\textcolor{#047857}{\\mathbf{9}}\\\\[5pt]&37+\\alpha=3\\beta=27\\ \\Rightarrow\\ \\alpha=\\textcolor{#047857}{\\mathbf{-10}}\\end{aligned}\\]",
   "actions": [
