    }
   ]
  },
  {
   "id": "s1",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{11}=\\begin{vmatrix}2&1\\\\1&6\\end{vmatrix}=26-11=11\\\\[5pt]&M_{12}=\\begin{vmatrix}0&1\\\\- 3 i&6\\end{vmatrix}=06-1(- 3 i)=3 i\\\\[5pt]&M_{13}=\\begin{vmatrix}0&2\\\\- 3 i&1\\end{vmatrix}=01-2(- 3 i)=6 i\\end{aligned}\\]",
   "actions": [
