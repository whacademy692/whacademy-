 "steps": [
  {
   "id": "s0",
   "title": "The system",
   "text": "\\[\\begin{aligned}&\\left\\{\\begin{array}{l}2x_1 - 3x_2 + 4x_3=0\\\\x_1 - 2x_2 + 3x_3=0\\\\4x_1 + x_2 - 6x_3=0\\end{array}\\right.\\\\[5pt]&\\text{Non$-$trivial solutions exist only when}\\\\[5pt]&\\text{|A| = 0.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Choose a row",
   "text": "\\[\\begin{aligned}&\\text{Expand along row 1 (we start with the}\\\\[5pt]&\\text{first row).}\\\\[5pt]&|A|=\\begin{vmatrix}2&-3&4\\\\1&-2&3\\\\4&1&-6\\end{vmatrix}\\\\[5pt]&|A|=a_{11}A_{11} + a_{12}A_{12} + a_{13}A_{13}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Minors",
   "text": "\\[\\begin{aligned}&\\text{Cross out the row and column of each}\\\\[5pt]&\\text{entry; the signs alternate + $-$ +.}\\\\[5pt]&M_{11}=\\begin{vmatrix}-2&3\\\\1&-6\\end{vmatrix}=(-2)(-6)-31=9\\\\[5pt]&M_{12}=\\begin{vmatrix}1&3\\\\4&-6\\end{vmatrix}=1(-6)-34=-18\\\\[5pt]&M_{13}=\\begin{vmatrix}1&-2\\\\4&1\\end{vmatrix}=11-(-2)4=9\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Add up",
   "text": "\\[\\begin{aligned}&|A|=2(9) - (-3)(-18) + 4(9)\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{0}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Decide",
   "text": "\\[\\begin{aligned}&|A|=0\\ \\Rightarrow\\ \\text{non-trivial solutions exist}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Matrix [A | 0]",
   "text": "\\[\\begin{aligned}&\\left[\\begin{array}{ccc|c}2&-3&4&0\\\\1&-2&3&0\\\\4&1&-6&0\\end{array}\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Row operations",
   "text": "\\[\\begin{aligned}&R_1\\leftrightarrow R_2:\\quad \\left[\\begin{array}{ccc|c}1&-2&3&0\\\\2&-3&4&0\\\\4&1&-6&0\\end{array}\\right]\\\\[5pt]&R_2\\to R_2-2R_1:\\quad \\left[\\begin{array}{ccc|c}1&-2&3&0\\\\0&1&-2&0\\\\4&1&-6&0\\end{array}\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s7",
   "title": "Row operations",
   "text": "\\[\\begin{aligned}&R_3\\to R_3-4R_1:\\quad \\left[\\begin{array}{ccc|c}1&-2&3&0\\\\0&1&-2&0\\\\0&9&-18&0\\end{array}\\right]\\\\[5pt]&R_3\\to R_3-9R_2:\\quad \\left[\\begin{array}{ccc|c}1&-2&3&0\\\\0&1&-2&0\\\\0&0&0&0\\end{array}\\right]\\\\[5pt]&\\text{This is an echelon form: rank = 2, which}\\\\[5pt]&\\text{is less than 3 unknowns, so there is 1}\\\\[5pt]&\\text{free variable.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 7
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s8",
   "title": "Back-substitution",
   "text": "\\[\\begin{aligned}&x_3=t\\quad(\\text{free variable})\\\\[5pt]&x_2 - 2x_3=0\\ \\Rightarrow\\ x_2=2 t\\\\[5pt]&x_1 - 2x_2 + 3x_3=0\\ \\Rightarrow\\ x_1=t\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 8
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s9",
   "title": "Solution family",
   "text": "\\[\\begin{aligned}&\\text{Take t = k.}\\\\[5pt]&(x_1,x_2,x_3)=\\textcolor{#047857}{\\mathbf{(k,\\ 2k,\\ k)}}\\quad k\\in\\mathbb{R}\\end{aligned}\\]",
   "actions": [
