 "steps": [
  {
   "id": "s0",
   "title": "Define the point I",
   "text": "\\[\\begin{aligned}&\\text{Let a, b, c be the side lengths opposite}\\\\[5pt]&\\text{A, B, C.}\\\\[5pt]&\\vec I=\\frac{a\\vec A+b\\vec B+c\\vec C}{a+b+c}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Bisector from A",
   "text": "\\[\\begin{aligned}&\\vec I-\\vec A=\\frac{bc}{a+b+c}\\left[\\frac{\\overrightarrow{AB}}{|AB|}+\\frac{\\overrightarrow{AC}}{|AC|}\\right]\\\\[5pt]&\\text{The bracket is the direction of the}\\\\[5pt]&\\text{bisector of angle A.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Same for B and C",
   "text": "\\[\\begin{aligned}&\\vec I-\\vec B=\\frac{ac}{a+b+c}\\left[\\frac{\\overrightarrow{BA}}{|BA|}+\\frac{\\overrightarrow{BC}}{|BC|}\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{I lies on all three bisectors, so they}\\\\[5pt]&\\text{are concurrent.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
