 "steps": [
  {
   "id": "s0",
   "title": "Take A as origin",
   "text": "\\[\\begin{aligned}&A=\\vec0,\\;B=12\\vec a,\\;D=3\\vec b\\\\[5pt]&C=D+\\overrightarrow{DC}=3\\vec b+18\\vec a\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Find E",
   "text": "\\[\\begin{aligned}&\\text{E divides DB so that DE : EB = 1 : 2.}\\\\[5pt]&E=\\frac{1\\cdot B+2\\cdot D}{3}=\\frac{12\\vec a+6\\vec b}{3}\\\\[5pt]&\\overrightarrow{AE}=4\\vec a+2\\vec b\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find BC",
   "text": "\\[\\begin{aligned}&\\overrightarrow{BC}=C-B=6\\vec a+3\\vec b\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Compare",
   "text": "\\[\\begin{aligned}&\\overrightarrow{BC}=\\frac32\\left(4\\vec a+2\\vec b\\right)=\\frac32\\overrightarrow{AE}\\\\[5pt]&\\text{So BC is parallel to AE.}\\end{aligned}\\]",
   "actions": [
