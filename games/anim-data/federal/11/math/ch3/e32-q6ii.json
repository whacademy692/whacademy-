 "steps": [
  {
   "id": "s0",
   "title": "Equal angles",
   "text": "\\[\\begin{aligned}&\\text{Equally inclined: all three direction}\\\\[5pt]&\\text{cosines are equal.}\\\\[5pt]&\\cos\\alpha=\\cos\\beta=\\cos\\gamma=l\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use l squared sum",
   "text": "\\[\\begin{aligned}&l^2+l^2+l^2=1\\;\\Rightarrow\\;l=\\pm\\frac1{\\sqrt3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Scale by 5",
   "text": "\\[\\begin{aligned}&\\vec r=5(l\\hat\\imath +l\\hat\\jmath +l\\hat k)\\\\[5pt]&\\vec r=\\textcolor{#047857}{\\mathbf{\\pm\\frac{5}{\\sqrt3}(\\hat\\imath +\\hat\\jmath +\\hat k)}}\\end{aligned}\\]",
   "actions": [
