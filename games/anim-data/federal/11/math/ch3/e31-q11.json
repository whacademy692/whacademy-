 "steps": [
  {
   "id": "s0",
   "title": "Midpoints",
   "text": "\\[\\begin{aligned}&\\text{Let P, Q, R, S be the midpoints of AB,}\\\\[5pt]&\\text{BC, CD, DA.}\\\\[5pt]&\\vec p=\\frac{\\vec a+\\vec b}{2},\\;\\vec q=\\frac{\\vec b+\\vec c}{2}\\\\[5pt]&\\vec r=\\frac{\\vec c+\\vec d}{2},\\;\\vec s=\\frac{\\vec d+\\vec a}{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Side PQ",
   "text": "\\[\\begin{aligned}&\\overrightarrow{PQ}=\\vec q-\\vec p=\\frac{\\vec c-\\vec a}{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Side SR",
   "text": "\\[\\begin{aligned}&\\overrightarrow{SR}=\\vec r-\\vec s=\\frac{\\vec c-\\vec a}{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{PQ and SR are equal and parallel, so}\\\\[5pt]&\\text{PQRS is a parallelogram.}\\\\[5pt]&\\overrightarrow{PQ}=\\overrightarrow{SR}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
