 "steps": [
  {
   "id": "s0",
   "title": "Ohm's law for AC",
   "text": "\\[\\begin{aligned}&E=IZ\\ \\Rightarrow\\ Z=\\dfrac{E}{I}\\\\[5pt]&E=-50 + 100i\\ \\text{V},\\qquad I=-6 - 2i\\ \\text{A}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Rationalise",
   "text": "\\[\\begin{aligned}&\\text{Multiply top and bottom by the}\\\\[5pt]&\\text{conjugate of the denominator.}\\\\[5pt]&\\dfrac{\\left(-50 + 100i\\right)}{\\left(-6 - 2i\\right)}=\\dfrac{\\left(-50 + 100i\\right)\\,\\left(-6 + 2i\\right)}{\\left(-6 - 2i\\right)\\,\\left(-6 + 2i\\right)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Expand the top",
   "text": "\\[\\begin{aligned}&\\text{Numerator:}\\\\[5pt]&\\left(-50 + 100i\\right)\\left(-6 + 2i\\right)\\\\[5pt]&{}= 300 - 100i - 600i + 200i^{2}\\\\[5pt]&{}= 300 - 100i - 600i - 200\\\\[5pt]&{}= 100 - 700i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Expand the bottom",
   "text": "\\[\\begin{aligned}&\\text{Denominator (it becomes real):}\\\\[5pt]&\\left(-6 - 2i\\right)\\left(-6 + 2i\\right)\\\\[5pt]&{}= 36 - 12i + 12i - 4i^{2}\\\\[5pt]&{}= 36 - 12i + 12i + 4\\\\[5pt]&{}= 40\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Impedance",
   "text": "\\[\\begin{aligned}&Z=\\textcolor{#047857}{\\mathbf{\\frac{5}{2} - \\frac{35}{2}i\\ \\Omega}}\\\\[5pt]&\\text{Real part = resistance, imaginary part}\\\\[5pt]&\\text{= reactance.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
 ],
