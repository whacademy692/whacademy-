  {
   "id": "s0",
   "title": "Let z = x + iy",
   "text": "\\[\\begin{aligned}&z=x+iy,\\qquad \\operatorname{Re}(z)=x,\\ \\operatorname{Im}(z)=y\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "v1",
      "p2"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply by i",
   "text": "\\[\\begin{aligned}&iz=i(x+iy)=-y+ix\\\\[5pt]&\\text{The imaginary part of $iz$ is $x$.}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "v3",
      "p4",
      "a5"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s2",
   "title": "Compare",
   "text": "\\[\\begin{aligned}&\\operatorname{Im}(iz)=x=\\textcolor{#047857}{\\mathbf{\\operatorname{Re}(z)}}\\\\[5pt]&\\text{Multiplying by $i$ turns the arrow by}\\\\[5pt]&\\text{$90^\\circ$, so $x$ and $y$ swap roles}\\\\[5pt]&\\text{(picture shows $z=3+2i$).}\\end{aligned}\\]",
