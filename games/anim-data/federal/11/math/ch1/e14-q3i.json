     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Take moduli",
   "text": "\\[\\begin{aligned}&\\text{The modulus of a product is the}\\\\[5pt]&\\text{product of the moduli.}\\\\[5pt]&|z_1||z_2|\\cdots|z_n|=|a+ib|\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Write each modulus",
   "text": "\\[\\begin{aligned}&\\sqrt{x_1^{2}+y_1^{2}}\\,\\sqrt{x_2^{2}+y_2^{2}}\\cdots\\sqrt{x_n^{2}+y_n^{2}}=\\sqrt{a^{2}+b^{2}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
