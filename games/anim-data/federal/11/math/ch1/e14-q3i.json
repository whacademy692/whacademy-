  {
   "id": "s0",
   "title": "Name the factors",
   "text": "\\[\\begin{aligned}&z_r=x_r+iy_r\\ (r=1,\\dots,n),\\qquad z_1z_2\\cdots z_n=a+ib\\end{aligned}\\]",
   "actions": [
    {
     "set": {
