 "steps": [
  {
   "id": "s0",
   "title": "Let z = x + iy",
   "text": "\\[\\begin{aligned}&z=x+iy,\\qquad \\bar z=x-iy\\\\[5pt]&z-1=(x-1)+iy,\\qquad \\bar z+i=x+(1-y)i\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Use modulus",
   "text": "\\[\\begin{aligned}&(x-1)^{2}+y^{2}=x^{2}+(1-y)^{2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Expand",
   "text": "\\[\\begin{aligned}&x^{2}-2x+1+y^{2}=x^{2}+1-2y+y^{2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Cancel",
   "text": "\\[\\begin{aligned}&-2x=-2y\\ \\Rightarrow\\ y=x\\\\[5pt]&\\text{The points are equally far from $1$ and}\\\\[5pt]&\\text{$-i$ (perpendicular bisector).}\\end{aligned}\\]",
   "actions": [
