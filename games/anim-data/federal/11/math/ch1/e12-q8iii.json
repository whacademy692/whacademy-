 "steps": [
  {
   "id": "s0",
   "title": "Let z = x + iy",
   "text": "\\[\\begin{aligned}&z=x+iy,\\qquad \\bar z=x-iy\\\\[5pt]&|z-4i|=\\sqrt{x^{2}+(y-4)^{2}},\\quad |z+4i|=\\sqrt{x^{2}+(y+4)^{2}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Isolate one root",
   "text": "\\[\\begin{aligned}&\\sqrt{x^{2}+(y-4)^{2}}=10-\\sqrt{x^{2}+(y+4)^{2}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Square",
   "text": "\\[\\begin{aligned}&x^{2}+y^{2}-8y+16=100-20\\sqrt{x^{2}+(y+4)^{2}}+x^{2}+y^{2}+8y+16\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Simplify",
   "text": "\\[\\begin{aligned}&20\\sqrt{x^{2}+(y+4)^{2}}=100+16y\\ \\Rightarrow\\ 5\\sqrt{x^{2}+(y+4)^{2}}=25+4y\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "p2",
      "p3"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s4",
   "title": "Square again",
   "text": "\\[\\begin{aligned}&25x^{2}+25(y^{2}+8y+16)=625+200y+16y^{2}\\\\[5pt]&25x^{2}+9y^{2}=225\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Equation",
   "text": "\\[\\begin{aligned}&\\text{Answer:}\\quad \\textcolor{#047857}{\\mathbf{\\dfrac{x^{2}}{9}+\\dfrac{y^{2}}{25}=1}}\\\\[5pt]&\\text{The picture shows every point $z$ that}\\\\[5pt]&\\text{satisfies it.}\\end{aligned}\\]",
