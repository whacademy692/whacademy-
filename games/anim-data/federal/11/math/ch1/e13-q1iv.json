  },
  {
   "id": "s2",
   "title": "Difference of squares",
   "text": "\\[\\begin{aligned}&z^{2}-(ki)^{2}=(z+ki)(z-ki)\\\\[5pt]&{}=\\left(z+\\frac{\\sqrt{3}}{5}i\\right)\\left(z-\\frac{\\sqrt{3}}{5}i\\right)\\end{aligned}\\]",
