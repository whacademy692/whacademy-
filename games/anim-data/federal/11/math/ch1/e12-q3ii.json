 "steps": [
  {
   "id": "s0",
   "title": "Let z = x + iy",
   "text": "\\[\\begin{aligned}&z=x+iy,\\qquad \\bar z=x-iy\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Top and bottom",
   "text": "\\[\\begin{aligned}&z-\\bar z=(x+iy)-(x-iy)=2iy\\\\[5pt]&z+\\bar z=(x+iy)+(x-iy)=2x\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Divide",
   "text": "\\[\\begin{aligned}&\\dfrac{z-\\bar z}{z+\\bar z}=\\dfrac{2iy}{2x}=i\\,\\dfrac{y}{x}\\\\[5pt]&\\text{(needs $x\\neq 0$)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Name x and y",
   "text": "\\[\\begin{aligned}&{}=i\\left(\\dfrac{\\operatorname{Im}z}{\\operatorname{Re}z}\\right)\\\\[5pt]&\\text{because $y=\\operatorname{Im}z$ and}\\\\[5pt]&\\text{$x=\\operatorname{Re}z$. Hence proved.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
