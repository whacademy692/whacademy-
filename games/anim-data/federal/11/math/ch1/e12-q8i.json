   "title": "Let z = x + iy",
   "text": "\\[\\begin{aligned}&z=x+iy,\\qquad \\bar z=x-iy\\\\[5pt]&2z-i=2x+(2y-1)i\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Use modulus",
   "text": "\\[\\begin{aligned}&|2z-i|=\\sqrt{(2x)^{2}+(2y-1)^{2}}=4\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Square both sides",
   "text": "\\[\\begin{aligned}&4x^{2}+4y^{2}-4y+1=16\\end{aligned}\\]",
   "actions": []
