  {
   "id": "s0",
   "title": "Use x=x_maxe^iθ",
   "text": "\\[\\begin{aligned}&x=x_{\\max}\\left(\\cos\\theta+i\\sin\\theta\\right)\\\\[5pt]&x=\\sqrt2+\\sqrt2\\,i,\\qquad \\theta=45^\\circ\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "th": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Put in θ=45°",
   "text": "\\[\\begin{aligned}&\\cos45^\\circ=\\sin45^\\circ=\\dfrac{\\sqrt2}{2}\\\\[5pt]&x=x_{\\max}\\cdot\\dfrac{\\sqrt2}{2}\\,(1+i)\\end{aligned}\\]",
   "actions": [
    {
     "tween": {
      "th": 45
     },
     "at": 0,
     "dur": 2400
    }
   ]
  },
  {
   "id": "s2",
   "title": "Compare the parts",
   "text": "\\[\\begin{aligned}&x_{\\max}\\cdot\\dfrac{\\sqrt2}{2}=\\sqrt2\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Amplitude",
   "text": "\\[\\begin{aligned}&x_{\\max}=\\textcolor{#047857}{\\mathbf{2\\ \\text{nm}}}\\\\[5pt]&\\text{Check:}\\\\[5pt]&\\text{$|x|=\\sqrt{(\\sqrt2)^2+(\\sqrt2)^2}=\\sqrt4=2$,}\\\\[5pt]&\\text{because $|e^{i\\theta}|=1$.}\\end{aligned}\\]",
   "actions": []
  }
