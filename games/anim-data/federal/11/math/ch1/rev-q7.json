 "steps": [
  {
   "id": "s0",
   "title": "Divide by 2",
   "text": "\\[\\begin{aligned}&z^{2}-\\dfrac{11}{2}z+8=0\\ \\Rightarrow\\ z^{2}-\\dfrac{11}{2}z=-8\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Add the square of half",
   "text": "\\[\\begin{aligned}&\\text{Half of $-\\frac{11}{2}$ is}\\\\[5pt]&\\text{$-\\frac{11}{4}$; its square is}\\\\[5pt]&\\text{$\\frac{121}{16}$.}\\\\[5pt]&z^{2}-\\dfrac{11}{2}z+\\dfrac{121}{16}=-8+\\dfrac{121}{16}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Perfect square",
   "text": "\\[\\begin{aligned}&\\left(z-\\dfrac{11}{4}\\right)^{2}=\\dfrac{-128+121}{16}=-\\dfrac{7}{16}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Square root",
   "text": "\\[\\begin{aligned}&z-\\dfrac{11}{4}=\\pm\\sqrt{-\\dfrac{7}{16}}=\\pm\\dfrac{\\sqrt7}{4}\\,i\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&z=\\textcolor{#047857}{\\mathbf{\\dfrac{11\\pm i\\sqrt7}{4}}}\\\\[5pt]&\\text{The two roots are conjugates, mirror}\\\\[5pt]&\\text{images in the real axis.}\\end{aligned}\\]",
   "actions": [
