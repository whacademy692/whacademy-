 "steps": [
  {
   "id": "s0",
   "title": "Make the z² coefficient 1",
   "text": "\\[\\begin{aligned}&4z^{2}+5z-14=0\\\\[5pt]&\\text{Divide by 4.}\\\\[5pt]&z^{2}+\\frac{5}{4} z-\\frac{7}{2}=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Move the constant",
   "text": "\\[\\begin{aligned}&z^{2}+\\frac{5}{4} z=\\frac{7}{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Add the square of half",
   "text": "\\[\\begin{aligned}&\\text{Half of the $z$ coefficient is}\\\\[5pt]&\\text{$\\frac{5}{8}$; its square is}\\\\[5pt]&\\text{$\\frac{25}{64}$.}\\\\[5pt]&z^{2}+\\frac{5}{4} z+\\frac{25}{64}=\\frac{7}{2}+\\frac{25}{64}=\\frac{249}{64}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Perfect square",
   "text": "\\[\\begin{aligned}&\\left(z+\\frac{5}{8}\\right)^{2}=\\frac{249}{64}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Square root",
   "text": "\\[\\begin{aligned}&z+\\frac{5}{8}=\\pm\\sqrt{\\frac{249}{64}}=\\pm \\frac{\\sqrt{249}}{8}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&z=\\textcolor{#047857}{\\mathbf{- \\frac{5}{8}\\pm \\frac{\\sqrt{249}}{8}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
 ],
