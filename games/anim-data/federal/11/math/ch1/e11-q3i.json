 "steps": [
  {
   "id": "s0",
   "title": "Top first",
   "text": "\\[\\begin{aligned}&\\text{Multiply the top two brackets.}\\\\[5pt]&\\left(2 + i\\right)\\left(3 - 2i\\right)\\\\[5pt]&{}= 6 - 4i + 3i - 2i^{2}\\\\[5pt]&{}= 6 - 4i + 3i + 2\\\\[5pt]&{}= 8 - i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply by the conjugate",
   "text": "\\[\\begin{aligned}&\\text{Multiply top and bottom by the}\\\\[5pt]&\\text{conjugate of the denominator.}\\\\[5pt]&\\dfrac{\\left(8 - i\\right)}{\\left(1 + i\\right)}=\\dfrac{\\left(8 - i\\right)\\,\\left(1 - i\\right)}{\\left(1 + i\\right)\\,\\left(1 - i\\right)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Expand the top",
   "text": "\\[\\begin{aligned}&\\text{Numerator:}\\\\[5pt]&\\left(8 - i\\right)\\left(1 - i\\right)\\\\[5pt]&{}= 8 - 8i - i + i^{2}\\\\[5pt]&{}= 8 - 8i - i - 1\\\\[5pt]&{}= 7 - 9i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Expand the bottom",
   "text": "\\[\\begin{aligned}&\\text{Denominator (it becomes real):}\\\\[5pt]&\\left(1 + i\\right)\\left(1 - i\\right)\\\\[5pt]&{}= 1 - i + i - i^{2}\\\\[5pt]&{}= 1 - i + i + 1\\\\[5pt]&{}= 2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Divide",
   "text": "\\[\\begin{aligned}&\\dfrac{7 - 9i}{2}=\\dfrac{7}{2}+\\dfrac{-9}{2}i\\\\[5pt]&{}=\\textcolor{#047857}{\\mathbf{\\frac{7}{2} - \\frac{9}{2}i}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
 ],
