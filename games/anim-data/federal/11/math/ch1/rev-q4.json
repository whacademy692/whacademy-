 "steps": [
  {
   "id": "s0",
   "title": "Remove the fraction",
   "text": "\\[\\begin{aligned}&\\left|\\dfrac{z+2i}{z-2i}\\right|=1\\ \\Rightarrow\\ |z+2i|=|z-2i|\\\\[5pt]&\\text{$z$ is equally far from $-2i$ and from $2i$.}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "p1",
      "p2"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use x and y",
   "text": "\\[\\begin{aligned}&\\sqrt{x^{2}+(y+2)^{2}}=\\sqrt{x^{2}+(y-2)^{2}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Square and cancel",
   "text": "\\[\\begin{aligned}&x^{2}+y^{2}+4y+4=x^{2}+y^{2}-4y+4\\\\[5pt]&8y=0\\ \\Rightarrow\\ y=0\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Locus",
   "text": "\\[\\begin{aligned}&y=0\\\\[5pt]&\\text{$z$ lies on the **real axis** (the}\\\\[5pt]&\\text{perpendicular bisector of the segment}\\\\[5pt]&\\text{from $-2i$ to $2i$).}\\end{aligned}\\]",
