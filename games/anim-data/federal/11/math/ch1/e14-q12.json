 "steps": [
  {
   "id": "s0",
   "title": "Arrows for each voltage",
   "text": "\\[\\begin{aligned}&V=\\operatorname{Re}\\left(Ae^{i(t+\\varphi)}\\right)=A\\cos(t+\\varphi)\\\\[5pt]&V_A=4\\cos(t+120^\\circ)\\ \\Rightarrow\\ V_1:\\ 4\\angle 120^\\circ\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Turn sine into cosine",
   "text": "\\[\\begin{aligned}&\\text{Write $\\sin x=\\cos(x-90^\\circ)$, so the}\\\\[5pt]&\\text{sine wave becomes a cosine wave.}\\\\[5pt]&5\\sin(t+60^\\circ)=5\\cos\\left(t+60^\\circ-90^\\circ\\right)=5\\cos\\left(t-30^\\circ\\right)\\\\[5pt]&V_2:\\ 5\\angle -30^\\circ\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Add the arrows",
   "text": "\\[\\begin{aligned}&\\text{Add the two arrows tip to tail; the}\\\\[5pt]&\\text{green arrow is the total voltage.}\\\\[5pt]&\\text{Re}=4\\cos 120^\\circ+5\\cos -30^\\circ=2.33\\\\[5pt]&\\text{Im}=4\\sin 120^\\circ+5\\sin -30^\\circ=0.964\\end{aligned}\\]",
   "actions": [
    {
     "tween": {
      "th": 0
     },
     "at": 0,
     "dur": 1
    }
   ]
  },
  {
   "id": "s3",
   "title": "Size and angle of the total",
   "text": "\\[\\begin{aligned}&R=\\sqrt{2.33^{2}+0.964^{2}}\\approx 2.522\\\\[5pt]&\\varphi=\\tan^{-1}\\dfrac{0.964}{2.33}\\approx 22.48^\\circ\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Total voltage",
   "text": "\\[\\begin{aligned}&V_{\\text{total}}\\approx\\textcolor{#047857}{\\mathbf{2.52\\cos\\left(t+22.5^\\circ\\right)}}\\\\[5pt]&\\text{Press play: the green wave is the sum}\\\\[5pt]&\\text{of the two other waves.}\\end{aligned}\\]",
   "actions": [
    {
     "startClock": "th",
     "at": 0
    }
   ]
  }
 ],
