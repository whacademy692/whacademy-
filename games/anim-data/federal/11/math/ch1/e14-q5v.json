 "steps": [
  {
   "id": "s0",
   "title": "Put z=x+iy",
   "text": "\\[\\begin{aligned}&\\dfrac{1-iz}{1-z}=\\dfrac{(1+y)-ix}{(1-x)-iy}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Rationalise",
   "text": "\\[\\begin{aligned}&\\text{Multiply top and bottom by the}\\\\[5pt]&\\text{conjugate of the bottom.}\\\\[5pt]&{}=\\dfrac{\\left[(1+y)-ix\\right]\\left[(1-x)+iy\\right]}{(1-x)^{2}+y^{2}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Real and imaginary parts",
   "text": "\\[\\begin{aligned}&\\text{Re}\\propto 1-x+y,\\qquad \\text{Im}\\propto x^{2}+y^{2}-x+y\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Argument π/4",
   "text": "\\[\\begin{aligned}&\\text{Real part = imaginary part > 0.}\\\\[5pt]&1-x+y=x^{2}+y^{2}-x+y\\ \\Rightarrow\\ x^{2}+y^{2}=1\\\\[5pt]&\\text{and}\\ 1-x+y>0\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "a1",
      "a2",
      "p3",
      "p4"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\text{Cartesian form:}\\quad \\textcolor{#047857}{\\mathbf{x^{2}+y^{2}=1,\\quad y>x-1}}\\end{aligned}\\]",
   "actions": []
  }
 ],
