 "steps": [
  {
   "id": "s0",
   "title": "Read x and y",
   "text": "\\[\\begin{aligned}&z=-2 - 2i,\\quad x=-2,\\ y=-2\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "v1",
      "p2"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s1",
   "title": "Modulus r",
   "text": "\\[\\begin{aligned}&r=\\sqrt{(-2)^{2}+(-2)^{2}}=\\sqrt8=2\\sqrt2\\\\[5pt]&r=\\textcolor{#047857}{\\mathbf{2 \\sqrt{2}}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Argument θ",
   "text": "\\[\\begin{aligned}&\\text{$x<0,\\ y<0$: third quadrant, so the}\\\\[5pt]&\\text{reference angle $\\frac{\\pi}{4}$ is}\\\\[5pt]&\\text{measured from the negative real axis.}\\\\[5pt]&\\tan\\theta=\\dfrac{-2}{-2}=1\\ \\Rightarrow\\ \\theta=-\\pi+\\dfrac{\\pi}{4}\\\\[5pt]&\\theta=\\textcolor{#047857}{\\mathbf{-\\dfrac{3\\pi}{4}}}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "a5"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s3",
   "title": "Polar form",
   "text": "\\[\\begin{aligned}&z=r(\\cos\\theta+i\\sin\\theta)=\\textcolor{#047857}{\\mathbf{2 \\sqrt{2}\\left[\\cos\\left(-\\dfrac{3\\pi}{4}\\right)+i\\sin\\left(-\\dfrac{3\\pi}{4}\\right)\\right]}}\\\\[5pt]&\\text{Adding $2\\pi$ gives the same angle:}\\\\[5pt]&\\text{$\\theta=\\dfrac{5\\pi}{4}$.}\\end{aligned}\\]",
   "actions": []
  }
 ],
