 "steps": [
  {
   "id": "s0",
   "title": "Collect the arguments",
   "text": "\\[\\begin{aligned}&\\arg(z-i)+\\arg(z+i)=\\dfrac{2\\pi}{3}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Add arguments = argument of product",
   "text": "\\[\\begin{aligned}&\\arg\\left[(z-i)(z+i)\\right]=\\arg\\left(z^{2}+1\\right)=\\dfrac{2\\pi}{3}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Real and imaginary parts",
   "text": "\\[\\begin{aligned}&z^{2}+1=\\left(x^{2}-y^{2}+1\\right)+2xy\\,i\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "p2"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s3",
   "title": "Use tan2π/3=−√3",
   "text": "\\[\\begin{aligned}&\\dfrac{2xy}{x^{2}-y^{2}+1}=-\\sqrt3\\ \\Rightarrow\\ \\sqrt3x^{2}+2xy-\\sqrt3y^{2}+\\sqrt3=0\\\\[5pt]&\\text{The angle $\\frac{2\\pi}{3}$ is in the}\\\\[5pt]&\\text{second quadrant: real part negative,}\\\\[5pt]&\\text{imaginary part positive. With}\\\\[5pt]&\\text{principal arguments this is the branch}\\\\[5pt]&\\text{$x>0,\\ y>1$.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\text{Cartesian form:}\\quad \\textcolor{#047857}{\\mathbf{\\sqrt3x^{2}+2xy-\\sqrt3y^{2}+\\sqrt3=0,\\quad x>0}}\\end{aligned}\\]",
   "actions": []
  }
 ],
