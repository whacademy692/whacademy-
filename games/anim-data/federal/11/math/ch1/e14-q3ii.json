 "steps": [
  {
   "id": "s0",
   "title": "Polar form of each factor",
   "text": "\\[\\begin{aligned}&z_r=r_r\\left(\\cos\\theta_r+i\\sin\\theta_r\\right),\\qquad \\theta_r=\\tan^{-1}\\dfrac{y_r}{x_r}\\end{aligned}\\]",
   "actions": [
