     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply",
   "text": "\\[\\begin{aligned}&\\text{Moduli multiply, angles add.}\\\\[5pt]&z_1z_2\\cdots z_n=\\left(r_1\\cdots r_n\\right)\\left[\\cos\\sum\\theta_r+i\\sin\\sum\\theta_r\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Polar form of a+ib",
   "text": "\\[\\begin{aligned}&a+ib=R(\\cos\\Theta+i\\sin\\Theta),\\qquad \\Theta=\\tan^{-1}\\dfrac{b}{a}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Compare angles",
   "text": "\\[\\begin{aligned}&\\text{Two complex numbers are equal when}\\\\[5pt]&\\text{their moduli match and their angles}\\\\[5pt]&\\text{differ by a whole number of turns.}\\\\[5pt]&\\sum_{r=1}^{n}\\theta_r=\\Theta+2k\\pi,\\quad k\\in\\mathbb Z\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\sum_{r=1}^{n}\\tan^{-1}\\dfrac{y_r}{x_r}=\\tan^{-1}\\dfrac{b}{a}+2k\\pi\\\\[5pt]&\\text{The angles are the arguments of the}\\\\[5pt]&\\text{factors, as in the statement.}\\end{aligned}\\]",
