 "steps": [
  {
   "id": "s0",
   "title": "Arrows for each voltage",
   "text": "\\[\\begin{aligned}&V=\\operatorname{Re}\\left(Ae^{i(t+\\varphi)}\\right)=A\\cos(t+\\varphi)\\\\[5pt]&V_1=5\\cos(t+45^\\circ)\\ \\Rightarrow\\ V_1:\\ 5\\angle 45^\\circ\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Turn sine into cosine",
   "text": "\\[\\begin{aligned}&\\text{Write $\\sin x=\\cos(x-90^\\circ)$, so the}\\\\[5pt]&\\text{sine wave becomes a cosine wave.}\\\\[5pt]&3\\sin(t+30^\\circ)=3\\cos\\left(t+30^\\circ-90^\\circ\\right)=3\\cos\\left(t-60^\\circ\\right)\\\\[5pt]&V_2:\\ 3\\angle -60^\\circ\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Add the arrows",
   "text": "\\[\\begin{aligned}&\\text{Add the two arrows tip to tail; the}\\\\[5pt]&\\text{green arrow is the total voltage.}\\\\[5pt]&\\text{Re}=5\\cos 45^\\circ+3\\cos -60^\\circ=5.036\\\\[5pt]&\\text{Im}=5\\sin 45^\\circ+3\\sin -60^\\circ=0.937\\end{aligned}\\]",
   "actions": [
    {
     "tween": {
      "th": 0
     },
     "at": 0,
     "dur": 1
    }
   ]
  },
  {
   "id": "s3",
   "title": "Size and angle of the total",
   "text": "\\[\\begin{aligned}&R=\\sqrt{5.036^{2}+0.937^{2}}\\approx 5.122\\\\[5pt]&\\varphi=\\tan^{-1}\\dfrac{0.937}{5.036}\\approx 10.55^\\circ\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Total voltage",
   "text": "\\[\\begin{aligned}&V_{\\text{total}}\\approx\\textcolor{#047857}{\\mathbf{5.12\\cos\\left(t+10.5^\\circ\\right)}}\\\\[5pt]&\\text{Press play: the green wave is the sum}\\\\[5pt]&\\text{of the two other waves.}\\end{aligned}\\]",
   "actions": [
    {
     "startClock": "th",
     "at": 0
    }
   ]
  }
 ],
