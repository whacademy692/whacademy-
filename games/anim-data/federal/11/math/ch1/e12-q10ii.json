  {
   "id": "s2",
   "title": "Right side",
   "text": "\\[\\begin{aligned}&\\dfrac{\\bar z_1}{\\bar z_2}=\\dfrac{-3-2i}{1+3i}\\cdot\\dfrac{1-3i}{1-3i}=\\dfrac{-3+9i-2i+6i^{2}}{10}=\\dfrac{-9+7i}{10}\\end{aligned}\\]",
   "actions": [
