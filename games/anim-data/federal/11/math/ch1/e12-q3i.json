 "steps": [
  {
   "id": "s0",
   "title": "Let z = x + iy",
   "text": "\\[\\begin{aligned}&z=x+iy,\\qquad \\bar z=x-iy\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "If z is real",
   "text": "\\[\\begin{aligned}&\\text{Then $y=0$, so}\\\\[5pt]&\\bar z=x-i(0)=x=z\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "p1"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s2",
   "title": "If z = z̄",
   "text": "\\[\\begin{aligned}&x+iy=x-iy\\ \\Rightarrow\\ 2iy=0\\ \\Rightarrow\\ y=0\\\\[5pt]&\\text{so $z=x$ is real.}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "p2",
      "p3"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s3",
   "title": "Conclusion",
   "text": "\\[\\begin{aligned}&\\text{Both directions hold, so $z$ is real if}\\\\[5pt]&\\text{and only if $z=\\bar z$. On the plane}\\\\[5pt]&\\text{only points on the real axis are their}\\\\[5pt]&\\text{own mirror image.}\\end{aligned}\\]",
   "actions": []
  }
 ],
