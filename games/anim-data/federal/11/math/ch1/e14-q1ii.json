  {
   "id": "s1",
   "title": "Modulus r",
   "text": "\\[\\begin{aligned}&r=\\sqrt{3^{2}+\\left(-\\sqrt3\\right)^{2}}=\\sqrt{9+3}=\\sqrt{12}=2\\sqrt3\\\\[5pt]&r=\\textcolor{#047857}{\\mathbf{2 \\sqrt{3}}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Argument θ",
   "text": "\\[\\begin{aligned}&\\text{$x>0,\\ y<0$: fourth quadrant.}\\\\[5pt]&\\tan\\theta=\\dfrac{-\\sqrt3}{3}=-\\dfrac{1}{\\sqrt3}\\\\[5pt]&\\theta=\\textcolor{#047857}{\\mathbf{-\\dfrac{\\pi}{6}}}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "a5"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s3",
   "title": "Polar form",
   "text": "\\[\\begin{aligned}&z=r(\\cos\\theta+i\\sin\\theta)=\\textcolor{#047857}{\\mathbf{2 \\sqrt{3}\\left[\\cos\\left(-\\dfrac{\\pi}{6}\\right)+i\\sin\\left(-\\dfrac{\\pi}{6}\\right)\\right]}}\\\\[5pt]&\\text{Adding $2\\pi$ gives the same angle:}\\\\[5pt]&\\text{$\\theta=\\dfrac{11\\pi}{6}$.}\\end{aligned}\\]",
   "actions": []
  }
