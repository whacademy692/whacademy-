  {
   "id": "s0",
   "title": "Read x and y",
   "text": "\\[\\begin{aligned}&z=3 - \\sqrt{3}i,\\quad x=3,\\ y=- \\sqrt{3}\\end{aligned}\\]",
   "actions": [
