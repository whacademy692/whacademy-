 "steps": [
  {
   "id": "s0",
   "title": "Split the argument",
   "text": "\\[\\begin{aligned}&\\arg\\left(\\dfrac{z-4}{1+i}\\right)=\\arg(z-4)-\\arg(1+i)=\\arg(z-4)-\\dfrac\\pi4\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Solve for arg(z−4)",
   "text": "\\[\\begin{aligned}&0\\le\\arg(z-4)-\\dfrac\\pi4\\le\\dfrac\\pi6\\ \\Rightarrow\\ \\dfrac\\pi4\\le\\arg(z-4)\\le\\dfrac{5\\pi}{12}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Slopes of the two rays",
   "text": "\\[\\begin{aligned}&\\tan\\dfrac\\pi4=1,\\qquad \\tan\\dfrac{5\\pi}{12}=2+\\sqrt3\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "p4"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s3",
   "title": "Between the rays",
   "text": "\\[\\begin{aligned}&\\text{Both angles are in the first quadrant,}\\\\[5pt]&\\text{so $x>4$ and $y$ lies between the two ray}\\\\[5pt]&\\text{heights.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&\\text{Cartesian form:}\\quad \\textcolor{#047857}{\\mathbf{x-4\\le y\\le(2+\\sqrt3)(x-4),\\quad x>4}}\\end{aligned}\\]",
   "actions": []
  }
