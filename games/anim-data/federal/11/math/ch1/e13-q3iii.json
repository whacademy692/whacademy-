  {
   "id": "s0",
   "title": "Clear the fractions",
   "text": "\\[\\begin{aligned}&z^{2}-6z+25=0\\\\[5pt]&a=1,\\quad b=-6,\\quad c=25\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Discriminant",
   "text": "\\[\\begin{aligned}&b^{2}-4ac=(-6)^{2}-4(1)(25)=-64\\\\[5pt]&\\text{Negative, so the roots are complex.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Quadratic formula",
   "text": "\\[\\begin{aligned}&z=\\dfrac{-b\\pm\\sqrt{b^{2}-4ac}}{2a}=\\dfrac{6\\pm\\sqrt{-64}}{2}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&z=\\textcolor{#047857}{\\mathbf{\\dfrac{6\\pm \\sqrt{64}\\,i}{2}}}\\end{aligned}\\]",
