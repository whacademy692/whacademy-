  {
   "id": "s0",
   "title": "Simplify the known fraction",
   "text": "\\[\\begin{aligned}&\\dfrac{1-5i}{3-2i}\\cdot\\dfrac{3+2i}{3+2i}=\\dfrac{3+2i-15i-10i^{2}}{13}=\\dfrac{13-13i}{13}=1-i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Rationalise the others",
   "text": "\\[\\begin{aligned}&\\dfrac{x}{2+i}=\\dfrac{x(2-i)}{5},\\qquad \\dfrac{y}{2-i}=\\dfrac{y(2+i)}{5}\\\\[5pt]&\\dfrac{x(2-i)}{5}=1-i+\\dfrac{y(2+i)}{5}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Equate real parts",
   "text": "\\[\\begin{aligned}&\\dfrac{2x}{5}=1+\\dfrac{2y}{5}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Equate imaginary parts",
   "text": "\\[\\begin{aligned}&-\\dfrac{x}{5}=-1+\\dfrac{y}{5}\\end{aligned}\\]",
   "actions": [
