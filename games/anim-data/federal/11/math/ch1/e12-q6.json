 "steps": [
  {
   "id": "s0",
   "title": "Find z₁/z₂",
   "text": "\\[\\begin{aligned}&\\dfrac{3+i}{1+i}\\cdot\\dfrac{1-i}{1-i}=\\dfrac{3-3i+i-i^{2}}{2}=\\dfrac{4-2i}{2}=2-i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Take the modulus as printed",
   "text": "\\[\\begin{aligned}&\\left|2-i+\\lambda\\right|=\\left|(\\lambda+2)-i\\right|=\\sqrt{(\\lambda+2)^{2}+1}\\\\[5pt]&(\\lambda+2)^{2}+1=\\lambda+2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Check for a real λ",
   "text": "\\[\\begin{aligned}&\\text{Put $u=\\lambda+2$.}\\\\[5pt]&u^{2}-u+1=0,\\qquad \\text{discriminant}=1-4=-3<0\\\\[5pt]&\\text{So as the question is printed, no real}\\\\[5pt]&\\text{$\\lambda$ exists. The book most likely}\\\\[5pt]&\\text{means the modulus of $z_1/z_2$ only,}\\\\[5pt]&\\text{then adds $\\lambda$.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Likely intended reading",
   "text": "\\[\\begin{aligned}&\\text{Read it as}\\\\[5pt]&\\text{$\\left|\\dfrac{z_1}{z_2}\\right|+\\lambda=\\sqrt{\\lambda+2}$.}\\\\[5pt]&\\left|2-i\\right|=\\sqrt5\\ \\Rightarrow\\ \\sqrt5+\\lambda=\\sqrt{\\lambda+2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Square both sides",
   "text": "\\[\\begin{aligned}&5+2\\sqrt5\\,\\lambda+\\lambda^{2}=\\lambda+2\\\\[5pt]&\\lambda^{2}+\\left(2\\sqrt5-1\\right)\\lambda+3=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Solve",
   "text": "\\[\\begin{aligned}&\\text{discriminant}=\\left(2\\sqrt5-1\\right)^{2}-12=9-4\\sqrt5=\\left(\\sqrt5-2\\right)^{2}\\\\[5pt]&\\lambda=\\dfrac{1-2\\sqrt5\\pm\\left(\\sqrt5-2\\right)}{2}\\\\[5pt]&\\lambda=\\textcolor{#047857}{\\mathbf{-\\dfrac{1+\\sqrt5}{2}}}\\quad\\text{or}\\quad\\lambda=\\textcolor{#047857}{\\mathbf{\\dfrac{3-3\\sqrt5}{2}}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s6",
   "title": "Check both values",
   "text": "\\[\\begin{aligned}&\\text{Both make $\\sqrt5+\\lambda\\ge0$ and}\\\\[5pt]&\\text{$\\lambda+2>0$, so both work:}\\\\[5pt]&\\lambda\\approx-1.618:\\ \\sqrt5+\\lambda\\approx0.618=\\sqrt{0.382}\\\\[5pt]&\\lambda\\approx-1.854:\\ \\sqrt5+\\lambda\\approx0.382=\\sqrt{0.146}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 6
     },
     "at": 0
    }
   ]
  }
 ],
