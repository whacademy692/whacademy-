 "steps": [
  {
   "id": "s0",
   "title": "Tidy the system",
   "text": "\\[\\begin{aligned}&\\begin{aligned}(1)\\quad &\\left(1 - i\\right)z+\\left(1 + i\\right)\\omega=3\\\\(2)\\quad &2z+\\left(-2 - 5i\\right)\\omega=2 + 3i\\end{aligned}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Eliminate ω",
   "text": "\\[\\begin{aligned}&\\text{Multiply (1) by $b_2$ and (2) by $b_1$,}\\\\[5pt]&\\text{then subtract.}\\\\[5pt]&\\left(a_1b_2-a_2b_1\\right)z=p_1b_2-p_2b_1\\\\[5pt]&a_1b_2-a_2b_1=\\left(-7 - 3i\\right)-\\left(2 + 2i\\right)=-9 - 5i\\\\[5pt]&p_1b_2-p_2b_1=\\left(-6 - 15i\\right)-\\left(-1 + 5i\\right)=-5 - 20i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Solve for z",
   "text": "\\[\\begin{aligned}&z=\\dfrac{-5 - 20i}{-9 - 5i}\\\\[5pt]&\\dfrac{\\left(-5 - 20i\\right)}{\\left(-9 - 5i\\right)}=\\dfrac{\\left(-5 - 20i\\right)\\left(-9 + 5i\\right)}{\\left(-9 - 5i\\right)\\left(-9 + 5i\\right)}=\\dfrac{145 + 155i}{106}\\\\[5pt]&{}=\\frac{145}{106} + \\frac{155}{106}i\\\\[5pt]&z=\\textcolor{#047857}{\\mathbf{\\frac{145}{106} + \\frac{155}{106}i}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Eliminate z",
   "text": "\\[\\begin{aligned}&\\text{Multiply (1) by $a_2$ and (2) by $a_1$,}\\\\[5pt]&\\text{then subtract.}\\\\[5pt]&\\left(a_1b_2-a_2b_1\\right)\\omega=a_1p_2-a_2p_1\\\\[5pt]&a_1p_2-a_2p_1=\\left(5 + i\\right)-6=-1 + i\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Solve for ω",
   "text": "\\[\\begin{aligned}&\\omega=\\dfrac{-1 + i}{-9 - 5i}\\\\[5pt]&\\dfrac{\\left(-1 + i\\right)}{\\left(-9 - 5i\\right)}=\\dfrac{\\left(-1 + i\\right)\\left(-9 + 5i\\right)}{\\left(-9 - 5i\\right)\\left(-9 + 5i\\right)}=\\dfrac{4 - 14i}{106}\\\\[5pt]&{}=\\frac{2}{53} - \\frac{7}{53}i\\\\[5pt]&\\omega=\\textcolor{#047857}{\\mathbf{\\frac{2}{53} - \\frac{7}{53}i}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&z=\\textcolor{#047857}{\\mathbf{\\frac{145}{106} + \\frac{155}{106}i}},\\qquad \\omega=\\textcolor{#047857}{\\mathbf{\\frac{2}{53} - \\frac{7}{53}i}}\\\\[5pt]&\\text{Substituting back in both equations}\\\\[5pt]&\\text{gives the right-hand sides (checked).}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 5
     },
     "at": 0
    }
   ]
  }
