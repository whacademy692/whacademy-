 "steps": [
  {
   "id": "s0",
   "title": "Reduce to x+iy",
   "text": "\\[\\begin{aligned}&\\dfrac{3-2i}{2+i}\\cdot\\dfrac{2-i}{2-i}=\\dfrac{6-3i-4i+2i^{2}}{5}=\\dfrac{4-7i}{5}\\\\[5pt]&z=\\dfrac{4}{5}-\\dfrac{7}{5}i\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Read x and y",
   "text": "\\[\\begin{aligned}&x=\\frac{4}{5},\\qquad y=- \\frac{7}{5}\\end{aligned}\\]",
   "actions": [
    {
     "pulse": [
      "v1",
      "p2"
     ],
     "at": 350
    }
   ]
  },
  {
   "id": "s2",
   "title": "Pythagoras",
   "text": "\\[\\begin{aligned}&\\text{$|z|$ is the length of the arrow from $0$}\\\\[5pt]&\\text{to $z$.}\\\\[5pt]&|z|=\\sqrt{x^{2}+y^{2}}=\\sqrt{\\frac{13}{5}}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&|z|=\\textcolor{#047857}{\\mathbf{\\frac{\\sqrt{65}}{5}}}\\end{aligned}\\]",
   "actions": []
  }
 ],
