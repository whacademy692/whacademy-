    }
   ]
  },
  {
   "id": "s2",
   "title": "Ohm's law",
   "text": "\\[\\begin{aligned}&I=\\dfrac{V}{Z}=\\dfrac{4e^{3it}}{5}=0.8\\,e^{3it}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
