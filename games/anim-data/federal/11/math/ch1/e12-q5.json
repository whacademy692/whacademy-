   "id": "s2",
   "title": "Subtract",
   "text": "\\[\\begin{aligned}&(x_1+x_2)^{2}-(x_1-x_2)^{2}=4x_1x_2\\\\[5pt]&(y_1+y_2)^{2}-(y_1-y_2)^{2}=4y_1y_2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
