  {
   "id": "s0",
   "title": "Clear the fractions",
   "text": "\\[\\begin{aligned}&\\text{Multiply by 2.}\\\\[5pt]&2z^{2}-z+34=0\\\\[5pt]&a=2,\\quad b=-1,\\quad c=34\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Discriminant",
   "text": "\\[\\begin{aligned}&b^{2}-4ac=(-1)^{2}-4(2)(34)=-271\\\\[5pt]&\\text{Negative, so the roots are complex.}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Quadratic formula",
   "text": "\\[\\begin{aligned}&z=\\dfrac{-b\\pm\\sqrt{b^{2}-4ac}}{2a}=\\dfrac{1\\pm\\sqrt{-271}}{4}\\end{aligned}\\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\[\\begin{aligned}&z=\\textcolor{#047857}{\\mathbf{\\dfrac{1\\pm \\sqrt{271}\\,i}{4}}}\\end{aligned}\\]",
