 "steps": [
  {
   "id": "s0",
   "title": "Find the nth term",
   "text": "\\[\\begin{aligned}&\\text{The three factors are consecutive odd}\\\\[5pt]&\\text{numbers, starting from 2n $-$ 1.}\\\\[5pt]&a_n=(2n-1)(2n+1)(2n+3)=\\left(4n^2-1\\right)(2n+3)=8n^3+12n^2-2n-3\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Sum the nth term",
   "text": "\\[\\begin{aligned}&S_n=8\\sum k^3+12\\sum k^2-2\\sum k-3\\sum 1\\\\[5pt]&\\sum k=\\frac{n(n+1)}{2},\\quad\\sum k^2=\\frac{n(n+1)(2n+1)}{6},\\quad\\sum k^3=\\left[\\frac{n(n+1)}{2}\\right]^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Calculate",
   "text": "\\[\\begin{aligned}&{}=2n^2(n+1)^2+2n(n+1)(2n+1)-n(n+1)-3n\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Simplify",
   "text": "\\[\\begin{aligned}&{}=n\\left[2n(n+1)^2+2(n+1)(2n+1)-(n+1)-3\\right]\\\\[5pt]&{}=n\\left[2n^3+4n^2+2n+4n^2+6n+2-n-1-3\\right]=\\textcolor{#047857}{\\mathbf{n\\left(2n^3+8n^2+7n-2\\right)}}\\\\[5pt]&\\text{Check n = 1: 1(2 + 8 + 7 $-$ 2) = 15 = 1 x}\\\\[5pt]&\\text{3 $\\times$ 5.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
