 "steps": [
  {
   "id": "s0",
   "title": "Identify",
   "text": "\\[\\begin{aligned}&a=1,\\quad d=3,\\quad r=\\frac{1}{7}\\\\[5pt]&\\text{The numerators 1, 4, 7, 10 form an A.P.}\\\\[5pt]&\\text{and the powers of 1/7 a G.P.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use the A.G.S. formula",
   "text": "\\[\\begin{aligned}&S_n=\\frac{a-[a+(n-1)d]r^n}{1-r}+\\frac{dr\\left(1-r^{n-1}\\right)}{(1-r)^2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Substitute",
   "text": "\\[\\begin{aligned}&S_n=\\frac{7}{6}\\left[1-\\frac{3n-2}{7^n}\\right]+\\frac{7}{12}\\left[1-\\frac{1}{7^{n-1}}\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Simplify",
   "text": "\\[\\begin{aligned}&{}=\\frac{7}{4}-\\frac{14(3n-2)+49}{12\\cdot 7^n}=\\textcolor{#047857}{\\mathbf{\\frac{7}{4}\\left[1-\\frac{2n+1}{7^n}\\right]}}\\\\[5pt]&\\text{Check n = 2: (7/4)(44/49) = 11/7 = 1 +}\\\\[5pt]&\\text{4/7.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
