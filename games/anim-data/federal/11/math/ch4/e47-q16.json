 "steps": [
  {
   "id": "s0",
   "title": "Sum the nth term",
   "text": "\\[\\begin{aligned}&S_n=3\\sum k^2+2\\sum k+\\sum 1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use the standard sums",
   "text": "\\[\\begin{aligned}&\\sum k=\\frac{n(n+1)}{2},\\quad\\sum k^2=\\frac{n(n+1)(2n+1)}{6},\\quad\\sum k^3=\\left[\\frac{n(n+1)}{2}\\right]^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Calculate",
   "text": "\\[\\begin{aligned}&{}=\\frac{n(n+1)(2n+1)}{2}+n(n+1)+n=\\frac{n}{2}\\left[(n+1)(2n+1)+2(n+1)+2\\right]\\\\[5pt]&{}=\\frac{n}{2}\\left[2n^2+3n+1+2n+2+2\\right]=\\textcolor{#047857}{\\mathbf{\\frac{n\\left(2n^2+5n+5\\right)}{2}}}\\end{aligned}\\]",
   "actions": [
