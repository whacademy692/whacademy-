 "steps": [
  {
   "id": "s0",
   "title": "Choose the numbers",
   "text": "\\[\\begin{aligned}&\\text{Take the four numbers as a $-$ 3d, a $-$ d,}\\\\[5pt]&\\text{a + d, a + 3d.}\\\\[5pt]&\\text{Sum}=4a=24\\ \\Rightarrow\\ a=6\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use the product",
   "text": "\\[\\begin{aligned}&(a-3d)(a+3d)(a-d)(a+d)=\\left(36-9d^2\\right)\\left(36-d^2\\right)=945\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Solve for d²",
   "text": "\\[\\begin{aligned}&\\text{Let }u=d^2:\\ \\ 9(4-u)(36-u)=945\\ \\Rightarrow\\ u^2-40u+39=0\\\\[5pt]&(u-1)(u-39)=0\\ \\Rightarrow\\ d^2=1\\ \\text{or}\\ d^2=39\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Write the numbers",
   "text": "\\[\\begin{aligned}&d=\\pm 1:\\quad \\textcolor{#047857}{\\mathbf{3,\\ 5,\\ 7,\\ 9}}\\\\[5pt]&\\text{Check: 3 $\\times$ 5 $\\times$ 7 $\\times$ 9 = 945. ($d^{2}$ = 39}\\\\[5pt]&\\text{gives the irrational numbers 6 $\\pm$ $\\sqrt{39}$ and}\\\\[5pt]&\\text{6 $\\pm$ 3$\\sqrt{39}$, which are not expected here.)}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
