 "steps": [
  {
   "id": "s0",
   "title": "Choose the numbers",
   "text": "\\[\\begin{aligned}&\\text{Take them as a/r, a, ar.}\\\\[5pt]&\\frac{a}{r}\\cdot a\\cdot ar=a^3=216\\ \\Rightarrow\\ a=6\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use the sum",
   "text": "\\[\\begin{aligned}&\\frac{6}{r}+6+6r=19\\ \\Rightarrow\\ 6+6r^2=13r\\\\[5pt]&6r^2-13r+6=0\\ \\Rightarrow\\ (2r-3)(3r-2)=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Solve for r",
   "text": "\\[\\begin{aligned}&r=\\frac{3}{2}\\ \\text{or}\\ r=\\frac{2}{3}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Write the numbers",
   "text": "\\[\\begin{aligned}&r=\\frac{3}{2}:\\quad \\textcolor{#047857}{\\mathbf{4,\\ 6,\\ 9}}\\\\[5pt]&\\text{Check: 4 $\\times$ 6 $\\times$ 9 = 216 and 4 + 6 + 9 =}\\\\[5pt]&\\text{19. The other value of r gives the same}\\\\[5pt]&\\text{numbers in reverse order: 9, 6, 4.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
