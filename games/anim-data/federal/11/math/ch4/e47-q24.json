 "steps": [
  {
   "id": "s0",
   "title": "Identify",
   "text": "\\[\\begin{aligned}&\\text{The numbers 1, 4, 7, 10, ... form an}\\\\[5pt]&\\text{A.P. with d = 3 and the powers of y form}\\\\[5pt]&\\text{a G.P. with r = y.}\\\\[5pt]&S_n=1+4y+7y^2+\\cdots+(3n-2)y^{n-1}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply by y and subtract",
   "text": "\\[\\begin{aligned}&(1-y)S_n=1+3y+3y^2+\\cdots+3y^{n-1}-(3n-2)y^n\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Sum the G.P. part",
   "text": "\\[\\begin{aligned}&3y+3y^2+\\cdots+3y^{n-1}=\\frac{3y\\left(1-y^{n-1}\\right)}{1-y}\\\\[5pt]&(1-y)S_n=1+\\frac{3y\\left(1-y^{n-1}\\right)}{1-y}-(3n-2)y^n\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Solve for Sₙ",
   "text": "\\[\\begin{aligned}&S_n=\\textcolor{#047857}{\\mathbf{\\frac{1-(3n-2)y^n}{1-y}+\\frac{3y\\left(1-y^{n-1}\\right)}{(1-y)^2}}}\\\\[5pt]&\\text{Check n = 1: S = 1.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
