 "steps": [
  {
   "id": "s0",
   "title": "Turn it into an A.P.",
   "text": "\\[\\begin{aligned}&\\text{Take reciprocals.}\\\\[5pt]&a_3=\\frac{7}{6},\\qquad a_{14}=3\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Find d",
   "text": "\\[\\begin{aligned}&a_{14}-a_3=11d\\ \\Rightarrow\\ 3-\\frac{7}{6}=11d\\ \\Rightarrow\\ \\frac{11}{6}=11d\\ \\Rightarrow\\ d=\\frac{1}{6}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find a₁",
   "text": "\\[\\begin{aligned}&a_1=a_3-2d=\\frac{7}{6}-\\frac{2}{6}=\\frac{5}{6}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Write the A.P. nth term",
   "text": "\\[\\begin{aligned}&a_n=\\frac{5}{6}+(n-1)\\frac{1}{6}=\\frac{n+4}{6}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Take the reciprocal",
   "text": "\\[\\begin{aligned}&\\text{H.P. }n\\text{th term}=\\textcolor{#047857}{\\mathbf{\\frac{6}{n+4}}}\\\\[5pt]&\\frac{6}{5},\\ 1,\\ \\frac{6}{7},\\ \\frac{3}{4},\\ \\ldots\\\\[5pt]&\\text{Check: n = 3 gives 6/7 and n = 14 gives}\\\\[5pt]&\\text{6/18 = 1/3.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
