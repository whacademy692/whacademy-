  {
   "id": "s1",
   "title": "Rebound heights",
   "text": "\\[\\begin{aligned}&556\\left(\\frac{3}{4}\\right),\\ 556\\left(\\frac{3}{4}\\right)^2,\\ \\ldots,\\ 556\\left(\\frac{3}{4}\\right)^5\\\\[5pt]&\\text{This is a G.P. with $a_{1}$ = 417, r = 3/4,}\\\\[5pt]&\\text{n = 5.}\\end{aligned}\\]",
   "actions": [
