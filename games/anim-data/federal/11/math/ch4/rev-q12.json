 "steps": [
  {
   "id": "s0",
   "title": "Look at the differences",
   "text": "\\[\\begin{aligned}&4-1=3,\\ 10-4=6,\\ 21-10=11,\\ 39-21=18\\\\[5pt]&\\text{second differences: }3,\\ 5,\\ 7,\\ \\ldots\\ \\ \\text{third differences: }2,\\ 2,\\ \\ldots\\\\[5pt]&\\text{The third differences are constant, so}\\\\[5pt]&\\text{the nth term is a cubic polynomial.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Find the nth term",
   "text": "\\[\\begin{aligned}&a_n=\\frac{(2n-1)\\left(n^2-n+6\\right)}{6}=\\frac{2n^3-3n^2+13n-6}{6}\\\\[5pt]&\\text{Check: n = 1, 2, 3, 4, 5 give 1, 4, 10,}\\\\[5pt]&\\text{21, 39.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Sum with the standard sums",
   "text": "\\[\\begin{aligned}&S_n=\\frac{1}{6}\\left[2\\sum k^3-3\\sum k^2+13\\sum k-6n\\right]\\\\[5pt]&{}=\\frac{1}{6}\\left[\\frac{n^2(n+1)^2}{2}-\\frac{n(n+1)(2n+1)}{2}+\\frac{13n(n+1)}{2}-6n\\right]\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Simplify",
   "text": "\\[\\begin{aligned}&S_n=\\textcolor{#047857}{\\mathbf{\\frac{n^2\\left(n^2+11\\right)}{12}}}\\\\[5pt]&\\text{Check n = 3: 9(20)/12 = 15 = 1 + 4 + 10.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
