 "steps": [
  {
   "id": "s0",
   "title": "Identify",
   "text": "\\[\\begin{aligned}&\\text{The numbers 1, 2, 3, ... form an A.P.;}\\\\[5pt]&\\text{the powers 1, 2, $2^{2}$, ... form a G.P.}\\\\[5pt]&\\text{with r = 2.}\\\\[5pt]&S_n=1+2(2)+3(2^2)+\\cdots+n(2^{n-1})\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply by r = 2 and subtract",
   "text": "\\[\\begin{aligned}&2S_n=\\ \\ \\ \\ 1(2)+2(2^2)+\\cdots+(n-1)2^{n-1}+n\\,2^n\\\\[5pt]&S_n-2S_n=1+2+2^2+\\cdots+2^{n-1}-n\\,2^n\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Sum the G.P. part",
   "text": "\\[\\begin{aligned}&-S_n=\\frac{2^n-1}{2-1}-n\\,2^n=2^n-1-n\\,2^n\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Solve for Sₙ",
   "text": "\\[\\begin{aligned}&S_n=n\\,2^n-2^n+1=\\textcolor{#047857}{\\mathbf{(n-1)2^n+1}}\\\\[5pt]&\\text{Check n = 2: 1 + 4 = 5 = (1)(4) + 1.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
