 "steps": [
  {
   "id": "s0",
   "title": "Choose the numbers",
   "text": "\\[\\begin{aligned}&\\text{Take them as a $-$ 3d, a $-$ d, a + d, a +}\\\\[5pt]&\\text{3d.}\\\\[5pt]&4a=6\\ \\Rightarrow\\ a=\\frac{3}{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Use the sum of squares",
   "text": "\\[\\begin{aligned}&(a-3d)^2+(a-d)^2+(a+d)^2+(a+3d)^2=4a^2+20d^2=14\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Solve for d",
   "text": "\\[\\begin{aligned}&4\\left(\\frac{9}{4}\\right)+20d^2=14\\ \\Rightarrow\\ 20d^2=5\\ \\Rightarrow\\ d=\\pm\\frac{1}{2}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Write the numbers",
   "text": "\\[\\begin{aligned}&\\frac{3}{2}-\\frac{3}{2},\\ \\frac{3}{2}-\\frac{1}{2},\\ \\frac{3}{2}+\\frac{1}{2},\\ \\frac{3}{2}+\\frac{3}{2}=\\textcolor{#047857}{\\mathbf{0,\\ 1,\\ 2,\\ 3}}\\\\[5pt]&\\text{Check: 0 + 1 + 2 + 3 = 6 and 0 + 1 + 4 +}\\\\[5pt]&\\text{9 = 14.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  }
 ],
