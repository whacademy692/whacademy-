 "steps": [
  {
   "id": "s0",
   "title": "Find the nth term",
   "text": "\\[\\begin{aligned}&a_n=(2n-1)^3=8n^3-12n^2+6n-1\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Sum the nth term",
   "text": "\\[\\begin{aligned}&S_n=8\\sum k^3-12\\sum k^2+6\\sum k-\\sum 1\\\\[5pt]&\\sum k=\\frac{n(n+1)}{2},\\quad\\sum k^2=\\frac{n(n+1)(2n+1)}{6},\\quad\\sum k^3=\\left[\\frac{n(n+1)}{2}\\right]^2\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Calculate",
   "text": "\\[\\begin{aligned}&{}=2n^2(n+1)^2-2n(n+1)(2n+1)+3n(n+1)-n\\\\[5pt]&{}=n\\left[2n(n+1)^2-2(n+1)(2n+1)+3(n+1)-1\\right]\\\\[5pt]&{}=n\\left[2n^3+4n^2+2n-4n^2-6n-2+3n+3-1\\right]=n\\left[2n^3-n\\right]=\\textcolor{#047857}{\\mathbf{n^2\\left(2n^2-1\\right)}}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  }
 ],
