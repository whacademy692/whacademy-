 "steps": [
  {
   "id": "s0",
   "title": "Write the H.M.",
   "text": "\\[\\begin{aligned}&H=\\frac{2ab}{a+b}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Set the two equal",
   "text": "\\[\\begin{aligned}&\\frac{a^{n+1}+b^{n+1}}{a^n+b^n}=\\frac{2ab}{a+b}\\\\[5pt]&(a+b)\\left(a^{n+1}+b^{n+1}\\right)=2ab\\left(a^n+b^n\\right)\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Expand and cancel",
   "text": "\\[\\begin{aligned}&a^{n+2}+a\\,b^{n+1}+a^{n+1}b+b^{n+2}=2a^{n+1}b+2ab^{n+1}\\\\[5pt]&a^{n+2}-a^{n+1}b-ab^{n+1}+b^{n+2}=0\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Factor",
   "text": "\\[\\begin{aligned}&a^{n+1}(a-b)-b^{n+1}(a-b)=(a-b)\\left(a^{n+1}-b^{n+1}\\right)=0\\\\[5pt]&\\text{Since a $\\neq$ b, we need $a^{n+1}$ = $b^{n+1}$}\\\\[5pt]&\\text{for every a and b, which happens when}\\\\[5pt]&\\text{the power is 0.}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Solve",
   "text": "\\[\\begin{aligned}&n+1=0\\ \\Rightarrow\\ \\textcolor{#047857}{\\mathbf{n=-1}}\\\\[5pt]&\\text{Check: ($a^{0}$ + $b^{0}$)/(a\\^{}-1 + b\\^{}-1) = 2/((a}\\\\[5pt]&\\text{+ b)/(ab)) = 2ab/(a + b).}\\end{aligned}\\]",
   "actions": [
    {
     "set": {
      "cur": 4
     },
     "at": 0
    }
   ]
  }
 ],
