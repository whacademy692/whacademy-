 "steps": [
  {
   "id": "s0",
   "title": "Same momentum",
   "text": "Take both objects with \\( p = 12 \\) kg m s⁻¹: a **1 kg** object at 12 m s⁻¹ and a **4 kg** object at 3 m s⁻¹.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Kinetic energy",
   "text": "Write \\( KE = \\tfrac12mv^2 = \\dfrac{p^2}{2m} \\). For the same \\( p \\), KE is **inversely proportional to m**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Compare",
   "text": "Small mass: \\( \\dfrac{144}{2(1)} = 72 \\) J. Large mass: \\( \\dfrac{144}{2(4)} = 18 \\) J.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "The **small-mass** object has the larger kinetic energy.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "KE and momentum",
   "tex": "KE = \\dfrac{p^2}{2m}",
   "text": "Same p: smaller m gives larger KE."
  }
 ],
