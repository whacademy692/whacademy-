 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "**v_i = 30 m s⁻¹**, **θ = 30°**, **g = 9.8 m s⁻²**. Find **H**, **T** and **R**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "(a) Height",
   "text": "\\( H = \\dfrac{v_i^2\\sin^2\\theta}{2g} = \\dfrac{900\\times0.25}{19.6} = 11.5 \\) m.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(b) Time of flight",
   "text": "\\( T = \\dfrac{2v_i\\sin\\theta}{g} = \\dfrac{2(30)(0.5)}{9.8} = 3.06 \\) s.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(c) Range",
   "text": "\\( R = \\dfrac{v_i^2\\sin2\\theta}{g} = \\dfrac{900\\times0.866}{9.8} = 79.5 \\) m.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Projectile at an angle",
   "tex": "H = \\dfrac{v_i^2\\sin^2\\theta}{2g},\\; T = \\dfrac{2v_i\\sin\\theta}{g},\\; R = \\dfrac{v_i^2\\sin2\\theta}{g}",
   "text": ""
  }
 ],
