 "steps": [
  {
   "id": "s0",
   "title": "Elastic collision",
   "text": "A collision in which **both momentum and kinetic energy are conserved** (e.g. atomic particles). The bodies return to their shape and no KE becomes heat or sound.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Momentum",
   "text": "\\( m_1u_1 + m_2u_2 = m_1v_1 + m_2v_2 \\) gives \\( m_1(u_1 - v_1) = m_2(v_2 - u_2) \\)  (A).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Kinetic energy",
   "text": "\\( \\tfrac12m_1u_1^2 + \\tfrac12m_2u_2^2 = \\tfrac12m_1v_1^2 + \\tfrac12m_2v_2^2 \\) gives \\( m_1(u_1 - v_1)(u_1 + v_1) = m_2(v_2 - u_2)(v_2 + u_2) \\)  (B).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Divide B by A",
   "text": "\\( u_1 + v_1 = v_2 + u_2 \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Result",
   "text": "\\( u_1 - u_2 = v_2 - v_1 \\): the relative speed of **approach** equals the relative speed of **separation**. ∎",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Relative speed",
   "tex": "u_1 - u_2 = v_2 - v_1",
   "text": "Elastic collision in one dimension."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Two bodies collide elastically with u₁ = 8 m/s and u₂ = 2 m/s. Find the relative speed of separation (m/s).",
   "answer": 6,
   "hint": "Separation = approach.",
   "explain": "\\( u_1 - u_2 = 8 - 2 = 6 \\) m/s.",
