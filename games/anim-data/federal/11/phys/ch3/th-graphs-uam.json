 "steps": [
  {
   "id": "s0",
   "title": "One motion, three graphs",
   "text": "A body has constant acceleration \\( a \\). Its motion can be drawn as distance–time, velocity–time and acceleration–time graphs.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "tm": 0,
      "vi": 1,
      "a": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Run the motion",
   "text": "Watch the three dots move together: the s–t dot climbs faster and faster, the v–t dot rises steadily, the a–t dot stays level.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "vi": 1,
      "a": 1
     },
     "at": 0
    },
    {
     "tween": {
      "tm": 4
     },
     "at": 0,
     "dur": 6000
    }
   ]
  },
  {
   "id": "s2",
   "title": "Read the slopes",
   "text": "Slope of s–t = velocity (it gets steeper). Slope of v–t = acceleration (constant). Area under v–t = distance.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "tm": 4,
      "vi": 1,
      "a": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Take away the acceleration",
   "text": "With \\( a = 0 \\) the velocity is constant: the v–t graph is flat and the s–t graph becomes a straight line.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "a": 0,
      "tm": 4,
      "vi": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "More acceleration",
   "text": "Raise \\( a \\) to 2: the v–t line is steeper and the s–t curve bends more.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "a": 2,
      "tm": 4,
      "vi": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "s",
   "value": "{{s|1}} m",
   "role": "dis"
  },
  {
   "label": "v",
   "value": "{{v|1}} m/s",
   "role": "vel"
  },
  {
   "label": "a",
   "value": "{{a|1}} m/s²",
   "role": "acc"
  }
 ],
 "formulas": [
  {
   "title": "Three graphs",
   "tex": "s = v_i t + \\tfrac12 a t^2,\\quad v = v_i + a t,\\quad a = \\text{constant}",
   "text": "Parabola, straight line, horizontal line."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A body moves with constant acceleration. Its distance–time graph is:",
   "options": [
    {
     "id": "a",
     "label": "A straight line"
    },
    {
     "id": "b",
     "label": "A parabola"
    },
    {
     "id": "c",
     "label": "A horizontal line"
    }
   ],
   "answer": "b",
   "hint": "S = v_i t + ½ a t² has t².",
   "explain": "S contains \\( t^2 \\): a parabola."
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "v_i = 1 m/s and a = 2 m/s². Find v at t = 4 s (m/s).",
   "answer": 9,
   "hint": "v = v_i + at.",
   "explain": "\\( 1 + 2\\times4 = 9 \\) m/s.",
   "tolerance": 0.09,
   "unit": "m/s"
  }
 ],
 "takeaways": [
  "s–t: parabola. v–t: straight line. a–t: horizontal line.",
  "Slope of s–t = v; slope of v–t = a; area under v–t = S."
 ]
}