 "formulas": [
  {
   "title": "Projectile at an angle",
   "tex": "H = \\dfrac{v_i^2\\sin^2\\theta}{2g},\\quad T = \\dfrac{2v_i\\sin\\theta}{g},\\quad R = \\dfrac{v_i^2\\sin 2\\theta}{g}",
   "text": "v_x = v_i cosθ (constant), v_y = v_i sinθ − g t."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A ball is launched at 20 m/s at 30°. Find the range R (m). Use g = 9.8.",
   "answer": 35.3,
   "hint": "R = v_i² sin2θ / g.",
   "explain": "\\( 400\\sin60^\\circ/9.8 = 35.3 \\) m.",
   "tolerance": 0.1,
   "unit": "m"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "For the same launch, find the maximum height H (m).",
   "answer": 5.1,
   "hint": "H = (v_i sinθ)² / 2g.",
   "explain": "\\( 10^2/19.6 = 5.1 \\) m.",
   "tolerance": 0.05,
   "unit": "m"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "At the highest point of the path, the velocity of the projectile is:",
   "options": [
    {
     "id": "a",
     "label": "Zero"
    },
    {
     "id": "b",
     "label": "Horizontal, equal to v_x"
    },
    {
     "id": "c",
     "label": "Vertical, equal to v_y"
    }
   ],
   "answer": "b",
   "hint": "v_y = 0 at the top.",
   "explain": "Only v_x remains, so the velocity is horizontal."
  }
 ],
 "takeaways": [
  "v_x = v_i cosθ is constant; v_y = v_i sinθ − gt.",
  "H, T and R follow from the vertical and horizontal motions."
 ]
}