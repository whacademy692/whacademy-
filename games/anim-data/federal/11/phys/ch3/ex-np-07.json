 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "**m₁ = 0.5 kg, u₁ = +4 m s⁻¹**; **m₂ = 3.5 kg, u₂ = 0**. Elastic collision. Find **v₁** and **v₂**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "First ball",
   "text": "\\( v_1 = \\dfrac{m_1 - m_2}{m_1 + m_2}u_1 = \\dfrac{0.5 - 3.5}{4}(4) = -3.0 \\) m s⁻¹ (it **rebounds** to the left).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Second ball",
   "text": "\\( v_2 = \\dfrac{2m_1}{m_1 + m_2}u_1 = \\dfrac{2(0.5)}{4}(4) = 1.0 \\) m s⁻¹ (to the right).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Check",
   "text": "Momentum: \\( 0.5(4) = 2.0 \\) before; \\( 0.5(-3) + 3.5(1) = 2.0 \\) after. Relative speed: approach 4, separation \\( 1 - (-3) = 4 \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Elastic collision, target at rest",
   "tex": "v_1 = \\dfrac{m_1 - m_2}{m_1 + m_2}u_1,\\qquad v_2 = \\dfrac{2m_1}{m_1 + m_2}u_1",
   "text": "u₂ = 0."
  }
 ],
 "challenges": [
  {
