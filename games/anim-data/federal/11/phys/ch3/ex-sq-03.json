 "steps": [
  {
   "id": "s0",
   "title": "Velocity of a launched projectile",
   "text": "For an angled (or horizontal) launch the horizontal part \\( v_i\\cos\\theta \\) **never changes**, so the velocity is never zero. At the top only \\( v_y \\) is zero.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Vertical throw",
   "text": "Only for a **vertical** throw (\\( \\theta = 90^\\circ \\)) is the velocity zero, and only for an instant at the top.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Acceleration",
   "text": "The acceleration is **g downward** at every instant in the air (\\( a_x = 0 \\), \\( a_y = \\mp g \\)). It is never zero.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "v: not zero for an angled launch (zero only at the top of a vertical throw). a: never zero.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Components",
   "tex": "v_x = v_i\\cos\\theta\\ (\\text{constant}),\\qquad a = g\\ (\\text{downward})",
   "text": ""
  }
 ],
