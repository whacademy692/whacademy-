 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "A bus moves at **v_i = 10 m s⁻¹** and speeds up uniformly at **a = 2 m s⁻²**. Find its velocity after **t = 5 s**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Choose the equation",
   "text": "We want a **velocity** and the time is given, so use the **first equation of motion**: \\( v_f = v_i + at \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Substitute",
   "text": "The bus gains \\( at = 2\\times5 = 10 \\) m s⁻¹ on top of its starting 10 m s⁻¹: \\( v_f = 10 + 2(5) = 10 + 10 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\( v_f = 20 \\) m s⁻¹. After 5 s the bus is moving twice as fast as it started.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "First equation of motion",
   "tex": "v_f = v_i + at",
   "text": "Use it when the distance is not involved."
  }
 ],
