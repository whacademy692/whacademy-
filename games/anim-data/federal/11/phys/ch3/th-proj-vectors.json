 "steps": [
  {
   "id": "s0",
   "title": "Five positions",
   "text": "The path is drawn with the ball marked at equal time intervals: launch, quarter-time, **top**, three-quarter time and landing.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "th": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Horizontal velocity",
   "text": "The **teal** arrow \\( v_x = v_i\\cos\\theta \\) is the same length at every point: nothing pushes the ball sideways.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "th": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Vertical velocity",
   "text": "The **pink** arrow \\( v_y \\) points up and shrinks, is **zero at the top**, then points down and grows. Going up and coming down at the same height it has the same size.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "th": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The resultant",
   "text": "The **blue** arrow is the vector sum \\( \\vec v = \\vec v_x + \\vec v_y \\). It is always tangent to the path and is shortest at the top.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "th": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Least speed at the top",
   "text": "At the top \\( v = v_x \\). Change \\( \\theta \\) to 60°: \\( v_x \\) is smaller, so the speed at the top is smaller too.",
   "actions": [
    {
     "set": {
      "lv": 4,
      "th": 60
     },
     "at": 0
    }
   ]
  }
