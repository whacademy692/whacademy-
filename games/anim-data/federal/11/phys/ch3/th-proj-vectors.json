  {
   "title": "Velocity of a projectile",
   "tex": "\\vec v = \\role{hx}{v_x}\\,\\hat i + \\role{vy}{(v_{y0} - g t)}\\,\\hat j",
   "text": "v_x constant; v_y decreases at 9.8 m s⁻¹ every second."
  }
 ],
