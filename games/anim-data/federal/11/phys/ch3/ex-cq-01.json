   "hint": "2aS = v_f² − v_i².",
   "explain": "\\( a = (64 - 4)/(2\\times25) = 1.2 \\) m/s².",
   "tolerance": 0.01,
   "unit": "m/s²"
  }
 ],
 "takeaways": [
  "Slope of v–t = a; area under v–t = S.",
  "Eliminating t gives 2aS = v_f² − v_i²."
