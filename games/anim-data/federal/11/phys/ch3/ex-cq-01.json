 "steps": [
  {
   "id": "s0",
   "title": "The v–t graph",
   "text": "A body moves in a straight line with constant acceleration \\( a \\): velocity \\( OA = v_i \\) at the start, \\( BD = v_f \\) after time \\( OD = t \\). The graph is the straight line AB.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "First equation",
   "text": "The slope of AB is the acceleration: \\( a = \\dfrac{BC}{AC} = \\dfrac{BD - CD}{OD} = \\dfrac{v_f - v_i}{t} \\), so \\( v_f = v_i + at \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Second equation",
   "text": "The distance is the area of the trapezium OABD: \\( S = \\tfrac12(OA + BD)\\times OD = \\tfrac12(v_i + v_f)t \\). Put \\( v_f = v_i + at \\): \\( S = v_it + \\tfrac12at^2 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Third equation",
   "text": "\\( 2S = (v_i + v_f)\\,t \\). Multiply both sides by \\( a = \\dfrac{BC}{OD} \\): \\( 2aS = (v_i + v_f)(v_f - v_i) \\), so \\( 2aS = v_f^2 - v_i^2 \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Equations of motion",
   "tex": "v_f = v_i + at,\\quad S = v_it + \\tfrac12at^2,\\quad 2aS = v_f^2 - v_i^2",
   "text": "Constant acceleration, straight line."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "v_i = 2 m/s, v_f = 8 m/s over S = 25 m. Find a (m/s²).",
