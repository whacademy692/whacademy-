   ]
  },
  {
   "id": "s1",
   "title": "Add air resistance",
   "text": "Air resistance acts like friction and **opposes the motion**. The same launch now follows the orange path.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "tm": 0
     },
     "at": 0
    },
    {
