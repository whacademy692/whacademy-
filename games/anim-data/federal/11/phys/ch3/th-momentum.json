 ],
 "formulas": [
  {
   "title": "Momentum and kinetic energy",
   "tex": "\\role{mom}{p} = m\\,v,\\qquad \\role{ke}{KE} = \\tfrac12 m v^2 = \\dfrac{p^2}{2m}",
   "text": "Momentum is a vector; kinetic energy is a scalar."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A car of mass 1000 kg moves at 20 m/s. Find its momentum (kg m/s).",
   "answer": 20000,
   "hint": "p = m v.",
   "explain": "\\( 1000\\times20 = 20000 \\) kg m s⁻¹.",
   "tolerance": 200.0,
   "unit": "kg m/s"
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Two bodies have the same momentum. The one with the smaller mass has:",
   "options": [
    {
     "id": "a",
     "label": "More kinetic energy"
    },
    {
     "id": "b",
     "label": "Less kinetic energy"
    },
    {
     "id": "c",
     "label": "The same kinetic energy"
    }
   ],
   "answer": "a",
   "hint": "KE = p²/2m.",
   "explain": "For equal p, KE is proportional to 1/m: the lighter body has more KE."
  }
 ],
 "takeaways": [
  "p = mv; its SI unit is kg m s⁻¹ (= N s).",
  "KE = p²/2m: equal momentum does not mean equal energy."
 ]
}