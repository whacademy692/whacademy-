 "steps": [
  {
   "id": "s0",
   "title": "Mass and velocity",
   "text": "Momentum depends on **both** how much matter moves and how fast: \\( \\vec p = m\\vec v \\). A heavy slow body and a light fast body can have the same momentum.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "m": 4,
      "v": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Momentum is an area",
   "text": "Draw a rectangle of width \\( m \\) and height \\( v \\). Its **area** is \\( p = mv = {{p|0}} \\) kg m s⁻¹.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "m": 4,
      "v": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Change m or v",
   "text": "Double the mass or double the velocity and the momentum doubles: the rectangle grows.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "m": 4,
      "v": 3
     },
     "at": 0
    },
    {
     "tween": {
      "m": 8
     },
     "at": 300,
     "dur": 2200
    },
    {
     "tween": {
      "v": 6
     },
     "at": 2700,
     "dur": 2200
    }
   ]
  },
  {
   "id": "s3",
   "title": "Same p: heavy and slow",
   "text": "Take \\( m = 6 \\), \\( v = 2 \\): \\( p = 12 \\). The kinetic energy is \\( p^2/2m = {{pk|0}} \\) J.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "m": 6,
      "v": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Same p: light and fast",
   "text": "Take \\( m = 2 \\), \\( v = 6 \\): the **same** \\( p = 12 \\), but the kinetic energy is now \\( {{pk|0}} \\) J, three times larger. Equal momentum does not mean equal energy.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "m": 2,
      "v": 6
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
