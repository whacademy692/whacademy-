 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "Height reached **h = 2.50 m**. At the highest point the kangaroo is momentarily at rest: **v_f = 0**. Going up, g is against the motion, so **g = −9.8 m s⁻²**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Choose the equation",
   "text": "Time is not asked, so use the 3rd equation: \\( 2gh = v_f^2 - v_i^2 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Substitute",
   "text": "\\( 2(-9.8)(2.5) = 0 - v_i^2 \\Rightarrow -49 = -v_i^2 \\Rightarrow v_i^2 = 49 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\( v_i = 7 \\) m s⁻¹ upward.",
   "actions": []
  }
 ],
