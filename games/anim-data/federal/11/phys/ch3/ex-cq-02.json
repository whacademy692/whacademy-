 "steps": [
  {
   "id": "s0",
   "title": "The law",
   "text": "The **total momentum of an isolated system** of interacting bodies is **conserved**: \\( \\Delta p = 0 \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Ball before",
   "text": "Take the ball (mass \\( m \\)) and the wall (fixed to the Earth) as the system. The ball hits the wall at velocity \\( u \\): \\( p = +mu \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Ball after",
   "text": "It bounces back with about the same speed: \\( p = -mu \\). The ball’s momentum changes by **−2mu**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "The wall gains it",
   "text": "By conservation the wall + Earth gain **+2mu**. Their mass is huge, so \\( v = 2mu/M \\approx 0 \\): they hardly move, but the total momentum is unchanged.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Conservation of momentum",
   "tex": "\\Delta p_{ball} + \\Delta p_{wall} = 0",
   "text": "Isolated system, no external force."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A 0.2 kg ball hits a wall at 10 m/s and rebounds at 10 m/s. What momentum (kg m/s) does the wall gain?",
