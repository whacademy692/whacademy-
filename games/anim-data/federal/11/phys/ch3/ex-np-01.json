 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "**v_i = 30.0 m s⁻¹**, **v_f = 0**; (a) \\( a = -7.00 \\) m s⁻², (b) \\( a = -5.00 \\) m s⁻². Find **S**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Formula",
   "text": "Time is not given, so use \\( 2aS = v_f^2 - v_i^2 \\): \\( S = \\dfrac{0 - v_i^2}{2a} \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(a) Dry concrete",
   "text": "\\( S = \\dfrac{-900}{2(-7.00)} = 64.3 \\) m.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(b) Wet concrete",
   "text": "\\( S = \\dfrac{-900}{2(-5.00)} = 90.0 \\) m.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Compare",
   "text": "On wet concrete the car needs \\( 25.7 \\) m more, about **1.4 times** the dry distance.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Stopping distance",
   "tex": "S = \\dfrac{v_i^2}{2a}",
   "text": "Doubling the speed gives four times the distance."
  }
 ],
