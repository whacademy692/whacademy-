 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "Horizontal launch: **v_ix = 12.0 m s⁻¹**, **v_iy = 0**, height **y = 24.6 m**. Find the horizontal distance **x**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Time of fall (vertical)",
   "text": "Vertically the ball is simply falling from rest: \\( y = \\tfrac12 g t^2 \\Rightarrow 24.6 = \\tfrac12(9.8)t^2 \\Rightarrow t^2 = 5.02 \\Rightarrow t = 2.24 \\) s.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Horizontal distance",
   "text": "Horizontally there is no acceleration (\\( a_x = 0 \\)), so \\( x = v_{ix}\\,t = 12\\times2.24 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\( x = 26.9 \\) m.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Horizontal launch",
   "tex": "y = \\tfrac12 g t^2,\\qquad x = v_i t",
   "text": "The two motions share only the time."
  }
 ],
