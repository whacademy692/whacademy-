 "formulas": [
  {
   "title": "Thrown upward",
   "tex": "v = v_i - g t,\\quad H = \\dfrac{v_i^2}{2g},\\quad T = \\dfrac{2v_i}{g}",
   "text": "g is negative when up is positive."
  }
 ],
