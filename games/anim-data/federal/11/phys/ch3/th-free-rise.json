 "steps": [
  {
   "id": "s0",
   "title": "Throw it up",
   "text": "A ball is thrown **upward** with \\( v_i \\). Taking up as positive, \\( g = -9.8 \\) m s⁻²: gravity points down the whole time.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "ph": 0,
      "vi": 15
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Going up",
   "text": "The velocity arrow points up and shrinks because \\( v = v_i - g t \\): velocity and acceleration are **opposite**.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "vi": 15
     },
     "at": 0
    },
    {
     "tween": {
      "ph": 0.5
     },
     "at": 0,
     "dur": 3800
    }
   ]
  },
  {
   "id": "s2",
   "title": "At the top",
   "text": "At the highest point \\( v = 0 \\) for an instant, but the acceleration is still 9.8 m s⁻² downward. That is why the ball turns back. \\( H = v_i^2/2g = {{H|1}} \\) m.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "ph": 0.5,
      "vi": 15
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Coming down",
   "text": "Now velocity and acceleration point the **same way** and the ball speeds up.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "vi": 15
     },
     "at": 0
    },
    {
     "tween": {
      "ph": 1
     },
     "at": 0,
     "dur": 3800
    }
   ]
  },
  {
   "id": "s4",
   "title": "Symmetry",
   "text": "Time up = time down, so the total time is \\( T = 2v_i/g = {{T|2}} \\) s, and the ball returns with the same speed it was thrown.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "ph": 1,
      "vi": 15
     },
     "at": 0
    }
   ]
  }
 ],
