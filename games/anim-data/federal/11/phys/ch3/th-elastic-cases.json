  },
  {
   "label": "KE before = after",
   "value": "{{KEb|0}} J",
   "role": "ke"
  }
 ],
 "formulas": [
  {
   "title": "Elastic collision",
   "tex": "v_1 = \\dfrac{m_1 - m_2}{m_1 + m_2}u_1 + \\dfrac{2m_2}{m_1 + m_2}u_2,\\quad v_2 = \\dfrac{2m_1}{m_1 + m_2}u_1 - \\dfrac{m_1 - m_2}{m_1 + m_2}u_2",
   "text": "Both p and KE are conserved."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Two 4 kg bodies collide elastically. The first moves at 6 m/s; the second is at rest. Find the final speed of the second body (m/s).",
   "answer": 6,
   "hint": "Equal masses exchange velocities.",
   "explain": "m₁ = m₂ and u₂ = 0: \\( v_2 = u_1 = 6 \\) m/s.",
   "tolerance": 0.05,
   "unit": "m/s"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "A 1 kg ball at 8 m/s hits a 10 kg body at rest, elastically. Find the velocity of the ball afterwards (m/s; − means backwards).",
   "answer": -6.5,
   "hint": "v₁ = (m₁ − m₂)u₁/(m₁ + m₂).",
   "explain": "\\( \\dfrac{1-10}{11}(8) = -6.5 \\) m/s: it rebounds.",
   "tolerance": 0.1,
   "unit": "m/s"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A heavy body hits a light body at rest elastically. The light body moves off at about:",
   "options": [
    {
     "id": "a",
     "label": "Half the speed"
    },
    {
     "id": "b",
     "label": "The same speed"
    },
    {
     "id": "c",
     "label": "Twice the speed"
    }
   ],
   "answer": "c",
   "hint": "Case 4: v₂ ≈ 2u₁.",
   "explain": "When m₁ ≫ m₂, \\( v_2 = 2m_1u_1/(m_1 + m_2) \\approx 2u_1 \\)."
  }
 ],
 "takeaways": [
  "Equal masses swap velocities; a target at rest ends up with all the speed.",
  "Light on heavy: bounces back. Heavy on light: light flies off at ≈ 2u₁."
 ]
}