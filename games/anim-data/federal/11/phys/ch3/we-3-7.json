 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "**m₁ = 5 kg, u₁ = 10 m s⁻¹**; **m₂ = 10 kg, u₂ = 5 m s⁻¹** (same direction). Find **v₁** and **v₂**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "First object",
   "text": "\\( v_1 = \\dfrac{m_1 - m_2}{m_1 + m_2}u_1 + \\dfrac{2m_2}{m_1 + m_2}u_2 = \\dfrac{-5}{15}(10) + \\dfrac{20}{15}(5) = -\\dfrac{50}{15} + \\dfrac{100}{15} \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Second object",
   "text": "\\( v_2 = \\dfrac{2m_1}{m_1 + m_2}u_1 - \\dfrac{m_1 - m_2}{m_1 + m_2}u_2 = \\dfrac{10}{15}(10) + \\dfrac{5}{15}(5) = \\dfrac{100}{15} + \\dfrac{25}{15} \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Check with the conservation laws",
   "text": "Momentum: \\( 5(10) + 10(5) = 100 \\) before; \\( 5(3.33) + 10(8.33) = 100 \\) after. Kinetic energy: 375 J before and after. Relative speed: \\( 10 - 5 = 5 \\) and \\( 8.33 - 3.33 = 5 \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( v_1 = 3.33 \\) m s⁻¹ and \\( v_2 = 8.33 \\) m s⁻¹. The lighter object slows down and the heavier one speeds up.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Elastic collision, two bodies",
   "tex": "v_1 = \\dfrac{m_1-m_2}{m_1+m_2}u_1 + \\dfrac{2m_2}{m_1+m_2}u_2",
   "text": "v_2 = \\dfrac{2m_1}{m_1+m_2}u_1 - \\dfrac{m_1-m_2}{m_1+m_2}u_2"
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Two equal masses collide elastically: 4 m/s hits 0 m/s. Find the speed (m/s) of the one that was at rest afterwards.",
