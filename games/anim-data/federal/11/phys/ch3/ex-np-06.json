 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "Equal masses \\( m_1 = m_2 = m \\); \\( u_1 = +2 \\) m s⁻¹ (right is positive), \\( u_2 = -1 \\) m s⁻¹. Find the common speed **v**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Momentum conservation",
   "text": "\\( m_1u_1 + m_2u_2 = (m_1 + m_2)v \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Substitute",
   "text": "\\( m(2) + m(-1) = 2m\\,v \\), so \\( m = 2m\\,v \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\( v = 0.5 \\) m s⁻¹, to the right (the direction of the faster cart).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Perfectly inelastic collision",
   "tex": "v = \\dfrac{m_1u_1 + m_2u_2}{m_1 + m_2}",
   "text": "Bodies stick together."
  }
 ],
 "challenges": [
  {
