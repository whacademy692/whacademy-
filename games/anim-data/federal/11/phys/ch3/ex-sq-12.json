 "steps": [
  {
   "id": "s0",
   "title": "The system",
   "text": "Take the **ball and the bat together** as the system. The hit is very short and the internal forces are far bigger than any external force.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Equal and opposite changes",
   "text": "The bat pushes the ball and the ball pushes back on the bat with an equal and opposite force: \\( \\Delta p_{ball} = -\\Delta p_{bat} \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Total unchanged",
   "text": "The ball gains the momentum that the bat loses, so \\( p_{before} = p_{after} \\) for the system.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "**Yes**, momentum is conserved for ball + bat.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Conservation of momentum",
   "tex": "\\Delta p_{ball} + \\Delta p_{bat} = 0",
   "text": "Isolated system, short interaction."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "In a bat–ball hit the change in momentum of the ball is:",
   "options": [
