 "steps": [
  {
   "id": "s0",
   "title": "Velocity against time",
   "text": "A body moves with constant acceleration. On the **v–t graph** its velocity is a straight line that starts at \\( v_i \\).",
   "actions": [
    {
     "set": {
      "lv": 0,
      "vi": 2,
      "a": 1,
      "tm": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "The rise is a·t",
   "text": "In time \\( t \\) the line rises by \\( v_f - v_i \\). Since the velocity changes by \\( a \\) every second, the rise is \\( a t \\).",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "The slope is a",
   "text": "Slope = rise ÷ run = \\( \\dfrac{at}{t} = a \\): the **slope of the v–t graph is the acceleration**.",
   "actions": [
    {
     "set": {
      "lv": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "First equation",
   "text": "Read the end height: \\( v_f = v_i + at \\). With \\( v_i = {{vi|0}} \\), \\( a = {{a|1}} \\), \\( t = {{tm|0}} \\): \\( v_f = {{vf|1}} \\) m s⁻¹.",
   "actions": [
    {
     "set": {
      "lv": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Try other values",
   "text": "Drag the sliders: a bigger **a** gives a steeper line; a longer **t** gives a taller rise.",
   "actions": [
    {
     "set": {
      "lv": 4
     },
     "at": 0
    },
    {
     "tween": {
      "tm": 8
     },
     "at": 0,
     "dur": 3500
    }
   ]
  }
 ],
