 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "A car starts at **v_i = 4 m s⁻¹**, accelerates at **a = 1 m s⁻²** for **t = 10 s**. Find the distance **S**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Draw the v–t graph",
   "text": "The velocity rises in a straight line from 4 m s⁻¹ to \\( 4 + 1\\times10 = 14 \\) m s⁻¹ in 10 s.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Distance = area",
   "text": "The distance travelled is the **area under the graph**: a trapezium with parallel sides 4 and 14 and width 10.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Second equation",
   "text": "Using the 2nd equation: \\( S = v_i t + \\tfrac12 a t^2 \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Substitute",
   "text": "\\( S = 4(10) + \\tfrac12(1)(10)^2 = 40 + 50 \\).",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer",
   "text": "\\( S = 90 \\) m. (Check by the trapezium: \\( \\tfrac12(4+14)\\times10 = 90 \\).)",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Second equation of motion",
   "tex": "S = v_i t + \\tfrac12 a t^2",
   "text": "The area under the v–t graph."
  }
 ],
