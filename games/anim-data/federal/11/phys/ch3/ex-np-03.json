 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "**v_i = 100 m s⁻¹**, **v_f = 0**, **a = −5.00 m s⁻²** (the greatest braking).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "(a) Time",
   "text": "\\( v_f = v_i + at \\Rightarrow t = \\dfrac{0 - 100}{-5.00} = 20 \\) s.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(b) Distance",
   "text": "\\( S = \\dfrac{v_f^2 - v_i^2}{2a} = \\dfrac{0 - 10000}{2(-5.00)} = 1000 \\) m = **1 km**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Compare",
   "text": "The plane needs at least **1 km** but the runway is only **0.8 km (800 m)**. It **cannot** land safely.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Stopping",
   "tex": "t = \\dfrac{v_f - v_i}{a},\\qquad S = \\dfrac{v_f^2 - v_i^2}{2a}",
   "text": ""
  }
 ],
