 "steps": [
  {
   "id": "s0",
   "title": "Set up",
   "text": "Launch at \\( v_i \\), angle \\( \\theta \\): \\( v_{iy} = v_i\\sin\\theta \\), \\( v_{ix} = v_i\\cos\\theta \\), \\( a_y = -g \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "(a) Maximum height",
   "text": "At the top \\( v_{fy} = 0 \\). From \\( 2a_yH = v_{fy}^2 - v_{iy}^2 \\): \\( -2gH = -v_i^2\\sin^2\\theta \\), so \\( H = \\dfrac{v_i^2\\sin^2\\theta}{2g} \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(b) Time of flight",
   "text": "At landing \\( y = 0 \\): \\( 0 = (v_i\\sin\\theta)T - \\tfrac12gT^2 \\), so \\( T = \\dfrac{2v_i\\sin\\theta}{g} \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(c) Range",
   "text": "\\( R = v_xT = v_i\\cos\\theta\\cdot\\dfrac{2v_i\\sin\\theta}{g} = \\dfrac{v_i^2(2\\sin\\theta\\cos\\theta)}{g} \\), so \\( R = \\dfrac{v_i^2\\sin2\\theta}{g} \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "H, T and R",
   "tex": "H = \\dfrac{v_i^2\\sin^2\\theta}{2g},\\quad T = \\dfrac{2v_i\\sin\\theta}{g},\\quad R = \\dfrac{v_i^2\\sin2\\theta}{g}",
   "text": "Level ground, no air resistance."
  }
 ],
