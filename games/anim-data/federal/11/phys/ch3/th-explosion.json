 "formulas": [
  {
   "title": "Explosion at rest",
   "tex": "0 = m_1 v_1 - m_2 v_2 \\;\\Rightarrow\\; v_2 = \\dfrac{m_1}{m_2}\\,v_1",
   "text": "Equal and opposite momenta; KE = p²/2m."
  }
 ],
