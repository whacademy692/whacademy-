 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "The train slows from **80 km h⁻¹** to **20 km h⁻¹** with retardation 2 m s⁻². Find the time.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Same units first",
   "text": "Change km h⁻¹ to m s⁻¹ by dividing by 3.6: \\( v_i = 80/3.6 = 22.22 \\), \\( v_f = 20/3.6 = 5.56 \\) m s⁻¹.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Retardation is negative",
   "text": "Slowing down means the acceleration points against the motion: **a = −2 m s⁻²**. From \\( v_f = v_i + at \\): \\( t = (v_f - v_i)/a \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute",
   "text": "\\( t = \\dfrac{5.56 - 22.22}{-2} = \\dfrac{-16.67}{-2} \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( t = 8.33 \\) s. The two negatives cancel, so the time is positive.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "First equation, solved for time",
   "tex": "t = \\dfrac{v_f - v_i}{a}",
   "text": "Retardation: use a negative value."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A train slows from 30 m/s to 10 m/s with a = −2 m/s². Find t (s).",
