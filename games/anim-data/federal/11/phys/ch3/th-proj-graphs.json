 "steps": [
  {
   "id": "s0",
   "title": "One flight, four graphs",
   "text": "A ball is launched at 20 m s⁻¹ and \\( \\theta = {{th|0}}^\\circ \\). Each graph shows one quantity against time, from launch to landing at \\( T \\).",
   "actions": [
    {
     "set": {
      "lv": 0,
      "ph": 0,
      "th": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Watch the dots",
   "text": "The dots move together: \\( x \\) grows steadily, \\( y \\) rises then falls, \\( v_x \\) stays level and \\( v_y \\) decreases through zero.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "th": 40
     },
     "at": 0
    },
    {
     "tween": {
      "ph": 1
     },
     "at": 0,
     "dur": 6000
    }
   ]
  },
  {
   "id": "s2",
   "title": "Read the shapes",
   "text": "**x–t:** straight line (constant \\( v_x \\)). **y–t:** parabola. \\( v_x \\)–t: horizontal. \\( v_y \\)–t: straight line with slope \\( -g \\), crossing zero at the top (\\( t = T/2 \\)).",
   "actions": [
    {
     "set": {
      "lv": 2,
      "ph": 1,
      "th": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Change the angle",
   "text": "Raise \\( \\theta \\) to 65°: \\( v_x \\) falls, \\( v_y \\) starts larger and the flight lasts longer.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "ph": 0,
      "th": 65
     },
     "at": 0
    },
    {
     "tween": {
      "ph": 1
     },
     "at": 300,
     "dur": 5500
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "x",
   "value": "{{x|1}} m",
   "role": "dis"
  },
  {
   "label": "y",
   "value": "{{y|1}} m",
   "role": "dis"
  },
  {
   "label": "v_x",
   "value": "{{vx|1}} m/s",
   "role": "hx"
  },
  {
   "label": "v_y",
   "value": "{{vy|1}} m/s",
   "role": "vy"
  }
 ],
 "formulas": [
  {
   "title": "Projectile graphs",
   "tex": "x = v_x t,\\quad y = v_{y0}t - \\tfrac12 g t^2,\\quad v_x = \\text{const},\\quad v_y = v_{y0} - g t",
   "text": "v_x–t flat, v_y–t straight line of slope −g."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which graph of a projectile is a horizontal straight line?",
   "options": [
    {
     "id": "a",
     "label": "x–t"
    },
    {
     "id": "b",
     "label": "v_x–t"
    },
    {
     "id": "c",
     "label": "v_y–t"
    }
   ],
   "answer": "b",
   "hint": "Which velocity component never changes?",
   "explain": "v_x is constant, so its graph is horizontal."
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "A projectile is launched at 20 m/s and 60°. What is v_x (m/s) at every instant?",
   "answer": 10,
   "hint": "v_x = v_i cosθ.",
   "explain": "\\( 20\\cos60^\\circ = 10 \\) m/s.",
   "tolerance": 0.05,
   "unit": "m/s"
  }
 ],
 "takeaways": [
  "x–t straight, y–t parabola, v_x–t flat, v_y–t sloping line (slope −g).",
  "v_y = 0 at t = T/2, the highest point."
 ]
}