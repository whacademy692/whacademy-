 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "**v_i = 21.8 m s⁻¹**, **θ = 35°**, **g = 9.8 m s⁻²** (\\( \\sin35^\\circ = 0.5736 \\), \\( \\sin70^\\circ = 0.9397 \\)).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "(a) Time of flight",
   "text": "\\( T = \\dfrac{2v_i\\sin\\theta}{g} = \\dfrac{2(21.8)(0.5736)}{9.8} = 2.55 \\) s.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(b) Peak height",
   "text": "\\( H = \\dfrac{v_i^2\\sin^2\\theta}{2g} = \\dfrac{(21.8)^2(0.5736)^2}{2(9.8)} = 7.98 \\) m.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(c) Range",
   "text": "\\( R = \\dfrac{v_i^2\\sin2\\theta}{g} = \\dfrac{(21.8)^2\\sin70^\\circ}{9.8} = 45.6 \\) m.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "H, T and R",
