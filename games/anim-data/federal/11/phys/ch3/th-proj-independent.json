 "steps": [
  {
   "id": "s0",
   "title": "Two balls, one release",
   "text": "Ball **A** is simply dropped. Ball **B** is thrown sideways at the same moment from the same height. Which one lands first?",
   "actions": [
    {
     "set": {
      "lv": 0,
      "tm": 0,
      "vx": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Watch them fall",
   "text": "Both balls fall side by side. The ghost images mark every half second.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "vx": 5
     },
     "at": 0
    },
    {
     "tween": {
      "tm": 2
     },
     "at": 0,
     "dur": 6000
    }
   ]
  },
  {
   "id": "s2",
   "title": "Same height every moment",
   "text": "The dashed lines are horizontal: at each instant the two balls are at the **same height**. The sideways motion of B did not slow its fall.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "tm": 2,
      "vx": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Two independent motions",
   "text": "Vertically both have the same \\( v_y = g t \\) (the pink arrows). Only B has the constant horizontal velocity \\( v_x \\) (the teal arrow).",
   "actions": [
    {
     "set": {
      "lv": 3,
      "tm": 1.5,
      "vx": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Faster sideways, same fall",
   "text": "Try \\( v_x = 8 \\) m s⁻¹. The curve is longer, but the ball still lands at the same time as A.",
   "actions": [
    {
     "set": {
      "lv": 4,
      "tm": 0,
      "vx": 8
     },
     "at": 0
    },
    {
     "tween": {
      "tm": 2
     },
     "at": 200,
     "dur": 5500
    }
   ]
  }
 ],
