 "formulas": [
  {
   "title": "Independent motions",
   "tex": "\\role{hx}{x = v_x t},\\qquad \\role{vy}{y = \\tfrac12 g t^2}",
   "text": "Horizontal: constant velocity. Vertical: free fall."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A ball is dropped and another is thrown horizontally from the same height at the same time (ignore air). Which lands first?",
   "options": [
    {
     "id": "a",
     "label": "The dropped ball"
    },
    {
     "id": "b",
     "label": "The thrown ball"
    },
    {
     "id": "c",
     "label": "They land together"
    }
   ],
   "answer": "c",
   "hint": "Compare the vertical motions.",
   "explain": "Both have v_y = 0 at the start and the same g, so they take the same time."
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "A ball is thrown horizontally at 6 m/s from a cliff 19.6 m high. How far from the base does it land (m)? Use g = 9.8.",
   "answer": 12,
   "hint": "Fall time first: h = ½ g t².",
   "explain": "\\( t = \\sqrt{2(19.6)/9.8} = 2 \\) s, so \\( x = 6\\times2 = 12 \\) m.",
   "tolerance": 0.1,
   "unit": "m"
  }
 ],
 "takeaways": [
  "Horizontal and vertical motions are **independent**.",
  "Time of fall depends only on the height, not on v_x."
 ]
}