 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "**v_i = 5 m s⁻¹**, **v_f = 15 m s⁻¹**, **S = 50 m**. Find **a** and **t**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Acceleration from the 3rd equation",
   "text": "Time is not given, so use \\( 2aS = v_f^2 - v_i^2 \\): \\( a = \\dfrac{15^2 - 5^2}{2\\times50} = \\dfrac{200}{100} = 2 \\) m s⁻².",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Time from the 1st equation",
   "text": "\\( t = \\dfrac{v_f - v_i}{a} = \\dfrac{15-5}{2} = 5 \\) s.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Check with the graph",
   "text": "The area of the trapezium is \\( \\tfrac12(5+15)\\times5 = 50 \\) m, the given distance. ✔",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Third equation of motion",
   "tex": "2aS = v_f^2 - v_i^2",
   "text": "Use it when the time is not involved."
  }
 ],
