 "steps": [
  {
   "id": "s0",
   "title": "Release the ball",
   "text": "A ball is **dropped** (\\( v_i = 0 \\)). Only gravity acts, so \\( a = g = 9.8 \\) m s⁻² downward.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "tm": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Fall for 3 seconds",
   "text": "Every second the speed grows by 9.8 m s⁻¹. The ghost images mark each second, and they get further apart.",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    },
    {
     "tween": {
      "tm": 3
     },
     "at": 0,
     "dur": 6000
    }
   ]
  },
  {
   "id": "s2",
   "title": "The two equations",
   "text": "From \\( v_i = 0 \\): \\( v = g t \\) and \\( h = \\tfrac12 g t^2 \\). The mass does not appear, so every body falls the same way.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "tm": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Distances grow",
   "text": "The ball covers 4.9 m in the 1st second, 14.7 m in the 2nd and 24.5 m in the 3rd: it falls farther each second because it is faster.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "tm": 3
     },
     "at": 0
    }
   ]
  }
 ],
