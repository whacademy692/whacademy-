  {
   "title": "Range and angle",
   "tex": "R = \\dfrac{v_i^2\\sin 2\\theta}{g}",
   "text": "R is the same for θ and 90°−θ; R is greatest at 45°, where R_max = v_i²/g = 4H."
  }
 ],
