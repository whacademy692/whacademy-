 "formulas": [
  {
   "title": "Horizontal projectile",
   "tex": "\\role{tim}{T} = \\sqrt{\\dfrac{2H}{g}},\\quad \\role{dis}{R} = \\role{hx}{v_x}\\,T",
   "text": "v_y = g t, v = √(v_x² + v_y²)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A ball is thrown horizontally at 10 m/s from a height of 19.6 m. Find the range R (m). Use g = 9.8.",
   "answer": 20,
   "hint": "T = √(2H/g), then R = v_x T.",
   "explain": "\\( T = \\sqrt{2(19.6)/9.8} = 2 \\) s, so \\( R = 10\\times2 = 20 \\) m.",
   "tolerance": 0.1,
   "unit": "m"
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "The launch speed v_x is doubled (same height). The time of flight:",
   "options": [
    {
     "id": "a",
     "label": "Doubles"
    },
    {
     "id": "b",
     "label": "Stays the same"
    },
    {
     "id": "c",
     "label": "Halves"
    }
   ],
   "answer": "b",
   "hint": "T depends only on H.",
   "explain": "T = √(2H/g) has no v_x in it."
  }
 ],
 "takeaways": [
  "T = √(2H/g); R = v_x T.",
  "v_x stays constant; only v_y changes."
 ]
