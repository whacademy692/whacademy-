 "formulas": [
  {
   "title": "Collisions",
   "tex": "m_1u_1 + m_2u_2 = m_1v_1 + m_2v_2\\ (\\text{always}),\\qquad \\tfrac12 m_1u_1^2 + \\tfrac12 m_2u_2^2 = \\tfrac12 m_1v_1^2 + \\tfrac12 m_2v_2^2\\ (\\text{elastic only})",
   "text": "Perfectly inelastic: v = (m₁u₁ + m₂u₂)/(m₁ + m₂)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
