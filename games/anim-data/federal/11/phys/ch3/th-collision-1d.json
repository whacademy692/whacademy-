 "derived": {
  "u2e": "min(u2,u1-1)",
  "M": "m1+m2",
  "v1e": "((m1-m2)*u1+2*m2*u2e)/M",
  "v2e": "((m2-m1)*u2e+2*m1*u1)/M",
  "vc": "(m1*u1+m2*u2e)/M",
  "v1f": "if(mode==0,v1e,vc)",
  "v2f": "if(mode==0,v2e,vc)",
  "vel1": "if(pr<1,u1,v1f)",
  "vel2": "if(pr<1,u2e,v2f)",
  "w1": "0.8+0.42*sqrt(m1)",
  "w2": "0.8+0.42*sqrt(m2)",
