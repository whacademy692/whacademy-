  "xl2": "clamp(7+0.38*vel2*(pr-1),0.2,14.2)",
  "KEb": "0.5*m1*u1*u1+0.5*m2*u2e*u2e",
  "KEa": "0.5*m1*v1f*v1f+0.5*m2*v2f*v2f",
  "pb": "m1*u1+m2*u2e",
  "pa": "m1*v1f+m2*v2f",
  "keep": "100*KEa/KEb",
  "apr": "u1-u2e",
  "sep": "v2f-v1f"
 },
