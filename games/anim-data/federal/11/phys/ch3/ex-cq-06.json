 "steps": [
  {
   "id": "s0",
   "title": "Why momentum is conserved",
   "text": "In a closed system the internal forces are **equal and opposite**, so they cancel in the total: the total of the momentum **vectors** cannot change.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Elastic collision",
   "text": "KE is a scalar and internal forces can do work. In an **elastic** collision (atomic particles) the KE is **conserved**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Inelastic collision",
   "text": "In an **inelastic** collision (meteorite, car crash) KE **decreases**: it becomes heat, sound and deformation. If the bodies stick together, the loss is greatest.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Explosion",
   "text": "In an **explosion** (bomb, cannon, rocket) KE **increases**: stored chemical energy becomes the KE of the fragments, while the total momentum stays zero.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Momentum and energy",
   "tex": "\\sum \\vec p = \\text{const},\\qquad KE\\ \\text{may change}",
   "text": "Elastic: same; inelastic: less; explosion: more."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "In an explosion of a body at rest, the total kinetic energy:",
   "options": [
    {
     "id": "a",
     "label": "Increases"
    },
    {
     "id": "b",
     "label": "Decreases"
    },
    {
