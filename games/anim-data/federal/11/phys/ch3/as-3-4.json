 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "Bullet **m_b = 20 g = 0.020 kg**, **v_b = 100 m s⁻¹**; gun **m_g = 5 kg**. Find the recoil velocity **v_g**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Momentum is conserved",
   "text": "Before the shot everything is at rest: \\( p_i = 0 \\). After the shot \\( p_f = m_g v_g + m_b v_b \\), and \\( p_f = p_i = 0 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Substitute",
   "text": "\\( 5\\,v_g + 0.020(100) = 0 \\Rightarrow 5\\,v_g = -2 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "\\( v_g = -0.4 \\) m s⁻¹: the gun recoils at 0.4 m s⁻¹, opposite to the bullet.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Recoil",
   "tex": "m_g v_g + m_b v_b = 0",
   "text": "Equal and opposite momenta."
  }
 ],
