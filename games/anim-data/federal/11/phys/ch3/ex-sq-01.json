 "steps": [
  {
   "id": "s0",
   "title": "The three equations",
   "text": "\\( v_f = v_i + at \\), \\( S = v_it + \\tfrac12at^2 \\) and \\( 2aS = v_f^2 - v_i^2 \\) are only valid in a special kind of motion.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Straight line, constant a",
   "text": "The body moves along a **straight line** and its **acceleration is constant**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Signs",
   "text": "Only the **magnitudes** of displacement, velocity and acceleration are used; direction is shown by a sign.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Positive direction",
   "text": "The direction of the **initial velocity** (and of everything along it) is taken as **positive**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Equations of motion",
   "tex": "v_f = v_i + at,\\quad S = v_it + \\tfrac12at^2,\\quad 2aS = v_f^2 - v_i^2",
   "text": "Constant acceleration, straight line."
  }
 ],
 "challenges": [
