 "steps": [
  {
   "id": "s0",
   "title": "Elastic collision",
   "text": "Both the **momentum** and the **kinetic energy** of the system are conserved (e.g. atomic and subatomic particles).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Inelastic collision",
   "text": "The **momentum** is conserved but the **kinetic energy is not**: some becomes heat, sound and deformation (e.g. a meteorite hitting the Earth).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Difference",
   "text": "The difference is only in the **kinetic energy**: conserved in an elastic collision, lost in an inelastic one.",
   "actions": []
  }
 ],
 "formulas": [
  {
