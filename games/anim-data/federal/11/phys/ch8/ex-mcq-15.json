 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Internal energy change does not depend on the path. Which quantity behaves the same way?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Path 1",
   "text": "A gas goes from state A to state B along path 1 (first at constant pressure, then at constant volume). The work done is the area under the path: here it is large.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Path 2",
   "text": "Now go from A to B along path 2 (first constant volume, then constant pressure). The work done is much **smaller**, yet the starting and finishing states are the same.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "ΔU does not care",
   "text": "Internal energy depends only on the **state** (temperature) of the gas, so \\( \\Delta U = U_B - U_A \\) is the **same** on both paths. Heat and work change with the path, but \\( \\Delta U \\) does not.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "The matching quantity",
   "text": "Gravitational potential energy depends only on **height** (the position), not on whether you climb by stairs or by a ramp. Kinetic energy, wave energy and solar energy are not \"state values\" in this sense.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer: (C)",
   "text": "**Gravitational potential energy**, a state-dependent quantity like internal energy.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "State function",
   "tex": "\\role{u}{\\Delta U} = U_{\\text{final}} - U_{\\text{initial}}",
   "text": "Depends only on the end states, not on the path."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Between the same two states, which quantity can **change with the path**?",
   "options": [
    {
     "id": "a",
     "label": "Work done by the gas"
    },
    {
     "id": "b",
     "label": "Change in internal energy"
    },
    {
     "id": "c",
     "label": "Change in temperature"
    },
    {
     "id": "d",
     "label": "Change in volume"
    }
   ],
   "answer": "a",
   "hint": "Which are determined by the end states only?",
   "explain": "ΔU, ΔT and ΔV depend only on the end states; the work (area under the path) depends on the path."
  }
 ],
 "takeaways": [
  "\\( \\Delta U \\) is a **state function**: the same for every path between two states."
 ]
}