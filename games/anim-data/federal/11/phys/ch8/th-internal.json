 "steps": [
  {
   "id": "s0",
   "title": "Internal energy",
   "text": "The molecules of a gas have **kinetic energy** (they move) and a little energy from the forces between them. All of it added up is the **internal energy U** of the gas. For an ideal gas it depends only on temperature.",
   "actions": [
    {
     "set": {
      "Q": 0,
      "W": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Way 1: add heat",
   "text": "Put the gas over a flame. Energy flows in as **heat** Q. The molecules speed up (more red), the temperature rises, and U goes **up**.",
   "actions": [
    {
     "set": {
      "Q": 0,
      "W": 0
     },
     "at": 0
    },
    {
     "tween": {
      "Q": 100
     },
     "at": 0,
     "dur": 3800
    }
   ]
  },
  {
   "id": "s2",
   "title": "Way 2: do work on it",
   "text": "Now push the piston in. The piston hits molecules and sends them away faster, so the gas **warms up** even with no flame. Work done **on** the gas also raises U.",
   "actions": [
    {
     "set": {
      "Q": 0,
      "W": 0
     },
     "at": 0
    },
    {
     "tween": {
      "W": 100
     },
     "at": 0,
     "dur": 3800
    }
   ]
  },
  {
   "id": "s3",
   "title": "Both together",
   "text": "Heat and work **add up**: the rise in internal energy is the heat added plus the work done on the gas. This is the first law of thermodynamics.",
   "actions": [
    {
     "set": {
      "Q": 60,
      "W": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Experiment",
   "text": "Use the two sliders. Notice the gas gets hot **either way**: from outside you cannot tell if the energy arrived as heat or as work.",
   "actions": [
    {
     "set": {
      "Q": 0,
      "W": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Q (J)",
   "value": "{{Q|0}}",
   "role": "hot"
  },
  {
   "label": "Work on gas (J)",
   "value": "{{W|0}}",
   "role": "work"
  },
  {
   "label": "Temperature (K)",
   "value": "{{Tt|0}}",
   "role": "u"
  }
 ],
 "formulas": [
  {
   "title": "Rise of internal energy",
   "tex": "\\role{u}{\\Delta U} = \\role{hot}{Q} + \\role{work}{W_{\\text{on}}}",
   "text": "Heat added to the gas plus work done on the gas."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas receives **300 J** of heat and **200 J** of work is done on it. By how many joules does its internal energy rise?",
   "answer": 500,
   "hint": "Add the two energies that go in.",
   "explain": "\\( \\Delta U = 300 + 200 = 500 \\) J.",
   "tolerance": 1,
   "unit": "J",
   "set": {
    "Q": 60,
    "W": 40
   }
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which of these will raise the internal energy of a gas?",
   "options": [
    {
     "id": "a",
     "label": "Heating it"
    },
    {
     "id": "b",
     "label": "Compressing it quickly"
    },
    {
     "id": "c",
     "label": "Both of these"
    },
    {
     "id": "d",
     "label": "Neither"
    }
   ],
   "answer": "c",
   "hint": "There are two ways to put energy in.",
   "explain": "Heat flowing in and work done on the gas both add energy to the molecules."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Compressing a gas quickly in an insulated container makes it warmer. Where did the extra energy come from?",
   "options": [
    {
     "id": "a",
     "label": "From the work done by the piston"
    },
    {
     "id": "b",
     "label": "From nowhere"
    },
    {
     "id": "c",
     "label": "From the cold air outside"
    },
    {
     "id": "d",
     "label": "From the walls"
    }
   ],
   "answer": "a",
   "hint": "No heat could enter.",
   "explain": "The piston does work on the gas: its energy becomes the energy of the molecules, so the gas heats up."
  }
 ],
 "takeaways": [
  "**Internal energy U** is the total energy of the molecules (mainly their kinetic energy in a gas).",
  "U can be raised by **heat** flowing in **or** by **work** done on the gas.",
  "Bigger U means higher temperature for an ideal gas."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "Putting this into one equation gives the **first law of thermodynamics**, Q = ΔU + W (see *First law*). Doing work **on** the gas is the compression of an **adiabatic** process."
  }
 ]
}