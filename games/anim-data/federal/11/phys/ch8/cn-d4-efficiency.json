   "title": "Carnot efficiency",
   "tex": "\\eta=\\dfrac{W}{Q_1}=1-\\dfrac{Q_2}{Q_1}=1-\\dfrac{T_2}{T_1}",
   "text": "Kelvin temperatures. Independent of the working substance.",
   "filled": "\\eta = 1-\\dfrac{ {{T2|0}} }{ {{T1|0}} } = {{eta*100|1}}\\%"
  }
 ],
 "challenges": [
