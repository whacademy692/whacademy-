 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Why is an **isothermal** process usually **slow** and an **adiabatic** process usually **fast**?",
   "actions": [
    {
     "set": {
      "Ls": 8,
      "Lf": 8
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Isothermal: T must stay constant",
   "text": "While the gas is squeezed it tends to heat up. To keep \\( T \\) constant, that heat has to **flow out through the walls into a bath**. Heat flow takes time, so the compression must be **slow**.",
   "actions": [
    {
     "set": {
      "Ls": 8,
      "Lf": 8
     },
     "at": 0
    },
    {
     "tween": {
      "Ls": 4
     },
     "at": 0,
     "dur": 7000
    }
   ]
  },
  {
   "id": "s2",
   "title": "Adiabatic: no heat may flow",
   "text": "For \\( Q = 0 \\) the gas must be insulated **or** the change must happen so quickly that heat has **no time** to leave or enter. A rapid compression does just that, and the gas heats up.",
   "actions": [
    {
     "set": {
      "Ls": 8,
      "Lf": 8
     },
     "at": 0
    },
    {
     "tween": {
      "Lf": 4
     },
     "at": 0,
     "dur": 1300
    }
   ]
  },
  {
   "id": "s3",
   "title": "Compare",
   "text": "The right-hand gas has finished compressing in a moment and its molecules are faster (hotter). The left-hand gas needed a long time to stay at the bath temperature.",
   "actions": [
    {
     "set": {
      "Ls": 4,
      "Lf": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "An **isothermal** change must be **slow** so heat can flow and keep \\( T \\) constant; an **adiabatic** change is done **fast** so there is no time for heat to enter or leave.",
   "actions": [
    {
     "set": {
      "Ls": 4,
      "Lf": 4
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "The two ideal limits",
   "tex": "\\text{isothermal: } \\Delta T = 0 \\;(\\text{slow}) \\qquad \\text{adiabatic: } \\role{hot}{Q} = 0 \\;(\\text{fast})",
   "text": "Real processes lie in between."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Pumping up a bicycle tyre quickly makes the pump hot. This is nearly:",
   "options": [
    {
     "id": "a",
     "label": "adiabatic"
    },
    {
     "id": "b",
     "label": "isothermal"
    },
    {
     "id": "c",
     "label": "isobaric"
    },
    {
     "id": "d",
     "label": "isochoric"
    }
   ],
   "answer": "a",
   "hint": "Fast compression: no time for heat to escape.",
   "explain": "A quick compression leaves no time for heat to leave, so Q ≈ 0 and the temperature rises: adiabatic."
  }
 ],
 "takeaways": [
  "Heat flow takes time: **isothermal = slow**, **adiabatic = fast** (or insulated)."
 ]
}