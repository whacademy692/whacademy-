 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Engine 1 runs between **0 °C and 200 °C**; engine 2 runs between **0 °C and −200 °C**. Find the ratio \\( \\eta_1/\\eta_2 \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Convert to kelvin",
   "text": "Carnot efficiency needs kelvin: \\( T = t + 273 \\). Engine 1: hot \\( 473 \\) K, cold \\( 273 \\) K. Engine 2: hot \\( 273 \\) K (0 °C), cold \\( 73 \\) K (−200 °C).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Efficiency of engine 1",
   "text": "\\[ \\eta_1 = 1 - \\dfrac{273}{473} = 1 - 0.577 = 0.423 \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Efficiency of engine 2",
   "text": "\\[ \\eta_2 = 1 - \\dfrac{73}{273} = 1 - 0.267 = 0.733 \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Take the ratio",
   "text": "\\[ \\dfrac{\\eta_1}{\\eta_2} = \\dfrac{0.423}{0.733} = 0.577 \\] Answer **(A) 0.577**. (0.733 in option C is \\( \\eta_2 \\) itself.)",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Carnot efficiency",
   "tex": "\\eta = 1 - \\dfrac{\\role{cold}{T_{\\text{cold}}}}{\\role{hot}{T_{\\text{hot}}}}",
   "text": "Use kelvin, hot source on the bottom."
  }
 ],
 "challenges": [
  {
   "id": "c1",
