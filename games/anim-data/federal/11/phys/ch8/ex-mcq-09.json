 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Compare the work done in each process from the same starting point.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Isothermal",
   "text": "The gas takes in heat and keeps its temperature: \\( \\Delta U = 0 \\), so **all the heat becomes work** (\\( Q = W \\)). The curve stays high.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Adiabatic",
   "text": "No heat enters, so the work comes only from the internal energy and the pressure drops faster. **Less area.**",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Isochoric",
   "text": "The volume does not change, so \\( W = P\\Delta V = 0 \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer: (B) isothermal",
   "text": "Work is the area under the curve; between the isotherm, the adiabat and the vertical isochore, the isotherm encloses the most. (An isobaric path could enclose more if its pressure were chosen high enough, so the book intends the isothermal answer.)",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Work as area",
   "tex": "\\role{work}{W} = \\text{area under the P–V curve}",
   "text": "Larger area, more work."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Work done in an **isochoric** process is:",
   "options": [
    {
     "id": "a",
     "label": "zero"
    },
    {
     "id": "b",
     "label": "maximum"
    },
    {
     "id": "c",
     "label": "negative always"
    },
    {
     "id": "d",
     "label": "equal to Q"
    }
   ],
   "answer": "a",
   "hint": "ΔV = 0.",
   "explain": "W = PΔV = 0."
  }
 ],
 "takeaways": [
  "Work = area under the curve; isochoric gives 0; isothermal gives more than adiabatic."
 ]
}