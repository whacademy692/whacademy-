 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "The hot-source temperature is doubled. By what factor does the efficiency grow? (The starting efficiency is not given.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Assumption",
   "text": "The key holds when the starting efficiency is \\( 50\\% \\), i.e. \\( T_2/T_1 = 1/2 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "After doubling",
   "text": "\\( T_1 \\to 2T_1 \\), so \\( T_2/T_1 = 1/4 \\) and \\( \\eta = 1 - 1/4 = 0.75 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Ratio",
   "text": "\\[ \\dfrac{0.75}{0.50} = 1.5 \\] Answer **(A)**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Carnot efficiency",
   "tex": "\\eta = 1 - \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1}}",
   "text": "Kelvin."
  }
 ],
 "challenges": [
  {
