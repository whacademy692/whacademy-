 ],
 "formulas": [
  {
   "title": "Work as an area",
   "tex": "\\role{work}{W} = \\int_{V_1}^{V_2} P\\,dV = \\text{area under the P–V curve}",
   "text": "For constant P this is just P ΔV."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Along **Path 1** the gas expands at 3 units of pressure from V = 1 to V = 3. What is the work done in units?",
   "answer": 6,
   "hint": "Rectangle: height × width.",
   "explain": "\\( 3 \\times (3-1) = 6 \\) units.",
   "tolerance": 0.1,
   "unit": "units",
   "set": {
    "path": 1,
    "s": 1
   }
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which path does the **least** work between A and B?",
   "options": [
    {
     "id": "a",
     "label": "Path 1"
    },
    {
     "id": "b",
     "label": "Path 2"
    },
    {
     "id": "c",
     "label": "Path 3"
    },
    {
     "id": "d",
     "label": "All the same"
    }
   ],
   "answer": "c",
   "hint": "Which one has the smallest area under it?",
   "explain": "Path 3 has the smallest area (2 units), so it does the least work.",
   "set": {
    "path": 3,
    "s": 1
   }
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "The work done by a gas between two states:",
   "options": [
    {
     "id": "a",
     "label": "depends only on the two states"
    },
    {
     "id": "b",
     "label": "depends on the path taken"
    },
    {
     "id": "c",
     "label": "is always zero"
    },
    {
     "id": "d",
     "label": "is always positive"
    }
   ],
   "answer": "b",
   "hint": "Compare the three areas.",
   "explain": "Work depends on the path. That is why it is not a \"state function\"."
  }
 ],
 "takeaways": [
  "**Work = area under the P–V curve** (for any path).",
  "Different paths between the same two states do **different amounts of work**.",
  "Work is **not** a property of the state; it depends on the path."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "In a **cycle** (an engine), the net work is the area **enclosed** by the loop: see *Heat engine* and *Carnot cycle*. Constant-volume steps do **no work** (zero width)."
  }
 ]
}