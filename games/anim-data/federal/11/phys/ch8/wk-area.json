 "steps": [
  {
   "id": "s0",
   "title": "From A to B",
   "text": "The gas starts at **A** (low volume, high pressure) and ends at **B** (high volume, low pressure). Many routes join A and B. Does the work done depend on the route?",
   "actions": [
    {
     "set": {
      "path": 1,
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Path 1: expand first",
   "text": "Keep the pressure high and expand to the final volume, then lower the pressure. The area under this path is \\( 3 \\times 2 = 6 \\) units.",
   "actions": [
    {
     "set": {
      "path": 1,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 4200
    }
   ]
  },
  {
   "id": "s2",
   "title": "Path 2: a smooth curve",
   "text": "A smooth isotherm from A to B. Its area is smaller: about {{3*ln(3)|2}} units. The work is the area under the curve.",
   "actions": [
    {
     "set": {
      "path": 2,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 4200
    }
   ]
  },
  {
   "id": "s3",
   "title": "Path 3: lower the pressure first",
   "text": "Reduce the pressure first at constant volume (no work!), then expand at the low pressure. The area is only \\( 1 \\times 2 = 2 \\) units.",
   "actions": [
    {
     "set": {
      "path": 3,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 4200
    }
   ]
  },
  {
   "id": "s4",
   "title": "Work depends on the path",
   "text": "Same start, same end, **three different amounts of work**: 6, 3.3 and 2. Work is not a property of the state of the gas; it depends on **how** the gas gets there. The same is true of heat.",
   "actions": [
    {
     "set": {
      "path": 1,
      "s": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Work (units)",
