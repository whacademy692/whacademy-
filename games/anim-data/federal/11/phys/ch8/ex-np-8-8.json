 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "**70 g** of water at \\( 0\\ \\text{°C} \\) freezes in a refrigerator. Melting 2 g of ice needs 500 J. Find the entropy change of the water.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Latent heat from the data",
   "text": "Melting 2 g takes 500 J, so \\( L = 500/2 = 250 \\) J per gram. We use this value, given in the problem (the textbook value of \\( L \\) for ice is larger, but the problem's own number is what the answer uses).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Heat removed",
   "text": "Freezing **removes** heat: \\( Q = 70 \\times 250 = 17\\,500 \\) J, so \\( \\Delta Q = -17\\,500 \\) J.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Entropy change",
   "text": "At the constant temperature \\( T = 0 + 273 = 273 \\) K: \\[ \\Delta S = \\dfrac{\\Delta Q}{T} = \\dfrac{-17\\,500}{273} = -64\\ \\text{J K}^{-1} \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer and meaning",
   "text": "\\( \\Delta S = -64 \\) J/K. It is **negative** because heat is removed and the molecules go from a free liquid to an ordered solid, so the **water's** entropy falls (the refrigerator's surroundings gain more).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Entropy change",
   "tex": "\\role{ent}{\\Delta S} = \\dfrac{\\Delta Q}{T}",
   "text": "ΔQ negative when heat is removed."
  }
 ],
