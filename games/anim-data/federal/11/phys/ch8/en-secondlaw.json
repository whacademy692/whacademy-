 "steps": [
  {
   "id": "s0",
   "title": "Energy conservation is not enough",
   "text": "The first law only says energy is **conserved**. A machine that turns all its heat into work would obey it. But nobody has ever built one. Something more is needed: the **second law**.",
   "actions": [
    {
     "set": {
      "case": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "A perfect engine?",
   "text": "Imagine an engine that takes 100 J from a hot reservoir and turns **all of it** into 100 J of work, rejecting nothing. It would conserve energy but it is **impossible**: this is the Kelvin–Planck statement.",
   "actions": [
    {
     "set": {
      "case": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "A real engine",
   "text": "A real engine always **rejects some heat** to the cold reservoir: here 100 J in, 40 J of work, 60 J rejected. It is the cold reservoir that makes work possible.",
   "actions": [
    {
     "set": {
      "case": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Heat does not climb uphill",
   "text": "Heat flows **from hot to cold** by itself. A machine that moves heat **from cold to hot** with no work at all is impossible: this is the Clausius statement.",
   "actions": [
    {
     "set": {
      "case": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "A refrigerator needs work",
   "text": "A refrigerator **can** move heat from cold to hot, but only if you supply **work** (the electricity). Then \\( Q_h = Q_c + W \\).",
   "actions": [
    {
     "set": {
      "case": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Try the four machines",
   "text": "Switch between the four machines. Each one conserves energy, but the second law forbids two of them.",
   "actions": [
    {
     "set": {
      "case": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Heat in (J)",
   "value": "{{Qh|0}}",
   "role": "hot"
  },
  {
   "label": "Work (J)",
   "value": "{{W|0}}",
   "role": "work"
  },
  {
   "label": "Heat out (J)",
   "value": "{{Qc|0}}",
   "role": "cold"
  }
 ],
 "formulas": [
  {
   "title": "Kelvin–Planck statement",
   "tex": "\\text{No engine can turn all the heat it takes in into work}",
   "text": "Some heat must always be rejected to a colder reservoir."
  },
  {
   "title": "Clausius statement",
   "tex": "\\text{Heat cannot flow from cold to hot without work}",
   "text": "A refrigerator needs a power supply."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A heat engine takes in 500 J of heat and produces **500 J** of work with no heat rejected. This engine:",
   "options": [
    {
     "id": "a",
     "label": "is possible if it is well made"
    },
    {
     "id": "b",
     "label": "violates the second law"
    },
    {
     "id": "c",
     "label": "violates the first law"
    },
    {
     "id": "d",
     "label": "is a refrigerator"
    }
   ],
   "answer": "b",
   "hint": "Energy is conserved, but is anything rejected?",
   "explain": "It conserves energy, but the second law (Kelvin–Planck) says no engine can convert all its heat into work."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which statement is the **Clausius** statement?",
   "options": [
    {
     "id": "a",
     "label": "Heat cannot flow from a cold body to a hotter body without outside work"
    },
    {
     "id": "b",
     "label": "Energy is conserved"
    },
    {
     "id": "c",
     "label": "Pressure is inversely proportional to volume"
    },
    {
     "id": "d",
     "label": "Entropy never decreases for a dead body"
    }
   ],
   "answer": "a",
   "hint": "It is about heat flowing uphill.",
   "explain": "Clausius: heat cannot pass from a colder to a hotter body by itself."
  },
  {
   "id": "c3",
   "type": "number",
   "title": "Now you try",
   "prompt": "A refrigerator removes **100 J** from the cold space using **40 J** of work. How much heat does it dump into the room (J)?",
   "answer": 140,
   "hint": "Q_h = Q_c + W.",
   "explain": "\\( Q_h = 100 + 40 = 140 \\) J.",
   "tolerance": 1,
   "unit": "J"
  }
 ],
 "takeaways": [
  "**Second law (Kelvin–Planck):** no engine can convert all its heat into work.",
  "**Second law (Clausius):** heat does not flow from cold to hot without work.",
