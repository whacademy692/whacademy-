 "steps": [
  {
   "id": "s0",
   "title": "Energy is conserved",
   "text": "Heat is energy. When 60 J of heat enters a gas, the energy cannot vanish. It goes into **two places**: it heats the gas (**ΔU**) and it pushes the piston out (**W**).",
   "actions": [
    {
     "set": {
      "Q": 60,
      "f": 0.3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Piston locked: all heat raises U",
   "text": "Lock the piston (nothing can move, so **W = 0**). All 60 J goes into the molecules: \\( \\Delta U = Q \\). The gas gets hot but does not expand.",
   "actions": [
    {
     "set": {
      "Q": 60,
      "f": 0.3
     },
     "at": 0
    },
    {
     "tween": {
      "f": 0
     },
     "at": 0,
     "dur": 2800
    }
   ]
  },
  {
   "id": "s2",
   "title": "Free piston at constant temperature: all heat becomes work",
   "text": "Now let the gas push the piston out while it stays at the same temperature (\\( \\Delta U = 0 \\)). All 60 J becomes work: \\( W = Q \\).",
   "actions": [
    {
     "set": {
      "Q": 60,
      "f": 0
     },
     "at": 0
    },
    {
     "tween": {
      "f": 1
     },
     "at": 0,
     "dur": 3200
    }
   ]
  },
  {
   "id": "s3",
   "title": "The usual case: a share of each",
   "text": "In between, part of the heat raises U and the rest pushes the piston. Always \\( Q = \\Delta U + W \\): {{Q|0}} = {{dU|0}} + {{Wk|0}}.",
   "actions": [
    {
     "set": {
      "Q": 60,
      "f": 1
     },
     "at": 0
    },
    {
     "tween": {
      "f": 0.4
     },
     "at": 0,
     "dur": 2800
    }
   ]
  },
  {
   "id": "s4",
   "title": "Sign convention",
   "text": "**Q > 0**: heat goes **into** the gas. **W > 0**: the gas does work **on** the surroundings (expands). **ΔU > 0**: the gas gets hotter. Try different heats and splits.",
   "actions": [
    {
     "set": {
      "Q": 60,
      "f": 0.4
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Heat Q (J)",
   "value": "{{Q|0}}",
   "role": "hot"
  },
  {
   "label": "ΔU (J)",
   "value": "{{dU|0}}",
   "role": "u"
  },
  {
   "label": "Work W (J)",
   "value": "{{Wk|0}}",
   "role": "work"
  }
 ],
 "formulas": [
  {
   "title": "First law of thermodynamics",
   "tex": "\\role{hot}{Q} = \\role{u}{\\Delta U} + \\role{work}{W}",
   "text": "Heat added to the gas = rise in internal energy + work done by the gas."
  },
  {
   "title": "Energy conservation",
   "tex": "\\Delta U = Q - W",
   "text": "The same law written for ΔU. It is conservation of energy including heat."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas absorbs **500 J** of heat and does **200 J** of work on its surroundings. What is the change in its internal energy (J)?",
   "answer": 300,
   "hint": "Use Q = ΔU + W.",
   "explain": "\\( \\Delta U = Q - W = 500 - 200 = 300 \\) J.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas is **compressed**: **150 J** of work is done **on** it and **50 J** of heat leaves it. What is ΔU (J)?",
   "answer": 100,
   "hint": "Work on the gas: W = −150 J. Heat out: Q = −50 J.",
   "explain": "\\( Q = -50,\\ W = -150 \\). \\( \\Delta U = Q - W = -50 + 150 = 100 \\) J. The gas warms up.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "In an **isothermal** expansion of an ideal gas (ΔU = 0), the heat absorbed Q equals:",
   "options": [
    {
     "id": "a",
     "label": "zero"
    },
    {
     "id": "b",
     "label": "the work done W"
    },
    {
     "id": "c",
     "label": "minus the work done"
    },
    {
     "id": "d",
     "label": "the internal energy U"
    }
   ],
   "answer": "b",
   "hint": "Put ΔU = 0 in Q = ΔU + W.",
   "explain": "With ΔU = 0, \\( Q = W \\): all the heat absorbed becomes work."
  }
 ],
 "takeaways": [
  "\\( Q = \\Delta U + W \\): heat in = rise in internal energy + work done by the gas.",
  "It is the law of **conservation of energy** for heat and work.",
  "Signs: Q > 0 heat in; W > 0 gas expands; ΔU > 0 gas heats up."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "Each **process** is the first law with one term removed: **isochoric** (W = 0), **isothermal** (ΔU = 0), **adiabatic** (Q = 0), **isobaric** (W = PΔV). Next: see the four processes one at a time."
  }
 ]
}