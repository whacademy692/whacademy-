 "steps": [
  {
   "id": "s0",
   "title": "A rigid, sealed box",
   "text": "The gas is sealed in a **rigid** box, so its volume cannot change. The gauge shows a pressure of {{Pm|2}} P₀ at {{T|0}} K.",
   "actions": [
    {
     "set": {
      "T": 300
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Heat the box",
   "text": "Heat it. The molecules move faster (redder), so every hit is harder and hits come more often. Nothing can expand, so the **pressure climbs**.",
   "actions": [
    {
     "set": {
      "T": 300
     },
     "at": 0
    },
    {
     "tween": {
      "T": 600
     },
     "at": 0,
     "dur": 4200
    }
   ]
  },
  {
   "id": "s2",
   "title": "A straight line through the origin",
   "text": "Double the kelvin temperature and the pressure **doubles**: at {{T|0}} K the pressure is {{Pm|2}} P₀. The P–T graph is a **straight line through the origin**.",
   "actions": [
    {
     "set": {
      "T": 600
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Cooling lowers the pressure",
   "text": "Cool the gas and the pressure falls. If we could reach **0 K** the molecules would stop and the pressure would drop to zero.",
   "actions": [
    {
     "set": {
      "T": 600
     },
     "at": 0
    },
    {
     "tween": {
      "T": 150
     },
     "at": 0,
     "dur": 4800
    }
   ]
  },
  {
   "id": "s4",
   "title": "Why a heated sealed can can burst",
   "text": "A sealed can in a fire keeps the same volume, so heating raises the pressure until the can bursts. That is why aerosol cans carry a **\"do not heat\"** warning.",
   "actions": [
    {
     "set": {
      "T": 450
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Temperature (K)",
