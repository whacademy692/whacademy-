 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "When does a **real** gas behave like the **ideal** gas of the gas laws?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "What makes a gas ideal?",
   "text": "An ideal gas has molecules that take up no space and **exert no forces on each other** except in collisions. Real molecules do attract each other, but that attraction is tiny when the molecules are **far apart**: this is **low density**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "High density spoils it",
   "text": "When the gas is **crowded** (high density or high pressure) or **cold and slow** (low temperature) the molecules sit close together and their attraction matters. Such a gas can even turn into a liquid.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Compare the options",
   "text": "High pressure (B), high density (C) and low temperature (D) all push the molecules **closer or slow them down**, so the gas becomes less ideal.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer: (A) low density",
   "text": "A real gas is nearly ideal at **low density** (low pressure and high temperature).",
   "actions": []
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which condition makes a real gas behave **most like an ideal gas**?",
   "options": [
    {
     "id": "a",
     "label": "Low pressure, high temperature"
    },
