 "formulas": [
  {
   "title": "Work as an area",
   "tex": "W = \\displaystyle\\int_{V_1}^{V_2} P\\,dV",
   "text": "Area under the P–V curve between the two volumes."
  },
  {
   "title": "Isothermal work",
   "tex": "W_{ab} = Q_1 = nRT_1\\ln\\dfrac{V_2}{V_1}",
   "text": "Valid at constant temperature for an ideal gas.",
   "filled": "W = 8.314 \\times {{T1|0}} \\times \\ln {{Vr|1}} = {{Wex|0}}\\ \\text{J}"
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "1 mol of an ideal gas expands isothermally at \\(400\\) K to **three times** its volume. Find the work done in J (\\(R=8.314\\) J/mol K).",
   "answer": "8.314*400*ln(3)",
   "hint": "Use \\(W=nRT\\ln(V_2/V_1)\\) with \\(V_2/V_1=3\\).",
   "explain": "\\(W=8.314\\times400\\times\\ln3\\approx3654\\) J.",
   "unit": "J",
   "set": {
    "T1": 400,
    "Vr": 3.0
   }
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Why can \\(nRT_1\\) be taken outside the integral?",
   "options": [
    {
     "id": "a",
     "label": "Because the volume is constant"
    },
    {
     "id": "b",
     "label": "Because the temperature is constant on an isotherm"
    },
    {
     "id": "c",
     "label": "Because \\(P\\) is constant"
    }
   ],
   "answer": "b",
   "hint": "What stays fixed along an isotherm?",
   "explain": "On an isotherm \\(T\\) does not change, so \\(nRT_1\\) is a constant multiplier. \\(P\\) and \\(V\\) both change."
  }
 ],
 "takeaways": [
  "Work = area under the P–V curve = \\(\\int P\\,dV\\).",
  "On an isotherm \\(P=nRT/V\\), so \\(W=nRT\\ln(V_2/V_1)\\).",
  "Since \\(\\Delta U=0\\), this is also the heat \\(Q_1\\) absorbed."
 ]
