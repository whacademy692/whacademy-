 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A gas loses \\( 200 \\) J of internal energy while it does \\( 50 \\) J of work. Find the heat \\( Q \\) and the sign of the work.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Signs",
   "text": "Internal energy **decreases**: \\( \\Delta U = -200 \\) J. Work is done **by** the gas: \\( W = +50 \\) J (positive).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "First law",
   "text": "\\[ Q = \\Delta U + W = -200 + 50 = -150\\ \\text{J} \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Meaning",
   "text": "Q is negative, so **150 J of heat flows out** of the gas. The work done by the gas is **positive**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "First law",
   "tex": "\\role{hot}{Q} = \\role{u}{\\Delta U} + \\role{work}{W}",
   "text": "W positive when done by the gas."
  }
 ],
