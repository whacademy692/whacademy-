 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A thermos of milk is **shaken hard** and the milk gets warmer. Which type of process is this?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "A thermos is insulated",
   "text": "The flask stops heat flowing in or out, so \\( Q = 0 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Shaking does work on the milk",
   "text": "The shaking pushes on the milk, so work is done **on** the system. By the usual sign rule the work done **by** the milk is **negative**: \\( W < 0 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Use the first law",
   "text": "\\( Q = \\Delta U + W \\) with \\( Q = 0 \\) gives \\( \\Delta U = -W > 0 \\). The internal energy rises, so the temperature rises.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer: (D) adiabatic",
   "text": "No heat is exchanged, yet the temperature changes: that is an **adiabatic** process (\\( Q = 0 \\)). It cannot be isothermal because T changes.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Adiabatic process",
   "tex": "\\role{hot}{Q} = 0 \\;\\Rightarrow\\; \\role{u}{\\Delta U} = -\\role{work}{W}",
   "text": "All the work done on the system appears as internal energy."
  }
 ],
 "challenges": [
  {
   "id": "c1",
