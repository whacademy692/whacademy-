 "steps": [
  {
   "id": "s0",
   "title": "Temperature is held constant",
   "text": "**Isothermal** means **constant temperature**. The cylinder sits on a large **heat bath** at 300 K. We expand the gas so slowly that heat can flow in and keep it at 300 K the whole time.",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Expand slowly",
   "text": "The piston moves out. Each time molecules hit a retreating piston they lose a little speed, but the bath heat tops them up straight away. Temperature stays at {{T|0}} K, while pressure falls along **Boyle's curve**.",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 5200
    }
   ]
  },
  {
   "id": "s2",
   "title": "ΔU = 0",
   "text": "The temperature did not change, so the internal energy did not change: \\( \\Delta U = 0 \\). The ΔU bar is empty.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "All the heat becomes work",
   "text": "With \\( \\Delta U = 0 \\) the first law gives \\( Q = W \\). The gas took {{Q|1}} units of heat from the bath and turned **all** of it into work: the shaded area under the curve.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Compress it and the reverse happens",
   "text": "Push the piston back in: work is done on the gas and the **same amount of heat flows out** into the bath. Temperature never moves.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    },
    {
     "tween": {
      "s": 0
     },
     "at": 0,
     "dur": 4200
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Heat Q",
   "value": "{{Q|1}}",
   "role": "hot"
  },
  {
   "label": "ΔU",
   "value": "{{dU|1}}",
