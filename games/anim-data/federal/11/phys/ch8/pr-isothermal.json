   "role": "work"
  }
 ],
 "formulas": [
  {
   "title": "Isothermal process",
   "tex": "\\Delta T = 0 \\;\\Rightarrow\\; \\role{u}{\\Delta U} = 0, \\qquad \\role{hot}{Q} = \\role{work}{W}",
   "text": "For an ideal gas U depends only on T."
  },
  {
   "title": "Boyle's law",
   "tex": "P_1V_1 = P_2V_2",
   "text": "The P–V curve is the hyperbola P = constant / V."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "An ideal gas expands isothermally and does **300 J** of work. How much heat does it absorb (J)?",
   "answer": 300,
   "hint": "ΔU = 0, so Q = W.",
   "explain": "\\( Q = \\Delta U + W = 0 + 300 = 300 \\) J.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "During an isothermal expansion the internal energy of an ideal gas changes by how many joules?",
   "answer": 0,
   "hint": "U of an ideal gas depends only on T.",
   "explain": "T is constant so \\( \\Delta U = 0 \\).",
   "tolerance": 0.1,
   "unit": "J"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Why must an isothermal expansion be done slowly?",
   "options": [
    {
     "id": "a",
     "label": "So heat has time to flow in from the surroundings"
    },
    {
     "id": "b",
     "label": "To avoid doing work"
    },
    {
     "id": "c",
     "label": "To keep the pressure constant"
    },
    {
     "id": "d",
     "label": "So the gas does not cool the walls"
    }
   ],
   "answer": "a",
   "hint": "The temperature must stay equal to the bath.",
   "explain": "Slow change gives the heat time to flow in or out and keep the gas at the bath temperature."
  }
 ],
 "takeaways": [
  "**Isothermal = constant temperature**: the P–V curve is a hyperbola \\( PV = \\text{constant} \\).",
  "**ΔU = 0**, so **Q = W**.",
  "Heat flows in or out through the walls to keep T fixed, so it is slow."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "This is **Boyle's law** seen from the energy side. Two steps of the **Carnot cycle** are isothermal: one takes heat from the hot reservoir, the other gives heat to the cold one."
  }
 ]
}