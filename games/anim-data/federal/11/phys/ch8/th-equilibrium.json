 "steps": [
  {
   "id": "s0",
   "title": "A hot body and a cold body",
   "text": "Body **A** is hot (500 K): its atoms vibrate fast (red). Body **B** is cold (200 K): its atoms vibrate slowly (blue). They are in contact but nothing has happened yet.",
   "actions": [
    {
     "set": {
      "TA": 500,
      "TB": 200,
      "t": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Heat flows from hot to cold",
   "text": "Watch the two temperatures. Fast atoms of A bump into slow atoms of B and **share their energy**. **Heat** is this energy on the move from hot to cold. A cools, B warms.",
   "actions": [
    {
     "set": {
      "TA": 500,
      "TB": 200
     },
     "at": 0
    },
    {
     "tween": {
      "t": 3
     },
     "at": 0,
     "dur": 4800
    }
   ]
  },
  {
   "id": "s2",
   "title": "The temperatures meet",
   "text": "The two curves meet at {{Tf|0}} K. The atoms of A and B now vibrate with the **same average energy**. Nothing more changes: the bodies are in **thermal equilibrium**.",
   "actions": [
    {
     "set": {
      "TA": 500,
      "TB": 200
     },
     "at": 0
    },
    {
     "tween": {
      "t": 8
     },
     "at": 0,
     "dur": 3600
    }
   ]
  },
  {
   "id": "s3",
   "title": "Equal temperature means no net heat flow",
   "text": "Two bodies at the **same temperature** are in thermal equilibrium: no net heat flows between them. Temperature is the property that tells which way heat will flow.",
   "actions": [
    {
     "set": {
      "TA": 500,
      "TB": 200,
      "t": 8
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Your turn",
   "text": "Change the starting temperatures and drag **Time** to follow the flow. The final temperature is always in between (for two identical bodies it is the average).",
   "actions": [
    {
     "set": {
      "TA": 500,
      "TB": 200,
      "t": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Body A (K)",
   "value": "{{ta|0}}",
   "role": "hot"
  },
  {
   "label": "Body B (K)",
   "value": "{{tb|0}}",
   "role": "cold"
  },
  {
   "label": "Final (K)",
   "value": "{{Tf|0}}"
  }
 ],
 "formulas": [
  {
   "title": "Final temperature (equal bodies)",
   "tex": "T_f = \\dfrac{\\role{hot}{T_A} + \\role{cold}{T_B}}{2}",
   "text": "Two identical bodies end up at the average temperature."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Two identical blocks, one at **500 K** and one at **300 K**, are placed in contact and left alone. At what temperature (K) will they settle?",
   "answer": 400,
   "hint": "Identical bodies share the difference equally.",
   "explain": "Average of 500 and 300 = **400 K**.",
   "tolerance": 5,
   "unit": "K",
   "set": {
    "TA": 500,
    "TB": 300
   }
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Body A and body B are in thermal equilibrium with a third body C. What can you say about A and B?",
   "options": [
    {
     "id": "a",
     "label": "A is hotter than B"
    },
    {
     "id": "b",
     "label": "They are at the same temperature"
    },
    {
     "id": "c",
     "label": "B is hotter than A"
    },
    {
     "id": "d",
     "label": "Heat will flow between them"
    }
   ],
   "answer": "b",
   "hint": "Equal temperature is what equilibrium means.",
   "explain": "Both are at the temperature of C, so they are at the same temperature as each other. No net heat flows between them."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Heat always flows from:",
   "options": [
    {
     "id": "a",
     "label": "cold to hot"
    },
    {
     "id": "b",
     "label": "hot to cold"
    },
    {
     "id": "c",
     "label": "big to small"
    },
    {
     "id": "d",
     "label": "heavy to light"
    }
   ],
   "answer": "b",
   "hint": "Think of the hot body cooling down.",
   "explain": "Heat flows from the higher temperature to the lower temperature until thermal equilibrium."
  }
 ],
 "takeaways": [
  "**Heat** is energy transferred because of a temperature difference: it flows from hot to cold.",
  "Bodies at the **same temperature** are in thermal equilibrium: no net heat flow.",
  "In a solid, hotter means atoms **vibrate with more energy**."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "Next, see why temperature measures the **average kinetic energy** of molecules, and how heat raises the **internal energy** of a body."
  }
 ]
}