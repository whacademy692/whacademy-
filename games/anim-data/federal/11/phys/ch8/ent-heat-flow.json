 "steps": [
  {
   "id": "s0",
   "title": "Two bodies at different temperatures",
   "text": "A hot body and a cold body are placed in contact. We will follow the **entropy** of each. Entropy change for heat Q added at temperature T is \\( \\Delta S = Q/T \\) (T in kelvin).",
   "actions": [
    {
     "set": {
      "Th": 450,
      "Tc": 300,
      "Q": 200,
      "dir": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "The hot body loses entropy",
   "text": "It gives out \\( Q = {{Q|0}} \\) J at about \\( T_h = {{Th|0}} \\) K. Its entropy changes by \\( -Q/T_h \\): a **decrease**.",
   "actions": [
    {
     "set": {
      "Th": 450,
      "Tc": 300,
      "Q": 200,
      "dir": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "The cold body gains more",
   "text": "It receives the same heat at the **lower** temperature \\( T_c = {{Tc|0}} \\) K, so \\( +Q/T_c \\) is **bigger** than \\( Q/T_h \\). Heat added to a cold body disorders it more than the same heat removes from a hot one.",
   "actions": [
    {
     "set": {
      "Th": 450,
      "Tc": 300,
      "Q": 200,
      "dir": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The total entropy goes up",
   "text": "Adding the two: \\( \\Delta S_{\\text{total}} = Q/T_c - Q/T_h > 0 \\). Heat flowing from hot to cold **increases** the total entropy, which is why it happens by itself.",
   "actions": [
    {
     "set": {
      "Th": 450,
      "Tc": 300,
      "Q": 200,
      "dir": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "The reverse never happens",
   "text": "Now let the same heat flow **from cold to hot**. The total change is **negative**: the entropy of the universe would fall. This is exactly the Clausius form of the second law.",
   "actions": [
    {
     "set": {
      "Th": 450,
      "Tc": 300,
      "Q": 200,
      "dir": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Try it",
   "text": "Change the temperatures and the heat. As long as heat flows from hot to cold, the total is always positive; it is zero only if the two temperatures are equal.",
   "actions": [
    {
     "set": {
      "Th": 450,
      "Tc": 300,
      "Q": 200,
      "dir": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "ΔS hot (J/K)",
   "value": "{{dSh|2}}",
   "role": "hot"
  },
  {
   "label": "ΔS cold (J/K)",
   "value": "{{dSc|2}}",
   "role": "cold"
  },
  {
   "label": "ΔS total (J/K)",
   "value": "{{dSt|2}}",
   "role": "ent"
  }
 ],
 "formulas": [
  {
   "title": "Entropy change",
   "tex": "\\Delta S = \\dfrac{Q}{T}",
   "text": "Q in joules, T in kelvin, ΔS in J/K (heat added at constant temperature)."
  },
  {
   "title": "Heat flow hot → cold",
   "tex": "\\Delta S_{\\text{total}} = \\dfrac{Q}{\\role{cold}{T_c}} - \\dfrac{Q}{\\role{hot}{T_h}} > 0",
   "text": "Because T_c < T_h."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "**400 J** of heat flows from a body at **500 K** to a body at **300 K**. What is the total entropy change in J/K?",
   "answer": 0.533,
   "hint": "ΔS = 400/300 − 400/500.",
   "explain": "\\( \\Delta S = 1.333 - 0.800 = +0.533 \\) J/K.",
   "tolerance": 0.02,
   "unit": "J/K",
   "set": {
    "Th": 500,
    "Tc": 300,
    "Q": 400,
    "dir": 1
   }
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Heat flowing **spontaneously from cold to hot** would make the total entropy:",
   "options": [
    {
     "id": "a",
     "label": "increase"
    },
    {
     "id": "b",
     "label": "decrease"
    },
    {
     "id": "c",
     "label": "stay the same"
    },
    {
     "id": "d",
     "label": "be unrelated to the heat"
    }
   ],
   "answer": "b",
   "hint": "Look at the Total bar.",
   "explain": "The total entropy would fall, which the second law forbids.",
   "set": {
    "dir": 2
   }
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "When does the total entropy change become zero for heat flow between two bodies?",
   "options": [
    {
     "id": "a",
     "label": "When they are at the same temperature"
    },
    {
     "id": "b",
     "label": "When Q is large"
    },
    {
     "id": "c",
     "label": "When heat flows cold to hot"
    },
    {
     "id": "d",
     "label": "Never"
    }
   ],
   "answer": "a",
   "hint": "Set T_h and T_c equal.",
   "explain": "If T_h = T_c, then Q/T_c − Q/T_h = 0: no net change (a reversible exchange)."
  }
 ],
 "takeaways": [
  "**\\( \\Delta S = Q/T \\)**: heat added to a body raises its entropy; heat removed lowers it.",
  "Heat flowing from **hot to cold** raises the **total** entropy, so it happens by itself.",
  "The **second law** in entropy form: the total entropy of an isolated system never decreases."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "A Carnot engine is the limiting reversible case in which the **total entropy change is zero**; every real engine produces a positive entropy change."
  }
 ]
}