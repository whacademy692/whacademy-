 "formulas": [
  {
   "title": "Entropy change on melting",
   "tex": "\\Delta S = \\dfrac{Q}{T}",
   "text": "Q is the heat absorbed while melting at the constant temperature T (in kelvin)."
  },
  {
   "title": "Heat to melt",
   "tex": "Q = m L_f",
   "text": "L_f is the latent heat of fusion: the heat per kilogram to melt a solid at its melting point."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
