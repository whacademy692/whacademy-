 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A refrigerator has \\( \\text{CP} = 5 \\) at room temperature. Find the temperature inside. (Room temperature is not given.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Assumption",
   "text": "Take room temperature \\( T_1 = 300 \\) K. The inside is the cold space at \\( T_2 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Formula",
   "text": "\\[ \\text{CP} = \\dfrac{T_2}{T_1 - T_2} = 5 \\Rightarrow T_2 = 5(300 - T_2) \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Solve",
   "text": "\\( 6T_2 = 1500 \\), so \\( T_2 = 250 \\) K.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer: (C)",
   "text": "250 K. This uses room temperature = 300 K; another room temperature would give a different value.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Coefficient of performance",
   "tex": "\\text{CP} = \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1} - \\role{cold}{T_2}}",
   "text": "Kelvin."
  }
 ],
 "challenges": [
  {
   "id": "c1",
