 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Two objects are in **thermal equilibrium**. Which thing can they **not** do?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "What thermal equilibrium means",
   "text": "Objects in thermal equilibrium have the **same temperature**, so there is **no net heat flow** between them. That is the only thing the condition fixes.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Test each option",
   "text": "Moving, colliding elastically or having different pressures say nothing about temperature, so equilibrium does not forbid them. Different temperatures would make heat flow, so they would **not** be in equilibrium.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer: (D)",
   "text": "They **cannot be at different temperatures**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Thermal equilibrium",
   "tex": "\\role{hot}{T_A} = \\role{cold}{T_B} \\;\\Leftrightarrow\\; \\text{no net heat flow}",
   "text": "Equal temperature is what thermal equilibrium means."
  }
 ],
 "challenges": [
  {
