 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Compare how a refrigerator and an air conditioner work. (The unit text does not list the differences, so they are written here by W.H. Academy.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Similarities",
   "text": "Both are heat engines run **in reverse**: a compressor does work \\( W \\), takes heat \\( Q_2 \\) from a cold space and rejects \\( Q_1 = Q_2 + W \\) to the hotter surroundings. Both need work, as the Clausius statement says.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Dissimilarities",
   "text": "A refrigerator cools a small closed, insulated box (food). A room air conditioner cools a living space and discharges the heat outdoors.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Reversed engine",
   "tex": "\\role{hot}{Q_1} = \\role{cold}{Q_2} + \\role{work}{W}",
   "text": "Heat rejected = heat removed + work."
  }
 ],
