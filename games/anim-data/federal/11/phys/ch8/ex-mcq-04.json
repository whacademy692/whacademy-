 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Gas sits in a **rigid** container and gets **Q** joules of heat. Find the change in internal energy \\( \\Delta U \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Rigid means no work",
   "text": "A rigid wall cannot move, so the volume stays fixed: \\( \\Delta V = 0 \\). Work \\( W = P\\,\\Delta V = 0 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Use the first law",
   "text": "First law: \\( Q = \\Delta U + W \\). With \\( W = 0 \\) it becomes \\( Q = \\Delta U + 0 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer: (C) Q",
   "text": "So \\( \\Delta U = Q \\): **every joule of heat goes into internal energy** (the gas just gets hotter). Options A, B and D would need some of the heat to vanish or to appear from nowhere.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "First law",
   "tex": "\\role{hot}{Q} = \\role{u}{\\Delta U} + \\role{work}{W}",
   "text": "Heat added = rise in internal energy + work done by the gas."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas in a rigid box receives **250 J** of heat. What is its change in internal energy (J)?",
   "answer": 250,
   "hint": "W = 0 in a rigid box.",
   "explain": "\\( \\Delta U = Q - W = 250 - 0 = 250 \\) J.",
   "tolerance": 1,
   "unit": "J"
  }
 ],
 "takeaways": [
  "Constant volume (**isochoric**): \\( W = 0 \\), so \\( Q = \\Delta U \\)."
 ]
}