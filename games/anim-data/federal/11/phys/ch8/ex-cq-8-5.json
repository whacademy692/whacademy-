 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Explain how a **heat engine** works.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "The three parts",
   "text": "A heat engine needs a **hot reservoir** (temperature \\( T_1 \\)), a **cold reservoir** (\\( T_2 \\)) and a **working substance**, usually a gas.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Heat in",
   "text": "The working substance takes heat \\( Q_1 \\) from the hot reservoir (here 100 J).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Work out",
   "text": "It turns part of that heat into mechanical **work** \\( W \\) (40 J) by pushing a piston or a turbine.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Heat rejected, then repeat",
   "text": "The rest, \\( Q_2 \\) (60 J), is **rejected** to the cold reservoir and the substance returns to its initial state. This is **one cycle**; the engine repeats it again and again.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Energy balance and efficiency",
   "text": "\\[ W = Q_1 - Q_2,\\qquad \\eta = \\dfrac{W}{Q_1} \\] The working principle is the **second law**: useful work can be got while heat passes from hot to cold. Example: the four-stroke petrol engine (intake, compression, power, exhaust).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Heat engine",
   "tex": "\\role{work}{W} = \\role{hot}{Q_1} - \\role{cold}{Q_2}, \\quad \\eta = \\dfrac{\\role{work}{W}}{\\role{hot}{Q_1}}",
   "text": "Per cycle."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "An engine takes **500 J** from the hot reservoir and rejects **300 J**. What is its efficiency (%)?",
   "answer": 40,
   "hint": "W = Q₁ − Q₂ = 200 J.",
   "explain": "\\( \\eta = 200/500 = 0.40 = 40\\% \\).",
   "tolerance": 0.5,
   "unit": "%"
  }
 ],
 "takeaways": [
  "Hot reservoir → working substance → work + heat rejected to the cold reservoir: \\( W = Q_1 - Q_2 \\)."
 ]
