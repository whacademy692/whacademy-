 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Explain why an increase of entropy means the **degradation of energy**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Entropy and lost chances",
   "text": "Whenever entropy increases, an **opportunity to convert heat into work is lost**. The energy is still there, but it is spread out and cannot be fully used.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "A car engine",
   "text": "Only part of the fuel's energy does useful work (the green-amber band, 25 %). The rest is released into the atmosphere, where it is **no longer available** to do work.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Refrigerators and air conditioners",
   "text": "A refrigerator cools its inside only by **heating** the room more than it cools the inside. The entropy of the universe **still increases**.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Conclusion",
   "text": "An increase in entropy means **degradation of energy**, and energy is degraded in **all natural processes**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Energy used and wasted",
   "tex": "\\role{hot}{Q_{\\text{fuel}}} = \\role{work}{W} + \\role{cold}{Q_{\\text{lost}}}",
   "text": "The lost part is degraded: it cannot be converted back to work."
  }
 ],
