 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A Carnot engine absorbs heat \\( Q \\) at temperature \\( T \\) and rejects heat at \\( T/3 \\). Find the rejected heat \\( Q_2 \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Carnot relation",
   "text": "For a Carnot (reversible) engine the heats are in the ratio of the kelvin temperatures: \\[ \\dfrac{Q_2}{Q_1} = \\dfrac{T_2}{T_1} \\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Put in the values",
   "text": "\\( Q_1 = Q,\\ T_1 = T,\\ T_2 = T/3 \\): \\[ \\dfrac{Q_2}{Q} = \\dfrac{T/3}{T} = \\dfrac{1}{3} \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Solve",
   "text": "\\( Q_2 = \\dfrac{Q}{3} \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Check",
   "text": "Work \\( W = Q_1 - Q_2 = \\dfrac{2Q}{3} \\), so \\( \\eta = 2/3 \\). The efficiency formula \\( 1 - T_2/T_1 = 1 - 1/3 = 2/3 \\) agrees.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Carnot relation",
   "tex": "\\dfrac{\\role{cold}{Q_2}}{\\role{hot}{Q_1}} = \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1}}",
   "text": "Temperatures in kelvin."
  }
 ],
