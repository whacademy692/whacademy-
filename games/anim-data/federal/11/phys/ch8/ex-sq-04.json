 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "The internal energy has risen. How could you tell whether the cause was **work** \\( W \\) or **heat** \\( Q \\)?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "The result cannot tell you",
   "text": "Internal energy is a **function of state**: \\( \\Delta U = U_2 - U_1 \\) depends only on the final and initial states. A rise of 100 J looks identical whether work or heat produced it.",
   "actions": [
    {
     "set": {
      "pp": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Work: orderly",
   "text": "**Work** is energy transferred by a force moving the **boundary** of the system, such as a piston pushed inward. All the molecules at the piston are shoved the **same way**: orderly, macroscopic motion.",
   "actions": [
    {
     "set": {
      "pp": 0
     },
     "at": 0
    },
    {
     "tween": {
      "pp": 1
     },
     "at": 0,
     "dur": 2800
    }
   ]
  },
  {
   "id": "s3",
   "title": "Heat: disorderly",
   "text": "**Heat** is energy that flows across the boundary **because of a temperature difference**, with no visible motion of the boundary. It is passed on by random molecular collisions: disorderly, microscopic energy.",
   "actions": [
    {
     "set": {
      "pp": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "So look at the process",
   "text": "To decide, examine **how** the energy entered: a force moving a boundary (work) or a temperature difference driving flow (heat).",
   "actions": [
    {
     "set": {
      "pp": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Answer",
   "text": "From the final state alone one cannot tell; the **process** tells. The first law \\( \\Delta U = Q - W \\) counts both.",
   "actions": [
    {
     "set": {
      "pp": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "First law",
   "tex": "\\role{u}{\\Delta U} = \\role{hot}{Q} - \\role{work}{W}",
   "text": "Both heat and work can change U; only the process distinguishes them."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which of these changes the gas's internal energy by **work**?",
   "options": [
    {
     "id": "a",
     "label": "A piston compressing the gas"
    },
    {
     "id": "b",
     "label": "A flame under the container"
    },
    {
     "id": "c",
     "label": "Hot walls touching the gas"
    },
    {
     "id": "d",
     "label": "Warm air around a jar"
    }
   ],
   "answer": "a",
   "hint": "Work needs a moving boundary.",
   "explain": "A moving piston does work on the gas; the other three transfer heat because of a temperature difference."
  }
 ],
 "takeaways": [
  "**Work** = organised energy via a moving boundary. **Heat** = disorganised energy via a temperature difference."
 ]
}