 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "The curve is labelled \\( T = \\) constant. Find \\( \\Delta U \\). (The numbers printed on the figure do not exactly fit \\( PV = \\) constant, but the label is what matters.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Use the label",
   "text": "For an ideal gas \\( U \\) depends only on temperature. Constant temperature means \\( \\Delta T = 0 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Answer: (A) zero",
   "text": "\\( \\Delta U = 0 \\), whatever the exact numbers on the axes.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Internal energy",
   "tex": "\\role{u}{U} \\propto T \\;\\Rightarrow\\; \\Delta T = 0 \\Rightarrow \\Delta U = 0",
   "text": "Ideal gas."
  }
 ],
