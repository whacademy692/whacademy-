 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "An ideal refrigerator: inside \\( 6\\ \\text{°C} \\), room \\( 37\\ \\text{°C} \\). Each joule of electrical work \\( W = 1 \\) J delivers how much heat \\( Q_1 \\) to the room?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Change to kelvin",
   "text": "\\( T_2 = 6 + 273 = 279 \\) K (inside) and \\( T_1 = 37 + 273 = 310 \\) K (room).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Coefficient of performance",
   "text": "How much heat is moved per joule of work: \\[ \\text{CP} = \\dfrac{T_2}{T_1 - T_2} = \\dfrac{279}{310 - 279} = \\dfrac{279}{31} = 9 \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Heat taken from inside",
   "text": "\\( Q_2 = \\text{CP} \\times W = 9 \\times 1 = 9 \\) J is pulled out of the cold interior for every joule of work.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Heat delivered to the room",
   "text": "Energy is conserved: \\[ Q_1 = Q_2 + W = 9 + 1 = 10\\ \\text{J} \\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer",
   "text": "**10 J** of heat reach the room for each joule of electricity. The room warms by more than the electrical energy supplied, because the fridge also dumps the heat it removed from inside.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Refrigerator",
   "tex": "\\text{CP} = \\dfrac{\\role{cold}{Q_2}}{\\role{work}{W}} = \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1} - \\role{cold}{T_2}}, \\quad \\role{hot}{Q_1} = \\role{cold}{Q_2} + \\role{work}{W}",
   "text": "Ideal (reversible) refrigerator; temperatures in kelvin."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "An ideal refrigerator keeps its inside at **0 °C** in a **27 °C** room. How much heat (J) goes to the room per joule of work?",
   "answer": 11.1,
   "hint": "Q₁ / W = T₁ / (T₁ − T₂).",
   "explain": "\\( Q_1/W = 300/(300 - 273) = 300/27 = 11.1 \\) J.",
   "tolerance": 0.1,
   "unit": "J"
  }
 ],
 "takeaways": [
  "Ideal fridge: \\( Q_1/W = T_1/(T_1 - T_2) \\) and \\( Q_1 = Q_2 + W \\)."
 ]
