 "steps": [
  {
   "id": "s0",
   "title": "An insulated cylinder",
   "text": "**Adiabatic** means **no heat flows in or out**: \\( Q = 0 \\). The cylinder is wrapped in insulation (or the change is so fast that heat has no time to move). The gas starts at 300 K.",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Expand: the gas cools",
   "text": "The piston moves out. Molecules that hit a retreating piston **bounce back slower**, and nothing replaces the lost energy. The molecules turn bluer: the gas **cools** to {{T|0}} K.",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 5200
    }
   ]
  },
  {
   "id": "s2",
   "title": "Steeper than the isotherm",
   "text": "Pressure falls faster than in the isothermal case, because the gas is cooling **as well as** spreading out. The adiabat (green) lies **below** the dashed isotherm.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The work comes from U",
   "text": "With \\( Q = 0 \\) the first law gives \\( 0 = \\Delta U + W \\), so \\( W = -\\Delta U \\). The gas did {{W|1}} units of work by **using up** {{-dU|1}} units of its own internal energy.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Compress it: it heats up",
   "text": "Push the piston back and the work done **on** the gas raises its internal energy: the gas **warms up** with no flame. This is how a bicycle pump gets hot and how a diesel engine ignites its fuel.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    },
    {
     "tween": {
      "s": 0
     },
     "at": 0,
     "dur": 4200
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Heat Q",
   "value": "{{Q|1}}",
   "role": "hot"
  },
  {
   "label": "ΔU",
   "value": "{{dU|1}}",
   "role": "u"
  },
  {
   "label": "Work W",
   "value": "{{W|1}}",
   "role": "work"
  }
 ],
 "formulas": [
  {
   "title": "Adiabatic process",
   "tex": "\\role{hot}{Q} = 0 \\;\\Rightarrow\\; \\role{u}{\\Delta U} = -\\role{work}{W}",
   "text": "Expansion: W > 0, so ΔU < 0 (cools). Compression: W < 0, so ΔU > 0 (heats)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "An insulated gas expands and does **200 J** of work. By how much does its internal energy change (J)? Use a negative sign for a decrease.",
   "answer": -200,
   "hint": "Q = 0, so ΔU = −W.",
   "explain": "\\( \\Delta U = Q - W = 0 - 200 = -200 \\) J: the gas cools.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A bicycle pump gets warm when you pump quickly. This is mainly because:",
   "options": [
    {
     "id": "a",
     "label": "Work is done on the air, raising its internal energy"
    },
    {
     "id": "b",
     "label": "Heat flows in from the outside"
    },
    {
     "id": "c",
     "label": "The air expands"
    },
    {
     "id": "d",
     "label": "Friction cools it"
    }
   ],
   "answer": "a",
   "hint": "The compression is fast, so heat has no time to leave.",
   "explain": "Quick compression is nearly adiabatic: work done on the gas goes into its internal energy, so it warms."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "On a P–V graph, compared with an isotherm through the same point, an adiabatic curve is:",
   "options": [
    {
     "id": "a",
     "label": "steeper"
    },
    {
     "id": "b",
     "label": "less steep"
    },
    {
     "id": "c",
     "label": "identical"
    },
    {
     "id": "d",
     "label": "horizontal"
    }
   ],
   "answer": "a",
   "hint": "The gas cools as it expands.",
   "explain": "In an adiabatic expansion the temperature also falls, so the pressure drops faster: the curve is steeper."
  }
 ],
 "takeaways": [
  "**Adiabatic: Q = 0**: no heat enters or leaves.",
  "**ΔU = −W**: expansion cools the gas, compression heats it.",
  "The adiabatic curve is **steeper** than the isotherm."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "Two steps of the **Carnot cycle** are adiabatic: the gas cools while expanding and heats while being compressed, joining the two isotherms. Fast processes such as sound waves in air are nearly adiabatic."
  }
 ]
}