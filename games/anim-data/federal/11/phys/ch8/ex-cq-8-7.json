 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Define and explain **Carnot's engine** and discuss the formula for its **efficiency**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Step 1: isothermal expansion",
   "text": "A Carnot engine is an **ideal, reversible** engine (proposed by Sadi Carnot, 1824) working between a **source** at \\( T_1 \\) and a **sink** at \\( T_2 \\). Step 1: the gas expands **isothermally** at \\( T_1 \\) and **absorbs** heat \\( Q_1 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Step 2: adiabatic expansion",
   "text": "It keeps expanding with **no heat** exchange; the temperature falls from \\( T_1 \\) to \\( T_2 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Step 3: isothermal compression",
   "text": "The gas is compressed **isothermally** at \\( T_2 \\) and **rejects** heat \\( Q_2 \\) to the sink.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Step 4: adiabatic compression",
   "text": "It is compressed with **no heat** exchange and warms from \\( T_2 \\) back to \\( T_1 \\), returning to the start. Over the cycle \\( \\Delta U = 0 \\), so \\( W = Q_1 - Q_2 \\) = the **area of the loop**.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Efficiency",
   "text": "\\[ \\eta = \\dfrac{W}{Q_1} = 1 - \\dfrac{Q_2}{Q_1} = 1 - \\dfrac{T_2}{T_1} \\] (multiply by 100 for a percentage; temperatures in kelvin).",
   "actions": []
  },
  {
   "id": "s6",
   "title": "Properties",
   "text": "The efficiency depends **only on the two temperatures**, not on the working substance. It can **never be 100%** because that would need \\( T_2 = 0 \\) K or \\( T_1 = \\infty \\). **Carnot's theorem:** no engine working between the same two temperatures is more efficient.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Carnot efficiency",
   "tex": "\\eta = 1 - \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1}} = 1 - \\dfrac{\\role{cold}{Q_2}}{\\role{hot}{Q_1}}",
   "text": "T in kelvin."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "What is the maximum efficiency (%) of an engine working between **600 K** and **300 K**?",
   "answer": 50,
   "hint": "η = 1 − T₂/T₁.",
   "explain": "\\( \\eta = 1 - 300/600 = 0.5 = 50\\% \\).",
   "tolerance": 0.5,
   "unit": "%"
  }
 ],
 "takeaways": [
  "Carnot cycle = 2 isotherms + 2 adiabats; \\( \\eta = 1 - T_2/T_1 \\), the highest possible between two temperatures."
 ]
}