 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Can the temperature of an **isolated** system change?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "What isolated means",
   "text": "An isolated system exchanges **no heat and no matter** with its surroundings. Nothing from outside can warm it or cool it.",
   "actions": [
    {
     "set": {
      "eq": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Its total energy is fixed",
   "text": "Because nothing enters or leaves, the **total energy** of the system stays constant.",
   "actions": [
    {
     "set": {
      "eq": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "But the parts inside can change",
   "text": "Inside, a hot part and a cold part exchange heat: the hot part **cools** and the cold part **warms** until both reach one common temperature (thermal equilibrium).",
   "actions": [
    {
     "set": {
      "eq": 0
     },
     "at": 0
    },
    {
     "tween": {
      "eq": 1
     },
     "at": 0,
     "dur": 4500
    }
   ]
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "The temperature of the **system as a whole** is not changed by the surroundings, but **different parts** inside it can change temperature until they reach equilibrium (for example a hot and a cold part in a thermos).",
   "actions": [
    {
     "set": {
      "eq": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "formulas": [
  {
   "title": "Isolated system",
   "tex": "\\role{hot}{Q} = 0,\\quad \\role{work}{W} = 0 \\;\\Rightarrow\\; \\role{u}{\\Delta U} = 0",
   "text": "The total internal energy cannot change."
  }
 ],
 "challenges": [
