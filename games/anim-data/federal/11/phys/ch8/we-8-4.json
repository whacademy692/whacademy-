 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A heat engine works between a source at \\( 400\\ \\text{°C} \\) and a sink at \\( 30\\ \\text{°C} \\). Find its efficiency.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Change to kelvin",
   "text": "\\( T_1 = 400 + 273 = 673 \\) K and \\( T_2 = 30 + 273 = 303 \\) K.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Choose the formula",
   "text": "The best (Carnot) efficiency between two temperatures: \\[ \\eta = \\left(1 - \\dfrac{T_2}{T_1}\\right) \\times 100\\% \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute",
   "text": "\\[ \\eta = \\left(1 - \\dfrac{303}{673}\\right) \\times 100\\% = (1 - 0.45) \\times 100\\% \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( \\eta = 55\\% \\). Of every 100 J taken from the source, at most **55 J** becomes work and **45 J** must be rejected to the cold sink.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Efficiency",
   "tex": "\\eta = \\left(1 - \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1}}\\right)\\times100\\%",
   "text": "Temperatures in kelvin."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "What is the efficiency of an engine working between **500 K** and **300 K** (as a percentage)?",
