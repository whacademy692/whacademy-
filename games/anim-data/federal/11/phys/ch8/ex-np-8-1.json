 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A balloon of radius \\( 10 \\) cm holds air at \\( 180 \\) kPa at room temperature. How many moles of air are inside? (Book answer: 0.3 mol.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Units and the assumption",
   "text": "Use SI units: \\( r = 0.10 \\) m and \\( P = 180\\ \\text{kPa} = 1.80\\times10^{5} \\) Pa. The question does not give the temperature, so we **take room temperature to be 27 °C**, i.e. \\( T = 300 \\) K (an assumption).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Volume of the balloon",
   "text": "The balloon is a sphere: \\[ V = \\tfrac{4}{3}\\pi r^{3} = \\tfrac{4}{3} \\times 3.142 \\times (0.10)^{3} = 4.19\\times10^{-3}\\ \\text{m}^{3} \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Use PV = nRT",
   "text": "\\[ n = \\dfrac{PV}{RT} = \\dfrac{1.80\\times10^{5} \\times 4.19\\times10^{-3}}{8.314 \\times 300} \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( n = 0.30 \\) mol, which matches the book. (If you take 25 °C instead, you still get 0.30 mol: the answer is not sensitive to the exact room temperature.)",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Ideal gas equation",
   "tex": "\\role{u}{P}\\,\\role{ent}{V} = n\\,R\\,\\role{hot}{T}",
   "text": "SI units; T in kelvin; R = 8.314 J mol⁻¹ K⁻¹."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
