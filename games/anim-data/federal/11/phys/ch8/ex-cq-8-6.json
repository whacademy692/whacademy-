 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Define and explain the **second law of thermodynamics**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Kelvin's statement",
   "text": "It is **impossible** for a heat engine to take heat from a **single reservoir** and convert it **entirely into work** with no other change. Some heat must be rejected to a **cold** reservoir.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Clausius's statement",
   "text": "It is **impossible** to make heat flow from a **cold** body to a **hotter** body **without work** being done. A refrigerator needs a motor.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "The entropy form",
   "text": "A natural process goes in the direction in which the **entropy** of the system **plus** its surroundings **increases**. This is why heat flows from hot to cold, never the other way by itself.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Why we need it",
   "text": "The first law only says energy is conserved; it does not say whether a conversion can happen. The **second law** gives the **direction** of heat flow and shows that **both a hot and a cold reservoir** are essential to get work from heat.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Direction of heat flow",
   "tex": "\\role{hot}{T_{\\text{hot}}} \\;\\xrightarrow{\\ \\text{heat flows by itself}\\ }\\; \\role{cold}{T_{\\text{cold}}}",
   "text": "The reverse needs work (a refrigerator)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which machine would break Kelvin's statement?",
   "options": [
    {
     "id": "a",
     "label": "An engine that turns all the heat from one reservoir into work"
    },
    {
     "id": "b",
     "label": "An engine that rejects heat to a cold sink"
    },
    {
     "id": "c",
     "label": "A refrigerator driven by a motor"
    },
    {
     "id": "d",
     "label": "A heat pump driven by electricity"
    }
   ],
   "answer": "a",
   "hint": "Kelvin: you cannot get work from a single reservoir with no heat rejected.",
   "explain": "Converting all the heat of a single reservoir into work violates Kelvin's statement."
  }
 ],
 "takeaways": [
  "Kelvin: no engine converts heat from one reservoir entirely into work. Clausius: heat does not go cold → hot without work."
 ]
