 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "**700 g** of ice melt at \\( 0\\ \\text{°C} \\). Find the entropy change \\( \\Delta S \\); \\( L_f = 3.36\\times10^{5} \\) J kg⁻¹. What is its sign?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Heat absorbed",
   "text": "While melting, the ice absorbs heat at constant temperature: \\[ \\Delta Q = mL_f = 0.7 \\times 3.36\\times10^{5} = 2.35\\times10^{5}\\ \\text{J} \\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Entropy change formula",
   "text": "For heat absorbed at a **constant** temperature: \\[ \\Delta S = \\dfrac{\\Delta Q}{T} = \\dfrac{mL_f}{T} \\] with \\( T = 0 + 273 = 273 \\) K.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute",
   "text": "\\[ \\Delta S = \\dfrac{0.7 \\times 336000}{273} = 861.5\\ \\text{J K}^{-1} \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "The sign",
   "text": "\\( \\Delta S \\) is **positive**: the ice absorbs heat, and its molecules change from an **ordered lattice** to a **disordered liquid**. More disorder means more entropy.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Entropy change at constant T",
   "tex": "\\role{ent}{\\Delta S} = \\dfrac{\\role{hot}{\\Delta Q}}{T}",
   "text": "Positive when heat is absorbed, negative when heat is removed."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "**1 kg** of ice melts at 273 K (L_f = 3.36 × 10⁵ J/kg). What is ΔS in J/K?",
   "answer": 1231,
   "hint": "ΔS = mL/T.",
   "explain": "\\( \\Delta S = 3.36\\times10^{5} / 273 \\approx 1231 \\) J/K.",
