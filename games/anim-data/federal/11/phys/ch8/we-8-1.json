 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Find the **average translational kinetic energy** of a gas molecule at room temperature, \\( 25\\ \\text{°C} \\). Boltzmann constant \\( k = 1.38\\times10^{-23}\\ \\text{J K}^{-1} \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Change to kelvin",
   "text": "Gas formulas need the **absolute** temperature: \\( T = 25 + 273 = 298 \\) K.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Choose the formula",
   "text": "Kinetic theory gives the mean translational kinetic energy of one molecule: \\[ \\langle \\text{K.E.} \\rangle = \\tfrac{3}{2}\\,kT \\] It depends **only on the temperature**, not on the kind of gas.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute",
   "text": "\\[ \\langle \\text{K.E.} \\rangle = \\tfrac{3}{2} \\times 1.38\\times10^{-23} \\times 298 \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( \\langle \\text{K.E.} \\rangle = 6.17\\times10^{-21} \\) J per molecule. A tiny energy, but there are about \\( 10^{25} \\) molecules in a cubic metre of air.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Mean kinetic energy",
