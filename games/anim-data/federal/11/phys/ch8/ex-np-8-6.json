 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "The sink is at room temperature and the efficiency rises from \\( 50\\% \\) to \\( 70\\% \\) by changing the source. Find the difference between the two source temperatures. (Room temperature is not given.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Assumptions",
   "text": "Room temperature \\( T_2 = 25\\ \\text{°C} = 298 \\) K, and \"difference\" means \\( T_1' - T_1 \\) (this matches the book answer).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "First source",
   "text": "\\( T_1 = \\dfrac{T_2}{1 - \\eta} = \\dfrac{298}{0.50} = 596 \\) K.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "New source",
   "text": "\\( T_1' = \\dfrac{298}{0.30} = 993 \\) K.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Difference",
   "text": "\\( 993 - 596 = 397 \\) K.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Source temperature",
   "tex": "\\role{hot}{T_1} = \\dfrac{\\role{cold}{T_2}}{1 - \\eta}",
   "text": "From η = 1 − T₂/T₁."
