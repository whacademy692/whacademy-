: "m", "bold": true}, {"type": "text", "id": "cw", "at": ["(lg>0.5 ? 1.55+px0+ln((cwV)/xmin)/ln(xmax/xmin)*(10.4-px0) : 1.55+px0+((cwV)-xmin)/(xmax-xmin)*(10.4-px0))", "(lg>0.5 ? 1.0+ln((cwP)/ymin)/ln(ymax/ymin)*6.6 : 1.0+((cwP)-ymin)/(ymax-ymin)*6.6)"], "text": "\\(\\circlearrowright\\)", "role": "work", "size": "l", "bold": true, "layer": "front"}, {"type": "point", "id": "live", "at": ["(lg>0.5 ? 1.55+px0+ln((V)/xmin)/ln(xmax/xmin)*(10.4-px0) : 1.55+px0+((V)-xmin)/(xmax-xmin)*(10.4-px0))", "(lg>0.5 ? 1.0+ln((P)/ymin)/ln(ymax/ymin)*6.6 : 1.0+((P)-ymin)/(ymax-ymin)*6.6)"], "role": "me", "r": 8, "layer": "front"}, {"type": "rect", "id": "slabH0", "x": 0.3, "y": 13.55, "w": 8.5, "h": 0.9, "role": "hot", "fill": true, "fillOpacity": 0.1, "strokeWidth": 2.5}, {"type": "rect", "id": "slabH", "x": 0.3, "y": 13.55, "w": 8.5, "h": 0.9, "role": "hot", "fill": true, "fillOpacity": 0.4, "strokeWidth": 2.5, "visible": "hotOn>0.5"}, {"type": "rect", "id": "slabC0", "x": 0.3, "y": 9.8, "w": 8.5, "h": 0.9, "role": "cold", "fill": true, "fillOpacity": 0.1, "strokeWidth": 2.5}, {"type": "rect", "id": "slabC", "x": 0.3, "y": 9.8, "w": 8.5, "h": 0.9, "role": "cold", "fill": true, "fillOpacity": 0.4, "strokeWidth": 2.5, "visible": "coldOn>0.5"}, {"type": "text", "id": "slH", "at": [4.55, 14.0], "text": "HOT RESERVOIR  \\(T_1 = {{T1|0}}\\) K", "role": "hot", "size": "s", "bold": true}, {"type": "text", "id": "slC", "at": [4.55, 10.25], "text": "COLD RESERVOIR  \\(T_2 = {{T2|0}}\\) K", "role": "cold", "size": "s", "bold": true}, {"type": "rect", "id": "insT", "x": 0.3, "y": 12.989999999999998, "w": 8.5, "h": 0.5200000000000015, "role": "wall", "fill": true, "fillOpacity": 0.3, "strokeWidth": 1.5, "visible": "insOn>0.5"}, {"type": "rect", "id": "insB", "x": 0.3, "y": 10.74, "w": 8.5, "h": 0.569999999999999, "role": "wall", "fill": true, "fillOpacity": 0.3, "strokeWidth": 1.5, "visible": "insOn>0.5"}, {"type": "text", "id": "insL", "at": [4.55, 13.25], "text": "INSULATED", "role": "wall", "size": "s", "bold": true, "visible": "insOn>0.5"}, {"type": "vector", "id": "hq0", "from": [1.4, 13.5], "to": [1.4, 12.399999999999999], "role": "hot", "strokeWidth": 6, "visible": "hotOn>0.5", "layer": "front"}, {"type": "vector", "id": "cq0", "from": [1.4, 11.9], "to": [1.4, 10.750000000000002], "role": "cold", "strokeWidth": 6, "visible": "coldOn>0.5", "layer": "front"}, {"type": "vector", "id": "hq1", "from": [3.1, 13.5], "to": [3.1, 12.399999999999999], "role": "hot", "strokeWidth": 6, "visible": "hotOn>0.5", "layer": "front"}, {"type": "vector", "id": "cq1", "from": [3.1, 11.9], "to": [3.1, 10.750000000000002], "role": "cold", "strokeWidth": 6, "visible": "coldOn>0.5", "layer": "front"}, {"type": "vector", "id": "hq2", "from": [4.8, 13.5], "to": [4.8, 12.399999999999999], "role": "hot", "strokeWidth": 6, "visible": "hotOn>0.5", "layer": "front"}, {"type": "vector", "id": "cq2", "from": [4.8, 11.9], "to": [4.8, 10.750000000000002], "role": "cold", "strokeWidth": 6, "visible": "coldOn>0.5", "layer": "front"}, {"type": "polyline", "id": "cyl", "pts": [[6.65, 12.95], [0.3, 12.95], [0.3, 11.35], [6.65, 11.35]], "role": "wall", "strokeWidth": 4}, {"type": "rect", "id": "pis", "x": "L", "y": 11.299999999999999, "w": 0.4, "h": 1.6999999999999997, "role": "pis", "fill": true, "fillOpacity": 0.55, "strokeWidth": 2.5}, {"type": "segment", "id": "rod", "from": ["L+0.4", 12.149999999999999], "to": ["L+1.5", 12.149999999999999], "role": "pis", "strokeWidth": 5}, {"type": "rect", "id": "hdl", "x": "L+1.5", "y": 11.7, "w": 0.3, "h": 0.9, "role": "pis", "fill": true, "fillOpacity": 0.7, "strokeWidth": 2}, {"type": "gas", "id": "g", "x0": 0.3, "x1": "L", "y0": 11.35, "y1": 12.95, "n": 30, "v": "vg", "bath": 1, "vref": 2.2, "seed": 7, "out": {"vrms": "gv", "P": "gp", "hits": "gh"}}, {"type": "vector", "id": "wOut", "from": ["L+1.95", 12.149999999999999], "to": ["L+2.75", 12.149999999999999], "role": "work", "strokeWidth": 6, "visible": "Ve>Vs", "layer": "front"}, {"type": "vector", "id": "wIn", "from": ["L+2.75", 12.149999999999999], "to": ["L+1.95", 12.149999999999999], "role": "work", "strokeWidth": 6, "visible": "Ve<Vs", "layer": "front"}, {"type": "text", "id": "wLab", "at": ["L+2.35", 12.7], "text": "W", "role": "work", "size": "s", "bold": true, "visible": "Ve>Vs || Ve<Vs"}, {"type": "text", "id": "h1_0", "at": [6.45, 9.4], "text": "\\(a\\to b\\)  Isothermal expansion", "role": "hot", "size": "m", "bold": true, "visible": "leg==0"}, {"type": "text", "id": "h2_0", "at": [6.45, 8.75], "text": "Heat \\(Q_1\\) flows IN  ·  \\(T\\) stays \\(T_1\\)", "role": "wall", "size": "s", "bold": false, "visible": "leg==0"}, {"type": "text", "id": "h1_1", "at": [6.45, 9.4], "text": "\\(b\\to c\\)  Adiabatic expansion", "role": "adB", "size": "m", "bold": true, "visible": "leg==1"}, {"type": "text", "id": "h2_1", "at": [6.45, 8.75], "text": "No heat flow  ·  gas cools \\(T_1\\to T_2\\)", "role": "wall", "size": "s", "bold": false, "visible": "leg==1"}, {"type": "text", "id": "h1_2", "at": [6.45, 9.4], "text": "\\(c\\to d\\)  Isothermal compression", "role": "cold", "size": "m", "bold": true, "visible": "leg==2"}, {"type": "text", "id": "h2_2", "at": [6.45, 8.75], "text": "Heat \\(Q_2\\) flows OUT  ·  \\(T\\) stays \\(T_2\\)", "role": "wall", "size": "s", "bold": false, "visible": "leg==2"}, {"type": "text", "id": "h1_3", "at": [6.45, 9.4], "text": "\\(d\\to a\\)  Adiabatic compression", "role": "adD", "size": "m", "bold": true, "visible": "leg==3"}, {"type": "text", "id": "h2_3", "at": [6.45, 8.75], "text": "No heat flow  ·  gas warms \\(T_2\\to T_1\\)", "role": "wall", "size": "s", "bold": false, "visible": "leg==3"}, {"type": "segment", "id": "bbase", "from": [9.3, 10.05], "to": [12.85, 10.05], "role": "wall", "strokeWidth": 2}, {"type": "rect", "id": "bar0", "x": 9.45, "y": 10.05, "w": 0.8, "h": "max(0.04, abs(bA)/bmax*2.6)", "role": "hot", "fill": true, "fillOpacity": 0.55, "strokeWidth": 2}, {"type": "text", "id": "bn0", "at": [9.85, 13.649999999999999], "text": "\\(Q_1\\)", "role": "hot", "size": "s", "bold": true}, {"type": "text", "id": "bv0", "at": [9.85, "10.05+max(0.04, abs(bA)/bmax*2.6)+0.32"], "text": "{{bA|int}}", "role": "hot", "size": "s", "bold": true}, {"type": "rect", "id": "bar1", "x": 10.649999999999999, "y": 10.05, "w": 0.8, "h": "max(0.04, abs(bW)/bmax*2.6)", "role": "work", "fill": true, "fillOpacity": 0.55, "strokeWidth": 2}, {"type": "text", "id": "bn1", "at": [11.049999999999999, 13.649999999999999], "text": "\\(W\\)", "role": "work", "size": "s", "bold": true}, {"type": "text", "id": "bv1", "at": [11.049999999999999, "10.05+max(0.04, abs(bW)/bmax*2.6)+0.32"], "text": "{{bW|int}}", "role": "work", "size": "s", "bold": true}, {"type": "rect", "id": "bar2", "x": 11.85, "y": 10.05, "w": 0.8, "h": "max(0.04, abs(bB)/bmax*2.6)", "role": "cold", "fill": true, "fillOpacity": 0.55, "strokeWidth": 2}, {"type": "text", "id": "bn2", "at": [12.25, 13.649999999999999], "text": "\\(Q_2\\)", "role": "cold", "size": "s", "bold": true}, {"type": "text", "id": "bv2", "at": [12.25, "10.05+max(0.04, abs(bB)/bmax*2.6)+0.32"], "text": "{{bB|int}}", "role": "cold", "size": "s", "bold": true}], "steps": [{"id": "s0", "title": "The Carnot loop", "text": "A gas in a cylinder is taken round a closed loop \\(a\\to b\\to c\\to d\\to a\\) on the \\(P\\)–\\(V\\) graph. The loop has **two isotherms** (temperature fixed) and **two adiabats** (no heat flows).", "actions": [{"set": {"ph": 0, "wk": 0}, "at": 0}], "dwell": 5200}, {"id": "s1", "title": "a → b: isothermal expansion", "text": "The gas touches the **hot** reservoir at \\(T_1 = {{T1|0}}\\) K. It expands and heat \\(Q_1\\) flows in. \\(\\Delta U = 0\\), so all of \\(Q_1\\) becomes work: \\(Q_1 = W_{ab}\\).", "actions": [{"set": {"wk": 0}, "at": 0}, {"tween": {"ph": 0.995}, "at": 0, "dur": 3600}], "dwell": 5200}, {"id": "s2", "title": "b → c: adiabatic expansion", "text": "Now the cylinder is **insulated**: \\(Q = 0\\). The gas keeps expanding, paying for the work from its own energy, \\(\\Delta U = -W\\). So it cools from \\(T_1\\) to \\(T_2 = {{T2|0}}\\) K.", "actions": [{"set": {"wk": 0}, "at": 0}, {"tween": {"ph": 1.995}, "at": 0, "dur": 3600}], "dwell": 5200}, {"id": "s3", "title": "c → d: isothermal compression", "text": "The gas touches the **cold** reservoir at \\(T_2\\). The piston squeezes it and heat \\(Q_2\\) flows **out**. \\(T\\) stays \\(T_2\\), \\(\\Delta U = 0\\).", "actions": [{"set": {"wk": 0}, "at": 0}, {"tween": {"ph": 2.995}, "at": 0, "dur": 3600}], "dwell": 5200}, {"id": "s4", "title": "d → a: adiabatic compression", "text": "Insulated again, \\(Q = 0\\). The piston does work on the gas, so it warms from \\(T_2\\) back to \\(T_1\\). We are back at \\(a\\): one full cycle, \\(\\Delta U_{\\text{cycle}} = 0\\).", "actions": [{"set": {"wk": 0}, "at": 0}, {"tween": {"ph": 3.995}, "at": 0, "dur": 3600}], "dwell": 5200}, {"id": "s5", "title": "Net work = area of the loop", "text": "Going out (\\(a\\to b\\to c\\)) the gas does **more** work than we do on it coming back (\\(c\\to d\\to a\\)). The difference \\(W = Q_1 - Q_2\\) is the **area enclosed** by the loop.", "actions": [{"set": {"ph": 4}, "at": 0}, {"tween": {"wk": 1}, "at": 0, "dur": 1500}], "dwell": 5200}, {"id": "s6", "title": "Heat in, heat out", "text": "With 1 mol of gas: \\(Q_1 = {{Q1|0}}\\) J goes in at \\(T_1\\) and \\(Q_2 = {{Q2|0}}\\) J goes out at \\(T_2\\). So \\(W = Q_1 - Q_2 = {{Wn|0}}\\) J per cycle.", "actions": [{"set": {"ph": 4, "wk": 1}, "at": 0}], "dwell": 5200}, {"id": "s7", "title": "Efficiency", "text": "\\(\\eta = \\dfrac{W}{Q_1} = 1 - \\dfrac{T_2}{T_1} = 1 - \\dfrac{ {{T2|0}} }{ {{T1|0}} } = {{eta*100|1}}\\%\\). It depends **only** on the two temperatures.", "actions": [{"set": {"ph": 4, "wk": 1}, "at": 0}], "dwell": 5200}, {"id": "s8", "title": "Your turn", "text": "Change \\(T_1\\), \\(T_2\\) and \\(V_2/V_1\\) and press play. Raise \\(T_1\\) or lower \\(T_2\\) and the efficiency climbs; the loop gets taller.", "actions": [{"set": {"ph": 0, "wk": 1}, "at": 0}], "dwell": 4000}], "readouts": [{"label": "Heat in (a→b)", "value": "{{Q1|0}} J", "role": "hot"}, {"label": "Heat out (c→d)", "value": "{{Q2|0}} J", "role": "cold"}, {"label": "Net work (loop area)", "value": "{{Wn|0}} J", "role": "work"}, {"label": "Efficiency", "value": "{{eta*100|1}} %", "role": "ans"}, {"label": "Gas now: T", "value": "{{T|0}} K", "role": "me"}, {"label": "Gas now: V", "value": "{{V/V1|2}} × V₁", "role": "me"}, {"label": "Gas now: P", "value": "{{P/P1|2}} × P₁", "role": "me"}], "presets": [{"name": "Textbook: 500 K and 300 K", "values": {"T1": 500, "T2": 300, "Vr": 2.0}}, {"name": "Big temperature gap", "values": {"T1": 650, "T2": 260, "Vr": 2.0}}, {"name": "Small gap (poor engine)", "values": {"T1": 480, "T2": 320, "Vr": 2.0}}], "formulas": [{"title": "Isothermal expansion (a→b)", "tex": "Q_1 = W_{ab} = nRT_1\\ln\\dfrac{V_2}{V_1},\\quad \\Delta U = 0", "text": "Heat in equals work out because the temperature does not change."}, {"title": "Adiabatic strokes (b→c, d→a)", "tex": "Q = 0,\\quad \\Delta U = -W", "text": "No heat flows; work changes the internal energy."}, {"title": "Isothermal compression (c→d)", "tex": "Q_2 = nRT_2\\ln\\dfrac{V_3}{V_4},\\quad \\Delta U = 0", "text": "Heat \\(Q_2\\) (a magnitude) is rejected to the cold reservoir."}, {"title": "Work and efficiency", "tex": "W = Q_1 - Q_2 = \\text{area of loop},\\qquad \\eta = \\dfrac{W}{Q_1} = 1-\\dfrac{T_2}{T_1}", "text": "Temperatures in kelvin.", "filled": "\\eta = 1-\\dfrac{ {{T2|0}} }{ {{T1|0}} } = {{eta*100|1}}\\%"}], "challenges": [{"id": "c1", "type": "choice", "title": "Now you try", "prompt": "Which two strokes are **adiabatic** (no heat flows)?", "options": [{"id": "a", "label": "\\(a\\to b\\) and \\(c\\to d\\)"}, {"id": "b", "label": "\\(b\\to c\\) and \\(d\\to a\\)"}, {"id": "c", "label": "\\(a\\to b\\) and \\(b\\to c\\)"}], "answer": "b", "hint": "Adiabatic means insulated cylinder: no contact with a reservoir.", "explain": "The reservoirs are touched only in \\(a\\to b\\) (hot) and \\(c\\to d\\) (cold). The other two strokes are adiabatic."}, {"id": "c2", "type": "number", "title": "Now you try", "prompt": "A Carnot engine works between \\(T_1 = 500\\) K and \\(T_2 = 300\\) K. Find its efficiency in %.", "answer": "(1-T2/T1)*100", "hint": "Use \\(\\eta = 1 - T_2/T_1\\) with kelvin temperatures.", "explain": "\\(\\eta = 1 - 300/500 = 0.4 = 40\\%\\).", "unit": "%", "set": {"T1": 500, "T2": 300}}, {"id": "c3", "type": "number", "title": "Now you try", "prompt": "The engine takes \\(Q_1 = 1000\\) J from the hot reservoir at \\(600\\) K and the cold reservoir is at \\(300\\) K. How much heat \\(Q_2\\) (in J) goes to the cold reservoir?", "answer": 500, "hint": "For a Carnot engine \\(Q_2/Q_1 = T_2/T_1\\).", "explain": "\\(Q_2 = Q_1\\,T_2/T_1 = 1000 \\times 300/600 = 500\\) J, so \\(W = 500\\) J.", "unit": "J"}, {"id": "c4", "type": "choice", "title": "Now you try", "prompt": "What does the area enclosed by the loop represent?", "options": [{"id": "a", "label": "Heat absorbed \\(Q_1\\)"}, {"id": "b", "label": "Net work \\(W\\) in one cycle"}, {"id": "c", "label": "Change in internal energy"}], "answer": "b", "hint": "Area under a P–V curve is work; the loop is \"out minus back\".", "explain": "The area under the top curves is work done **by** the gas, the area under the bottom curves is work done **on** it; the loop area is the difference, \\(W = Q_1 - Q_2\\)."}], "takeaways": ["Two isotherms and two adiabats make the loop \\(a\\to b\\to c\\to d\\to a\\).", "Heat enters only on \\(a\\to b\\) and leaves only on \\(c\\to d\\).", "Net work \\(W = Q_1 - Q_2\\) is the area of the loop.", "\\(\\eta = 1 - T_2/T_1\\) — only the reservoir temperatures matter."], "notes": [{"title": "3D model", "text": "Want to turn the engine around in 3D? Open **games/carnot-3d.html** (whacademypk.com/games/carnot-3d.html): drag to rotate the cylinder, piston and reservoirs while the P–V loop is drawn beside it. The cube 