  }
 ],
 "formulas": [
  {
   "title": "Carnot efficiency",
   "tex": "\\eta = 1 - \\dfrac{\\role{cold}{T_c}}{\\role{hot}{T_h}}",
   "text": "Temperatures in kelvin. Always less than 1 because T_c > 0."
  },
  {
   "title": "Heat ratio",
   "tex": "\\dfrac{\\role{cold}{Q_c}}{\\role{hot}{Q_h}} = \\dfrac{\\role{cold}{T_c}}{\\role{hot}{T_h}}",
   "text": "In a Carnot engine the heats are in the ratio of the temperatures."
  }
 ],
