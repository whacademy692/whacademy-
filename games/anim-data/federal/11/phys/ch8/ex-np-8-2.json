 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A heat engine works between the **freezing point** and the **boiling point** of water. Find its efficiency.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Temperatures in kelvin",
   "text": "\\( T_2 = 0 + 273 = 273 \\) K (cold) and \\( T_1 = 100 + 273 = 373 \\) K (hot).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Choose the formula",
   "text": "\\[ \\eta = \\left(1 - \\dfrac{T_2}{T_1}\\right) \\times 100\\% \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute",
   "text": "\\[ \\eta = \\left(1 - \\dfrac{273}{373}\\right) \\times 100\\% = (1 - 0.732) \\times 100\\% \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( \\eta = 27\\% \\). Of every 100 J taken from the 373 K source, at most 27 J can become work.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Efficiency",
   "tex": "\\eta = \\left(1 - \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1}}\\right) \\times 100\\%",
   "text": "Kelvin."
  }
 ],
