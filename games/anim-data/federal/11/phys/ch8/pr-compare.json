 "steps": [
  {
   "id": "s0",
   "title": "One start, four roads",
   "text": "The gas starts at the same state (300 K, 2 P₀, V = 4). We will push it along four different paths, each keeping one quantity fixed or special.",
   "actions": [
    {
     "set": {
      "k": 2,
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Isochoric: vertical",
   "text": "Constant **volume**: straight up. No work. All the heat raises U: \\( Q = \\Delta U \\).",
   "actions": [
    {
     "set": {
      "k": 1,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 3600
    }
   ]
  },
  {
   "id": "s2",
   "title": "Isobaric: horizontal",
   "text": "Constant **pressure**: straight across. Work \\( W = P\\Delta V \\). The heat covers both: \\( Q = \\Delta U + W \\).",
   "actions": [
    {
     "set": {
      "k": 2,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 3600
    }
   ]
  },
  {
   "id": "s3",
   "title": "Isothermal: the hyperbola",
   "text": "Constant **temperature**: \\( \\Delta U = 0 \\), so \\( Q = W \\). All heat taken in becomes work.",
   "actions": [
    {
     "set": {
      "k": 3,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 3600
    }
   ]
  },
  {
   "id": "s4",
   "title": "Adiabatic: the steep curve",
   "text": "No **heat**: \\( Q = 0 \\), so \\( \\Delta U = -W \\). The gas cools as it does work, and the curve falls below the isotherm.",
   "actions": [
    {
     "set": {
      "k": 4,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 3600
    }
   ]
  },
  {
   "id": "s5",
   "title": "Compare them all",
   "text": "Choose a process and slide **Progress**. Which one does the most work? (Compare the area under each curve to the same final volume.) Which one needs the most heat?",
   "actions": [
    {
     "set": {
      "k": 2,
      "s": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Heat Q",
   "value": "{{Q|1}}",
   "role": "hot"
  },
  {
   "label": "ΔU",
   "value": "{{dU|1}}",
   "role": "u"
  },
  {
   "label": "Work W",
   "value": "{{W|1}}",
   "role": "work"
  }
 ],
 "formulas": [
  {
   "title": "One law, four special cases",
   "tex": "\\role{hot}{Q} = \\role{u}{\\Delta U} + \\role{work}{W}",
   "text": "Isochoric: W = 0.  Isobaric: W = PΔV.  Isothermal: ΔU = 0.  Adiabatic: Q = 0."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which process has **no work** at all?",
   "options": [
    {
     "id": "a",
     "label": "Isochoric"
    },
    {
     "id": "b",
     "label": "Isobaric"
    },
    {
     "id": "c",
     "label": "Isothermal"
    },
    {
     "id": "d",
     "label": "Adiabatic"
    }
   ],
   "answer": "a",
   "hint": "Work needs a change of volume.",
   "explain": "Isochoric: ΔV = 0, so W = 0."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which process has **no heat exchange** with the surroundings?",
   "options": [
    {
     "id": "a",
     "label": "Isochoric"
    },
    {
     "id": "b",
     "label": "Isobaric"
    },
    {
     "id": "c",
     "label": "Isothermal"
    },
    {
     "id": "d",
     "label": "Adiabatic"
    }
   ],
   "answer": "d",
   "hint": "Think of the insulated cylinder.",
   "explain": "Adiabatic: Q = 0."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "In which process is the heat absorbed **exactly equal** to the work done?",
   "options": [
    {
     "id": "a",
     "label": "Isochoric"
    },
    {
     "id": "b",
     "label": "Isobaric"
    },
    {
     "id": "c",
     "label": "Isothermal"
    },
    {
     "id": "d",
     "label": "Adiabatic"
    }
   ],
   "answer": "c",
   "hint": "ΔU must be zero.",
   "explain": "Isothermal: ΔU = 0, so Q = W."
  }
 ],
 "takeaways": [
  "All four processes obey **Q = ΔU + W**.",
  "Isochoric W = 0; isobaric W = PΔV; isothermal ΔU = 0; adiabatic Q = 0.",
  "On the P–V graph the work is the **area under** each curve."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "A **Carnot cycle** is built from two isotherms and two adiabats. Next: see how a closed loop of processes becomes a **heat engine**."
  }
 ]
}