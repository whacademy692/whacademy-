   "title": "Read the question",
   "text": "Which statement about expansion on heating is correct? (Thermal expansion is a Class 11 topic outside the Unit 8 text, so the idea is explained here.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Materials differ",
   "text": "Each material has its own expansion coefficient, so metals, glass and plastics expand by different amounts for the same temperature rise.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Other options",
   "text": "Heating does not change the **weight**, and expansion makes the density **smaller**, not larger.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer: (C)",
   "text": "Expansion occurs at different rates for different materials.",
   "actions": []
  }
 ],
