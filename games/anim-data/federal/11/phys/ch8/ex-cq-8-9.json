 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Explain the working of a **refrigerator**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "A heat engine in reverse",
   "text": "A refrigerator is a **heat engine run backwards**: it moves heat from a **cold** place to a **warm** one. Its working substance is a refrigerant gas.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Heat taken from inside",
   "text": "The refrigerant absorbs heat \\( Q_2 \\) from the **cold** interior (temperature \\( T_2 \\)), here 400 J.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Work from the compressor",
   "text": "A **compressor** does work \\( W \\) on the gas (100 J). Without work the heat would not go uphill.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Heat rejected to the room",
   "text": "The gas rejects heat \\( Q_1 = Q_2 + W \\) (500 J) to the **hot** surroundings (the room).",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Coefficient of performance",
   "text": "How well it cools: \\[ \\text{CP} = \\dfrac{Q_2}{W} = \\dfrac{T_2}{T_1 - T_2} \\] Here \\( \\text{CP} = 400/100 = 4 \\).",
   "actions": []
  },
  {
   "id": "s6",
   "title": "Why work is needed",
   "text": "Heat does not flow from cold to hot by itself (**Clausius**), so work is essential. Used to heat a space, the same machine is a **heat pump** with \\( \\text{CP}_{\\text{heating}} = T_1/(T_1 - T_2) \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Refrigerator",
   "tex": "\\role{hot}{Q_1} = \\role{cold}{Q_2} + \\role{work}{W}, \\quad \\text{CP} = \\dfrac{\\role{cold}{Q_2}}{\\role{work}{W}} = \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1} - \\role{cold}{T_2}}",
   "text": "Ideal refrigerator; kelvin."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A refrigerator takes **600 J** from inside using **150 J** of work. What is its coefficient of performance?",
   "answer": 4,
   "hint": "CP = Q₂ / W.",
   "explain": "\\( \\text{CP} = 600/150 = 4 \\).",
   "tolerance": 0.05
  }
 ],
 "takeaways": [
  "Refrigerator: takes \\( Q_2 \\) from cold, work \\( W \\) in, rejects \\( Q_1 = Q_2 + W \\) to hot; \\( \\text{CP} = Q_2/W \\)."
 ]
