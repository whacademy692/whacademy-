 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "What is **entropy**? Explain.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Entropy and disorder",
   "text": "**Entropy** \\( S \\) is a state variable that measures the **disorder** (randomness) of the particles, or how unavailable the thermal energy is for doing work.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "The formula",
   "text": "For a reversible process absorbing heat \\( \\Delta Q \\) at absolute temperature \\( T \\): \\[ \\Delta S = \\dfrac{\\Delta Q}{T} \\quad (\\text{J K}^{-1}) \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Signs",
   "text": "\\( \\Delta S \\) is **positive** when heat is added (more disorder) and **negative** when heat is removed.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Heat flowing hot → cold",
   "text": "Let \\( Q = 100 \\) J flow from \\( T_1 = 400 \\) K to \\( T_2 = 300 \\) K: \\[ \\Delta S = \\dfrac{Q}{T_2} - \\dfrac{Q}{T_1} = \\dfrac{100}{300} - \\dfrac{100}{400} = +0.083\\ \\text{J K}^{-1} \\] The total is **positive**.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Natural processes",
   "text": "Natural processes go towards **greater disorder**, so the entropy of the universe **increases** (for example when ice melts).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Entropy change",
   "tex": "\\role{ent}{\\Delta S} = \\dfrac{\\Delta Q}{T}",
   "text": "T in kelvin; ΔQ positive if heat is absorbed."
  }
 ],
 "challenges": [
  {
   "id": "c1",
