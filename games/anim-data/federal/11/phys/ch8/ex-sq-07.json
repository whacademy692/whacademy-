 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Compare the two curves that start from the same point on a P–V diagram. (This explanation is written by W.H. Academy; the book gives no model answer.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Isothermal",
   "text": "Heat flows in to keep \\( T \\) constant, so only the **volume** change lowers the pressure: \\( PV = \\text{constant} \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Adiabatic",
   "text": "No heat enters, so the gas does work at the cost of its internal energy: **T falls** while V rises. Both the larger volume and the lower temperature lower P, so P drops faster.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "That is why the adiabat is **steeper**. In symbols it follows \\( PV^{\\gamma} = \\text{constant} \\) with \\( \\gamma > 1 \\), while the isotherm has \\( PV = \\text{constant} \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Two curves",
   "tex": "\\role{hot}{PV} = \\text{const}\\quad \\role{cold}{PV^{\\gamma}} = \\text{const}",
   "text": "γ > 1."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "During an adiabatic expansion the temperature of the gas:",
   "options": [
    {
     "id": "a",
