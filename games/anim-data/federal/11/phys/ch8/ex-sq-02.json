 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "The internal energy \\( U \\) of a system goes **up**. Must its temperature go up too?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "What internal energy contains",
   "text": "Internal energy is the **kinetic** energy of the molecules **plus** the **potential** energy stored in the bonds between them. Temperature measures only the **kinetic** part.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Heating a solid",
   "text": "Warming ice from −20 °C to 0 °C: the heat raises the kinetic energy, so both \\( U \\) and \\( T \\) rise.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Melting: the plateau",
   "text": "At 0 °C the ice melts. The heat now goes into **breaking bonds**: the potential energy rises, so \\( U \\) rises, but the molecules' average kinetic energy is unchanged: **T stays at 0 °C**.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "After melting",
   "text": "Once all the ice has melted, extra heat raises the kinetic energy again and the temperature climbs.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer: Yes",
   "text": "**Yes.** During a change of state (melting, boiling) the internal energy increases while the temperature stays constant.",
   "actions": []
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Boiling water at 100 °C absorbs heat. Its temperature stays at 100 °C. Where does the heat go?",
   "options": [
