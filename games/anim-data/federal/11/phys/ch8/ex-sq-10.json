 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Does the entropy of a **Carnot engine** go up in each cycle?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Isothermal expansion",
   "text": "The gas absorbs \\( Q_1 \\) at \\( T_1 \\): \\( \\Delta S = +Q_1/T_1 \\) (entropy of the gas rises).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Adiabatic expansion",
   "text": "No heat flows, so \\( \\Delta S = 0 \\). The gas just cools from \\( T_1 \\) to \\( T_2 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Isothermal compression",
   "text": "The gas rejects \\( Q_2 \\) at \\( T_2 \\): \\( \\Delta S = -Q_2/T_2 \\) (entropy falls). For a Carnot cycle \\( Q_2/Q_1 = T_2/T_1 \\), so this exactly cancels the gain.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Adiabatic compression",
   "text": "Again \\( \\Delta S = 0 \\). The gas returns to its starting state.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer: No",
   "text": "Over one cycle \\( \\Delta S = \\dfrac{Q_1}{T_1} - \\dfrac{Q_2}{T_2} = 0 \\). The cycle is **reversible** and the gas returns to its initial state, so its entropy change is **zero**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Carnot cycle",
   "tex": "\\Delta S = \\dfrac{\\role{hot}{Q_1}}{\\role{hot}{T_1}} - \\dfrac{\\role{cold}{Q_2}}{\\role{cold}{T_2}} = 0",
   "text": "Because Q₁/T₁ = Q₂/T₂ for a reversible engine."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A Carnot engine takes **400 J** at **400 K**. How much heat (J) does it reject at **300 K**?",
   "answer": 300,
   "hint": "Q₂/Q₁ = T₂/T₁.",
   "explain": "\\( Q_2 = 400 \\times 300/400 = 300 \\) J. Then \\( 400/400 - 300/300 = 0 \\).",
   "tolerance": 1,
   "unit": "J"
  }
 ],
 "takeaways": [
  "A reversible cycle returns to the start: \\( \\Delta S = 0 \\) for the engine's working substance."
 ]
