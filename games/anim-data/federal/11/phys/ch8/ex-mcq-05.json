 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Pressure is **constant** at \\( 6\\times10^{5} \\) Pa while the volume grows from \\( 5 \\) to \\( 20 \\) m³. Find the work done by the gas.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Draw it on a P–V graph",
   "text": "Constant pressure is a **horizontal line** (an isobar) from \\( V = 5 \\) to \\( V = 20 \\) m³.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Work is the area",
   "text": "The work done by the gas is the **area under the line**: a rectangle of height \\( P \\) and width \\( \\Delta V \\). So \\( W = P\\,\\Delta V \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Substitute",
   "text": "\\[ W = P\\,(V_2 - V_1) = 6\\times10^{5} \\times (20 - 5) = 6\\times10^{5} \\times 15 = 9\\times10^{6}\\ \\text{J} \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer: (C)",
   "text": "\\( W = 9\\times10^{6} \\) J. The work is **positive** because the gas expands. (B) forgets to subtract 5 m³; (D) is 10 times too large.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Work at constant pressure",
   "tex": "\\role{work}{W} = P\\,\\Delta V = P\\,(V_2 - V_1)",
   "text": "Positive when the gas expands, negative when it is compressed."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas expands from **2 m³** to **10 m³** at a constant **3 × 10⁵ Pa**. What is the work done, in MJ (10⁶ J)?",
   "answer": 2.4,
   "hint": "W = PΔV; ΔV = 8 m³.",
   "explain": "\\( W = 3\\times10^{5} \\times 8 = 2.4\\times10^{6} \\) J = 2.4 MJ.",
