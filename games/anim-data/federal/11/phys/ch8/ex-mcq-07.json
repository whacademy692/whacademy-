 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A **Carnot engine** works between \\( T_1 = 600 \\) K (source) and \\( T_2 = 300 \\) K (sink) and gives \\( W = 800 \\) J every cycle. Find the heat supplied \\( Q_1 \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Carnot efficiency",
   "text": "The efficiency of a Carnot engine depends only on the two temperatures: \\[ \\eta = 1 - \\dfrac{T_2}{T_1} = 1 - \\dfrac{300}{600} = 0.5 \\]",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Efficiency is W / Q₁",
   "text": "Since \\( \\eta = W/Q_1 \\): \\[ Q_1 = \\dfrac{W}{\\eta} = \\dfrac{800}{0.5} = 1600\\ \\text{J} \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Check with energy balance",
   "text": "Heat rejected: \\( Q_2 = Q_1 - W = 1600 - 800 = 800 \\) J. And \\( Q_2/Q_1 = 0.5 = T_2/T_1 \\) ✔.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer: (B) 1600 J/cycle",
   "text": "The engine must take in **1600 J** to do 800 J of work (A would give \\( \\eta = 0.8 \\), which is impossible between these temperatures).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Carnot efficiency",
   "tex": "\\eta = 1 - \\dfrac{\\role{cold}{T_2}}{\\role{hot}{T_1}} = \\dfrac{\\role{work}{W}}{\\role{hot}{Q_1}}",
   "text": "Temperatures in kelvin."
  }
 ],
 "challenges": [
