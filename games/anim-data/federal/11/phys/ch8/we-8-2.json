 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "**2 kg** of argon at \\( 30\\ \\text{°C} \\) fill a cylinder of radius \\( 1 \\) m and height \\( 2 \\) m. Find the pressure. Molar mass of argon: \\( 40\\ \\text{g mol}^{-1} \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Temperature in kelvin",
   "text": "\\( T = 30 + 273 = 303 \\) K.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Number of moles",
   "text": "\\[ n = \\dfrac{2000\\ \\text{g}}{40\\ \\text{g mol}^{-1}} = 50\\ \\text{mol} \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Volume of the cylinder",
   "text": "\\[ V = \\pi r^{2} h = 3.142 \\times 1^{2} \\times 2 = 6.28\\ \\text{m}^{3} \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Use the ideal gas equation",
   "text": "\\( PV = nRT \\), so \\[ P = \\dfrac{nRT}{V} = \\dfrac{50 \\times 8.314 \\times 303}{6.28} \\]",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer",
   "text": "\\( P \\approx 2.0\\times10^{4} \\) Pa (20 044 Pa), about one fifth of atmospheric pressure, because the gas has a large volume.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Ideal gas equation",
   "tex": "\\role{u}{P}\\,\\role{ent}{V} = n\\,R\\,\\role{hot}{T}",
   "text": "R = 8.314 J mol⁻¹ K⁻¹; SI units; T in kelvin."
  }
 ],
