 "steps": [
  {
   "id": "s0",
   "title": "Pressure is held constant",
   "text": "**Isobaric** means **constant pressure**. The piston floats freely under a steady outside pressure, so the gas pressure cannot change. It starts at 300 K and 2 P₀.",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Heat the gas: it expands",
   "text": "Heat flows in and the molecules speed up. To keep the pressure the same the gas **expands**, pushing the piston out. The state moves **right** along a horizontal line (Charles's law).",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 4600
    }
   ]
  },
  {
   "id": "s2",
   "title": "Work is the area",
   "text": "The expanding gas does work \\( W = P\\Delta V \\): the shaded rectangle. Here \\( W = {{W|1}} \\) units.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The heat does two jobs",
   "text": "The gas also got hotter, so \\( \\Delta U = {{dU|1}} \\) rose. The heat has to cover **both** the rise in U and the work: \\( Q = \\Delta U + W = {{dU|1}} + {{W|1}} = {{Q|1}} \\).",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "More heat than an isochoric rise",
   "text": "The same temperature rise at constant volume would need only \\( Q = \\Delta U = {{dU|1}} \\). At constant pressure you must **also pay for the work**, so more heat is needed.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    },
    {
     "tween": {
      "s": 0
     },
     "at": 0,
     "dur": 3200
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Heat Q",
   "value": "{{Q|1}}",
   "role": "hot"
  },
  {
   "label": "ΔU",
   "value": "{{dU|1}}",
   "role": "u"
  },
  {
   "label": "Work W",
   "value": "{{W|1}}",
   "role": "work"
  }
 ],
 "formulas": [
  {
   "title": "Isobaric process",
   "tex": "\\Delta P = 0, \\qquad \\role{work}{W} = P\\Delta V, \\qquad \\role{hot}{Q} = \\role{u}{\\Delta U} + P\\Delta V",
   "text": "The heat covers the rise in internal energy and the work of expansion."
  },
  {
   "title": "Charles's law",
   "tex": "\\dfrac{V_1}{T_1} = \\dfrac{V_2}{T_2}",
   "text": "At constant pressure V is proportional to T (kelvin)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas at constant pressure **1 × 10⁵ Pa** expands by **2 × 10⁻³ m³** while absorbing **500 J** of heat. How much work does it do (J)?",
   "answer": 200,
   "hint": "W = P ΔV.",
   "explain": "\\( W = 10^5 \\times 2\\times10^{-3} = 200 \\) J.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "In the same process the gas absorbs **500 J** and does **200 J** of work. What is the rise in internal energy (J)?",
   "answer": 300,
   "hint": "ΔU = Q − W.",
   "explain": "\\( \\Delta U = 500 - 200 = 300 \\) J.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "In an isobaric expansion the heat added is:",
   "options": [
    {
     "id": "a",
     "label": "equal to ΔU only"
    },
    {
     "id": "b",
     "label": "equal to W only"
    },
    {
     "id": "c",
     "label": "ΔU + P ΔV"
    },
    {
     "id": "d",
     "label": "zero"
    }
   ],
   "answer": "c",
   "hint": "Heat covers the energy rise and the work.",
   "explain": "Isobaric: \\( Q = \\Delta U + P\\Delta V \\)."
  }
 ],
 "takeaways": [
  "**Isobaric = constant pressure**: horizontal line on the P–V graph.",
  "**W = PΔV** is the area under the line.",
  "**Q = ΔU + PΔV**: more heat is needed than for a constant-volume rise."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "Boiling water in an open pan, or a gas under a weighted piston, is isobaric. Constant-pressure steps appear in **engine cycles** such as the steam engine."
  }
 ]
}