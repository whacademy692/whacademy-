 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Define and explain the four processes: isothermal, isobaric, adiabatic and isochoric.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "(a) Isothermal",
   "text": "**Temperature constant.** For an ideal gas \\( \\Delta U = 0 \\), so \\( Q = W \\). The curve is the **isotherm** \\( PV = \\text{constant} \\). It must be **slow** so that heat can flow. Example: ice melting at 0 °C.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(b) Isobaric",
   "text": "**Pressure constant.** \\( Q = \\Delta U + P\\Delta V \\). On the P–V graph it is a **horizontal line**, and the area under it is the work. Example: water boiling in an open container.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(c) Isochoric",
   "text": "**Volume constant.** No volume change, so \\( W = 0 \\) and \\( Q = \\Delta U \\). A **vertical line** on the graph. Example: a pressure cooker.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "(d) Adiabatic",
   "text": "**No heat or mass transfer**, \\( Q = 0 \\), so \\( W = -\\Delta U \\). It is **rapid**; the curve falls more steeply than the isotherm. Example: sound waves in air.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Compare them",
   "text": "All four are special cases of \\( Q = \\Delta U + W \\): isothermal makes \\( \\Delta U = 0 \\), isochoric makes \\( W = 0 \\), adiabatic makes \\( Q = 0 \\), and isobaric keeps \\( P \\) fixed.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Special cases of the first law",
   "tex": "\\role{hot}{Q} = \\role{u}{\\Delta U} + \\role{work}{W}",
   "text": "Isothermal ΔU = 0 · Isochoric W = 0 · Adiabatic Q = 0 · Isobaric W = PΔV."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which process has **W = 0**?",
   "options": [
    {
     "id": "a",
     "label": "Isochoric"
    },
    {
     "id": "b",
     "label": "Isobaric"
    },
    {
     "id": "c",
     "label": "Isothermal"
    },
    {
     "id": "d",
     "label": "Adiabatic"
    }
   ],
   "answer": "a",
   "hint": "Work needs a volume change.",
   "explain": "At constant volume ΔV = 0, so W = PΔV = 0."
  }
 ],
 "takeaways": [
  "Isothermal \\( \\Delta U = 0 \\); isobaric \\( W = P\\Delta V \\); isochoric \\( W = 0 \\); adiabatic \\( Q = 0 \\)."
 ]
}