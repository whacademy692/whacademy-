 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Heat \\( Q \\) is added to a system. Does its internal energy **have to** increase?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Use the first law",
   "text": "\\( Q = \\Delta U + W \\), so \\( \\Delta U = Q - W \\). Where the heat goes depends on how much **work** the system does. Add \\( Q = +4 \\) J each time.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Little work: W < Q",
   "text": "If the system does only 1 J of work, \\( \\Delta U = 4 - 1 = +3 \\) J: the internal energy rises.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "W = Q",
   "text": "If the gas expands and does 4 J of work, \\( \\Delta U = 4 - 4 = 0 \\): all the heat leaves as work. This is an **isothermal** expansion of an ideal gas.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "W > Q",
   "text": "If it does 6 J of work, \\( \\Delta U = 4 - 6 = -2 \\) J: the internal energy actually **falls**.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Answer: No",
   "text": "**No.** Adding heat raises the internal energy only if the work done by the system is smaller than the heat added.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "First law",
   "tex": "\\role{u}{\\Delta U} = \\role{hot}{Q} - \\role{work}{W}",
   "text": "Positive Q does not guarantee positive ΔU."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas absorbs **500 J** of heat and does **700 J** of work. What is ΔU (in J)?",
   "answer": -200,
   "hint": "ΔU = Q − W.",
   "explain": "\\( \\Delta U = 500 - 700 = -200 \\) J (it cools).",
   "tolerance": 1,
   "unit": "J"
  }
 ],
 "takeaways": [
  "\\( \\Delta U = Q - W \\): heat in can still give \\( \\Delta U \\le 0 \\) if the system does enough work."
 ]
