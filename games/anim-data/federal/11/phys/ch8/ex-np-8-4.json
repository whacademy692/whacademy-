 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A Carnot engine works between \\( 600 \\) K and \\( 400 \\) K and absorbs \\( 600 \\) J. Find the work. (The wording says the heat is absorbed \"at 400 K\", which is unclear.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Reading used",
   "text": "The book answer (200 J) needs \\( Q_1 = 600 \\) J taken from the **600 K source**, so we read it that way.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Efficiency",
   "text": "\\[ \\eta = 1 - \\dfrac{400}{600} = \\dfrac{1}{3} \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Work",
   "text": "\\[ W = \\eta\\,Q_1 = \\dfrac{1}{3} \\times 600 = 200\\ \\text{J} \\]",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Work from efficiency",
   "tex": "\\role{work}{W} = \\eta\\,\\role{hot}{Q_1}",
   "text": "η = 1 − T₂/T₁."
  }
 ],
