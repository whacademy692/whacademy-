    }
   ],
   "answer": "c",
   "hint": "Look for gas → liquid or liquid → solid.",
   "explain": "Condensing steam becomes more ordered (gas → liquid), so its entropy falls."
  }
 ],
 "takeaways": [
  "Solid → liquid → gas: disorder and entropy **increase**. The reverse changes **decrease** entropy."
 ]
