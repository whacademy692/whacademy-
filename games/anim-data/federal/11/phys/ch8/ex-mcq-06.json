 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Which of the four changes of state makes the entropy **increase**?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Entropy = disorder",
   "text": "Entropy measures how **disordered** the molecules are. In a solid they sit in fixed places (ordered); in a gas they move freely everywhere (very disordered). Going from solid to gas increases the entropy.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Check each option",
   "text": "Crystallization, freezing and condensation all make the molecules **more ordered** (gas → liquid → solid), so entropy **falls**. Only sublimation goes the other way.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer: (B) sublimation",
   "text": "Sublimation changes a solid straight into a gas: the arrangement becomes far more random, so \\( \\Delta S > 0 \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Entropy change with heat",
   "tex": "\\role{ent}{\\Delta S} = \\dfrac{\\Delta Q}{T}",
   "text": "Heat absorbed (ΔQ > 0) raises the entropy; heat removed lowers it."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which change **lowers** the entropy of the water?",
   "options": [
    {
     "id": "a",
     "label": "Ice melting"
    },
