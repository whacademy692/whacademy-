 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "When two surfaces rub together, does their entropy go up or down?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Friction makes heat",
   "text": "Rubbing surfaces turn organised **motion** (mechanical energy) into **heat**: the surfaces get warmer.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "More random motion",
   "text": "The extra energy makes the molecules of the surfaces **jiggle harder in random directions**: the disorder has increased.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "It cannot be undone",
   "text": "Friction is **irreversible**: the heat never turns back into neat motion by itself. For every irreversible process the entropy **increases**.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "The entropy **increases**: heat \\( Q \\) is added to the surfaces, so \\( \\Delta S = Q/T > 0 \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Entropy and heat",
   "tex": "\\role{ent}{\\Delta S} = \\dfrac{\\role{hot}{Q}}{T} > 0",
   "text": "Heat produced by friction is positive, so entropy rises."
  }
 ],
