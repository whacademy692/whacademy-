 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A thermos of coffee is shaken hard. Answer the four parts.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "(i) Work done on the coffee?",
   "text": "**Yes.** The shaking pushes and stirs the coffee, so work is done **on** it (\\( W < 0 \\) for the coffee as the system).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(ii) Does U increase?",
   "text": "**Yes.** The work done on it is stored as internal energy: \\( \\Delta U = -W > 0 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(iii) Does the temperature rise?",
   "text": "**Yes.** A larger internal energy means faster molecules, so the coffee is slightly **warmer**.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "(iv) Heat from outside?",
   "text": "**No.** The thermos is insulated, so \\( Q = 0 \\) (an **adiabatic** change). The warming comes from the **work** alone.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "First law with Q = 0",
   "tex": "\\role{hot}{Q} = 0 \\;\\Rightarrow\\; \\role{u}{\\Delta U} = -\\role{work}{W}",
   "text": "Work done on the system raises its internal energy."
  }
 ],
