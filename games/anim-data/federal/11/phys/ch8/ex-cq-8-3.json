 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Explain the **first law of thermodynamics**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Heat goes in",
   "text": "Add heat \\( Q \\) to a system (here \\( Q = 5 \\) J). The energy has to **go somewhere**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Part stays as internal energy",
   "text": "Some of the heat **raises the internal energy**: \\( \\Delta U = 3 \\) J (the molecules move faster, so the temperature rises).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Part is work",
   "text": "The rest is used for **work** \\( W \\) done by the system on its surroundings (here 2 J, by expanding). \\[ Q = \\Delta U + W \\] This is the law of **conservation of energy** applied to heat and work.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Sign conventions",
   "text": "\\( Q \\) is positive when heat is **added**, negative when removed. \\( W \\) is positive when the gas **expands** (does work), negative when it is compressed. \\( \\Delta U \\) depends only on the initial and final states.",
   "actions": []
  },
  {
   "id": "s5",
   "title": "Examples",
   "text": "Melting ice, sweating, pumping up a tyre and the **metabolism of the human body** all follow \\( Q = \\Delta U + W \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "First law",
   "tex": "\\role{hot}{Q} = \\role{u}{\\Delta U} + \\role{work}{W}",
   "text": "Heat added = rise in internal energy + work done by the system."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A gas takes in **800 J** of heat and does **300 J** of work. What is its change in internal energy (J)?",
   "answer": 500,
   "hint": "ΔU = Q − W.",
   "explain": "\\( \\Delta U = 800 - 300 = 500 \\) J.",
   "tolerance": 1,
   "unit": "J"
  }
 ],
 "takeaways": [
  "\\( Q = \\Delta U + W \\): conservation of energy for heat, internal energy and work."
 ]
