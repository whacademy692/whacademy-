 "steps": [
  {
   "id": "s0",
   "title": "Volume is held fixed",
   "text": "**Isochoric** means **constant volume**. The piston is locked, so the gas cannot expand or shrink. It starts at 300 K.",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Heat the gas",
   "text": "Heat flows in. The molecules speed up, the temperature climbs from 300 K to {{T|0}} K and the pressure rises: Gay-Lussac's law. On the P–V graph the state moves **straight up**.",
   "actions": [
    {
     "set": {
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 4600
    }
   ]
  },
  {
   "id": "s2",
   "title": "No volume change, no work",
   "text": "Nothing moved, so the area under the vertical line is **zero**: \\( W = P\\Delta V = 0 \\). The W bar stays empty.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "All the heat raises U",
   "text": "The first law \\( Q = \\Delta U + W \\) with \\( W = 0 \\) gives \\( Q = \\Delta U \\): the whole {{Q|1}} units of heat is stored as internal energy.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Cooling is the reverse",
   "text": "Cool the gas instead and it loses heat, U falls and the pressure drops. Drag the slider back to see it.",
   "actions": [
    {
     "set": {
      "s": 1
     },
     "at": 0
    },
    {
     "tween": {
      "s": 0
     },
     "at": 0,
     "dur": 3600
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Heat Q",
   "value": "{{Q|1}}",
   "role": "hot"
  },
  {
   "label": "ΔU",
   "value": "{{dU|1}}",
   "role": "u"
  },
  {
   "label": "Work W",
   "value": "{{W|1}}",
   "role": "work"
  }
 ],
 "formulas": [
  {
   "title": "Isochoric process",
   "tex": "\\Delta V = 0 \\;\\Rightarrow\\; \\role{work}{W} = 0, \\qquad \\role{hot}{Q} = \\role{u}{\\Delta U}",
   "text": "All the heat changes the internal energy."
  },
  {
   "title": "Gay-Lussac's law",
   "tex": "\\dfrac{P_1}{T_1} = \\dfrac{P_2}{T_2}",
   "text": "At constant volume P is proportional to T (kelvin)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A rigid sealed tank is heated and absorbs **400 J** of heat. How much work does the gas do (J)?",
   "answer": 0,
   "hint": "What is ΔV in a rigid tank?",
   "explain": "ΔV = 0, so \\( W = P\\Delta V = 0 \\).",
   "tolerance": 0.1,
   "unit": "J"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "The same tank absorbs **400 J** of heat. By how much does its internal energy rise (J)?",
   "answer": 400,
   "hint": "Q = ΔU + W and W = 0.",
   "explain": "\\( \\Delta U = Q - W = 400 - 0 = 400 \\) J.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "The line of an isochoric process on a P–V graph is:",
   "options": [
    {
     "id": "a",
     "label": "horizontal"
    },
    {
     "id": "b",
     "label": "vertical"
    },
    {
     "id": "c",
     "label": "a hyperbola"
    },
    {
     "id": "d",
     "label": "a diagonal line"
    }
   ],
   "answer": "b",
   "hint": "Volume (the x-axis) does not change.",
   "explain": "V is constant, so the point moves straight up or down: a vertical line."
  }
 ],
 "takeaways": [
  "**Isochoric = constant volume**: vertical line on the P–V graph.",
  "**W = 0** because ΔV = 0.",
  "The first law reduces to **Q = ΔU**: all the heat changes the internal energy."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "Contrast with the **isobaric** process, where the gas also expands and so spends some of the heat on work. In engine cycles (Carnot, Otto) constant-volume steps add or remove heat without any work."
  }
 ]
}