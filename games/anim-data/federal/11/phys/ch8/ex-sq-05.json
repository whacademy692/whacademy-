 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A gas at \\( 0\\ \\text{°C} \\) is heated at **constant pressure** until its volume is **double**. Find the new temperature in °C.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Use Charles's law",
   "text": "At constant pressure \\( V \\propto T \\) (kelvin): \\[ \\dfrac{V_1}{T_1} = \\dfrac{V_2}{T_2} \\] The graph of V against T (kelvin) is a straight line through the origin.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Starting point",
   "text": "\\( T_1 = 0 + 273 = 273 \\) K and \\( V_1 \\) is the starting volume (take it as 1 unit).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Doubling the volume",
   "text": "\\( V_2 = 2V_1 \\), so \\( \\dfrac{V_2}{V_1} = \\dfrac{T_2}{T_1} \\Rightarrow 2 = \\dfrac{T_2}{273} \\) and \\( T_2 = 546 \\) K.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Back to °C",
   "text": "\\( t = 546 - 273 = 273\\ \\text{°C} \\). The volume doubles when the **kelvin** temperature doubles, i.e. at **273 °C**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Charles's law",
   "tex": "\\dfrac{\\role{ent}{V_1}}{\\role{hot}{T_1}} = \\dfrac{\\role{ent}{V_2}}{\\role{hot}{T_2}}",
   "text": "T in kelvin, pressure constant."
  }
 ],
