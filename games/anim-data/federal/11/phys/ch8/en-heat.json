 ],
 "formulas": [
  {
   "title": "Energy balance",
   "tex": "\\role{hot}{Q_h} = \\role{work}{W} + \\role{cold}{Q_c}",
   "text": "Heat in = work out + heat rejected."
  },
  {
   "title": "Efficiency",
   "tex": "\\eta = \\dfrac{\\role{work}{W}}{\\role{hot}{Q_h}} = 1 - \\dfrac{\\role{cold}{Q_c}}{\\role{hot}{Q_h}}",
   "text": "Always less than 1 for a real engine."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "An engine takes **1000 J** from the hot reservoir and rejects **700 J** to the cold one. What work does it do (J)?",
   "answer": 300,
   "hint": "W = Q_h − Q_c.",
   "explain": "\\( W = 1000 - 700 = 300 \\) J.",
   "tolerance": 1,
   "unit": "J"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "What is the efficiency of that engine, as a percentage?",
   "answer": 30,
   "hint": "η = W / Q_h.",
   "explain": "\\( \\eta = 300/1000 = 0.30 = 30\\% \\).",
   "tolerance": 0.5,
   "unit": "%"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which statement about a heat engine is true?",
   "options": [
    {
     "id": "a",
     "label": "It converts all the heat it takes in into work"
    },
    {
     "id": "b",
     "label": "It rejects some heat to a colder reservoir"
    },
    {
     "id": "c",
     "label": "It needs no hot reservoir"
    },
    {
     "id": "d",
     "label": "It creates energy"
    }
   ],
   "answer": "b",
   "hint": "Energy is conserved: where does the unused heat go?",
   "explain": "Every heat engine must reject some heat to a cold reservoir; it cannot convert all the heat into work."
  }
 ],
 "takeaways": [
  "A **heat engine** takes heat \\( Q_h \\) from a hot reservoir, does work \\( W \\), and rejects \\( Q_c \\) to a cold reservoir.",
  "\\( Q_h = W + Q_c \\) and \\( \\eta = W/Q_h \\).",
  "Efficiency is **always below 100%**: some heat must be rejected."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "The engine itself is a gas going round a **cycle** of processes: see the *Four-stroke engine* and the *Carnot cycle*. The fact that Q_c cannot be zero is the **second law**."
  }
 ]
}