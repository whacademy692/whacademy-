 "steps": [
  {
   "id": "s0",
   "title": "One cylinder, four strokes",
   "text": "In a petrol engine each cylinder repeats **four strokes** (two full turns of the crankshaft). On the P–V graph they trace a loop. Only **one** stroke, the power stroke, produces work.",
   "actions": [
    {
     "set": {
      "phi": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Stroke 1: intake",
   "text": "The piston moves out and the **inlet valve opens**. A fresh fuel–air mixture is sucked in at about atmospheric pressure: the flat bottom line of the graph.",
   "actions": [
    {
     "set": {
      "phi": 0
     },
     "at": 0
    },
    {
     "tween": {
      "phi": 178
     },
     "at": 0,
     "dur": 4000
    }
   ]
  },
  {
   "id": "s2",
   "title": "Stroke 2: compression",
   "text": "Both valves are shut. The piston moves in and squeezes the mixture. Work is done **on** the gas, so it gets **hotter and its pressure climbs**: this is an adiabatic compression.",
   "actions": [
    {
     "set": {
      "phi": 180
     },
     "at": 0
    },
    {
     "tween": {
      "phi": 358
     },
     "at": 0,
     "dur": 4000
    }
   ]
  },
  {
   "id": "s3",
   "title": "Stroke 3: power",
   "text": "At the top the **spark** ignites the mixture. The temperature and pressure shoot up (vertical line), then the hot gas pushes the piston out: the engine does **work**. The gas cools as it expands.",
   "actions": [
    {
     "set": {
      "phi": 360
     },
     "at": 0
    },
    {
     "tween": {
      "phi": 538
     },
     "at": 0,
     "dur": 4800
    }
   ]
  },
  {
   "id": "s4",
   "title": "Stroke 4: exhaust",
   "text": "The **exhaust valve opens**. The pressure drops and the piston pushes the burnt gas out, **rejecting heat** to the surroundings. The cycle then starts again.",
   "actions": [
    {
     "set": {
      "phi": 540
     },
     "at": 0
    },
    {
     "tween": {
      "phi": 718
     },
     "at": 0,
     "dur": 4000
    }
   ]
  },
  {
   "id": "s5",
   "title": "The loop is the work",
   "text": "The **area enclosed** by the loop is the net work per cycle. Run the engine and watch the loop trace itself. Press play on **Crank angle**.",
   "actions": [
    {
     "set": {
      "phi": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Stroke",
   "value": "{{stroke|0}} of 4"
  },
  {
   "label": "Crank angle",
   "value": "{{phi|0}}°"
  },
  {
   "label": "Gas temp (K)",
   "value": "{{T|0}}",
   "role": "hot"
  }
 ],
 "formulas": [
  {
   "title": "Net work in a cycle",
   "tex": "\\role{work}{W_{\\text{net}}} = \\oint P\\,dV = \\text{area enclosed by the loop}",
   "text": "Work out in the power stroke minus the work put in during compression."
  },
  {
   "title": "Energy balance per cycle",
   "tex": "\\role{hot}{Q_h} = \\role{work}{W_{\\text{net}}} + \\role{cold}{Q_c}",
   "text": "Fuel heat in = useful work + heat lost in the exhaust."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "In which stroke does the engine produce **useful work**?",
   "options": [
    {
     "id": "a",
     "label": "Intake"
    },
    {
     "id": "b",
     "label": "Compression"
    },
    {
     "id": "c",
     "label": "Power"
    },
    {
     "id": "d",
     "label": "Exhaust"
    }
   ],
   "answer": "c",
   "hint": "The hot gas pushes the piston.",
   "explain": "Only the power stroke does work on the piston; the other three strokes use energy."
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Why does the gas get hotter during the **compression** stroke?",
   "options": [
    {
     "id": "a",
     "label": "Work is done on it by the piston"
    },
    {
     "id": "b",
     "label": "The spark ignites it"
    },
    {
     "id": "c",
     "label": "Cold air enters"
    },
    {
     "id": "d",
     "label": "The walls are hot"
    }
   ],
   "answer": "a",
   "hint": "Think of the bicycle pump.",
   "explain": "Fast compression is nearly adiabatic: the work done on the gas becomes internal energy."
  },
  {
   "id": "c3",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many full turns of the crankshaft does one four-stroke cycle need?",
   "answer": 2,
   "hint": "Each stroke is half a turn.",
   "explain": "Four strokes × half a turn each = **2 turns** (720°).",
   "tolerance": 0.1,
   "unit": "turns"
  }
 ],
 "takeaways": [
  "The four strokes are **intake, compression, power, exhaust**.",
  "On the P–V graph the strokes form a **loop**; its **area is the net work** per cycle.",
  "Only the **power stroke** does work; some heat must always be **rejected in the exhaust**."
 ],
 "notes": [
  {
   "title": "Connects to",
   "text": "The engine has an efficiency \\( \\eta = W/Q_h \\) well below 100%. The best possible for given temperatures is the **Carnot engine**, which uses two isotherms and two adiabats."
  }
 ]
}