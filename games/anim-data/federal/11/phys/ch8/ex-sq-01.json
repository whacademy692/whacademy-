 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "After a long drive a car tyre feels warm and its pressure reading is **higher**. Why?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Friction heats the tyre",
   "text": "As the tyre rolls, it flexes and rubs on the road. **Friction** turns some of the car's energy into heat, so the tyre and the air inside get **hotter**.",
   "actions": [
    {
     "set": {
      "T": 300
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "The air molecules speed up",
   "text": "Hotter air means its molecules move **faster** (higher average kinetic energy).",
   "actions": [
    {
     "set": {
      "T": 300
     },
     "at": 0
    },
    {
     "tween": {
      "T": 345
     },
     "at": 0,
     "dur": 3500
    }
   ]
  },
  {
   "id": "s3",
   "title": "Faster molecules push harder",
   "text": "Faster molecules hit the tyre wall **harder** and **more often**. The tyre is nearly rigid, so the volume hardly changes and the pressure **rises**.",
   "actions": [
    {
     "set": {
      "T": 345
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Gay-Lussac's law",
   "text": "At constant volume \\( P \\propto T \\) (kelvin). So the pressure of the air rises in proportion to its temperature.",
   "actions": [
    {
     "set": {
      "T": 345
     },
     "at": 0
    }
   ]
  }
 ],
