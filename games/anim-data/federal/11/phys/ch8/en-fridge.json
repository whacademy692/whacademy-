 "steps": [
  {
   "id": "s0",
   "title": "A heat engine run backwards",
   "text": "In an engine, heat falls from hot to cold and some becomes work. Run it **backwards**: put work **in** and heat is pumped from the **cold** space to the **hot** surroundings. That is a **refrigerator** (or an air-conditioner).",
   "actions": [
    {
     "set": {
      "Qc": 100,
      "W": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Heat removed from the cold space",
   "text": "The refrigerator takes \\( Q_c = {{Qc|0}} \\) J out of the cold space: this is the heat it is trying to remove.",
   "actions": [
    {
     "set": {
      "Qc": 100,
      "W": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Work is supplied",
   "text": "Heat will not climb uphill by itself (second law), so the compressor must supply work \\( W = {{W|0}} \\) J from the mains.",
   "actions": [
    {
     "set": {
      "Qc": 100,
      "W": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Everything is dumped in the room",
   "text": "The heat removed **plus** the work supplied leaves as heat to the room: \\( Q_h = Q_c + W = {{Qh|0}} \\) J. This is why the back of a fridge is warm.",
   "actions": [
    {
     "set": {
      "Qc": 100,
      "W": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Coefficient of performance",
   "text": "A good refrigerator removes a lot of heat for little work. The **coefficient of performance** is \\( CP = Q_c / W = {{cp|2}} \\). Less work for the same heat gives a bigger CP.",
   "actions": [
    {
     "set": {
      "Qc": 100,
      "W": 40
     },
     "at": 0
    },
    {
     "tween": {
      "W": 20
     },
     "at": 0,
     "dur": 3600
    }
   ]
  }
 ],
