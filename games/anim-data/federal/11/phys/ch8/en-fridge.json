 "formulas": [
  {
   "title": "Energy balance",
   "tex": "\\role{hot}{Q_h} = \\role{cold}{Q_c} + \\role{work}{W}",
   "text": "Heat dumped = heat removed + work supplied."
  },
  {
   "title": "Coefficient of performance",
   "tex": "CP = \\dfrac{\\role{cold}{Q_c}}{\\role{work}{W}}",
   "text": "For a Carnot refrigerator \\( CP = \\dfrac{T_c}{T_h - T_c} \\)."
  }
 ],
