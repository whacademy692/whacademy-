 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "State and explain the **gas laws** (for a fixed amount of gas, with temperature in **kelvin**).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Boyle's law (T constant)",
   "text": "When the temperature is constant the volume is **inversely proportional** to the pressure: \\( V \\propto 1/P \\), i.e. \\( PV = \\text{constant} \\). Squeeze the gas and its pressure rises along a hyperbola.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Charles's law (P constant)",
   "text": "At constant pressure the volume is **directly proportional** to the kelvin temperature: \\( V \\propto T \\), i.e. \\( V/T = \\text{constant} \\). The V–T line, extended back, reaches zero volume at **−273 °C**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Gay-Lussac's law (V constant)",
   "text": "At constant volume the pressure is directly proportional to the kelvin temperature: \\( P \\propto T \\), i.e. \\( P/T = \\text{constant} \\). (Also called Amontons's law.)",
   "actions": []
  },
  {
   "id": "s4",
   "title": "One equation for all",
   "text": "Together the three laws are contained in the **ideal gas equation** \\( PV = nRT \\): fix any one of \\( T,\\ P,\\ V \\) and the other two follow the relevant law.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "The gas laws",
   "tex": "\\role{cold}{PV = \\text{const}}\\ (T) \\qquad \\role{hot}{\\dfrac{V}{T} = \\text{const}}\\ (P) \\qquad \\role{ok}{\\dfrac{P}{T} = \\text{const}}\\ (V)",
   "text": "Fixed amount of gas; T in kelvin."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "At constant volume the pressure of a gas is doubled. The kelvin temperature:",
   "options": [
    {
     "id": "a",
     "label": "doubles"
    },
    {
     "id": "b",
     "label": "halves"
    },
    {
     "id": "c",
     "label": "stays the same"
    },
    {
     "id": "d",
     "label": "quadruples"
    }
   ],
   "answer": "a",
   "hint": "P ∝ T at constant V.",
   "explain": "Gay-Lussac: P ∝ T (kelvin) at constant volume, so doubling P doubles T."
  }
 ],
 "takeaways": [
  "Boyle: \\( PV \\) const (T fixed). Charles: \\( V/T \\) const (P fixed). Gay-Lussac: \\( P/T \\) const (V fixed)."
 ]
