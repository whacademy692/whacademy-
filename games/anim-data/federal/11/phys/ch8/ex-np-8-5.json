 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "A **220 W** heater warms **136 g** of water from \\( 23.5\\ \\text{°C} \\) to boiling. Ignore heat losses. How long does it take?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Data we need",
   "text": "The question does not give the **specific heat** of water or its **boiling point**, so we use the standard values \\( c = 4186\\ \\text{J kg}^{-1}\\text{K}^{-1} \\) and \\( 100\\ \\text{°C} \\). Also \\( m = 0.136 \\) kg, \\( \\Delta T = 100 - 23.5 = 76.5 \\) K.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Heat needed",
   "text": "\\[ Q = mc\\Delta T = 0.136 \\times 4186 \\times 76.5 = 4.36\\times10^{4}\\ \\text{J} \\]",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Time from the power",
   "text": "Power is energy per second, \\( Q = P\\,t \\): \\[ t = \\dfrac{Q}{P} = \\dfrac{4.36\\times10^{4}}{220} \\]",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( t = 198 \\) s (about 3.3 minutes). The straight line shows the temperature rising steadily because the heater supplies energy at a constant rate.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Heating water",
   "tex": "\\role{hot}{Q} = m\\,c\\,\\Delta T, \\qquad \\role{hot}{Q} = P\\,t",
   "text": "Energy needed = power × time."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "The same heater warms **200 g** of water from **20 °C** to **100 °C**. How long does it take (s)?",
   "answer": 304,
