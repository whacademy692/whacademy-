   "role": "ang"
  }
 ],
 "formulas": [
  {
   "title": "Same two vectors, two products",
   "tex": "\\vec A\\cdot\\vec B = AB\\cos\\theta, \\qquad |\\vec A\\times\\vec B| = AB\\sin\\theta",
   "text": "Dot: component along. Cross: component across."
  },
  {
   "title": "Dividing them",
   "tex": "\\dfrac{|\\vec A\\times\\vec B|}{\\vec A\\cdot\\vec B} = \\tan\\theta",
   "text": "Useful when both products are given."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "The magnitude of the cross product of two vectors is √3 times their dot product. Find the angle (°).",
   "answer": 60,
   "hint": "tan θ = √3.",
   "explain": "\\( \\tan\\theta = \\sqrt3 \\Rightarrow \\theta = 60^\\circ \\).",
   "tolerance": 0.5,
   "unit": "°"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "The dot and cross products have magnitudes 6√3 and 6. Find the angle (°).",
   "answer": 30,
   "hint": "tan θ = 6/(6√3).",
   "explain": "\\( \\tan\\theta = 1/\\sqrt3 \\Rightarrow \\theta = 30^\\circ \\).",
   "tolerance": 0.5,
   "unit": "°"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "For which of these angles is |A · B| = |A × B|?",
   "options": [
    {
     "id": "a",
     "label": "30°"
    },
    {
     "id": "b",
     "label": "45°"
    },
    {
     "id": "c",
     "label": "60°"
    },
    {
     "id": "d",
     "label": "90°"
    }
   ],
   "answer": "b",
   "hint": "You need tan θ = 1.",
   "explain": "\\( \\tan45^\\circ = 1 \\): **45°**."
  }
 ],
 "takeaways": [
  "**Dot** ∝ **cos θ**, **cross** ∝ **sin θ**.",
  "Parallel: dot maximum, cross zero. Perpendicular: dot zero, cross maximum.",
  "**tan θ = |A × B| / A · B**; |A · B| = |A × B| at 45° (and 135°)."
 ]
}