 "steps": [
  {
   "id": "s0",
   "title": "A slanted pull",
   "text": "A rope pulls a block with force **F** at angle θ above the horizontal while the block moves a distance d along the ground.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "f": 10,
      "th": 60,
      "d": 5
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Split the force",
   "text": "Only the horizontal component \\( F\\cos\\theta = {{fx|2}} \\) N pushes the block along its path. The vertical part \\( F\\sin\\theta = {{fy|2}} \\) N is perpendicular to the motion and does **no work**.",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Work = F · d",
   "text": "Work is the dot product of force and displacement: \\( W = \\vec F\\cdot\\vec d = F d\\cos\\theta = {{W|1}} \\) J. It is a **scalar**.",
   "actions": [
    {
     "set": {
      "lv": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Pull flat, then straight up",
   "text": "At θ = 0° the whole force works (W = Fd). Raise the rope to 90° and W falls to zero: a force perpendicular to the motion does no work.",
   "actions": [
    {
     "set": {
      "lv": 2,
      "th": 0
     },
     "at": 0
    },
    {
     "tween": {
      "th": 90
     },
     "at": 0,
     "dur": 5000
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Work W",
