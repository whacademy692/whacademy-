 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "We need the angle at which the **magnitudes** of the dot and cross product are equal.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Write both",
   "text": "\\( |\\vec A\\cdot\\vec B| = AB|\\cos\\theta| \\) and \\( |\\vec A\\times\\vec B| = AB\\sin\\theta \\). Divide out AB and compare cos θ with sin θ.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Dashed curve = |cos θ|",
   "text": "Taking the magnitude folds the negative part of cos θ upwards (dashed).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Equal at 45°",
   "text": "\\( |\\cos\\theta| = \\sin\\theta \\Rightarrow \\tan\\theta = 1 \\Rightarrow \\theta = 45^\\circ \\). Answer **B**.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "135° also works (flag F5)",
   "text": "For 135° the dot product is negative but its magnitude equals the cross product, so 135° also satisfies the equation. It is not offered, so **B (45°)** is the only choice.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Equal magnitudes",
   "tex": "|\\cos\\theta| = |\\sin\\theta| \\;\\Rightarrow\\; \\tan\\theta = \\pm1",
   "text": "θ = 45° or 135°."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "If |A · B| = |A × B| and the angle is acute, what is the angle (°)?",
   "answer": 45,
   "hint": "tan θ = 1.",
   "explain": "\\( \\theta = 45^\\circ \\).",
   "tolerance": 0.5,
   "unit": "°"
  }
 ],
 "takeaways": [
  "**|A · B| = |A × B|** when **tan θ = ±1**: 45° (and 135°).",
  "Only 45° appears among the options (flag F5)."
 ]
}