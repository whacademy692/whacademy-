 "steps": [
  {
   "id": "s0",
   "title": "Set up the determinant",
   "text": "The cross product in components is the determinant \\( \\begin{vmatrix} \\hat i & \\hat j & \\hat k \\\\ 1 & 6 & 2 \\\\ 7 & 1 & 5 \\end{vmatrix} \\). Its **magnitude** will be the area of the parallelogram.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "î coefficient",
   "text": "Cover the î column: \\( 6\\times5 - 2\\times1 = 28 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "ĵ coefficient",
   "text": "Cover the ĵ column and **subtract**: \\( -(1\\times5 - 2\\times7) = -(5-14) = +9 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "k̂ coefficient",
   "text": "Cover the k̂ column: \\( 1\\times1 - 6\\times7 = -41 \\). So \\( \\vec A\\times\\vec B = 28\\hat i + 9\\hat j - 41\\hat k \\) m². (This is where the book stops, flag F3.)",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Area from the magnitude",
   "text": "The question asks for an **area**, so take the magnitude: \\( \\sqrt{28^2 + 9^2 + 41^2} = \\sqrt{784 + 81 + 1681} = \\sqrt{2546} = 50.5 \\) m².",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Cross product determinant",
   "tex": "\\vec A\\times\\vec B = (A_yB_z - A_zB_y)\\hat i + (A_zB_x - A_xB_z)\\hat j + (A_xB_y - A_yB_x)\\hat k",
   "text": "The ĵ term is the one with the minus sign when you expand along the top row."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Find |A × B| for A = î + 2ĵ + 3k̂ and B = 4î + 5ĵ + 6k̂ (2 decimals).",
   "answer": 7.35,
   "hint": "A × B = −3î + 6ĵ − 3k̂.",
   "explain": "\\( \\sqrt{9 + 36 + 9} = \\sqrt{54} = 7.35 \\).",
   "tolerance": 0.02
  }
 ],
 "takeaways": [
  "**A × B** = determinant; **|A × B|** = area of the parallelogram.",
  "Watch the minus sign on the ĵ term.",
  "Flag F3: the book stops at the vector; the area 50.5 m² is added by W.H."
 ]
