 "steps": [
  {
   "id": "s0",
   "title": "The parallelogram",
   "text": "A and B are adjacent sides of a parallelogram. We want its area.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "s": 0,
      "ma": 5,
      "mb": 4,
      "th": 60
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Base and height",
   "text": "Take A as the base. The perpendicular height is \\( h = B\\sin\\theta = {{by|2}} \\), not B itself.",
   "actions": [
    {
     "set": {
      "lv": 1,
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Cut the triangle",
   "text": "Cut off the slanted triangle at the left end (shaded).",
   "actions": [
    {
     "set": {
      "lv": 2,
      "s": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Slide it to the other end",
   "text": "Slide the triangle to the right end. The two slanted edges fit together exactly and the figure is now a **rectangle** of the same area.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "s": 0
     },
     "at": 0
    },
    {
     "tween": {
      "s": 1
     },
     "at": 0,
     "dur": 3200
    }
   ]
  },
  {
   "id": "s4",
   "title": "Area = |A × B|",
   "text": "Rectangle: base × height = \\( A \\times B\\sin\\theta = {{ar|1}} \\). That is exactly the magnitude of the cross product, so \\( \\text{Area} = |\\vec A\\times\\vec B| \\).",
   "actions": [
    {
     "set": {
      "lv": 4,
      "s": 1
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Area",
   "value": "{{ar|1}}",
   "role": "crs"
  },
  {
   "label": "h = B sin θ",
   "value": "{{by|2}}",
   "role": "crs"
  }
 ],
 "formulas": [
  {
   "title": "Parallelogram area",
   "tex": "\\text{Area} = \\text{base}\\times\\text{height} = A\\,(B\\sin\\theta) = |\\vec A\\times\\vec B|",
   "text": "n̂ then gives the direction of the area, perpendicular to the plane."
  }
 ],
