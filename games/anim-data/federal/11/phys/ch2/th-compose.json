   "hint": "Pythagoras.",
   "explain": "\\( F = \\sqrt{6^2 + 8^2} = 10 \\) N.",
   "tolerance": 0.05,
   "unit": "N"
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "Find the angle (°) of the vector with components Aₓ = 1 and Aᵧ = 1 from the +x axis.",
   "answer": 45,
   "hint": "tan θ = 1.",
   "explain": "\\( \\theta = \\tan^{-1}(1) = 45^\\circ \\).",
   "tolerance": 0.5,
   "unit": "°"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A has Aₓ = −3 and Aᵧ = 3. The calculator gives tan⁻¹(3/−3) = −45°. What is the angle from the +x axis?",
   "options": [
    {
     "id": "a",
     "label": "45°"
    },
    {
     "id": "b",
     "label": "135°"
    },
    {
     "id": "c",
     "label": "225°"
    },
    {
     "id": "d",
     "label": "315°"
    }
   ],
   "answer": "b",
   "hint": "Aₓ is negative, Aᵧ positive: second quadrant.",
   "explain": "Second quadrant: −45° + 180° = **135°**."
  }
 ],
 "takeaways": [
  "**A = √(Aₓ² + Aᵧ²)** and **θ = tan⁻¹(Aᵧ/Aₓ)**.",
  "Resolving and rebuilding are inverse jobs: they undo each other.",
  "Check the quadrant from the signs of Aₓ and Aᵧ."
 ]
}