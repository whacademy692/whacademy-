 "steps": [
  {
   "id": "s0",
   "title": "Start with the two components",
   "text": "The vector **A** has components \\(A_x = {{ax|0}}\\) and \\(A_y = {{ay|0}}\\). Together they give the point (Aₓ, Aᵧ) and the vector from the origin to it.",
   "actions": [
    {
     "set": {
      "ax": 4,
      "ay": 3,
      "lv": 0
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Length by Pythagoras",
   "text": "The components and A form a right triangle with A as the hypotenuse: \\( A = \\sqrt{A_x^2 + A_y^2} = {{m|2}} \\). (4, 3 gives the famous 3-4-5 triangle.)",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Angle by tan⁻¹",
   "text": "\\( \\tan\\theta = A_y / A_x \\) so \\( \\theta = \\tan^{-1}(A_y/A_x) = {{thp|1}}^\\circ \\).",
   "actions": [
    {
     "set": {
      "lv": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Check the quadrant",
   "text": "Both components are positive, so A is in the **first quadrant** and the calculator angle is already the angle from +x: θ = {{thf|1}}°.",
   "actions": [
    {
     "set": {
      "lv": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Make Aₓ negative",
   "text": "Now Aₓ = {{ax|0}}, Aᵧ = {{ay|0}}: the vector points into the **second quadrant**. The calculator still shows a negative angle, so we add 180° to get {{thf|1}}° from +x.",
   "actions": [
    {
     "set": {
      "lv": 3
     },
     "at": 0
    },
    {
     "tween": {
      "ax": -4
     },
     "at": 0,
     "dur": 2500
    }
   ]
  },
  {
   "id": "s5",
   "title": "Both negative",
   "text": "With Aₓ and Aᵧ both negative the vector is in the **third quadrant**: again add 180° to the calculator angle.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "ax": -4
     },
     "at": 0
    },
    {
     "tween": {
      "ay": -3
     },
     "at": 0,
     "dur": 2500
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "A",
   "value": "{{m|2}}",
   "role": "va"
  },
  {
   "label": "θ from +x",
   "value": "{{thf|1}}°",
   "role": "ang"
  },
  {
   "label": "Quadrant",
   "value": "{{q}}",
   "role": "wall"
  }
 ],
 "formulas": [
  {
   "title": "Magnitude and direction",
   "tex": "A = \\sqrt{A_x^2 + A_y^2}, \\qquad \\theta = \\tan^{-1}\\!\\left(\\dfrac{A_y}{A_x}\\right)",
   "text": "Check the quadrant: if Aₓ < 0 add 180° to the calculator value."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "The components of a force are **6 N** and **8 N**. Find its magnitude (N).",
