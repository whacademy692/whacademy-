 "steps": [
  {
   "id": "s0",
   "title": "Two vectors, one angle",
   "text": "Draw **A** and **B** from the same point; θ is the angle between them (0° to 180°).",
   "actions": [
    {
     "set": {
      "lv": 0,
      "ma": 5,
      "mb": 4,
      "th": 55
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Project B on A",
   "text": "Drop a perpendicular from the head of **B** onto the line of **A**. The projection (the component of B along A) is \\( B\\cos\\theta = {{bx|2}} \\).",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Multiply by A",
   "text": "The **dot product** is the magnitude of A times the component of B along A: \\( \\vec A \\cdot \\vec B = A\\,(B\\cos\\theta) = {{dv|1}} \\). It is a **scalar**.",
   "actions": [
    {
     "set": {
      "lv": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Sweep θ from 0° to 180°",
   "text": "Watch the sign: positive for acute angles, zero at 90°, negative for obtuse angles.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "th": 0
     },
     "at": 0
    },
    {
     "tween": {
      "th": 180
     },
     "at": 0,
     "dur": 6000
    }
   ]
  },
  {
   "id": "s4",
   "title": "Special cases",
   "text": "Parallel (θ = 0°): A · B = AB. Anti-parallel (θ = 180°): A · B = −AB. Perpendicular (θ = 90°): A · B = 0. Order does not matter: A · B = B · A.",
   "actions": [
    {
     "set": {
      "lv": 4,
      "th": 90
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "A · B",
   "value": "{{dv|1}}",
   "role": "dot"
  },
  {
   "label": "B cos θ",
   "value": "{{bx|2}}",
   "role": "dot"
  },
  {
   "label": "θ",
   "value": "{{th|0}}°",
   "role": "ang"
  }
 ],
 "formulas": [
  {
   "title": "Scalar (dot) product",
   "tex": "\\vec A\\cdot\\vec B = \\role{va}{A}\\,\\role{vb}{B}\\,\\role{ang}{\\cos\\theta} = \\role{va}{A}\\,(\\role{dot}{B\\cos\\theta})",
   "text": "A scalar; commutative: A · B = B · A."
  },
  {
   "title": "Angle from the dot product",
   "tex": "\\cos\\theta = \\dfrac{\\vec A\\cdot\\vec B}{AB}",
   "text": "This is why the dot product is used to find the angle between two vectors."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A = 4, B = 5 and θ = 60°. Find A · B.",
   "answer": 10,
   "hint": "A B cos θ.",
   "explain": "\\( 4 \\times 5 \\times \\cos60^\\circ = 10 \\).",
   "tolerance": 0.05
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "Two non-zero vectors have A · B = 0. What is the angle (°) between them?",
   "answer": 90,
   "hint": "cos θ = 0.",
   "explain": "\\( \\cos\\theta = 0 \\Rightarrow \\theta = 90^\\circ \\): perpendicular.",
   "tolerance": 0.5,
   "unit": "°"
  },
  {
   "id": "c3",
   "type": "number",
   "title": "Now you try",
   "prompt": "A = 3 and B = 7 point in exactly opposite directions. Find A · B.",
   "answer": -21,
   "hint": "θ = 180°, cos 180° = −1.",
   "explain": "\\( 3 \\times 7 \\times \\cos180^\\circ = -21 \\).",
   "tolerance": 0.05
  },
  {
   "id": "c4",
   "type": "number",
   "title": "Now you try",
   "prompt": "B = 6 makes 30° with A. Find the component of B along A.",
   "answer": 5.196,
   "hint": "B cos θ.",
   "explain": "\\( 6\\cos30^\\circ = 5.196 \\).",
   "tolerance": 0.02
  }
 ],
 "takeaways": [
  "**A · B = AB cos θ** = (A cos θ) B = A (B cos θ): a **scalar**.",
  "Maximum **AB** at 0°, **0** at 90°, **−AB** at 180°.",
  "Commutative: **A · B = B · A**. Used for work, power and flux."
 ]
}