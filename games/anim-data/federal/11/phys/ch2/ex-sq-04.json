 "steps": [
  {
   "id": "s0",
   "title": "Brackets first",
   "text": "Evaluate the product inside the bracket first in both parts: \\( \\hat j\\times\\hat k \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "ĵ × k̂ = î",
   "text": "Cyclic order y → z → x: \\( \\hat j\\times\\hat k = +\\hat i \\) (the thumb points along î).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(a) Dot with î",
   "text": "\\( \\hat i\\cdot(\\hat j\\times\\hat k) = \\hat i\\cdot\\hat i = 1 \\). The result is a **scalar**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(b) Cross with ĵ",
   "text": "Now \\( \\hat j\\times(\\hat j\\times\\hat k) = \\hat j\\times\\hat i \\). The order is y then x, **against** the cycle.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "(b) Result",
   "text": "\\( \\hat j\\times\\hat i = -\\hat k \\). The result is a **vector** (along −z).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Cross products of unit vectors",
   "tex": "\\hat i\\times\\hat j=\\hat k,\\; \\hat j\\times\\hat k=\\hat i,\\; \\hat k\\times\\hat i=\\hat j",
   "text": "Reverse the order for a minus sign."
  }
 ],
