 "steps": [
  {
   "id": "s0",
   "title": "Read the data",
   "text": "F = 200 N at 30° to the x-axis. Find the horizontal and vertical components.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Horizontal",
   "text": "\\( F_x = F\\cos\\theta = 200\\cos30^\\circ = 200\\times0.866 = 173.2 \\) N.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Vertical",
   "text": "\\( F_y = F\\sin\\theta = 200\\sin30^\\circ = 200\\times0.5 = 100 \\) N.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Check",
   "text": "\\( \\sqrt{F_x^2 + F_y^2} = \\sqrt{173.2^2 + 100^2} = \\sqrt{40000} = 200 \\) N ✓.",
   "actions": []
  }
 ],
 "formulas": [
