   "title": "Divide by cos θ",
   "text": "\\( \\tan\\theta = \\sqrt3 \\). A right triangle with sides 1, √3 and 2 has exactly this tangent.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Angle",
   "text": "\\( \\theta = \\tan^{-1}\\sqrt3 = 60^\\circ \\). Matches the book key.",
   "actions": []
  }
 ],
