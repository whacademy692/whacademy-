 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "What does \\( \\vec A\\times\\vec B \\) mean geometrically?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Draw the figure",
   "text": "Take **A** along the x-axis and **B** at angle θ. Complete the parallelogram with dotted lines (Fig 2.7). The vectors are its **adjacent sides**.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Magnitude = area",
   "text": "Base = A and height = \\( B\\sin\\theta \\), so **Area** \\( = AB\\sin\\theta = |\\vec A\\times\\vec B| \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Direction = normal",
   "text": "The unit vector \\( \\hat n \\) gives the **direction of the area**: perpendicular to the plane, fixed by the right-hand rule (here out of the page).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Example 2.3",
   "text": "\\( \\vec A = \\hat i + 6\\hat j + 2\\hat k \\) m and \\( \\vec B = 7\\hat i + \\hat j + 5\\hat k \\) m give \\( \\vec A\\times\\vec B = 28\\hat i + 9\\hat j - 41\\hat k \\) m², so the area is \\( \\sqrt{2546} = 50.5 \\) m².",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Area of a parallelogram",
   "tex": "\\text{Area} = |\\vec A\\times\\vec B| = AB\\sin\\theta",
   "text": "For a rectangle (θ = 90°) the area is simply AB."
  }
 ],
 "challenges": [
