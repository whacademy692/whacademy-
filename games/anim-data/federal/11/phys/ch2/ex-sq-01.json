 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "The cross product \\( \\vec A\\times\\vec B \\) is the **zero vector**. What does that say about A and B?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Write the magnitude",
   "text": "\\( |\\vec A\\times\\vec B| = AB\\sin\\theta = 0 \\). If neither vector is zero, then \\( \\sin\\theta = 0 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "θ = 0°",
   "text": "\\( \\sin0^\\circ = 0 \\): the vectors point the same way (**parallel**). The parallelogram they span has no height.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "θ = 180°",
   "text": "\\( \\sin180^\\circ = 0 \\): the vectors point in opposite directions (**anti-parallel**). Again no area.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "A special case",
   "text": "Also possible: A or B is itself a null vector (magnitude 0). Then the product is zero whatever the angle.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Zero cross product",
   "tex": "\\vec A\\times\\vec B = \\vec 0 \\;\\Rightarrow\\; \\theta = 0^\\circ \\text{ or } 180^\\circ",
   "text": "Parallel or anti-parallel (or a null vector)."
  }
 ],
