 "formulas": [
  {
   "title": "Vector (cross) product",
   "tex": "\\vec A\\times\\vec B = \\role{va}{A}\\,\\role{vb}{B}\\,\\sin\\role{ang}{\\theta}\\;\\hat n",
   "text": "n̂ is perpendicular to the plane of A and B (right-hand rule)."
  }
 ],
