 "steps": [
  {
   "id": "s0",
   "title": "Two vectors, one angle",
   "text": "Draw **A** and **B** tail to tail with angle θ between them.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "ma": 4,
      "mb": 3,
      "th": 55
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Complete the parallelogram",
   "text": "Use A and B as adjacent sides and complete the parallelogram.",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Height of the parallelogram",
   "text": "Taking A as the base, the height is \\( h = B\\sin\\theta = {{mb*abs(sin(th))|2}} \\).",
   "actions": [
    {
     "set": {
      "lv": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Magnitude = area",
   "text": "Area = base × height, so \\( |\\vec A\\times\\vec B| = AB\\sin\\theta = {{abs(cv)|1}} \\). When θ = 0° or 180° the parallelogram collapses and A × B = 0.",
   "actions": [
    {
     "set": {
      "lv": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Direction: right-hand rule",
   "text": "Curl the fingers of your **right hand** from A towards B through the smaller angle. Your thumb points along \\( \\hat n \\), perpendicular to the page: here **out of the page** (⊙).",
   "actions": [
    {
     "set": {
      "lv": 4,
      "th": 55
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s5",
   "title": "Swap the side of B",
   "text": "Put B on the other side of A (θ = −55°). Now the fingers curl clockwise and the thumb points **into the page** (⊗). Same size, opposite direction.",
   "actions": [
    {
     "set": {
      "lv": 4
     },
     "at": 0
    },
    {
     "tween": {
      "th": -55
     },
     "at": 0,
     "dur": 3500
    }
   ]
  }
 ],
