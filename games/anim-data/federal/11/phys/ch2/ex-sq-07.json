 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Name two physical quantities defined by a scalar product and two by a vector product.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Scalar product",
   "text": "**Work** \\( W = \\vec F\\cdot\\vec d = Fd\\cos\\theta \\) and **power** \\( P = \\vec F\\cdot\\vec v = Fv\\cos\\theta \\). Both are scalars.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Vector product",
   "text": "**Torque** \\( \\vec\\tau = \\vec r\\times\\vec F \\) and **angular momentum** \\( \\vec L = \\vec r\\times\\vec p \\). Both are vectors (axis of rotation).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Bonus",
   "text": "Electric flux \\( \\Phi = \\vec E\\cdot\\vec A = EA\\cos\\theta \\) is another scalar product (as in the book’s list).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Examples",
   "tex": "W=\\vec F\\cdot\\vec d,\\; P=\\vec F\\cdot\\vec v,\\; \\vec\\tau=\\vec r\\times\\vec F,\\; \\vec L=\\vec r\\times\\vec p",
   "text": "r comes first in both cross products (flag F10)."
  }
 ],
