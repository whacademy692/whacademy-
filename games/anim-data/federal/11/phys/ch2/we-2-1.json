 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "The trolley is pushed with **F = 50 N** at **θ = 30°** to the horizontal road. We want the horizontal and vertical components.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Resolve into components",
   "text": "Drop perpendiculars from the head of **F** to the x-axis and y-axis. The two perpendicular parts are the rectangular components \\(F_x\\) and \\(F_y\\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Horizontal component",
   "text": "\\( F_x = F\\cos\\theta = 50\\cos30^\\circ = 50\\times0.866 = 43.3 \\) N: the part that pushes the trolley forward.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Vertical component",
   "text": "\\( F_y = F\\sin\\theta = 50\\sin30^\\circ = 50\\times0.5 = 25 \\) N: the part pressing down on the road.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Check",
   "text": "\\( \\sqrt{43.3^2 + 25^2} = \\sqrt{1874.9 + 625} = 50 \\) N, equal to the original force. ✔",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Components",
   "tex": "F_x = F\\cos\\theta,\\qquad F_y = F\\sin\\theta",
   "text": "θ is measured from the horizontal."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "The same trolley is pushed with **80 N** at 30° to the road. Find the horizontal component (N).",
   "answer": 69.28,
   "hint": "Fx = F cos θ.",
   "explain": "\\( 80\\cos30^\\circ = 69.28 \\) N.",
   "tolerance": 0.05,
   "unit": "N"
  }
 ],
 "takeaways": [
  "**Fx = F cos θ**, **Fy = F sin θ**.",
  "Check with Pythagoras: **√(Fx² + Fy²) = F**."
 ]
}