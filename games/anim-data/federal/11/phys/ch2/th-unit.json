 "formulas": [
  {
   "title": "Position and unit vector",
   "tex": "\\vec r = a\\,\\hat i + b\\,\\hat j, \\quad r = \\sqrt{a^2 + b^2}, \\quad \\hat r = \\dfrac{\\vec r}{r}",
   "text": "r̂ has magnitude 1 and no unit."
  }
 ],
