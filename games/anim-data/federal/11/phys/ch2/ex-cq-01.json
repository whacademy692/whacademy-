 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Show how a vector in a plane is split into two **rectangular components**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Figure 2.1",
   "text": "Vector **A** makes angle θ with +x. Drop perpendiculars from its head P to the axes: they meet the x-axis at Q and the y-axis at S. Then \\( OQ = A_x \\), \\( OS = A_y \\), so \\( \\vec A = A_x\\hat i + A_y\\hat j \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Magnitudes from triangle OPQ",
   "text": "\\( \\sin\\theta = A_y/A \\Rightarrow A_y = A\\sin\\theta \\) and \\( \\cos\\theta = A_x/A \\Rightarrow A_x = A\\cos\\theta \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Vector from components",
   "text": "Pythagoras: \\( A = \\sqrt{A_x^2 + A_y^2} \\). Also \\( \\tan\\theta = A_y/A_x \\Rightarrow \\theta = \\tan^{-1}(A_y/A_x) \\) (check the quadrant).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Example 2.1",
   "text": "\\( F = 50\\) N at 30°: \\( F_x = 50\\cos30^\\circ = 43.3 \\) N and \\( F_y = 50\\sin30^\\circ = 25 \\) N.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Rectangular components",
   "tex": "A_x = A\\cos\\theta,\\; A_y = A\\sin\\theta,\\; A = \\sqrt{A_x^2 + A_y^2},\\; \\theta = \\tan^{-1}\\dfrac{A_y}{A_x}",
   "text": "Eq 2.1–2.5."
  }
 ],
