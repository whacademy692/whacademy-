 ],
 "steps": [
  {
   "id": "s0",
   "title": "Two vectors in components",
   "text": "\\( \\vec A = {{ax|0}}\\hat i {{ay|+}}\\hat j \\) and \\( \\vec B = {{bx|0}}\\hat i {{by|+}}\\hat j \\).",
   "actions": [
    {
     "set": {
      "lv": 0,
      "ax": 3,
      "ay": 2,
      "bx": 1,
      "by": 4
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Multiply like with like",
   "text": "Since î·î = ĵ·ĵ = 1 and î·ĵ = 0, only matching components survive: \\( \\vec A\\cdot\\vec B = A_xB_x + A_yB_y = {{dv|0}} \\).",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Find the magnitudes",
   "text": "\\( A = \\sqrt{A_x^2 + A_y^2} = {{ma|2}} \\) and \\( B = \\sqrt{B_x^2 + B_y^2} = {{mb|2}} \\).",
   "actions": [
    {
     "set": {
      "lv": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Angle between them",
   "text": "\\( \\cos\\theta = \\dfrac{\\vec A\\cdot\\vec B}{AB} = {{cs|3}} \\), so \\( \\theta = {{th|1}}^\\circ \\).",
   "actions": [
    {
     "set": {
      "lv": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "A perpendicular pair",
   "text": "A = (3, 4) and B = (4, −3): 12 − 12 = 0, so the vectors are **perpendicular** (θ = 90°). This is the dot-product test for perpendicular vectors.",
   "actions": [
    {
     "set": {
      "lv": 3,
      "ax": 3,
      "ay": 4,
      "bx": 4,
      "by": -3
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "A · B",
   "value": "{{dv|0}}",
   "role": "dot"
  },
  {
   "label": "θ",
   "value": "{{th|1}}°",
   "role": "ang"
  }
 ],
 "formulas": [
  {
   "title": "Dot product in components",
   "tex": "\\vec A\\cdot\\vec B = A_xB_x + A_yB_y + A_zB_z",
   "text": "Multiply matching components and add: a scalar."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Find A · B for A = (1, 2) and B = (3, 4).",
   "answer": 11,
   "hint": "AₓBₓ + AᵧBᵧ.",
   "explain": "\\( 1\\times3 + 2\\times4 = 11 \\).",
   "tolerance": 0.05
  },
  {
   "id": "c2",
   "type": "number",
   "title": "Now you try",
   "prompt": "Find the angle (°) between A = (1, 0) and B = (1, 1).",
   "answer": 45,
   "hint": "cos θ = (A·B)/(AB) = 1/√2.",
   "explain": "\\( \\cos\\theta = \\dfrac{1}{1\\cdot\\sqrt2} \\Rightarrow \\theta = 45^\\circ \\).",
   "tolerance": 0.5,
   "unit": "°"
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "A = (2, 6) and B = (3, −1). The dot product is…",
   "options": [
    {
     "id": "a",
     "label": "0, so perpendicular"
    },
    {
     "id": "b",
     "label": "12, so acute"
    },
    {
     "id": "c",
     "label": "−12, so obtuse"
    },
    {
     "id": "d",
     "label": "6, so acute"
    }
   ],
   "answer": "a",
   "hint": "2×3 + 6×(−1).",
   "explain": "\\( 6 - 6 = 0 \\): the vectors are perpendicular."
  }
 ],
 "takeaways": [
  "**A · B = AₓBₓ + AᵧBᵧ + A_zB_z** (add the products of matching components).",
  "**cos θ = A·B / AB** gives the angle.",
  "A · B = 0 (for non-zero vectors) means **perpendicular**."
 ]
}