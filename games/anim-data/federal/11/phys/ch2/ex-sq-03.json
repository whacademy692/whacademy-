 "steps": [
  {
   "id": "s0",
   "title": "What we must show",
   "text": "The scalar product of A and B equals the scalar product of B and A.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "A · B",
   "text": "\\( \\vec A\\cdot\\vec B = AB\\cos\\theta \\): A times the projection of B on A.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "B · A",
   "text": "\\( \\vec B\\cdot\\vec A = BA\\cos\\theta \\): B times the projection of A on B. The angle between the two vectors is the same θ whichever you name first.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Compare",
   "text": "A and B are ordinary numbers, so \\( AB = BA \\); cos θ is the same. Therefore \\( \\vec A\\cdot\\vec B = \\vec B\\cdot\\vec A \\): the dot product is **commutative**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Commutative",
   "tex": "\\vec A\\cdot\\vec B = AB\\cos\\theta = BA\\cos\\theta = \\vec B\\cdot\\vec A",
   "text": "The cross product is **not** commutative."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which product changes sign when the vectors are swapped?",
   "options": [
    {
     "id": "a",
     "label": "Dot product"
    },
    {
     "id": "b",
     "label": "Cross product"
    },
    {
