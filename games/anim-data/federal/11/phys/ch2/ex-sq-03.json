    },
    {
     "id": "d",
     "label": "Neither"
    }
   ],
   "answer": "b",
   "hint": "Only one is commutative.",
   "explain": "A × B = −B × A, while A · B = B · A."
  }
 ],
 "takeaways": [
  "**A · B = B · A** because AB cos θ = BA cos θ.",
  "The cross product is anti-commutative."
 ]
