 "steps": [
  {
   "id": "s0",
   "title": "Expand the product",
   "text": "Multiplying the two sums term by term gives **nine** products: \\( A_xB_x(\\hat i\\cdot\\hat i) + A_xB_y(\\hat i\\cdot\\hat j) + \\dots \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Same unit vectors",
   "text": "\\( \\hat i\\cdot\\hat i = \\hat j\\cdot\\hat j = \\hat k\\cdot\\hat k = 1 \\): the three diagonal terms survive as \\( A_xB_x,\\; A_yB_y,\\; A_zB_z \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Different unit vectors",
   "text": "\\( \\hat i\\cdot\\hat j = \\hat j\\cdot\\hat k = \\hat k\\cdot\\hat i = 0 \\): the six off-diagonal terms vanish (perpendicular unit vectors).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Result",
   "text": "Only three terms are left: \\( \\vec A\\cdot\\vec B = A_xB_x + A_yB_y + A_zB_z \\). ∎",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Dot product in components",
   "tex": "\\vec A\\cdot\\vec B = A_xB_x + A_yB_y + A_zB_z",
   "text": "Eq 2.13."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "How many of the nine cross terms (such as AₓBᵧ î·ĵ) are zero?",
   "answer": 6,
   "hint": "Only matching unit vectors survive.",
   "explain": "Three diagonal terms survive; the other **six** are zero.",
   "tolerance": 0.01
  }
 ],
 "takeaways": [
  "Nine terms, only **three** survive.",
  "**î·î = 1** keeps AₓBₓ etc.; **î·ĵ = 0** kills the rest."
 ]
