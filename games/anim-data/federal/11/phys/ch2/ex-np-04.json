 "steps": [
  {
   "id": "s0",
   "title": "Read the data",
   "text": "\\( \\vec A\\cdot\\vec B = 6\\sqrt3 \\) and \\( |\\vec A\\times\\vec B| = 6 \\). Find θ.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Write both products",
   "text": "\\( AB\\cos\\theta = 6\\sqrt3 \\) and \\( AB\\sin\\theta = 6 \\). They are the two legs of a right triangle whose hypotenuse is AB.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Divide",
   "text": "\\( \\tan\\theta = \\dfrac{AB\\sin\\theta}{AB\\cos\\theta} = \\dfrac{6}{6\\sqrt3} = \\dfrac{1}{\\sqrt3} \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Angle",
   "text": "\\( \\theta = \\tan^{-1}(1/\\sqrt3) = 30^\\circ \\). Matches the book key.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Check",
   "text": "\\( AB = \\sqrt{(6\\sqrt3)^2 + 6^2} = \\sqrt{108 + 36} = 12 \\), and \\( 12\\cos30^\\circ = 6\\sqrt3 \\) ✓.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Angle from the two products",
   "tex": "\\tan\\theta = \\dfrac{|\\vec A\\times\\vec B|}{\\vec A\\cdot\\vec B}",
   "text": "Also AB = √((A·B)² + |A×B|²)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A · B = 5 and |A × B| = 5. Find θ in degrees.",
   "answer": 45,
   "hint": "tan θ = 1.",
   "explain": "\\( \\tan\\theta = 5/5 = 1 \\Rightarrow 45^\\circ \\).",
