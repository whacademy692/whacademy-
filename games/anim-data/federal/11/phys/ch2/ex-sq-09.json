 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "What is the unit of the unit vectors î, ĵ, k̂? (The book gives no explanation, flag F9.)",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Their magnitude",
   "text": "A unit vector has magnitude exactly **1**: just a number, with no metre, newton or second attached.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "What they do",
   "text": "They only show a **direction** (along +x, +y, +z). In a vector such as \\( \\vec F = 3\\,\\text{N}\\;\\hat i \\) the unit belongs to the coefficient 3 N.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Answer",
   "text": "The unit vectors are **dimensionless**: they have no units.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Unit vector",
   "tex": "\\hat r = \\dfrac{\\vec r}{r},\\qquad |\\hat r| = 1",
   "text": "Dividing a vector by its own magnitude cancels its unit."
  }
 ],
