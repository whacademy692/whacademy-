 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Both \\( \\vec A\\cdot\\vec B = 0 \\) and \\( \\vec A\\times\\vec B = \\vec 0 \\). What do we learn about A and B?",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Write both conditions",
   "text": "\\( AB\\cos\\theta = 0 \\) and \\( AB\\sin\\theta = 0 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "cos θ and sin θ together",
   "text": "For any angle the point (cos θ, sin θ) lies on the unit circle, so cos θ and sin θ are **never both zero**.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "So AB = 0",
   "text": "Both equations can hold together only if \\( AB = 0 \\): at least one of the vectors is a **null vector**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Both products vanish",
   "tex": "\\vec A\\cdot\\vec B = 0 \\text{ and } \\vec A\\times\\vec B = \\vec 0 \\;\\Rightarrow\\; AB = 0",
   "text": "cos²θ + sin²θ = 1."
  }
 ],
