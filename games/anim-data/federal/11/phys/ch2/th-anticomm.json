 "steps": [
  {
   "id": "s0",
   "title": "A × B",
   "text": "Curl your right-hand fingers from **A** to **B**: the thumb points out of the page, \\( \\vec A\\times\\vec B = {{ma*mb*sin(th)|1}}\\,\\hat k \\).",
   "actions": [
    {
     "set": {
      "o": 0,
      "ma": 4,
      "mb": 3,
      "th": 60
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "B × A",
   "text": "Now curl the fingers from **B** to **A**: the other way round, so the thumb points **into** the page. Same magnitude, opposite direction: \\( \\vec B\\times\\vec A = -\\vec A\\times\\vec B \\).",
   "actions": [
    {
     "set": {
      "o": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Not commutative",
   "text": "The cross product is **anti-commutative**: swapping the order reverses the sign. So A × B ≠ B × A (unless both are zero).",
   "actions": [
    {
     "set": {
      "o": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "The dot product does not care",
   "text": "\\( \\vec A\\cdot\\vec B = AB\\cos\\theta = BA\\cos\\theta = \\vec B\\cdot\\vec A \\) and cos θ does not depend on which vector is named first: the dot product is **commutative**.",
   "actions": [
    {
     "set": {
      "o": 0
     },
     "at": 0
    }
   ]
  }
 ],
 "readouts": [
  {
   "label": "Result",
   "value": "{{v|1}} k̂",
   "role": "crs"
  },
  {
   "label": "A · B",
   "value": "{{dv|1}}",
   "role": "dot"
  }
 ],
 "formulas": [
  {
   "title": "Order of the product",
   "tex": "\\vec A\\times\\vec B = -\\,\\vec B\\times\\vec A, \\qquad \\vec A\\cdot\\vec B = \\vec B\\cdot\\vec A",
   "text": "Cross: anti-commutative. Dot: commutative."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "If A × B = 12 k̂, what is the coefficient of k̂ in B × A?",
   "answer": -12,
   "hint": "Reverse the order.",
   "explain": "\\( \\vec B\\times\\vec A = -12\\,\\hat k \\).",
   "tolerance": 0.01
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "Which product is commutative?",
   "options": [
    {
     "id": "a",
     "label": "Dot product"
    },
    {
     "id": "b",
     "label": "Cross product"
    },
    {
     "id": "c",
     "label": "Both"
    },
    {
     "id": "d",
     "label": "Neither"
    }
   ],
   "answer": "a",
   "hint": "cos θ is the same for A·B and B·A.",
   "explain": "Only the **dot product** is commutative."
  }
 ],
 "takeaways": [
  "**A × B = −B × A**: the direction flips, the magnitude stays.",
  "**A · B = B · A**.",
  "That is why r × F (not F × r) defines torque."
 ]
}