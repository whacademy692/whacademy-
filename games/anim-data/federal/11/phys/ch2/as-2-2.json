 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "\\( \\vec A = 5\\hat i + \\hat j \\) and \\( \\vec B = 2\\hat i + 4\\hat j \\). The projection of one vector on another is the component of the first **along** the second.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Dot product first",
   "text": "\\( \\vec A\\cdot\\vec B = A_xB_x + A_yB_y = 5\\times2 + 1\\times4 = 14 \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Magnitudes",
   "text": "\\( A = \\sqrt{25+1} = \\sqrt{26} = 5.10 \\) and \\( B = \\sqrt{4+16} = \\sqrt{20} = 4.47 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "(i) Projection of A on B",
   "text": "\\( A\\cos\\theta = \\dfrac{\\vec A\\cdot\\vec B}{B} = \\dfrac{14}{4.47} = 3.13 \\). The orange segment along B is this length.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "(ii) Projection of B on A",
   "text": "\\( B\\cos\\theta = \\dfrac{\\vec A\\cdot\\vec B}{A} = \\dfrac{14}{5.10} = 2.75 \\). The green segment along A.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Projection",
   "tex": "\\text{proj}_{B}\\vec A = A\\cos\\theta = \\dfrac{\\vec A\\cdot\\vec B}{B}",
   "text": "Divide the dot product by the length of the vector you project ON."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Find the projection of A = (3, 4) on B = (1, 0).",
   "answer": 3,
   "hint": "A·B / B.",
   "explain": "\\( 3\\times1 + 4\\times0 = 3 \\), divided by B = 1: 3.",
   "tolerance": 0.02
  }
 ],
 "takeaways": [
  "**Projection of A on B = A·B / B**; of B on A = A·B / A.",
  "The two projections are different unless A = B in length."
 ]
}