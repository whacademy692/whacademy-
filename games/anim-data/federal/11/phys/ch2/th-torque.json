 "steps": [
  {
   "id": "s0",
   "title": "A spanner and a push",
   "text": "A force **F** is applied at the end of a spanner of length r, at angle θ to the spanner. The pivot is the nut.",
   "actions": [
    {
     "set": {
      "lv": 0,
      "r": 4,
      "f": 5,
      "th": 60
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Only the perpendicular part turns",
   "text": "Split F. The part along the spanner pushes straight at the pivot and cannot turn it. The part perpendicular to the spanner is \\( F\\sin\\theta = {{f*sin(th)|2}} \\) N.",
   "actions": [
    {
     "set": {
      "lv": 1
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s2",
   "title": "Torque = r F sin θ",
   "text": "The magnitude of the torque is \\( \\tau = rF\\sin\\theta = {{tau|1}} \\) N m: the magnitude of the cross product \\( \\vec r\\times\\vec F \\).",
   "actions": [
    {
     "set": {
      "lv": 2
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s3",
   "title": "Direction by the right-hand rule",
   "text": "Curl your fingers from **r** to **F**: the thumb points out of the page for a counter-clockwise turn. The torque is a **vector** along the axis of rotation.",
   "actions": [
    {
     "set": {
      "lv": 3
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s4",
   "title": "Sweep the angle",
   "text": "Torque is largest at θ = 90° (push at right angles) and zero when you push or pull along the spanner (0° or 180°). Push the other way (negative θ) and the direction flips.",
   "actions": [
    {
     "set": {
      "lv": 3
     },
     "at": 0
    },
    {
     "tween": {
      "th": 90
     },
     "at": 0,
     "dur": 3500
    }
   ]
  }
 ],
 "readouts": [
  {
