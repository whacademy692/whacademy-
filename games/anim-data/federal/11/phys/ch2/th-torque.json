  }
 ],
 "formulas": [
  {
   "title": "Torque",
   "tex": "\\vec\\tau = \\vec r\\times\\vec F, \\qquad \\tau = r\\,F\\sin\\theta",
   "text": "r first, F second (the order matters for the sign)."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
