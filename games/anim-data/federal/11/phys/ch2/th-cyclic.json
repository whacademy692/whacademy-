 "formulas": [
  {
   "title": "Cyclic order",
   "tex": "\\hat i\\times\\hat j=\\hat k,\\quad \\hat j\\times\\hat k=\\hat i,\\quad \\hat k\\times\\hat i=\\hat j",
   "text": "Reversing the order reverses the sign: ĵ × î = −k̂."
  },
  {
   "title": "Same unit vector",
   "tex": "\\hat i\\times\\hat i=\\hat j\\times\\hat j=\\hat k\\times\\hat k=\\vec 0",
   "text": "sin 0° = 0, so a vector crossed with itself is the null vector."
  }
 ],
