 "steps": [
  {
   "id": "s0",
   "title": "Quadrant I (0°–90°)",
   "text": "For θ between 0° and 90° both cos θ and sin θ are positive, so both components are positive. This is the first quadrant.",
   "actions": [
    {
     "set": {
      "th": 40
     },
     "at": 0
    }
   ]
  },
  {
   "id": "s1",
   "title": "Quadrant II (90°–180°)",
   "text": "Past 90° the vector leans left. Aₓ = A cos θ becomes **negative** while Aᵧ stays positive.",
   "actions": [
    {
     "set": {
      "th": 40
     },
     "at": 0
    },
    {
     "tween": {
      "th": 130
     },
     "at": 0,
     "dur": 3200
    }
   ]
  },
  {
   "id": "s2",
   "title": "Quadrant III (180°–270°)",
   "text": "Past 180° the vector points down-left: **both** components are negative.",
   "actions": [
    {
     "set": {
      "th": 130
     },
     "at": 0
    },
    {
     "tween": {
      "th": 220
     },
     "at": 0,
     "dur": 3200
    }
   ]
  },
  {
   "id": "s3",
   "title": "Quadrant IV (270°–360°)",
   "text": "Past 270° the vector points down-right: Aₓ is positive again and Aᵧ is negative.",
   "actions": [
    {
     "set": {
      "th": 220
     },
     "at": 0
    },
    {
     "tween": {
      "th": 320
     },
     "at": 0,
     "dur": 3200
    }
   ]
  },
  {
   "id": "s4",
   "title": "Run the full circle",
   "text": "Press play on the angle slider to spin the vector once around. The formulas Aₓ = A cos θ and Aᵧ = A sin θ work for every angle; the signs come out by themselves.",
   "actions": [
    {
     "set": {
      "th": 320
     },
     "at": 0
    },
    {
     "tween": {
      "th": 360
     },
     "at": 0,
     "dur": 1800
    }
   ]
  }
 ],
