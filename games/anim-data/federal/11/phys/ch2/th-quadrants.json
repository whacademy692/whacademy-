  }
 ],
 "formulas": [
  {
   "title": "Signs by quadrant",
   "tex": "I: (+,+) \\quad II: (-,+) \\quad III: (-,-) \\quad IV: (+,-)",
   "text": "Signs of (Aₓ, Aᵧ) for θ measured from the +x axis."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "A vector of magnitude 6 makes 120° with the +x axis. What is its x-component?",
   "answer": -3,
   "hint": "cos 120° = −0.5.",
   "explain": "\\( A_x = 6\\cos120^\\circ = -3 \\).",
   "tolerance": 0.05
  },
  {
   "id": "c2",
   "type": "choice",
   "title": "Now you try",
   "prompt": "In which quadrant are both components negative?",
   "options": [
    {
     "id": "a",
     "label": "I"
    },
    {
     "id": "b",
     "label": "II"
    },
    {
     "id": "c",
     "label": "III"
    },
    {
     "id": "d",
     "label": "IV"
    }
   ],
   "answer": "c",
   "hint": "Left of the y-axis and below the x-axis.",
   "explain": "Aₓ < 0 and Aᵧ < 0 means quadrant **III** (180°–270°)."
  },
  {
   "id": "c3",
   "type": "choice",
   "title": "Now you try",
   "prompt": "For θ = 300° what are the signs of (Aₓ, Aᵧ)?",
   "options": [
    {
     "id": "a",
     "label": "(+, +)"
    },
    {
     "id": "b",
     "label": "(−, +)"
    },
    {
     "id": "c",
     "label": "(−, −)"
    },
    {
     "id": "d",
     "label": "(+, −)"
    }
   ],
   "answer": "d",
   "hint": "300° lies in the fourth quadrant.",
   "explain": "cos 300° = +0.5 and sin 300° = −0.87: **(+, −)**."
  }
 ],
 "takeaways": [
  "The formulas work for **every** angle; only the signs change.",
  "**I (+,+), II (−,+), III (−,−), IV (+,−).**",
  "Always sketch the vector before trusting a calculator angle."
 ]
}