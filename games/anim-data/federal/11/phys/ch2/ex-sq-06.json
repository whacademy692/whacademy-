 "steps": [
  {
   "id": "s0",
   "title": "A vector at an angle",
   "text": "Take a vector **A** at angle θ to the +x axis.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "What they are",
   "text": "Perpendicular projections of A on the x-axis and y-axis are its **rectangular components** \\( A_x \\) and \\( A_y \\): mutually perpendicular, so they do not affect each other.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "How to find them (A, θ known)",
   "text": "In the right triangle: \\( A_x = A\\cos\\theta \\) and \\( A_y = A\\sin\\theta \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Write the vector",
   "text": "\\( \\vec A = A_x\\hat i + A_y\\hat j \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "The other direction",
   "text": "If the components are known: \\( A = \\sqrt{A_x^2 + A_y^2} \\) and \\( \\theta = \\tan^{-1}(A_y/A_x) \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Rectangular components",
   "tex": "A_x = A\\cos\\theta,\\quad A_y = A\\sin\\theta",
   "text": "Eq 2.1, 2.2."
  }
 ],
