 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "Unit vectors have magnitude 1. Use \\( \\vec A\\cdot\\vec B = AB\\cos\\theta \\) with A = B = 1.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "(a) At 0° (same unit vector)",
   "text": "\\( \\hat i\\cdot\\hat i = (1)(1)\\cos0^\\circ = 1 \\). The same holds for \\( \\hat j\\cdot\\hat j \\) and \\( \\hat k\\cdot\\hat k \\).",
   "actions": []
  },
  {
   "id": "s2",
   "title": "(b) At 90° (different axes)",
   "text": "\\( \\hat i\\cdot\\hat j = (1)(1)\\cos90^\\circ = 0 \\). The same holds for \\( \\hat j\\cdot\\hat k \\) and \\( \\hat k\\cdot\\hat i \\): perpendicular vectors have zero dot product.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Summary",
   "text": "Same unit vector: **1**. Different unit vectors: **0**. These two facts are all you need to prove \\( \\vec A\\cdot\\vec B = A_xB_x + A_yB_y + A_zB_z \\).",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Dot products of unit vectors",
   "tex": "\\hat i\\cdot\\hat i=\\hat j\\cdot\\hat j=\\hat k\\cdot\\hat k=1,\\qquad \\hat i\\cdot\\hat j=\\hat j\\cdot\\hat k=\\hat k\\cdot\\hat i=0",
   "text": "Eq 2.11–2.12."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Evaluate (2î + 3ĵ) · î.",
