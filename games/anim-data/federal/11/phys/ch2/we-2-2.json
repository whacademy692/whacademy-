 "steps": [
  {
   "id": "s0",
   "title": "Given",
   "text": "Velocity \\( \\vec v = 3\\hat i + 4\\hat j \\) m s⁻¹ and force \\( \\vec F = 8\\hat i - 2\\hat j \\) N. Power is the **dot product** of force and velocity.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Use P = F · v",
   "text": "Multiply matching components and add: \\( P = \\vec F\\cdot\\vec v = F_xv_x + F_yv_y \\). (Because î·î = ĵ·ĵ = 1 and î·ĵ = 0.)",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Substitute",
   "text": "\\( P = (8)(3) + (-2)(4) = 24 - 8 \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Result",
   "text": "\\( P = 16 \\) W. It is a **scalar**: the engine delivers 16 joules every second, even though F and v are vectors.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Power as a scalar product",
   "tex": "P = \\vec F\\cdot\\vec v = F_xv_x + F_yv_y",
   "text": "Work/time: the component of F along v times v."
  }
 ],
 "challenges": [
