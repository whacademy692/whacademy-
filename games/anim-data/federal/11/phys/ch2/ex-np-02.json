 "steps": [
  {
   "id": "s0",
   "title": "Read the data",
   "text": "Angle with horizontal θ = 30° and \\( F_x = 20 \\) N. Find F.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Draw it",
   "text": "**F** is the hypotenuse; \\( F_x \\) is the side next to the 30° angle.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Component formula",
   "text": "\\( F_x = F\\cos\\theta \\).",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Rearrange and substitute",
   "text": "\\( F = \\dfrac{F_x}{\\cos\\theta} = \\dfrac{20}{\\cos30^\\circ} = \\dfrac{20}{0.866} \\).",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Answer",
   "text": "\\( F = 23.1 \\) N. Check: \\( F_y = 23.1\\sin30^\\circ = 11.5 \\) N, and \\( \\sqrt{20^2 + 11.5^2} = 23.1 \\) N ✓.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Force from a component",
   "tex": "F_x = F\\cos\\theta \\;\\Rightarrow\\; F = \\dfrac{F_x}{\\cos\\theta}",
   "text": "Eq 2.4 rearranged."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Fx = 30 N and θ = 60°. Find F.",
