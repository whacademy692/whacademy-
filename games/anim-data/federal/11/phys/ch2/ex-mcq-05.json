 "steps": [
  {
   "id": "s0",
   "title": "Read the question",
   "text": "We need a quick way to find the angle θ between **A** and **B**.",
   "actions": []
  },
  {
   "id": "s1",
   "title": "The angle",
   "text": "θ is the angle between the two vectors when drawn tail to tail.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Dot product",
   "text": "\\( \\vec A\\cdot\\vec B = AB\\cos\\theta \\) contains θ through **cos θ**, with everything else (A, B and the dot product from components) known.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Solve for θ",
   "text": "\\( \\theta = \\cos^{-1}\\!\\left(\\dfrac{\\vec A\\cdot\\vec B}{AB}\\right) \\). Cross product gives sin θ (and a direction), the head-to-tail rule adds vectors, the right-hand rule gives a direction: none is as direct. Answer **A**.",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Angle from the dot product",
   "tex": "\\cos\\theta = \\dfrac{\\vec A\\cdot\\vec B}{AB} = \\dfrac{A_xB_x + A_yB_y + A_zB_z}{AB}",
   "text": "Eq 2.14."
  }
 ],
 "challenges": [
  {
   "id": "c1",
   "type": "number",
   "title": "Now you try",
   "prompt": "Find the angle (°) between A = (1, 0) and B = (0, 3).",
   "answer": 90,
   "hint": "A · B = 0.",
   "explain": "\\( \\vec A\\cdot\\vec B = 0 \\Rightarrow \\cos\\theta = 0 \\Rightarrow \\theta = 90^\\circ \\).",
   "tolerance": 0.5,
   "unit": "°"
  }
 ],
 "takeaways": [
  "**cos θ = A · B / AB**: use the dot product for angles.",
  "A · B can be found from components without knowing θ."
 ]
}