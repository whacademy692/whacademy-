 "steps": [
  {
   "id": "s0",
   "title": "Read the data",
   "text": "F = 5.5 N at 10° and r = 4.3 m at 80°, both measured from +x. Find \\( \\vec F\\cdot\\vec r \\) and \\( |\\vec F\\times\\vec r| \\).",
   "actions": []
  },
  {
   "id": "s1",
   "title": "Angle between the vectors",
   "text": "Both angles are from the same axis, so \\( \\theta = 80^\\circ - 10^\\circ = 70^\\circ \\). Also \\( Fr = 5.5\\times4.3 = 23.65 \\) N m.",
   "actions": []
  },
  {
   "id": "s2",
   "title": "Angle and product",
   "text": "The product \\( Fr = 23.65 \\) N m is common to both formulas. Only cos 70° and sin 70° differ.",
   "actions": []
  },
  {
   "id": "s3",
   "title": "Dot product",
   "text": "\\( \\vec F\\cdot\\vec r = Fr\\cos70^\\circ = 23.65\\times0.342 = 8.1 \\) N m.",
   "actions": []
  },
  {
   "id": "s4",
   "title": "Cross product",
   "text": "\\( |\\vec F\\times\\vec r| = Fr\\sin70^\\circ = 23.65\\times0.9397 = 22.2 \\) N m. (Order r × F would give the torque, flag F10.)",
   "actions": []
  }
 ],
 "formulas": [
  {
   "title": "Dot and cross magnitudes",
   "tex": "\\vec F\\cdot\\vec r = Fr\\cos\\theta,\\qquad |\\vec F\\times\\vec r| = Fr\\sin\\theta",
   "text": "θ is the angle between the two vectors, not the angle from the x-axis."
  }
 ],
 "challenges": [
